## Output

import { Derive } from '@macro/derive';


class User {
    name: string;

    static clone(value: User): User {
        return userClone(value);
    }
}

export function userClone(value: User): User {
    const cloned = Object.create(Object.getPrototypeOf(value));
    cloned.name = value.name;
    return cloned;
}

