import { clonedWith as __mf_clonedWith } from "@macroforge/core/structural";
import { Derive } from '@macro/derive';


class User {
    name: string;

    static clone(value: User): User {
        return __mf_clonedWith(value, () => ({ name: value.name }));
    }
}

export function userClone(value: User): User {
    return User.clone(value);
}

