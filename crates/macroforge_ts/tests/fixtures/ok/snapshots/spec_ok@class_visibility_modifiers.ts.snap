## Output

import { clonedWith as __mf_clonedWith } from "@macroforge/core/structural";
import { Derive } from '@macro/derive';


class Account {
    public username: string;
    protected password: string;
    private apiKey: string;

    constructor(username: string, password: string, apiKey: string) {
        this.username = username;
        this.password = password;
        this.apiKey = apiKey;
    }

    public login(): boolean {
        return true;
    }

    protected validatePassword(input: string): boolean {
        return this.password === input;
    }

    private getApiKey(): string {
        return this.apiKey;
    }

    static clone(value: Account): Account {
        return __mf_clonedWith(value, () => ({
        	username: value.username,
        	password: value.password,
        	apiKey: value.apiKey
        }));
    }
}

export function accountClone(value: Account): Account {
    return Account.clone(value);
}

