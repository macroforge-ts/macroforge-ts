## Output

#!/usr/bin/env node
/// <reference lib="esnext" />
// @ts-check
'use client';
import { clonedWith as __mf_clonedWith, equalWithin as __mf_equalWithin } from "@macroforge/core/structural";

/** The first declaration's own comment. */
export const first = 1;


export interface Point {
    x: number;
    y: number;
}

export function pointClone(value: Point): Point {
    return __mf_clonedWith(value, (): Point => ({
	x: value.x,
	y: value.y
}));
}

export function pointEquals(a: Point, b: Point): boolean {
    if (a === b) return true;
    return __mf_equalWithin(a, b, () => {
        return [
            () => a.x === b.x || a.x !== a.x && b.x !== b.x,
            () => a.y === b.y || a.y !== a.y && b.y !== b.y,
        ].every((same) => same());
    });
}

export const Point: {
  readonly clone: typeof pointClone;
  readonly equals: typeof pointEquals;
} = {
  clone: pointClone,
  equals: pointEquals
};

