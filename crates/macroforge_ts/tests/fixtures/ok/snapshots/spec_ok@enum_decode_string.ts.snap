import { DecodeContext as __mf_DecodeContext } from "@macroforge/core/endec";

enum Role {
    Admin = 'admin',
    User = 'user',
    Guest = 'guest'
}

/** Decodes input to an enum value. @param input - Value to decode @returns The enum value @throws Error if the value is not a valid enum member  */
        export function roleDecode(input: unknown): Role {
            return roleDecodeWithContext(input);
        }

        /** Decodes with an existing context (for consistency with other types).  */
        export function roleDecodeWithContext(data: unknown, ctx?: __mf_DecodeContext): Role;
        export function roleDecodeWithContext(data: unknown): Role {
            if (Role["Admin"] === data) {
                    return Role["Admin"];
                }
            if (Role["User"] === data) {
                    return Role["User"];
                }
            if (Role["Guest"] === data) {
                    return Role["Guest"];
                }




            throw new Error("Invalid Role value: " + JSON.stringify(data));
        }

        export function roleIs(value: unknown): value is Role {
            if (Role["Admin"] === value) {
                    return true;
                }
            if (Role["User"] === value) {
                    return true;
                }
            if (Role["Guest"] === value) {
                    return true;
                }




            return false;
        }

namespace Role {
  export const decode: typeof roleDecode = roleDecode;
  export const decodeWithContext: typeof roleDecodeWithContext = roleDecodeWithContext;
  export const is: typeof roleIs = roleIs;
}

