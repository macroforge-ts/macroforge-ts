import { parsedText as __mf_parsedText, DecodeContext as __mf_DecodeContext, DecodeError as __mf_DecodeError } from "@macroforge/core/endec";

enum Role {
    Admin = 'admin',
    User = 'user',
    Guest = 'guest'
}

/** Decodes a value to an enum member; JSON text decodes through `fromString`. @param input - The value to decode @returns The enum value @throws Error if the value is not a valid enum member  */
export function roleDecode(input: unknown): Role {
    return roleDecodeWithContext(input);
}

/** Decodes JSON text, as `encode` writes it, to an enum member. @param text - The JSON text @returns The enum value @throws Error if the text is not JSON or spells no member  */
export function roleFromString(text: string): Role {
    return roleDecodeWithContext(__mf_parsedText(text));
}

/** Decodes with an existing context (for consistency with other types).  */
export function roleDecodeWithContext(data: unknown, ctx?: __mf_DecodeContext): Role;
export function roleDecodeWithContext(data: unknown): Role {
    if (Role["Admin"] === data) {
        return Role["Admin"];
    }
    if (Role["User"] === data) {
        return Role["User"];
    }
    if (Role["Guest"] === data) {
        return Role["Guest"];
    }
    throw new __mf_DecodeError([{ field: "_root", message: "Invalid Role value: " + JSON.stringify(data) }]);
}

export function roleIs(value: unknown): value is Role {
    if (Role["Admin"] === value) {
        return true;
    }
    if (Role["User"] === value) {
        return true;
    }
    if (Role["Guest"] === value) {
        return true;
    }
    return false;
}

namespace Role {
  export const decode: typeof roleDecode = roleDecode;
  export const fromString: typeof roleFromString = roleFromString;
  export const decodeWithContext: typeof roleDecodeWithContext = roleDecodeWithContext;
  export const is: typeof roleIs = roleIs;
}

