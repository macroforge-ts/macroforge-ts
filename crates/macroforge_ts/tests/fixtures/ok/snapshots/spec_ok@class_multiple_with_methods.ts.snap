import { debuggedWithin as __mf_debuggedWithin, clonedWith as __mf_clonedWith, equalWithin as __mf_equalWithin, hashedWithin as __mf_hashedWithin } from "@macroforge/core/structural";
import { Derive } from '@macro/derive';


class Product {
    id: string;
    name: string;
    price: number;
    private secret: string;

    constructor(id: string, name: string, price: number, secret: string) {
        this.id = id;
        this.name = name;
        this.price = price;
        this.secret = secret;
    }

    getDisplayName(): string {
        return `${this.name} - $${this.price}`;
    }

    static fromJSON(json: any): Product {
        return new Product(json.id, json.name, json.price, json.secret);
    }

    static toString(value: Product): string {
        return __mf_debuggedWithin(value, () => {
            const parts: string[] = [];
        parts.push("id: " + String(value.id));
        parts.push("name: " + String(value.name));
        parts.push("price: " + String(value.price));
        parts.push("secret: " + String(value.secret));
            return "Product { " + parts.join(", ") + " }";
        });
    }

    static clone(value: Product): Product {
        return __mf_clonedWith(value, () => ({
        	id: value.id,
        	name: value.name,
        	price: value.price,
        	secret: value.secret
        }));
    }

    static equals(a: Product, b: Product): boolean {
        if (a === b) return true;
        return __mf_equalWithin(a, b, () => a.id === b.id && a.name === b.name && (a.price === b.price || a.price !== a.price && b.price !== b.price) && a.secret === b.secret);
    }

    static hashCode(value: Product): number {
        return __mf_hashedWithin(value, () => {
            let hash = 17;
        hash = (hash * 31 + ((value.id ?? "").split("").reduce<number>((h, c) => h * 31 + c.charCodeAt(0) | 0, 0))) | 0;
        hash = (hash * 31 + ((value.name ?? "").split("").reduce<number>((h, c) => h * 31 + c.charCodeAt(0) | 0, 0))) | 0;
        hash = (hash * 31 + (Number.isInteger(value.price) ? value.price | 0 : value.price.toString().split("").reduce<number>((h, c) => h * 31 + c.charCodeAt(0) | 0, 0))) | 0;
        hash = (hash * 31 + ((value.secret ?? "").split("").reduce<number>((h, c) => h * 31 + c.charCodeAt(0) | 0, 0))) | 0;
            return hash;
        });
    }
}

export function productToString(value: Product): string {
    return Product.toString(value);
}

export function productClone(value: Product): Product {
    return Product.clone(value);
}

export function productEquals(a: Product, b: Product): boolean {
    return Product.equals(a, b);
}

export function productHashCode(value: Product): number {
    return Product.hashCode(value);
}

