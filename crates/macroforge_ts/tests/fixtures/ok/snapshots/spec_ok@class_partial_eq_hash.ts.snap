## Output

import { equalWithin as __mf_equalWithin, hashedWithin as __mf_hashedWithin } from "@macroforge/core/structural";
import { Derive } from '@macro/derive';


class User {
    name: string;

    static equals(a: User, b: User): boolean {
        if (a === b) return true;
        return __mf_equalWithin(a, b, () => a.name === b.name);
    }

    static hashCode(value: User): number {
        return __mf_hashedWithin(value, () => {
            let hash = 17;
        hash = (hash * 31 + ((value.name ?? "").split("").reduce<number>((h, c) => h * 31 + c.charCodeAt(0) | 0, 0))) | 0;
            return hash;
        });
    }
}

export function userEquals(a: User, b: User): boolean {
    return User.equals(a, b);
}

export function userHashCode(value: User): number {
    return User.hashCode(value);
}

