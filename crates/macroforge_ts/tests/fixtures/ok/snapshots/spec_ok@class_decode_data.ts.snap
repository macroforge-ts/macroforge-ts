import { DecodeContext as __mf_DecodeContext, DecodeError as __mf_DecodeError, PendingRef as __mf_PendingRef } from "@macroforge/core/endec";
import type { DecodeOptions as __mf_DecodeOptions } from "@macroforge/core/endec";
import { Derive } from '@macro/derive';


class Data {
    val: number;

    constructor(props: { val: number }) {
        this.val = props.val;
    }

    /** Decodes input to an instance of this class. Automatically detects whether input is a JSON string or object. @param input - JSON string or object to decode @param opts - Optional decoding options @returns Result containing the decoded instance or validation errors  */
    static decode(input: unknown, opts?: __mf_DecodeOptions): { success: true; value: Data } | { success: false; errors: Array<{ field: string; message: string }> } {
        try {

            const data = typeof input === "string" ? JSON.parse(input) : input;

            const ctx = __mf_DecodeContext.create();
            const resultOrRef = Data.decodeWithContext(data, ctx);

            if (__mf_PendingRef.is(resultOrRef)) {
                return ({
    	success: false,
    	errors: [{
    		field: "_root",
    		message: "Data.decode: root cannot be a forward reference"
    	}]
    });
            }

            ctx.applyPatches();
            if (opts?.freeze) {
                ctx.freezeAll();
            }

            const __errors = ctx.getErrors();
            if (__errors.length > 0) {
                return ({
    	success: false,
    	errors: __errors
    });
            }

            return ({
    	success: true,
    	value: resultOrRef
    });
        } catch (e) {
            if (e instanceof __mf_DecodeError) {
                return ({
    	success: false,
    	errors: e.errors
    });
            }
            const message = e instanceof Error ? e.message : String(e);
            return ({
    	success: false,
    	errors: [{
    		field: "_root",
    		message
    	}]
    });
        }
    }

    /** Decodes with an existing context for nested/cyclic object graphs. @param value - The raw value to decode @param ctx - The decoding context  */
    static decodeWithContext(value: unknown, ctx: __mf_DecodeContext): Data | __mf_PendingRef {
        if (typeof value === "object" && value !== null && "__ref" in value) {
            if (typeof value.__ref !== "number") {
                throw new __mf_DecodeError([{ field: "__ref", message: "Data.decodeWithContext: __ref must be a number" }]);
            }
            return ctx.getOrDefer(value.__ref) as Data | __mf_PendingRef;
        }

        if (typeof value !== "object" || value === null || Array.isArray(value)) {
            throw new __mf_DecodeError([{ field: "_root", message: "Data.decodeWithContext: expected an object" }]);
        }

        const obj = value as Record<string, unknown>;
        const errors: Array<{ field: string; message: string }> = [];
        if (!("val" in obj)) {
            errors.push({ field: "val", message: "missing required field" });
        }

        const instance = Object.create(Data.prototype) as Data;

        if (obj.__id !== undefined) {
            ctx.register(obj.__id as number, instance);
        }

        ctx.trackForFreeze(instance);

        {
            const __raw_val = obj["val"] as number;

            if (!(typeof __raw_val === "number")) {
                errors.push({ field: "val", message: __raw_val == null ? "Data.val is required" : "expected number" });
            } else {
                instance.val = __raw_val;
            }
        }

        ctx.pushErrors(errors);

        return instance;
    }
    static validateField<K extends keyof Data>(field: K, value: unknown): Array<{ field: string; message: string }>;
    static validateField(): Array<{ field: string; message: string }> {
        return [];
    }

    static validateFields(partial: { readonly [K in keyof Data]?: unknown }): Array<{ field: string; message: string }>;
    static validateFields(): Array<{ field: string; message: string }> {
        return [];
    }

    static hasShape(obj: unknown): boolean {
        if (typeof obj !== "object" || obj === null || Array.isArray(obj)) {
            return false;
        }
        const o = obj as Record<string, unknown>;
        return "val" in o;
    }

    static is(obj: unknown): obj is Data {
        if (obj instanceof Data) {
            return true;
        }
        if (!Data.hasShape(obj)) {
            return false;
        }
        const result = Data.decode(obj);
        return result.success;
    }
}

/** Decodes input to an instance. Automatically detects whether input is a JSON string or object. @param input - JSON string or object to decode @param opts - Optional decoding options @returns Result containing the decoded instance or validation errors  */
export function dataDecode(input: unknown, opts?: __mf_DecodeOptions): { success: true; value: Data } | { success: false; errors: Array<{ field: string; message: string }> } {
    return Data.decode(input, opts);
}

/** Decodes with an existing context for nested/cyclic object graphs. @param value - The raw value to decode @param ctx - The decoding context  */
export function dataDecodeWithContext(value: unknown, ctx: __mf_DecodeContext): Data | __mf_PendingRef {
    return Data.decodeWithContext(value, ctx);
}

/** Type guard: checks if a value can be successfully decoded. @param value - The value to check @returns True if the value can be decoded to this type  */
export function dataIs(value: unknown): value is Data {
