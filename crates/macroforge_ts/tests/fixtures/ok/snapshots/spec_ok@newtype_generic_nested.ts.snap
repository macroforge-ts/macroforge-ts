                    return ({
	success: false,
	errors: e.errors
});
                }
                const message = e instanceof Error ? e.message : String(e);
                return ({
	success: false,
	errors: [{
		field: "_root",
		message
	}]
});
            }
        }

        /** Decodes with an existing context for nested/cyclic object graphs. @param value - The raw value to decode @param ctx - The decoding context  */
        export function idDecodeWithContext<T>(value: unknown, _ctx: __mf_DecodeContext): Id<T> {const __decoded: unknown = value;











