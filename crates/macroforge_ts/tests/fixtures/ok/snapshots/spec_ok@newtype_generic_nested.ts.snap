import { EncodeContext as __mf_EncodeContext, DecodeContext as __mf_DecodeContext, DecodeError as __mf_DecodeError } from "@macroforge/core/endec";
import type { DecodeOptions as __mf_DecodeOptions } from "@macroforge/core/endec";
declare const __mf_newtype_1: unique symbol;
declare const __mf_newtype_3: unique symbol;
declare const __mf_newtype_2: unique symbol;

export type Id<T> = string & { readonly [__mf_newtype_1]: true };

/** Encodes a value to a JSON string. @param value - The value to encode @param keepMetadata - Accepted for signature parity; primitives carry no metadata @returns JSON string representation  */
export function idEncode<T>(value: Id<T>, keepMetadata?: boolean): string;
export function idEncode<T>(value: Id<T>): string {
    return JSON.stringify(value);
}

/** Encodes with an existing context for nested/cyclic object graphs. @param value - The value to encode @param ctx - The encoding context, unused for primitives  */
export function idEncodeWithContext<T>(value: Id<T>, ctx: __mf_EncodeContext): unknown;
export function idEncodeWithContext<T>(value: Id<T>): unknown {
    return value;
}

/** Decodes input to this type. @param input - Value to decode @param opts - Optional decoding options @returns Result containing the decoded value or validation errors  */
export function idDecode<T>(input: unknown, opts?: __mf_DecodeOptions): { success: true; value: Id<T> } | { success: false; errors: Array<{ field: string; message: string }> } {
    try {
        const data = input;

        const ctx = __mf_DecodeContext.create();
        const result = idDecodeWithContext<T>(data, ctx);
        if (opts?.freeze) {
            ctx.freezeAll();
        }

        const __errors = ctx.getErrors();
        if (__errors.length > 0) {
            return ({
	success: false,
	errors: __errors
});
        }

        return ({
	success: true,
	value: result
});
    } catch (e) {
        if (e instanceof __mf_DecodeError) {
            return ({
	success: false,
	errors: e.errors
});
        }
        const message = e instanceof Error ? e.message : String(e);
        return ({
	success: false,
	errors: [{
		field: "_root",
		message
	}]
});
    }
}

/** Decodes with an existing context for nested/cyclic object graphs. @param value - The raw value to decode @param ctx - The decoding context  */
export function idDecodeWithContext<T>(value: unknown, _ctx: __mf_DecodeContext): Id<T> {
    const __decoded: unknown = value;
    if (typeof __decoded !== "string") {
        throw new __mf_DecodeError([{ field: "_root", message: "Id.decodeWithContext: expected string" }]);
    }
    return __decoded as Id<T>;
}

export function idHasShape(value: unknown): boolean {
    return typeof value === "string";
}

export function idIs<T>(value: unknown): value is Id<T> {
    return typeof value === "string";
}

export const Id: {
  readonly encode: typeof idEncode;
  readonly encodeWithContext: typeof idEncodeWithContext;
  readonly decode: typeof idDecode;
  readonly decodeWithContext: typeof idDecodeWithContext;
