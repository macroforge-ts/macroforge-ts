import { encodedText as __mf_encodedText, textOrValue as __mf_textOrValue, DecodeContext as __mf_DecodeContext, DecodeError as __mf_DecodeError } from "@macroforge/core/endec";
import type { EncodeContext as __mf_EncodeContext } from "@macroforge/core/endec";

enum Status {
    Active = 'active',
    Inactive = 'inactive'
}

export function statusToString(value: Status): string {

    const held: unknown = value;
    if (held === Status["Active"]) {
        return "Status.Active";
    }
    if (held === Status["Inactive"]) {
        return "Status.Inactive";
    }
    return "Status(" + String(value) + ")";
}

export function statusClone(value: Status): Status {
    return value;
}

export function statusEquals(a: Status, b: Status): boolean {
    return a === b;
}

export function statusHashCode(value: Status): number {
    return (value ?? "").split("").reduce<number>((h, c) => (h * 31 + c.charCodeAt(0)) | 0, 0);
}

/** Encodes this enum value to a JSON string.  */
export function statusEncode(value: Status): string {
    return __mf_encodedText(value);
}

/** Encodes with an existing context for nested/cyclic object graphs.  */
export function statusEncodeWithContext(value: Status, ctx: __mf_EncodeContext): string | number;
export function statusEncodeWithContext(value: Status): string | number {
    return value;
}

/** Decodes input to an enum value. @param input - Value to decode @returns The enum value @throws Error if the value is not a valid enum member  */
export function statusDecode(input: unknown): Status {

    return statusDecodeWithContext(__mf_textOrValue(input, statusIs));
}

/** Decodes with an existing context (for consistency with other types).  */
export function statusDecodeWithContext(data: unknown, ctx?: __mf_DecodeContext): Status;
export function statusDecodeWithContext(data: unknown): Status {
    if (Status["Active"] === data) {
        return Status["Active"];
    }
    if (Status["Inactive"] === data) {
        return Status["Inactive"];
    }
    throw new __mf_DecodeError([{ field: "_root", message: "Invalid Status value: " + JSON.stringify(data) }]);
}

export function statusIs(value: unknown): value is Status {
    if (Status["Active"] === value) {
        return true;
    }
    if (Status["Inactive"] === value) {
        return true;
    }
    return false;
}

namespace Status {
  export const toString: typeof statusToString = statusToString;
  export const clone: typeof statusClone = statusClone;
  export const equals: typeof statusEquals = statusEquals;
  export const hashCode: typeof statusHashCode = statusHashCode;
  export const encode: typeof statusEncode = statusEncode;
  export const encodeWithContext: typeof statusEncodeWithContext = statusEncodeWithContext;
  export const decode: typeof statusDecode = statusDecode;
  export const decodeWithContext: typeof statusDecodeWithContext = statusDecodeWithContext;
  export const is: typeof statusIs = statusIs;
}

