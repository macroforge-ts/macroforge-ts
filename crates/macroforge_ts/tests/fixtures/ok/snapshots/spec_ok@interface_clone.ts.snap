interface UserData {
    name: string;
    age: number;
}

export function userDataClone(value: UserData): UserData {
                    const result = {} as any;
                    result.name = value.name;
result.age = value.age;

                    return result as UserData;
                }

const UserData = {
  clone: userDataClone
} as const;

