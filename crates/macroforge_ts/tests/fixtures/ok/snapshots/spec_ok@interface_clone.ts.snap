interface UserData {
    name: string;
    age: number;
}

export function userDataClone(value: UserData): UserData {
    return ({
	name: value.name,
	age: value.age
});
}

const UserData: {
  readonly clone: typeof userDataClone;
} = {
  clone: userDataClone
};

