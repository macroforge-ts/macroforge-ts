import { clonedWith as __mf_clonedWith } from "@macroforge/core/structural";

interface UserData {
    name: string;
    age: number;
}

export function userDataClone(value: UserData): UserData {
    return __mf_clonedWith(value, (): UserData => ({
	name: value.name,
	age: value.age
}));
}

const UserData: {
  readonly clone: typeof userDataClone;
} = {
  clone: userDataClone
};

