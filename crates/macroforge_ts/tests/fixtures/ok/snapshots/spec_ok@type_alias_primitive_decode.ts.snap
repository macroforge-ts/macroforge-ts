import { encodedText as __mf_encodedText, EncodeContext as __mf_EncodeContext, decodedText as __mf_decodedText, DecodeContext as __mf_DecodeContext, DecodeError as __mf_DecodeError } from "@macroforge/core/endec";
import type { DecodeOptions as __mf_DecodeOptions } from "@macroforge/core/endec";

type Port = number;

/** Encodes a value to a JSON string. @param value - The value to encode @param keepMetadata - Accepted for signature parity; primitives carry no metadata @returns JSON string representation  */
export function portEncode(value: Port, keepMetadata?: boolean): string;
export function portEncode(value: Port): string {
    return __mf_encodedText(value);
}

/** Encodes with an existing context for nested/cyclic object graphs. @param value - The value to encode @param ctx - The encoding context, unused for primitives  */
export function portEncodeWithContext(value: Port, ctx: __mf_EncodeContext): unknown;
export function portEncodeWithContext(value: Port): unknown {
    return value;
}

/** Decodes a value to this type; JSON text decodes through `fromString`. @param input - The value to decode @param opts - Optional decoding options @returns Result containing the decoded value or validation errors  */
export function portDecode(input: unknown, opts?: __mf_DecodeOptions): { success: true; value: Port } | { success: false; errors: Array<{ field: string; message: string }> } {
    try {
        const ctx = __mf_DecodeContext.create();
        const result = portDecodeWithContext(input, ctx);
        if (opts?.freeze) {
            ctx.freezeAll();
        }

        const __errors = ctx.getErrors();
        if (__errors.length > 0) {
            return ({
	success: false,
	errors: __errors
});
        }

        return ({
	success: true,
	value: result
});
    } catch (e) {
        if (e instanceof __mf_DecodeError) {
            return ({
	success: false,
	errors: e.errors
});
        }
        const message = e instanceof Error ? e.message : String(e);
        return ({
	success: false,
	errors: [{
		field: "_root",
		message
	}]
});
    }
}

/** Decodes with an existing context for nested/cyclic object graphs. @param value - The raw value to decode @param ctx - The decoding context  */
export function portDecodeWithContext(value: unknown, _ctx: __mf_DecodeContext): Port {
    const __decoded: unknown = value;
    if (!((typeof __decoded === "number" && globalThis.Number.isFinite(__decoded)))) {
        throw new __mf_DecodeError([{ field: "_root", message: "Port.decodeWithContext: expected number" }]);
    }
    return __decoded as Port;
}

export function portHasShape(value: unknown): boolean {
    return (typeof value === "number" && globalThis.Number.isFinite(value));
}

export function portIs(value: unknown): value is Port {
    return (typeof value === "number" && globalThis.Number.isFinite(value)) && portDecode(value).success;
}
/** Decodes JSON text, as `encode` writes it, to this type. @param text - The JSON text @param opts - Optional decoding options @returns Result containing the decoded value or validation errors  */
export function portFromString(text: string, opts?: __mf_DecodeOptions): { success: true; value: Port } | { success: false; errors: Array<{ field: string; message: string }> } {
    return __mf_decodedText(text, (value) => portDecode(value, opts));
}

const Port: {
  readonly encode: typeof portEncode;
  readonly encodeWithContext: typeof portEncodeWithContext;
  readonly decode: typeof portDecode;
  readonly decodeWithContext: typeof portDecodeWithContext;
  readonly hasShape: typeof portHasShape;
  readonly is: typeof portIs;
  readonly fromString: typeof portFromString;
} = {
  encode: portEncode,
  encodeWithContext: portEncodeWithContext,
  decode: portDecode,
  decodeWithContext: portDecodeWithContext,
  hasShape: portHasShape,
  is: portIs,
  fromString: portFromString
};


type RequestId = string;

/** Decodes a value to this type; JSON text decodes through `fromString`. @param input - The value to decode @param opts - Optional decoding options @returns Result containing the decoded value or validation errors  */
export function requestIdDecode(input: unknown, opts?: __mf_DecodeOptions): { success: true; value: RequestId } | { success: false; errors: Array<{ field: string; message: string }> } {
    try {
        const ctx = __mf_DecodeContext.create();
        const result = requestIdDecodeWithContext(input, ctx);
        if (opts?.freeze) {
            ctx.freezeAll();
        }

        const __errors = ctx.getErrors();
        if (__errors.length > 0) {
            return ({
	success: false,
	errors: __errors
});
        }

        return ({
	success: true,
	value: result
});
    } catch (e) {
        if (e instanceof __mf_DecodeError) {
