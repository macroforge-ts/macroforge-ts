	success: false,
	errors: e.errors
});
        }
        const message = e instanceof Error ? e.message : String(e);
        return ({
	success: false,
	errors: [{
		field: "_root",
		message
	}]
});
    }
}

/** Decodes with an existing context for nested/cyclic object graphs. @param value - The raw value to decode @param ctx - The decoding context  */
export function requestIdDecodeWithContext(value: unknown, ctx: __mf_DecodeContext): RequestId {
    const __decoded: unknown = value;
    if (!(typeof __decoded === "string")) {
        throw new __mf_DecodeError([{ field: "_root", message: "RequestId.decodeWithContext: expected string" }]);
    }
    const errors: Array<{ field: string; message: string }> = [];
    if (!/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(__decoded)) { errors.push({ field: "_root", message: "RequestId must be a valid UUID" }); }
    ctx.pushErrors(errors);
    return __decoded as RequestId;
}

export function requestIdHasShape(value: unknown): boolean {
    return typeof value === "string";
}

export function requestIdIs(value: unknown): value is RequestId {
    return typeof value === "string" && requestIdDecode(value).success;
}
/** Decodes JSON text, as `encode` writes it, to this type. @param text - The JSON text @param opts - Optional decoding options @returns Result containing the decoded value or validation errors  */
export function requestIdFromString(text: string, opts?: __mf_DecodeOptions): { success: true; value: RequestId } | { success: false; errors: Array<{ field: string; message: string }> } {
