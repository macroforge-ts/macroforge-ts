export type Reading = [string, number, boolean];

export function readingHashCode(value: Reading): number {
    let hash = 1;
    hash = (hash * 31 + ((value[0] ?? "").split("").reduce<number>((h, c) => (h * 31 + c.charCodeAt(0)) | 0, 0))) | 0;
    hash = (hash * 31 + ((Number.isInteger(value[1]) ? value[1] | 0 : value[1].toString().split("").reduce<number>((h, c) => (h * 31 + c.charCodeAt(0)) | 0, 0)))) | 0;
    hash = (hash * 31 + ((value[2] ? 1231 : 1237))) | 0;
    return hash;
}

export const Reading: {
  readonly hashCode: typeof readingHashCode;
} = {
  hashCode: readingHashCode
};


export type Nothing = [];

export function nothingHashCode(_value: Nothing): number {
    let hash = 1;
    return hash;
}

export const Nothing: {
  readonly hashCode: typeof nothingHashCode;
} = {
  hashCode: nothingHashCode
};

