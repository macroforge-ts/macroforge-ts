## Output

export class User {
    name: string;

    static toString(value: User): string {
        return userToString(value);
    }
}

export function userToString(value: User): string {
    const parts: string[] = [];
    parts.push("name: " + String(value.name));
    return "User { " + parts.join(", ") + " }";
}

