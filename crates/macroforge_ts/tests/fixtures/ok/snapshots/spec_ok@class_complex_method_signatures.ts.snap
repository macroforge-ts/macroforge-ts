import { Derive } from '@macro/derive';


class API {
    endpoint: string;

    constructor(endpoint: string) {
        this.endpoint = endpoint;
    }

    async fetch<T>(
        path: string,
        options?: { method?: string; body?: any }
    ): Promise<T> {
        return {} as T;
    }

    subscribe(
        event: 'data' | 'error',
        callback: (data: any) => void,
        thisArg?: any
    ): () => void {
        return () => {};
    }

static toString(value: API): string {
                    return apiToString(value);
                }}

export function apiToString(value: API): string {
                        const parts: string[] = [];
                        parts.push("endpoint: " + value.endpoint);

                        return "API { " + parts.join(", ") + " }";
                    }

