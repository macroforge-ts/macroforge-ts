## Output

class MacroUser {
    
    id: string;

    name: string;
    role: string;
    favoriteMacro: 'Derive' | 'JsonNative';
    since: string;

    
    apiToken: string;

    constructor(
        id: string,
        name: string,
        role: string,
        favoriteMacro: 'Derive' | 'JsonNative',
        since: string,
        apiToken: string
    ) {
        this.id = id;
        this.name = name;
        this.role = role;
        this.favoriteMacro = favoriteMacro;
        this.since = since;
        this.apiToken = apiToken;
    }

    static toString(value: MacroUser): string {
        return macroUserToString(value);
    }
}

export function macroUserToString(value: MacroUser): string {
    const parts: string[] = [];
    parts.push("userId: " + String(value.id));
    parts.push("name: " + String(value.name));
    parts.push("role: " + String(value.role));
    parts.push("favoriteMacro: " + String(value.favoriteMacro));
    parts.push("since: " + String(value.since));
    return "MacroUser { " + parts.join(", ") + " }";
}

