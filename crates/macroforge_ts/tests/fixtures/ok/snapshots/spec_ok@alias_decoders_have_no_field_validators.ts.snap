type Meters = number;

/** Decodes a value to this type; JSON text decodes through `fromString`. @param input - The value to decode @param opts - Optional decoding options @returns Result containing the decoded value or validation errors  */
export function metersDecode(input: unknown, opts?: __mf_DecodeOptions): { success: true; value: Meters } | { success: false; errors: Array<{ field: string; message: string }> } {
    try {
        const ctx = __mf_DecodeContext.create();
        const result = metersDecodeWithContext(input, ctx);
        if (opts?.freeze) {
            ctx.freezeAll();
        }

        const __errors = ctx.getErrors();
        if (__errors.length > 0) {
            return ({
	success: false,
	errors: __errors
});
        }

        return ({
	success: true,
	value: result
});
    } catch (e) {
        if (e instanceof __mf_DecodeError) {
            return ({
	success: false,
	errors: e.errors
});
        }
        const message = e instanceof Error ? e.message : String(e);
        return ({
	success: false,
	errors: [{
		field: "_root",
		message
	}]
});
    }
}

/** Decodes with an existing context for nested/cyclic object graphs. @param value - The raw value to decode @param ctx - The decoding context  */
export function metersDecodeWithContext(value: unknown, ctx: __mf_DecodeContext): Meters {
    const __decoded: unknown = value;
    if (!((typeof __decoded === "number" && globalThis.Number.isFinite(__decoded)))) {
        throw new __mf_DecodeError([{ field: "_root", message: "Meters.decodeWithContext: expected number" }]);
    }
    const errors: Array<{ field: string; message: string }> = [];
    if (__decoded < 0) { errors.push({ field: "_root", message: "Meters must be non-negative" }); }
    ctx.pushErrors(errors);
    return __decoded as Meters;
}

export function metersHasShape(value: unknown): boolean {
    return (typeof value === "number" && globalThis.Number.isFinite(value));
}

export function metersIs(value: unknown): value is Meters {
    return (typeof value === "number" && globalThis.Number.isFinite(value)) && metersDecode(value).success;
}
/** Decodes JSON text, as `encode` writes it, to this type. @param text - The JSON text @param opts - Optional decoding options @returns Result containing the decoded value or validation errors  */
export function metersFromString(text: string, opts?: __mf_DecodeOptions): { success: true; value: Meters } | { success: false; errors: Array<{ field: string; message: string }> } {
