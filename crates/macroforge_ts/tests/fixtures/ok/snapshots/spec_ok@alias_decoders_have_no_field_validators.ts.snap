        const message = e instanceof Error ? e.message : String(e);
        return ({
	success: false,
	errors: [{
		field: "_root",
		message
	}]
});
    }
}

export function spanIs(value: unknown): value is Span {
    return spanHasShape(value) && spanDecode(value).success;
}
/** Decodes with an existing context for nested/cyclic object graphs. @param value - The raw value to decode @param ctx - The decoding context  */
export function spanDecodeWithContext(value: unknown, ctx: __mf_DecodeContext): Span {
    if (typeof value === "object" && value !== null && "__ref" in value) {
        if (typeof value.__ref !== "number") {
            throw new __mf_DecodeError([{ field: "__ref", message: "Span.decodeWithContext: __ref must be a number" }]);
        }
        return ctx.getOrDefer(value.__ref) as Span;
    }
    if (!Array.isArray(value)) {
        throw new __mf_DecodeError([{ field: "_root", message: "Span.decodeWithContext: expected an array" }]);
    }
    const errors: Array<{ field: string; message: string }> = [];
    if (value.length <= 0) {
        errors.push({ field: "0", message: "missing required element" });
    }
    if (value.length <= 1) {
        errors.push({ field: "1", message: "missing required element" });
    }
    if (value.length > 2) {
        errors.push({ field: "_root", message: "too many elements" });
    }
    const obj: Record<string, unknown> = {};
    for (let __index = 0; __index < Math.min(value.length, 2); __index++) {
        obj[__index] = value[__index];
    }

    const tuple: unknown[] = new Array<unknown>(Math.min(value.length, 2)).fill(undefined);
    const instance: { "e0"?: number | undefined; "e1"?: number | undefined } = {};
    Object.defineProperty(instance, "e0", {
        get: () => tuple[0],
        set: (item: unknown) => {
            tuple[0] = item;
        }
    });
    Object.defineProperty(instance, "e1", {
        get: () => tuple[1],
        set: (item: unknown) => {
            tuple[1] = item;
        }
    });
    ctx.trackForFreeze(tuple);

    for (const __part of [
        () => {
            if ("0" in obj) {
                const __raw_e0 = obj["0"] as number;

                if (!(typeof __raw_e0 === "number" && globalThis.Number.isFinite(__raw_e0))) {
                    errors.push({ field: "0", message: __raw_e0 == null ? "Span.0 is required" : "expected number" });
                } else {
                    instance.e0 = __raw_e0;
                }
            }
        },
        () => {
            if ("1" in obj) {
                const __raw_e1 = obj["1"] as number;

                if (!(typeof __raw_e1 === "number" && globalThis.Number.isFinite(__raw_e1))) {
                    errors.push({ field: "1", message: __raw_e1 == null ? "Span.1 is required" : "expected number" });
                } else {
                    instance.e1 = __raw_e1;
                }
            }
        },
    ]) {
        __part();
    }

    ctx.pushErrors(errors);
    return tuple as Span;
}

export function spanHasShape(value: unknown): boolean {
    return Array.isArray(value) && value.length >= 2 && value.length <= 2;
}
/** Decodes JSON text, as `encode` writes it, to this type. @param text - The JSON text @param opts - Optional decoding options @returns Result containing the decoded value or validation errors  */
export function spanFromString(text: string, opts?: __mf_DecodeOptions): { success: true; value: Span } | { success: false; errors: Array<{ field: string; message: string }> } {
    return __mf_decodedText(text, (value) => spanDecode(value, opts));
}

const Span: {
