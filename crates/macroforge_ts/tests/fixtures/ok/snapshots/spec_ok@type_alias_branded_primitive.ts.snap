	}]
});
            }
        }

        /** Decodes with an existing context for nested/cyclic object graphs. @param value - The raw value to decode @param ctx - The decoding context  */
        export function metersDecodeWithContext(value: unknown, ctx: __mf_DecodeContext): Meters {const __decoded: unknown = value;











            if (typeof __decoded !== "number") {
