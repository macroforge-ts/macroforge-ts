import type { DecodeOptions as __mf_DecodeOptions } from "@macroforge/core/endec";
declare const MetersBrand: unique symbol;


type Meters = number & {
  readonly [MetersBrand]: true;
};

/** Encodes a value to a JSON string. @param value - The value to encode @param keepMetadata - Accepted for signature parity; primitives carry no metadata @returns JSON string representation  */
export function metersEncode(value: Meters, keepMetadata?: boolean): string;
export function metersEncode(value: Meters): string {
    return JSON.stringify(value);
}

/** Encodes with an existing context for nested/cyclic object graphs. @param value - The value to encode @param ctx - The encoding context, unused for primitives  */
export function metersEncodeWithContext(value: Meters, ctx: __mf_EncodeContext): unknown;
export function metersEncodeWithContext(value: Meters): unknown {
    return value;
}

/** Decodes input to this type. @param input - Value to decode @param opts - Optional decoding options @returns Result containing the decoded value or validation errors  */
export function metersDecode(input: unknown, opts?: __mf_DecodeOptions): { success: true; value: Meters } | { success: false; errors: Array<{ field: string; message: string }> } {
    try {
        const data = typeof input === "string" ? JSON.parse(input) : input;

        const ctx = __mf_DecodeContext.create();
        const result = metersDecodeWithContext(data, ctx);
        if (opts?.freeze) {
            ctx.freezeAll();
        }

        const __errors = ctx.getErrors();
        if (__errors.length > 0) {
            return ({
	success: false,
	errors: __errors
});
        }

        return ({
	success: true,
	value: result
});
    } catch (e) {
        if (e instanceof __mf_DecodeError) {
            return ({
	success: false,
	errors: e.errors
});
        }
        const message = e instanceof Error ? e.message : String(e);
        return ({
	success: false,
	errors: [{
		field: "_root",
		message
	}]
});
    }
}

/** Decodes with an existing context for nested/cyclic object graphs. @param value - The raw value to decode @param ctx - The decoding context  */
export function metersDecodeWithContext(value: unknown, ctx: __mf_DecodeContext): Meters {
    const __decoded: unknown = value;
    if (typeof __decoded !== "number") {
        throw new __mf_DecodeError([{ field: "_root", message: "Meters.decodeWithContext: expected number" }]);
    }
    const errors: Array<{ field: string; message: string }> = [];
    if (__decoded < 0) { errors.push({ field: "_root", message: "Meters must be non-negative" }); }
    ctx.pushErrors(errors);
    return __decoded as Meters;
}

export function metersHasShape(value: unknown): boolean {
    return typeof value === "number";
}

export function metersIs(value: unknown): value is Meters {
    return typeof value === "number" && metersDecode(value).success;
}

export function metersDefaultValue(): Meters {
    return 0 as Meters;
}

