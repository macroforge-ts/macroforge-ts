        export function metersDecode(input: unknown, opts?: __mf_DecodeOptions): { success: true; value: Meters } | { success: false; errors: Array<{ field: string; message: string }> } {
            try {
                const data = typeof input === "string" ? JSON.parse(input) : input;

                const ctx = __mf_DecodeContext.create();
                const result = metersDecodeWithContext(data, ctx);
                if (opts?.freeze) {
                    ctx.freezeAll();
