    }

    static validateFields(partial: { readonly [K in keyof Config]?: unknown }): Array<{ field: string; message: string }>;
    static validateFields(): Array<{ field: string; message: string }> {
        return [];
    }

    static hasShape(obj: unknown): boolean {
        if (typeof obj !== "object" || obj === null || Array.isArray(obj)) {
            return false;
        }
        const o = obj as Record<string, unknown>;
        return "host" in o && "port" in o;
    }

    static is(obj: unknown): obj is Config {
        if (obj instanceof Config) {
