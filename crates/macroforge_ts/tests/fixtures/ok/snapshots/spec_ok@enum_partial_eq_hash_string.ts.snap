## Changed

true

## Output

enum Color {
    Red = 'red',
    Green = 'green',
    Blue = 'blue'
}

export function colorEquals(a: Color, b: Color): boolean {
    return a === b;
}

export function colorHashCode(value: Color): number {
    let hash = 0;
    for (let i = 0; i < value.length; i++) {
        hash = (hash * 31 + value.charCodeAt(i)) | 0;
    }
    return hash;
}

namespace Color {
  export const equals: typeof colorEquals = colorEquals;
  export const hashCode: typeof colorHashCode = colorHashCode;
}

