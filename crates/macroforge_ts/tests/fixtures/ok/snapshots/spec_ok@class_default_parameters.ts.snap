import { Derive } from '@macro/derive';


class ServerConfig {
    host: string;
    port: number;

    constructor(
        host: string = 'localhost',
        port: number = 8080,
        secure: boolean = false
    ) {
        this.host = host;
        this.port = port;
    }

    connect(
        timeout: number = 5000,
        retries: number = 3,
        onError?: (err: Error) => void
    ): Promise<void> {
        return Promise.resolve();
    }

    static create(
        config: Partial<ServerConfig> = {},
        defaults: { host?: string; port?: number } = { host: '0.0.0.0', port: 3000 }
    ): ServerConfig {
        return new ServerConfig();
    }

static toString(value: ServerConfig): string {
                    return serverConfigToString(value);
                }}

export function serverConfigToString(value: ServerConfig): string {
                        const parts: string[] = [];
                        parts.push("host: " + value.host);
parts.push("port: " + value.port);

                        return "ServerConfig { " + parts.join(", ") + " }";
                    }

## DTS

import { Derive } from '@macro/derive';


class ServerConfig {
    host: string;
    port: number;

    constructor(host: string = 'localhost',
        port: number = 8080,
        secure: boolean = false);

    connect(timeout: number = 5000,
        retries: number = 3,
        onError?: (err: Error) => void): Promise<void>;

    static create(config: Partial<ServerConfig> = {},
        defaults: { host?: string; port?: number } = { host: '0.0.0.0', port: 3000 }): ServerConfig;

static toString(value: ServerConfig): string {
                    return serverConfigToString(value);
                }}

export function serverConfigToString(value: ServerConfig): string {
                        const parts: string[] = [];
                        parts.push("host: " + value.host);
parts.push("port: " + value.port);

                        return "ServerConfig { " + parts.join(", ") + " }";
                    }

