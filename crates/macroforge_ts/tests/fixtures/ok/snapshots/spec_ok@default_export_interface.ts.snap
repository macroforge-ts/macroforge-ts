## Output

import { clonedWith as __mf_clonedWith, equalWithin as __mf_equalWithin } from "@macroforge/core/structural";

export default interface Shape {
    x: number;
    y: number;
}

export function shapeClone(value: Shape): Shape {
    return __mf_clonedWith(value, (): Shape => ({
	x: value.x,
	y: value.y
}));
}

export function shapeEquals(a: Shape, b: Shape): boolean {
    if (a === b) return true;
    return __mf_equalWithin(a, b, () => {
        return [
            () => a.x === b.x || a.x !== a.x && b.x !== b.x,
            () => a.y === b.y || a.y !== a.y && b.y !== b.y,
        ].every((same) => same());
    });
}

export function shapeDefaultValue(): Shape {
    return {
        x: 0,
        y: 0,
    };
}

export const Shape: {
  readonly clone: typeof shapeClone;
  readonly equals: typeof shapeEquals;
  readonly defaultValue: typeof shapeDefaultValue;
} = {
  clone: shapeClone,
  equals: shapeEquals,
  defaultValue: shapeDefaultValue
};

