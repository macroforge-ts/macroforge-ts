    return value;
}

/** Decodes input to an enum value. @param input - Value to decode @returns The enum value @throws Error if the value is not a valid enum member  */
export function stageDecode(input: unknown): Stage {
    return stageDecodeWithContext(input);
}

/** Decodes with an existing context (for consistency with other types).  */
export function stageDecodeWithContext(data: unknown, ctx?: __mf_DecodeContext): Stage;
export function stageDecodeWithContext(data: unknown): Stage {
    if (Stage["Draft"] === data) {
        return Stage["Draft"];
    }
    if (Stage["Active"] === data) {
        return Stage["Active"];
    }
    if (Stage["Needs Review"] === data) {
        return Stage["Needs Review"];
    }
    throw new Error("Invalid Stage value: " + JSON.stringify(data));
}

export function stageIs(value: unknown): value is Stage {
    if (Stage["Draft"] === value) {
        return true;
    }
    if (Stage["Active"] === value) {
        return true;
    }
    if (Stage["Needs Review"] === value) {
        return true;
    }
    return false;
}

