export function jobHasShape(obj: unknown): boolean {
    if (typeof obj !== "object" || obj === null || Array.isArray(obj)) {
        return false;
    }
    const o = obj as Record<string, unknown>;
    return "stage" in o;
}

export function jobIs(obj: unknown): obj is Job {
    return jobHasShape(obj) && jobDecode(obj).success;
}

