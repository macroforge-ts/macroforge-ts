	lng: value.lng
});
}

export function coordinateEquals(a: Coordinate, b: Coordinate): boolean {
    if (a === b) return true;
    return a.lat === b.lat && a.lng === b.lng;
}

export function coordinateHashCode(value: Coordinate): number {
    let hash = 17;
    hash = (hash * 31 + (Number.isInteger(value.lat) ? value.lat | 0 : value.lat.toString().split("").reduce((h, c) => h * 31 + c.charCodeAt(0) | 0, 0))) | 0;
