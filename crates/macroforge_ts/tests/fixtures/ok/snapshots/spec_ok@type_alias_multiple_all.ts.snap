                            const parts: string[] = [];
                            parts.push("lat: " + value.lat);
parts.push("lng: " + value.lng);

                            return "Coordinate { " + parts.join(", ") + " }";
                        }

export function coordinateClone(value: Coordinate): Coordinate {
                        const result = {} as any;
                        result.lat = value.lat;
result.lng = value.lng;

