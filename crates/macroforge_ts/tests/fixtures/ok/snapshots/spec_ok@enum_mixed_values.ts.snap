## Output

enum Mixed {
    Zero = 0,
    Text = 'text',
    Five = 5
}

export function mixedEquals(a: Mixed, b: Mixed): boolean {
    return a === b;
}

export function mixedHashCode(value: Mixed): number {
    return typeof value === "string" ? (value ?? "").split("").reduce<number>((h, c) => (h * 31 + c.charCodeAt(0)) | 0, 0) : (Number.isInteger(value) ? value | 0 : value.toString().split("").reduce<number>((h, c) => (h * 31 + c.charCodeAt(0)) | 0, 0));
}

export function mixedPartialCompare(a: Mixed, b: Mixed): number | null {
    if (typeof a === "number" && typeof b === "number") {
        return a < b ? -1 : a > b ? 1 : 0;
    }
    if (typeof a === "string" && typeof b === "string") {
        return a < b ? -1 : a > b ? 1 : 0;
    }

    return typeof a === "number" ? -1 : 1;
}

export function mixedCompare(a: Mixed, b: Mixed): number {
    if (typeof a === "number" && typeof b === "number") {
        return a < b ? -1 : a > b ? 1 : 0;
    }
    if (typeof a === "string" && typeof b === "string") {
        return a < b ? -1 : a > b ? 1 : 0;
    }

    return typeof a === "number" ? -1 : 1;
}

namespace Mixed {
  export const equals: typeof mixedEquals = mixedEquals;
  export const hashCode: typeof mixedHashCode = mixedHashCode;
  export const partialCompare: typeof mixedPartialCompare = mixedPartialCompare;
  export const compare: typeof mixedCompare = mixedCompare;
}

