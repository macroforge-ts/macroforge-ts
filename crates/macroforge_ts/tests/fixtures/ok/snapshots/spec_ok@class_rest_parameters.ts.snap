import { Derive } from '@macro/derive';


class EventEmitter {
    listeners: Map<string, Function[]>;

    constructor();

    on(event: string, ...callbacks: Array<(...args: any[]) => void>): void;

    emit(event: string, ...args: any[]): void;

static clone(value: EventEmitter): EventEmitter {
                    return eventEmitterClone(value);
                }}

export function eventEmitterClone(value: EventEmitter): EventEmitter {
                    const cloned = Object.create(Object.getPrototypeOf(value));
                    cloned.listeners = new Map(value.listeners);

                    return cloned;
                }

