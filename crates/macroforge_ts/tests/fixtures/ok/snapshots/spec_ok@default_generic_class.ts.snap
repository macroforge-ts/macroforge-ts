import { instanceOf as __mf_instanceOf } from "@macroforge/core/structural";

export class Shelf<T> {
    items: T[] = [];
    label: string = '';

    static defaultValue<T>(): Shelf<T> {
        const fields: { items: T[]; label: string } = {
            items: [],
            label: "",
        };
        return __mf_instanceOf(Shelf.prototype, fields);
    }
}

export function shelfDefaultValue<T>(): Shelf<T> {
    return Shelf.defaultValue<T>();
}


export class Pinned<T extends object> {
    
    value: T | null;

    static defaultValue<T extends object>(): Pinned<T> {
        const fields: { value: T | null } = {
            value: null,
        };
        return __mf_instanceOf(Pinned.prototype, fields);
    }
}

export function pinnedDefaultValue<T extends object>(): Pinned<T> {
    return Pinned.defaultValue<T>();
}

