import { clonedWith as __mf_clonedWith } from "@macroforge/core/structural";

type Config = {
    host: string;
    port: number;
};

export function configClone(value: Config): Config {
    return __mf_clonedWith(value, (): Config => ({
	host: value.host,
	port: value.port
}));
}

const Config: {
  readonly clone: typeof configClone;
} = {
  clone: configClone
};

