import { debuggedWithin as __mf_debuggedWithin, clonedWith as __mf_clonedWith, equalWithin as __mf_equalWithin, hashedWithin as __mf_hashedWithin } from "@macroforge/core/structural";

interface Status {
    active: boolean;
}

export function statusToString(value: Status): string {
    return __mf_debuggedWithin(value, () => {
        const parts: string[] = [];
    parts.push("active: " + String(value.active));
        return "Status { " + parts.join(", ") + " }";
    });
}

export function statusClone(value: Status): Status {
    return __mf_clonedWith(value, (): Status => ({ active: value.active }));
}

export function statusEquals(a: Status, b: Status): boolean {
    if (a === b) return true;
    return __mf_equalWithin(a, b, () => a.active === b.active);
}

export function statusHashCode(value: Status): number {
    return __mf_hashedWithin(value, () => {
        let hash = 17;
    hash = (hash * 31 + (value.active ? 1231 : 1237)) | 0;
        return hash;
    });
}

const Status: {
  readonly toString: typeof statusToString;
  readonly clone: typeof statusClone;
  readonly equals: typeof statusEquals;
  readonly hashCode: typeof statusHashCode;
} = {
  toString: statusToString,
  clone: statusClone,
  equals: statusEquals,
  hashCode: statusHashCode
};

