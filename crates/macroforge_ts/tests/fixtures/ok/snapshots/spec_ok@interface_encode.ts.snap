import { encodedText as __mf_encodedText, encodedTextWithoutMetadata as __mf_encodedTextWithoutMetadata, encodeSelection as __mf_encodeSelection, EncodeContext as __mf_EncodeContext, fieldRequirement as __mf_fieldRequirement } from "@macroforge/core/endec";
import type { FieldSelection as __mf_FieldSelection, FieldRequirement as __mf_FieldRequirement } from "@macroforge/core/endec";

interface Point {
    x: number;
    y: number;
}

/** Encodes a value to a JSON string. @param value - The value to encode @param keepMetadata - If true, preserves __type and __id fields in the output @returns JSON string representation  */
export function pointEncode(value: Point, keepMetadata?: boolean): string {
    const ctx = __mf_EncodeContext.create();
    const __raw = pointEncodeWithContext(value, ctx);
    return keepMetadata ? __mf_encodedText(__raw) : __mf_encodedTextWithoutMetadata(__raw, "__type");
}

/** Encodes with an existing context for nested/cyclic object graphs. @param value - The value to encode @param ctx - The encoding context  */
export function pointEncodeWithContext(value: Point, ctx: __mf_EncodeContext): Record<string, unknown> {
    const existingId = ctx.getId(value);
    if (existingId !== undefined) {
        return { __ref: existingId };
    }
    const result: Record<string, unknown> = {
        "__type": "Point",
        __id: ctx.register(value),
    };
    pointEncodeFields(value, ctx, result, undefined);
    return result;
}

/** Encodes the fields a partial value has, with an existing context. A value encoded this way is written out wherever it is held: no reference stands for it. @param value - The value to encode @param ctx - The encoding context @param fields - The fields a `Pick` or `Omit` keeps: every field when left out  */
export function pointEncodePartialWithContext(value: Partial<Point>, ctx: __mf_EncodeContext, fields?: __mf_FieldSelection<keyof Point>): Record<string, unknown> {
    return __mf_encodeSelection(ctx, value, () => {
        const result: Record<string, unknown> = { "__type": "Point" };
        pointEncodeFields(value as Point, ctx, result, fields === undefined ? undefined : __mf_fieldRequirement(fields));
        return result;
    });
}

function pointEncodeFields(value: Point, _ctx: __mf_EncodeContext, result: Record<string, unknown>, __fields: __mf_FieldRequirement | undefined): void {
    if (__fields === undefined || __fields.keeps("x")) {
        if (value.x !== undefined) {
            result.x = value.x;
        }
    }
    if (__fields === undefined || __fields.keeps("y")) {
        if (value.y !== undefined) {
            result.y = value.y;
        }
    }
}

const Point: {
  readonly encode: typeof pointEncode;
  readonly encodeWithContext: typeof pointEncodeWithContext;
  readonly encodePartialWithContext: typeof pointEncodePartialWithContext;
} = {
  encode: pointEncode,
  encodeWithContext: pointEncodeWithContext,
  encodePartialWithContext: pointEncodePartialWithContext
};

