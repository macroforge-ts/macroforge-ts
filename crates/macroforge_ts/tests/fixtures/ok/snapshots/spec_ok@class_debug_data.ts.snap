import { debuggedWithin as __mf_debuggedWithin } from "@macroforge/core/structural";
import { Derive } from '@macro/derive';


class Data {
    val: number;

    static toString(value: Data): string {
        return __mf_debuggedWithin(value, () => {
            const parts: string[] = [];
        parts.push("val: " + String(value.val));
            return "Data { " + parts.join(", ") + " }";
        });
    }
}

export function dataToString(value: Data): string {
    return Data.toString(value);
}

