                        return ({
	success: false,
	errors: [{
		field: "_root",
		message: "Settings.deserialize: root cannot be a forward reference"
	}]
});
                    }

                    ctx.applyPatches();
                    if (opts?.freeze) {
                        ctx.freezeAll();
                    }

                    const __errors = ctx.getErrors();
                    if (__errors.length > 0) {
