import { structuralCompare as __mf_structuralCompare } from "@macroforge/core/structural";
declare const __mf_newtype_1: unique symbol;

export type Level = 1 | 2 | 3;

export function levelClone(value: Level): Level {
    return value;
}

export function levelEquals(a: Level, b: Level): boolean {
    if (a === b) return true;
    return a === b;
}

export function levelPartialCompare(a: Level, b: Level): number | null {
    return __mf_structuralCompare(a, b);
}

