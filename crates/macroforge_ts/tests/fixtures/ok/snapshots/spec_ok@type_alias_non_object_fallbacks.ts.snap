declare const __mf_newtype_1: unique symbol;

export type Level = 1 | 2 | 3;

export function levelClone(value: Level): Level {
                        return value;
                    }

export function levelPartialCompare(a: Level, b: Level): number | null {
                        if (a === b) return 0;

                        const left: unknown = a;
                        const right: unknown = b;
                        if (typeof left === "number" && typeof right === "number") {
                            return left < right ? -1 : left > right ? 1 : 0;
                        }
                        if (typeof left === "string" && typeof right === "string") {
                            return left.localeCompare(right);
                        }
                        return null;
                    }

export function levelCompare(a: Level, b: Level): number {
                        if (a === b) return 0;

                        const left: unknown = a;
                        const right: unknown = b;
                        if (typeof left === "number" && typeof right === "number") {
                            return left < right ? -1 : left > right ? 1 : 0;
                        }
                        if (typeof left === "string" && typeof right === "string") {
                            const cmp = left.localeCompare(right);
                            return cmp < 0 ? -1 : cmp > 0 ? 1 : 0;
                        }
                        return 0;
                    }

export const Level: {
