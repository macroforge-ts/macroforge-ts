export type Pair = [string, number];

export function pairClone(value: Pair): Pair {
    return [value[0], value[1]];
}

export function pairEquals(a: Pair, b: Pair): boolean {
    if (a === b) return true;
    return a[0] === b[0] && a[1] === b[1];
}

export function pairPartialCompare(a: Pair, b: Pair): number | null {
    if (a === b) return 0;
    const left0 = a[0];
    const right0 = b[0];
    const cmp0 = (left0 < right0 ? -1 : left0 > right0 ? 1 : 0);
    if (cmp0 !== 0) return cmp0;
    const left1 = a[1];
    const right1 = b[1];
    const cmp1 = (left1 < right1 ? -1 : left1 > right1 ? 1 : left1 === right1 ? 0 : null);
    if (cmp1 !== 0) return cmp1;
    return a.length < b.length ? -1 : a.length > b.length ? 1 : 0;
}

export function pairCompare(a: Pair, b: Pair): number {
    if (a === b) return 0;
    const left0 = a[0];
    const right0 = b[0];
    const cmp0 = (left0 < right0 ? -1 : left0 > right0 ? 1 : 0);
    if (cmp0 !== 0) return cmp0;
    const left1 = a[1];
    const right1 = b[1];
    const cmp1 = (left1 < right1 ? -1 : left1 > right1 ? 1 : 0);
    if (cmp1 !== 0) return cmp1;
    return a.length < b.length ? -1 : a.length > b.length ? 1 : 0;
}

export const Pair: {
  readonly clone: typeof pairClone;
  readonly equals: typeof pairEquals;
  readonly partialCompare: typeof pairPartialCompare;
  readonly compare: typeof pairCompare;
} = {
  clone: pairClone,
  equals: pairEquals,
  partialCompare: pairPartialCompare,
  compare: pairCompare
};


export type Meters = number & { readonly [__mf_newtype_1]: true };

export function metersClone(value: Meters): Meters {
    return value;
}

export function metersEquals(a: Meters, b: Meters): boolean {
    if (a === b) return true;
    return a === b;
}

export function metersPartialCompare(a: Meters, b: Meters): number | null {
    return a < b ? -1 : a > b ? 1 : a === b ? 0 : null;
}

export function metersCompare(a: Meters, b: Meters): number {
    return a < b ? -1 : a > b ? 1 : 0;
}

export const Meters: {
  readonly clone: typeof metersClone;
  readonly equals: typeof metersEquals;
  readonly partialCompare: typeof metersPartialCompare;
  readonly compare: typeof metersCompare;
} = {
  clone: metersClone,
  equals: metersEquals,
  partialCompare: metersPartialCompare,
  compare: metersCompare
};

