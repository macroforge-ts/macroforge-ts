## Output

import { debuggedWithin as __mf_debuggedWithin, clonedWith as __mf_clonedWith } from "@macroforge/core/structural";
import { Derive } from '@macro/derive';


class User {
    id: number;
    name: string;

    constructor(id: number, name: string) {
        this.id = id;
        this.name = name;
    }

    static toString(value: User): string {
        return __mf_debuggedWithin(value, () => {
            const parts: string[] = [];
        parts.push("id: " + String(value.id));
        parts.push("name: " + String(value.name));
            return "User { " + parts.join(", ") + " }";
        });
    }

    static clone(value: User): User {
        return __mf_clonedWith(value, () => ({
        	id: value.id,
        	name: value.name
        }));
    }
}

export function userToString(value: User): string {
    return User.toString(value);
}

export function userClone(value: User): User {
    return User.clone(value);
}

