/** import macro { traced } from "@macroforge/test-macros" */


export function first(x: number): number {
    (globalThis as any).__traced ??= {};
    (globalThis as any).__traced["first"] = ((globalThis as any).__traced["first"] || 0) + 1;
    return x * 2;
}


export function second(x: number): number {
    (globalThis as any).__traced ??= {};
    (globalThis as any).__traced["second"] = ((globalThis as any).__traced["second"] || 0) + 1;
    return x + 10;
}

