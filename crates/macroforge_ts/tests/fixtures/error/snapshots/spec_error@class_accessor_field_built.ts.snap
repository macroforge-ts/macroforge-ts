## Output

import { debuggedWithin as __mf_debuggedWithin, equalWithin as __mf_equalWithin } from "@macroforge/core/structural";

class Stepper {
    accessor step: number = 1;
    label: string = '';

    static toString(value: Stepper): string {
        return __mf_debuggedWithin(value, () => {
            const parts: string[] = [];
        parts.push("step: " + String(value.step));
        parts.push("label: " + String(value.label));
            return "Stepper { " + parts.join(", ") + " }";
        });
    }
}

export function stepperToString(value: Stepper): string {
    return Stepper.toString(value);
}


class Dial {
    accessor turn = 0;

    static equals(a: Dial, b: Dial): boolean {
        if (a === b) return true;
        return __mf_equalWithin(a, b, () => a.turn === b.turn || a.turn !== a.turn && b.turn !== b.turn);
    }
}

export function dialEquals(a: Dial, b: Dial): boolean {
    return Dial.equals(a, b);
}

