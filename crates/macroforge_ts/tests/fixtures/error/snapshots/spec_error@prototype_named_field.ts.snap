import { debuggedWithin as __mf_debuggedWithin } from "@macroforge/core/structural";

interface Sneaky {
    '__proto__': string;
    id: string;
}


type Aliased = { __proto__: number };

export function aliasedToString(value: Aliased): string {
    return __mf_debuggedWithin(value, () => {
        const parts: string[] = [];
    parts.push("__proto__: " + String(value.__proto__));
        return "Aliased { " + parts.join(", ") + " }";
    });
}

const Aliased: {
  readonly toString: typeof aliasedToString;
} = {
  toString: aliasedToString
};


class Carrier {
    ['__proto__']: string = '';
    __proto__: number = 0;
}

