import { debuggedWithin as __mf_debuggedWithin } from "@macroforge/core/structural";
/** @derive(Debug) */
export const value = 1;

/** @derive(Debug) */
export namespace Space {
    export const inside = 1;
}

/** @derive(Debug) */
// a note between the two
export interface Commented {
    a: string;
}

export interface Member {
    /** @derive(Debug) */
    field: string;
}



export interface Spaced {
    a: string;
}

export function spacedToString(value: Spaced): string {
    return __mf_debuggedWithin(value, () => {
        const parts: string[] = [];
    parts.push("a: " + String(value.a));
        return "Spaced { " + parts.join(", ") + " }";
    });
}

export const Spaced: {
  readonly toString: typeof spacedToString;
} = {
  toString: spacedToString
};


/** A description. */
export interface Stacked {
    a: string;
}

export function stackedToString(value: Stacked): string {
    return __mf_debuggedWithin(value, () => {
        const parts: string[] = [];
    parts.push("a: " + String(value.a));
        return "Stacked { " + parts.join(", ") + " }";
    });
}

export const Stacked: {
  readonly toString: typeof stackedToString;
} = {
  toString: stackedToString
};

export namespace Outer {
    /** @derive(Debug) */
    export interface Inside {
        a: string;
    }
}

export function local(): string {
    /** @derive(Debug, Clone) */
    class Local {
        a: string = 'local';
    }
    return new Local().a;
}

