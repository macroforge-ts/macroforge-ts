## Output

import { debuggedWithin as __mf_debuggedWithin } from "@macroforge/core/structural";

class Counter {
    count: number = $state(0);
    label: string = '';

    static toString(value: Counter): string {
        return __mf_debuggedWithin(value, () => {
            const parts: string[] = [];
        parts.push("count: " + String(value.count));
        parts.push("label: " + String(value.label));
            return "Counter { " + parts.join(", ") + " }";
        });
    }
}

export function counterToString(value: Counter): string {
    return Counter.toString(value);
}

