export function onlyPartialOrdPartialCompare(a: OnlyPartialOrd, b: OnlyPartialOrd): number | null {
    if (a === b) return 0;
    const cmp0 = (a.id < b.id ? -1 : a.id > b.id ? 1 : a.id === b.id ? 0 : null);
    if (cmp0 === null) return null;
    if (cmp0 !== 0) return cmp0;
    return 0;
}

export const OnlyPartialOrd: {
  readonly partialCompare: typeof onlyPartialOrdPartialCompare;
} = {
  partialCompare: onlyPartialOrdPartialCompare
};


export interface OrdWithoutEq {
    id: number;
}

export function ordWithoutEqEquals(a: OrdWithoutEq, b: OrdWithoutEq): boolean {
    if (a === b) return true;
    return a.id === b.id;
}

export function ordWithoutEqPartialCompare(a: OrdWithoutEq, b: OrdWithoutEq): number | null {
    if (a === b) return 0;
    const cmp0 = (a.id < b.id ? -1 : a.id > b.id ? 1 : a.id === b.id ? 0 : null);
    if (cmp0 === null) return null;
    if (cmp0 !== 0) return cmp0;
    return 0;
}

export function ordWithoutEqCompare(a: OrdWithoutEq, b: OrdWithoutEq): number {
    if (a === b) return 0;
    const cmp0 = a.id < b.id ? -1 : a.id > b.id ? 1 : 0;
    if (cmp0 !== 0) return cmp0;
    return 0;
}

export const OrdWithoutEq: {
  readonly equals: typeof ordWithoutEqEquals;
  readonly partialCompare: typeof ordWithoutEqPartialCompare;
  readonly compare: typeof ordWithoutEqCompare;
} = {
