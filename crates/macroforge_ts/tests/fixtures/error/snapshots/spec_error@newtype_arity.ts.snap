import { DecodeContext as __mf_DecodeContext, DecodeError as __mf_DecodeError } from "@macroforge/core/endec";
import type { DecodeOptions as __mf_DecodeOptions } from "@macroforge/core/endec";

type Pair = $Newtype<number, string>;

/** Decodes input to this type. @param input - Value to decode @param opts - Optional decoding options @returns Result containing the decoded value or validation errors  */
export function pairDecode(input: unknown, opts?: __mf_DecodeOptions): { success: true; value: Pair } | { success: false; errors: Array<{ field: string; message: string }> } {
    try {
        const data = typeof input === "string" ? JSON.parse(input) : input;

        const ctx = __mf_DecodeContext.create();
        const result = pairDecodeWithContext(data, ctx);
        ctx.applyPatches();
        if (opts?.freeze) {
            ctx.freezeAll();
        }

        const __errors = ctx.getErrors();
        if (__errors.length > 0) {
            return ({
	success: false,
	errors: __errors
});
        }

        return ({
	success: true,
	value: result
});
    } catch (e) {
        if (e instanceof __mf_DecodeError) {
            return ({
	success: false,
	errors: e.errors
});
        }
        const message = e instanceof Error ? e.message : String(e);
        return ({
	success: false,
	errors: [{
		field: "_root",
		message
	}]
});
    }
}

export function pairIs(value: unknown): value is Pair {
    return pairHasShape(value);
}
/** Decodes with an existing context for nested/cyclic object graphs. @param value - The raw value to decode @param ctx - The decoding context  */
export function pairDecodeWithContext(value: unknown, ctx: __mf_DecodeContext): Pair {
    if (typeof value === "object" && value !== null && "__ref" in value) {
        if (typeof value.__ref !== "number") {
            throw new __mf_DecodeError([{ field: "__ref", message: "Pair.decodeWithContext: __ref must be a number" }]);
        }
        return ctx.getOrDefer(value.__ref) as Pair;
    }
    const obj: Record<string, unknown> = { _root: value };
    const errors: Array<{ field: string; message: string }> = [];
    const instance: any = {};

    {
        const __raw__root = obj["_root"] as $Newtype<number, string>;

        instance._root = __raw__root;
    }

    ctx.pushErrors(errors);
    return instance._root as Pair;
}

export function pairHasShape(value: unknown): boolean {
    return value != null;
}

const Pair: {
  readonly decode: typeof pairDecode;
  readonly is: typeof pairIs;
  readonly decodeWithContext: typeof pairDecodeWithContext;
  readonly hasShape: typeof pairHasShape;
} = {
  decode: pairDecode,
  is: pairIs,
  decodeWithContext: pairDecodeWithContext,
  hasShape: pairHasShape
};

