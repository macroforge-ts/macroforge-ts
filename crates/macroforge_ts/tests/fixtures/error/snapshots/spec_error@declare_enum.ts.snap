import { encodedText as __mf_encodedText, parsedText as __mf_parsedText, DecodeContext as __mf_DecodeContext, DecodeError as __mf_DecodeError } from "@macroforge/core/endec";
import type { EncodeContext as __mf_EncodeContext } from "@macroforge/core/endec";

export declare enum Elsewhere {
    One = 1,
    Two = 2
}

export function elsewhereToString(value: Elsewhere): string {

    const held: unknown = value;
    if (held === Elsewhere["One"]) {
        return "Elsewhere.One";
    }
    if (held === Elsewhere["Two"]) {
        return "Elsewhere.Two";
    }
    return "Elsewhere(" + String(value) + ")";
}

/** Encodes this enum value to a JSON string.  */
export function elsewhereEncode(value: Elsewhere): string {
    return __mf_encodedText(value);
}

/** Encodes with an existing context for nested/cyclic object graphs.  */
export function elsewhereEncodeWithContext(value: Elsewhere, ctx: __mf_EncodeContext): string | number;
export function elsewhereEncodeWithContext(value: Elsewhere): string | number {
    return value;
}

/** Decodes a value to an enum member; JSON text decodes through `fromString`. @param input - The value to decode @returns The enum value @throws Error if the value is not a valid enum member  */
export function elsewhereDecode(input: unknown): Elsewhere {
    return elsewhereDecodeWithContext(input);
}

/** Decodes JSON text, as `encode` writes it, to an enum member. @param text - The JSON text @returns The enum value @throws Error if the text is not JSON or spells no member  */
export function elsewhereFromString(text: string): Elsewhere {
    return elsewhereDecodeWithContext(__mf_parsedText(text));
}

/** Decodes with an existing context (for consistency with other types).  */
export function elsewhereDecodeWithContext(data: unknown, ctx?: __mf_DecodeContext): Elsewhere;
export function elsewhereDecodeWithContext(data: unknown): Elsewhere {
    if (Elsewhere["One"] === data) {
        return Elsewhere["One"];
    }
    if (Elsewhere["Two"] === data) {
        return Elsewhere["Two"];
    }
    throw new __mf_DecodeError([{ field: "_root", message: "Invalid Elsewhere value: " + JSON.stringify(data) }]);
}

export function elsewhereIs(value: unknown): value is Elsewhere {
    if (Elsewhere["One"] === value) {
        return true;
    }
    if (Elsewhere["Two"] === value) {
        return true;
    }
    return false;
}

export namespace Elsewhere {
  export const toString: typeof elsewhereToString = elsewhereToString;
  export const encode: typeof elsewhereEncode = elsewhereEncode;
  export const encodeWithContext: typeof elsewhereEncodeWithContext = elsewhereEncodeWithContext;
  export const decode: typeof elsewhereDecode = elsewhereDecode;
  export const fromString: typeof elsewhereFromString = elsewhereFromString;
  export const decodeWithContext: typeof elsewhereDecodeWithContext = elsewhereDecodeWithContext;
  export const is: typeof elsewhereIs = elsewhereIs;
}


enum Here {
    One = 1
}

export function hereToString(value: Here): string {

