## Output

import { structuralClone as __mf_structuralClone, structuralEquals as __mf_structuralEquals } from "@macroforge/core/structural";
import type { Named, Dated } from './elsewhere';


export type Both = Named & Dated;

export function bothClone(value: Both): Both {
    return __mf_structuralClone(value);
}

export function bothEquals(a: Both, b: Both): boolean {
    if (a === b) return true;
    return __mf_structuralEquals(a, b);
}

export const Both: {
  readonly clone: typeof bothClone;
  readonly equals: typeof bothEquals;
} = {
  clone: bothClone,
  equals: bothEquals
};


export type Mixed = Named & { extra: number };

