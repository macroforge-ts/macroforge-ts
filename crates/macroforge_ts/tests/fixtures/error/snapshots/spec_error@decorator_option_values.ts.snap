    counted: string;
    
    emptied: string;
    
    quoted: string;
    
    lone: string;
    
    kept: string;
    
    twice: string;
    
    both: string;
}

export function valuesToString(value: Values): string {
    return __mf_debuggedWithin(value, () => {
        const parts: string[] = [];
    parts.push("numbered: " + String(value.numbered));
    parts.push(": " + String(value.unnamed));
    parts.push("worded: " + String(value.worded));
    parts.push("counted: " + String(value.counted));
    parts.push("emptied: " + String(value.emptied));
    parts.push("quoted: " + String(value.quoted));
    parts.push("lone: " + String(value.lone));
    parts.push("skip: " + String(value.kept));
    parts.push("b: " + String(value.twice));
    parts.push("both: " + String(value.both));
        return "Values { " + parts.join(", ") + " }";
    });
}

export function valuesClone(value: Values): Values {
    return __mf_clonedWith(value, (): Values => ({
	numbered: value.numbered,
	unnamed: value.unnamed,
	worded: value.worded,
	counted: value.counted,
	emptied: value.emptied,
	quoted: value.quoted,
	lone: value.lone,
	kept: value.kept,
	twice: value.twice,
	both: value.both
}));
}

export function valuesEquals(a: Values, b: Values): boolean {
    if (a === b) return true;
    return __mf_equalWithin(a, b, () => a.numbered === b.numbered && a.unnamed === b.unnamed && a.worded === b.worded && a.counted === b.counted && a.emptied === b.emptied && a.quoted === b.quoted && a.lone === b.lone && a.kept === b.kept && a.twice === b.twice && a.both === b.both);
}

export function valuesHashCode(value: Values): number {
    return __mf_hashedWithin(value, () => {
        let hash = 17;
    hash = (hash * 31 + ((value.numbered ?? "").split("").reduce<number>((h, c) => h * 31 + c.charCodeAt(0) | 0, 0))) | 0;
