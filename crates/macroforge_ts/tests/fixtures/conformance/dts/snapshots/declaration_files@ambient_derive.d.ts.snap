## Output

import { instanceWith as __mf_instanceWith } from "@macroforge/core/structural";

export declare class Point {
    x: number;
    y: number;

    static toString(value: Point): string {
        return pointToString(value);
    }

    static clone(value: Point): Point {
        return pointClone(value);
    }
}

export function pointToString(value: Point): string {
    const parts: string[] = [];
    parts.push("x: " + String(value.x));
    parts.push("y: " + String(value.y));
    return "Point { " + parts.join(", ") + " }";
}

export function pointClone(value: Point): Point {
    return __mf_instanceWith(value, ({
	x: value.x,
	y: value.y
}));
}


export interface Named {
    name: string;
}

export function namedToString(value: Named): string {
    const parts: string[] = [];
    parts.push("name: " + String(value.name));
    return "Named { " + parts.join(", ") + " }";
}

export const Named: {
  readonly toString: typeof namedToString;
} = {
  toString: namedToString
};

/** @deprecated */
export declare function formatPoint(point: Point): string;

