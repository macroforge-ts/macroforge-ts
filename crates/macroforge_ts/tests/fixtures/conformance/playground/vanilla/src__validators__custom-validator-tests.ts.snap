        static decode(input: unknown, opts?: __mf_DecodeOptions): { success: true; value: CustomNumberValidator } | { success: false; errors: Array<{ field: string; message: string }> } {
            try {

                const data = typeof input === "string" ? JSON.parse(input) : input;

                const ctx = __mf_DecodeContext.create();
                const resultOrRef = CustomNumberValidator.decodeWithContext(data, ctx);

                if (__mf_PendingRef.is(resultOrRef)) {
                    return ({
	success: false,
	errors: [{
		field: "_root",
		message: "CustomNumberValidator.decode: root cannot be a forward reference"
	}]
});
                }

