                const data = typeof input === "string" ? JSON.parse(input) : input;

                const ctx = __mf_DecodeContext.create();
                const resultOrRef = DocEmail.decodeWithContext(data, ctx);

                if (__mf_PendingRef.is(resultOrRef)) {
                    return ({
	success: false,
	errors: [{
		field: "_root",
		message: "DocEmail.decode: root cannot be a forward reference"
	}]
});
