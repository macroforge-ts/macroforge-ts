export function testRecursiveActual(): RecursiveDeserResult {
    const result = Container.deserialize({
        items: [
            { name: 'Alice', createdAt: '2024-01-15T10:30:00Z', score: 95 },
            { name: 'Bob', createdAt: '2024-06-20T14:00:00Z', score: 87 }
