}

export function priorityToString(value: Priority): string {const key = Priority[value as unknown as keyof typeof Priority];
                        if (key !== undefined) {
                            return "Priority." + key;
                        }
                        return "Priority(" + String(value) + ")";








                }

export function priorityClone(value: Priority): Priority {
                    return value;
                }

export function priorityEquals(a: Priority, b: Priority): boolean {
                    return a === b;
                }

export function priorityHashCode(value: Priority): number {
                        return value as number;
                    }

/** Encodes this enum value to a JSON string.  */
                export function priorityEncode(value: Priority): string {
                    return JSON.stringify(value);
                }

                /** Encodes with an existing context for nested/cyclic object graphs.  */
                export function priorityEncodeWithContext(value: Priority, ctx: __mf_EncodeContext): string | number;
                export function priorityEncodeWithContext(value: Priority): string | number {
                    return value;
                }

/** Decodes input to an enum value. @param input - Value to decode @returns The enum value @throws Error if the value is not a valid enum member  */
        export function priorityDecode(input: unknown): Priority {
            return priorityDecodeWithContext(input);
        }

        /** Decodes with an existing context (for consistency with other types).  */
        export function priorityDecodeWithContext(data: unknown, ctx?: __mf_DecodeContext): Priority;
        export function priorityDecodeWithContext(data: unknown): Priority {
            if (Priority["Low"] === data) {
                    return Priority["Low"];
                }
            if (Priority["Medium"] === data) {
                    return Priority["Medium"];
                }
            if (Priority["High"] === data) {
                    return Priority["High"];
                }
            if (Priority["Critical"] === data) {
                    return Priority["Critical"];
                }




            throw new Error("Invalid Priority value: " + JSON.stringify(data));
        }

        export function priorityIs(value: unknown): value is Priority {
            if (Priority["Low"] === value) {
                    return true;
                }
            if (Priority["Medium"] === value) {
                    return true;
                }
            if (Priority["High"] === value) {
                    return true;
                }
            if (Priority["Critical"] === value) {
                    return true;
                }




            return false;
        }

export namespace Priority {
  export const toString: typeof priorityToString = priorityToString;
  export const clone: typeof priorityClone = priorityClone;
