        static decodeWithContext(value: any, ctx: __mf_DecodeContext): MaxItemsValidator | __mf_PendingRef {

            if (value?.__ref !== undefined) {
                return ctx.getOrDefer(value.__ref);
            }

            if (typeof value !== "object" || value === null || Array.isArray(value)) {
                throw new __mf_DecodeError([{ field: "_root", message: "MaxItemsValidator.decodeWithContext: expected an object" }]);
            }

            const obj = value as Record<string, unknown>;
            const errors: Array<{ field: string; message: string }> = [];if (!("items" in obj)) {
                        errors.push({ field: "items", message: "missing required field" });
                    }








            const instance = Object.create(MaxItemsValidator.prototype) as MaxItemsValidator;


            if (obj.__id !== undefined) {
                ctx.register(obj.__id as number, instance);
            }


            ctx.trackForFreeze(instance);{
                            const __raw_items = obj["items"] as Array<string>;if (Array.isArray(__raw_items)) {
                                            if (__raw_items == null) { errors.push({ field: "items", message: "MaxItemsValidator.items is required" }); } else {
if (__raw_items.length > 5) { errors.push({ field: "items", message: "MaxItemsValidator.items must have at most 5 items" }); }
}
instance.items = __raw_items as string[];



























































                                    }




































































































































































































































































                        }






















            ctx.pushErrors(errors);

            return instance;
        }

        static validateField<K extends keyof MaxItemsValidator>(
            _field: K,
            _value: MaxItemsValidator[K]
        ): Array<{ field: string; message: string }> {const errors: Array<{ field: string; message: string }> = [];
            if (_field === "items") {
                const __val = _value as Array<string>;
                if (__val == null) { errors.push({ field: "items", message: "MaxItemsValidator.items is required" }); } else {
if (__val.length > 5) { errors.push({ field: "items", message: "MaxItemsValidator.items must have at most 5 items" }); }
}


            }







            return errors;













        }

