/** Parses FormData and validates it, returning a Result with the parsed data or errors. Delegates validation to decode() from @derive(Decode).  */
        export function colorsFromFormData(formData: FormData): Exit.Exit<Colors, Array<{ field: string; message: string }>> {
            const obj: Record<string, unknown> = {};

            
            obj.main = formData.get("main") ?? "";
            obj.hover = formData.get("hover") ?? "";
            obj.active = formData.get("active") ?? "";


            return toExit(colorsDecode(obj));
        }

