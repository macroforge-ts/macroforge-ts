            type: "text",
            optional: false,
            array: false,
            path: ["hover"],
            get: () => data.hover,
            set: (value: string) => { data.hover = value; },
            getError: () => errors.hover,
            setError: (value: Option.Option<Array<string>>) => { errors.hover = value; },
            getTainted: () => tainted.hover,
            setTainted: (value: Option.Option<boolean>) => { tainted.hover = value; },
            validate: () => colorsValidateField("hover", data.hover).map((e: { field: string; message: string }) => e.message),
            
            constraints: {},
            
            
            disabled: false,
            readonly: false,
        },
            
                active: {
            name: "active",
            label: "active",
            type: "text",
            optional: false,
            array: false,
            path: ["active"],
            get: () => data.active,
            set: (value: string) => { data.active = value; },
            getError: () => errors.active,
            setError: (value: Option.Option<Array<string>>) => { errors.active = value; },
            getTainted: () => tainted.active,
            setTainted: (value: Option.Option<boolean>) => { tainted.active = value; },
            validate: () => colorsValidateField("active", data.active).map((e: { field: string; message: string }) => e.message),
            
            constraints: {},
            
            
            disabled: false,
            readonly: false,
        },



        } as unknown as ColorsFieldControllers;


            function validate(): Exit.Exit<Colors, Array<{ field: string; message: string }>> {
                return toExit(colorsDecode(data));
            }


            function reset(newOverrides?: Partial<Colors>): void {
                data = { ...colorsDefaultValue(), ...newOverrides };
                errors = {
            _errors: Option.none(),
            main: Option.none(),
            hover: Option.none(),
            active: Option.none(),


        };
                tainted = {
            main: Option.none(),
            hover: Option.none(),
            active: Option.none(),


        };
            }

            return {
                get data() { return data; },
                set data(v) { data = v; },
                get errors() { return errors; },
                set errors(v) { errors = v; },
