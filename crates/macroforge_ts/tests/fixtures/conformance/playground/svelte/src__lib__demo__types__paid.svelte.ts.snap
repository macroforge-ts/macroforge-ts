            setTainted: (value: Option.Option<boolean>) => { tainted.currency = value; },
            validate: () => paidValidateField("currency", data.currency).map((e: { field: string; message: string }) => e.message),
            
            constraints: {},
            
            
            disabled: false,
            readonly: false,
        },
            
                paymentMethod: {
            name: "paymentMethod",
            label: "paymentMethod",
            type: "text",
            optional: false,
            array: false,
            path: ["paymentMethod"],
