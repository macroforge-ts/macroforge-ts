        export type PaidErrors = {
            _errors: Option.Option<Array<string>>;
            amount: Option.Option<Array<string>>;
            currency: Option.Option<Array<string>>;
            paymentMethod: Option.Option<Array<string>>;


        };

        /** Nested boolean structure for tracking touched/dirty fields  */
        export type PaidTainted = {
            amount: Option.Option<boolean>;
            currency: Option.Option<boolean>;
            paymentMethod: Option.Option<boolean>;


        };

        /** Type-safe field controllers for this form  */
        export interface PaidFieldControllers {
