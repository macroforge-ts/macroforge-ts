            let errors = $state<PaidErrors>({
                _errors: Option.none(),
                amount: Option.none(),
                currency: Option.none(),
                paymentMethod: Option.none(),


            });
            let tainted = $state<PaidTainted>({
                amount: Option.none(),
                currency: Option.none(),
                paymentMethod: Option.none(),


            });
            const fields = {
            
                amount: {
            name: "amount",
            label: "amount",
            type: "number",
            optional: false,
            array: false,
            path: ["amount"],
