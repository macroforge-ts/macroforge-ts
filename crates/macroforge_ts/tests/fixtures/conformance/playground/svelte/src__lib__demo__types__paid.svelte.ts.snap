                                                        errors.push({ field: "amount", message: "expected number | null" });
                                                    } else {
                                                        instance.amount = __raw_amount;
                                                    }


































































































































































































































































































                            }{
                                const __raw_currency = obj["currency"] as string | null;if (!(typeof __raw_currency === "string" || __raw_currency === null)) {
                                                        errors.push({ field: "currency", message: "expected string | null" });
                                                    } else {
                                                        instance.currency = __raw_currency;
                                                    }


































































































































































































































































































                            }{
                                const __raw_paymentMethod = obj["paymentMethod"] as string | null;if (!(typeof __raw_paymentMethod === "string" || __raw_paymentMethod === null)) {
                                                        errors.push({ field: "paymentMethod", message: "expected string | null" });
                                                    } else {
                                                        instance.paymentMethod = __raw_paymentMethod;
                                                    }


































































































































































































































































































                            }




































































































































































































































































































































































































































































































































































































































































                ctx.pushErrors(errors);

                return instance as Paid;
            }

