                                    const fieldName = key.slice("customFields.".length + String(idx).length + 1);
                                    item[fieldName] = value;
                                }
                            }
                            customFieldsItems.push(item);
                        }
                        idx++;
                        if (idx > 1000) break;
                    }
                    obj.customFields = customFieldsItems;
                }


            return toExit(leadDeserialize(obj));
        }

