                    obj.needsReview = needsReviewVal === "true" || needsReviewVal === "on" || needsReviewVal === "1";
                }
            {
                    const hasAlertVal = formData.get("hasAlert");
                    obj.hasAlert = hasAlertVal === "true" || hasAlertVal === "on" || hasAlertVal === "1";
                }
            {

