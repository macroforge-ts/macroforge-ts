                                                ? value.location
                                                : siteEncodeWithContext(value.location, ctx);result.description = value.description;result.colors = colorsEncodeWithContext(value.colors, ctx);if (value.recurrenceRule !== null) {
                                                    result.recurrenceRule = recurrenceRuleEncodeWithContext(value.recurrenceRule, ctx);





