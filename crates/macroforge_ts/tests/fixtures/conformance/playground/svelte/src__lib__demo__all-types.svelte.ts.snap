                export function serviceDefaultsEncodeWithContext(value: ServiceDefaults, ctx: __mf_EncodeContext): Record<string, unknown> {

                    const existingId = ctx.getId(value);
                    if (existingId !== undefined) {
                        return { __ref: existingId };
                    }


                    const __id = ctx.register(value);

                    const result: Record<string, unknown> = {
                        "__type": "ServiceDefaults",
                        __id,
                    };result.price = value.price;result.description = value.description;































































































                    return result;
