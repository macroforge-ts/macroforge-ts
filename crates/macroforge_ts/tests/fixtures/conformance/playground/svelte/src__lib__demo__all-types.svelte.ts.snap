                        "__type": "Appointment",
                        __id,
                    };result.id = value.id;result.title = value.title;result.status = statusEncodeWithContext(value.status, ctx);result.begins = value.begins;result.duration = value.duration;result.timeZone = value.timeZone;result.offsetMs = value.offsetMs;result.allDay = value.allDay;result.multiDay = value.multiDay;result.employees = value.employees.map(
