            obj.reference = formData.get("reference") ?? "";
            obj.leadSource = formData.get("leadSource") ?? "";
            obj.salesRep = formData.get("salesRep") ?? "";
            obj.group = formData.get("group") ?? "";
            obj.subgroup = formData.get("subgroup") ?? "";
