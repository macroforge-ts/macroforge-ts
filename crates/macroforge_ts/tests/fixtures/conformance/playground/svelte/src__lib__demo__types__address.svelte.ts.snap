            setError: (value: Option.Option<Array<string>>) => { errors.state = value; },
            getTainted: () => tainted.state,
            setTainted: (value: Option.Option<boolean>) => { tainted.state = value; },
            validate: () => addressValidateField("state", data.state).map((e: { field: string; message: string }) => e.message),
            
