/** Parses FormData and validates it, returning a Result with the parsed data or errors. Delegates validation to decode() from @derive(Decode).  */
        export function addressFromFormData(formData: FormData): Exit.Exit<Address, Array<{ field: string; message: string }>> {
            const obj: Record<string, unknown> = {};

            
            obj.street = formData.get("street") ?? "";
            obj.city = formData.get("city") ?? "";
            obj.state = formData.get("state") ?? "";
            obj.zipcode = formData.get("zipcode") ?? "";


            return toExit(addressDecode(obj));
        }

