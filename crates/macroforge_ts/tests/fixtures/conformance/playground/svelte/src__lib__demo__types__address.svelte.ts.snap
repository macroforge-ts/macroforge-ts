            function reset(newOverrides?: Partial<Address>): void {
                data = { ...addressDefaultValue(), ...newOverrides };
                errors = {
            _errors: Option.none(),
            street: Option.none(),
            city: Option.none(),
            state: Option.none(),
            zipcode: Option.none(),


        };
