                if (typeof value !== "object" || value === null || Array.isArray(value)) {
                    throw new __mf_DecodeError([{ field: "_root", message: "FullFeaturedType.decodeWithContext: expected an object" }]);
                }

                const obj = value as Record<string, unknown>;
                const errors: Array<{ field: string; message: string }> = [];if (!("id" in obj)) {
