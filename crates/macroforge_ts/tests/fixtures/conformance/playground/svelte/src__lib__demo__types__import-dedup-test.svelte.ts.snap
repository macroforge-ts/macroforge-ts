import { DecodeContext as __mf_DecodeContext } from "@macroforge/core/endec";
import { DecodeError as __mf_DecodeError } from "@macroforge/core/endec";
import type { DecodeOptions as __mf_DecodeOptions } from "@macroforge/core/endec";
import { PendingRef as __mf_PendingRef } from "@macroforge/core/endec";
/**
 * Stress test for aliased imports and tree-shaking.
 *
 * Macroforge now imports specific functions with `__mf_` prefixed aliases
 * to avoid any risk of collision with user imports:
 *
 * - `import { succeed as __mf_exitSucceed } from "effect/Exit";`
 * - `import { some as __mf_optionSome } from "effect/Option";`
 *
 * This approach:
 * - Eliminates namespace collisions with user imports
 * - Enables better tree-shaking (only specific functions imported)
 * - Is explicit about what macroforge uses
 *
 * The user's `import { Exit, Option } from "effect"` is preserved and works
 * alongside the aliased imports without any conflict.
 */

import { Exit, Option } from 'effect';

// Test 1: Type with Decode (uses Exit for return type)

export interface UserWithDecode {
    name: string;
    age: number;
    email: string;
}

/** Decodes input to this interface type.Automatically detects whether input is a JSON string or object.@param input - JSON string or object to decode@param opts - Optional decoding options @returns Result containing the decoded value or validation errors  */
            export function userWithDecodeDecode(input: unknown, opts?: __mf_DecodeOptions): { success: true; value: UserWithDecode } | { success: false; errors: Array<{ field: string; message: string }> } {
                try {

                    const data = typeof input === "string" ? JSON.parse(input) : input;

                    const ctx = __mf_DecodeContext.create();
                    const resultOrRef = userWithDecodeDecodeWithContext(data, ctx);

                    if (__mf_PendingRef.is(resultOrRef)) {
                        return ({
	success: false,
	errors: [{
		field: "_root",
		message: "UserWithDecode.decode: root cannot be a forward reference"
	}]
});
                    }

                    ctx.applyPatches();
                    if (opts?.freeze) {
                        ctx.freezeAll();
                    }

                    const __errors = ctx.getErrors();
                    if (__errors.length > 0) {
                        return ({
	success: false,
	errors: __errors
});
                    }

                    return ({
	success: true,
	value: resultOrRef
});
                } catch (e) {
                    if (e instanceof __mf_DecodeError) {
                        return ({
	success: false,
	errors: e.errors
});
                    }
                    const message = e instanceof Error ? e.message : String(e);
                    return ({
	success: false,
	errors: [{
		field: "_root",
		message
	}]
});
                }
            }

            /** Decodes with an existing context for nested/cyclic object graphs. @param value - The raw value to decode @param ctx - The decoding context  */
            export function userWithDecodeDecodeWithContext(value: any, ctx: __mf_DecodeContext): UserWithDecode | __mf_PendingRef {
                if (value?.__ref !== undefined) {
                    return ctx.getOrDefer(value.__ref);
                }

                if (typeof value !== "object" || value === null || Array.isArray(value)) {
                    throw new __mf_DecodeError([{ field: "_root", message: "UserWithDecode.decodeWithContext: expected an object" }]);
                }

                const obj = value as Record<string, unknown>;
                const errors: Array<{ field: string; message: string }> = [];if (!("name" in obj)) {
                            errors.push({ field: "name", message: "missing required field" });
                        }if (!("age" in obj)) {
                            errors.push({ field: "age", message: "missing required field" });
                        }if (!("email" in obj)) {
                            errors.push({ field: "email", message: "missing required field" });
                        }







                const instance: any = {};

                if (obj.__id !== undefined) {
                    ctx.register(obj.__id as number, instance);
                }

                ctx.trackForFreeze(instance);{
                                const __raw_name = obj["name"] as string;if (!(typeof __raw_name === "string")) {
                                                    errors.push({ field: "name", message: __raw_name == null ? "UserWithDecode.name is required" : "expected string" });
                                                } else {



                                                    instance.name = __raw_name;
                                                }


































































































































































































































































































                            }{
                                const __raw_age = obj["age"] as number;if (!(typeof __raw_age === "number")) {
                                                    errors.push({ field: "age", message: __raw_age == null ? "UserWithDecode.age is required" : "expected number" });
                                                } else {



                                                    instance.age = __raw_age;
                                                }


































































































































































































































































































                            }{
                                const __raw_email = obj["email"] as string;if (!(typeof __raw_email === "string")) {
                                                    errors.push({ field: "email", message: __raw_email == null ? "UserWithDecode.email is required" : "expected string" });
                                                } else {



                                                    instance.email = __raw_email;
                                                }


































































































































































































































































































                            }




































































































































































































































































































































































































































































































































































































































































                ctx.pushErrors(errors);

                return instance as UserWithDecode;
            }

            export function userWithDecodeValidateField<K extends keyof UserWithDecode>(
                _field: K,
                _value: UserWithDecode[K]
            ): Array<{ field: string; message: string }> {return [];













            }

            export function userWithDecodeValidateFields(
                _partial: Partial<UserWithDecode>
            ): Array<{ field: string; message: string }> {return [];













            }

            export function userWithDecodeHasShape(obj: unknown): boolean {
                if (typeof obj !== "object" || obj === null || Array.isArray(obj)) {
                    return false;
                }
                const o = obj as Record<string, unknown>;
                return "name" in o && "age" in o && "email" in o;
            }

            export function userWithDecodeIs(obj: unknown): obj is UserWithDecode {
                if (!userWithDecodeHasShape(obj)) {
                    return false;
                }
                const result = userWithDecodeDecode(obj);
                return result.success;
            }

export const UserWithDecode: {
  readonly decode: typeof userWithDecodeDecode;
  readonly decodeWithContext: typeof userWithDecodeDecodeWithContext;
  readonly validateFields: typeof userWithDecodeValidateFields;
  readonly hasShape: typeof userWithDecodeHasShape;
  readonly is: typeof userWithDecodeIs;
} = {
  decode: userWithDecodeDecode,
  decodeWithContext: userWithDecodeDecodeWithContext,
  validateFields: userWithDecodeValidateFields,
  hasShape: userWithDecodeHasShape,
  is: userWithDecodeIs
};

// Test 2: Type with PartialOrd (uses Option for return type)

export interface ComparableItem {
    priority: number;
    name: string;
}

export function comparableItemPartialCompare(a: ComparableItem, b: ComparableItem): number | null {
                        if (a === b) return 0;
                        const cmp0 = (a.priority < b.priority ? -1 : a.priority > b.priority ? 1 : 0);
if (cmp0 === null) return null;
if (cmp0 !== 0) return cmp0;
const cmp1 = a.name.localeCompare(b.name);
if (cmp1 === null) return null;
if (cmp1 !== 0) return cmp1;

                        return 0;
                    }

export const ComparableItem: {
  readonly partialCompare: typeof comparableItemPartialCompare;
} = {
  partialCompare: comparableItemPartialCompare
};

