export function fullFeaturedTypePartialCompare(a: FullFeaturedType, b: FullFeaturedType): number | null {
                        if (a === b) return 0;
                        const cmp0 = (a.id < b.id ? -1 : a.id > b.id ? 1 : 0);
if (cmp0 === null) return null;
