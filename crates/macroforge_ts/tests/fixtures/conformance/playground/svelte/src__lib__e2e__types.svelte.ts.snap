                    return ({
	success: false,
	errors: [{
		field: "_root",
		message
	}]
});
                }
            }

            /** Decodes with an existing context for nested/cyclic object graphs. @param value - The raw value to decode @param ctx - The decoding context  */
            export function addressDecodeWithContext(value: any, ctx: __mf_DecodeContext): Address | __mf_PendingRef {
                if (value?.__ref !== undefined) {
                    return ctx.getOrDefer(value.__ref);
                }

                if (typeof value !== "object" || value === null || Array.isArray(value)) {
                    throw new __mf_DecodeError([{ field: "_root", message: "Address.decodeWithContext: expected an object" }]);
                }

                const obj = value as Record<string, unknown>;
                const errors: Array<{ field: string; message: string }> = [];if (!("street" in obj)) {
                            errors.push({ field: "street", message: "missing required field" });
                        }if (!("city" in obj)) {
                            errors.push({ field: "city", message: "missing required field" });
                        }if (!("state" in obj)) {
                            errors.push({ field: "state", message: "missing required field" });
                        }if (!("zip" in obj)) {
                            errors.push({ field: "zip", message: "missing required field" });
                        }if (!("country" in obj)) {
                            errors.push({ field: "country", message: "missing required field" });
                        }







                const instance: any = {};

                if (obj.__id !== undefined) {
                    ctx.register(obj.__id as number, instance);
                }

                ctx.trackForFreeze(instance);{
                                const __raw_street = obj["street"] as string;instance.street = __raw_street;


































































































































































































































































                            }{
                                const __raw_city = obj["city"] as string;instance.city = __raw_city;


































































































































































































































































                            }{
                                const __raw_state = obj["state"] as string;instance.state = __raw_state;


































































































































































































































































                            }{
                                const __raw_zip = obj["zip"] as string;instance.zip = __raw_zip;


































































































































































































































































                            }{
                                const __raw_country = obj["country"] as string;instance.country = __raw_country;


































































































































































































































































                            }
























































































































































































































































































































































































































































































































































































                ctx.pushErrors(errors);

                return instance as Address;
            }

            export function addressValidateField<K extends keyof Address>(
                _field: K,
                _value: Address[K]
            ): Array<{ field: string; message: string }> {return [];













            }

            export function addressValidateFields(
                _partial: Partial<Address>
            ): Array<{ field: string; message: string }> {return [];













            }

            export function addressHasShape(obj: unknown): boolean {
                if (typeof obj !== "object" || obj === null || Array.isArray(obj)) {
                    return false;
                }
                const o = obj as Record<string, unknown>;
                return "street" in o && "city" in o && "state" in o && "zip" in o && "country" in o;
            }

            export function addressIs(obj: unknown): obj is Address {
                if (!addressHasShape(obj)) {
                    return false;
                }
