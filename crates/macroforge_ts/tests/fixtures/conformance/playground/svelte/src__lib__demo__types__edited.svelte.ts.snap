                data = { ...editedDefaultValue(), ...newOverrides };
                errors = {
            _errors: Option.none(),
            fieldName: Option.none(),
            oldValue: Option.none(),
            newValue: Option.none(),


        };
                tainted = {
            fieldName: Option.none(),
            oldValue: Option.none(),
            newValue: Option.none(),


        };
