            let errors = $state<EditedErrors>({
                _errors: Option.none(),
                fieldName: Option.none(),
                oldValue: Option.none(),
                newValue: Option.none(),


            });
            let tainted = $state<EditedTainted>({
                fieldName: Option.none(),
                oldValue: Option.none(),
                newValue: Option.none(),


            });
            const fields = {
            
                fieldName: {
            name: "fieldName",
            label: "fieldName",
            type: "text",
            optional: false,
            array: false,
            path: ["fieldName"],
            get: () => data.fieldName,
            set: (value: string) => { data.fieldName = value; },
            getError: () => errors.fieldName,
            setError: (value: Option.Option<Array<string>>) => { errors.fieldName = value; },
            getTainted: () => tainted.fieldName,
            setTainted: (value: Option.Option<boolean>) => { tainted.fieldName = value; },
            validate: () => editedValidateField("fieldName", data.fieldName).map((e: { field: string; message: string }) => e.message),
            
            constraints: {},
            
            
            disabled: false,
            readonly: false,
        },
            
                oldValue: {
            name: "oldValue",
            label: "oldValue",
            type: "text",
            optional: false,
            array: false,
            path: ["oldValue"],
            get: () => data.oldValue,
            set: (value: string | null) => { data.oldValue = value; },
            getError: () => errors.oldValue,
            setError: (value: Option.Option<Array<string>>) => { errors.oldValue = value; },
            getTainted: () => tainted.oldValue,
            setTainted: (value: Option.Option<boolean>) => { tainted.oldValue = value; },
            validate: () => editedValidateField("oldValue", data.oldValue).map((e: { field: string; message: string }) => e.message),
            
            constraints: {},
            
            
            disabled: false,
            readonly: false,
        },
            
                newValue: {
            name: "newValue",
            label: "newValue",
            type: "text",
            optional: false,
            array: false,
            path: ["newValue"],
            get: () => data.newValue,
            set: (value: string | null) => { data.newValue = value; },
