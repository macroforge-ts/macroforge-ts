                    if (__val == null) { errors.push({ field: "fieldName", message: "Edited.fieldName is required" }); } else {
if (__val.length === 0) { errors.push({ field: "fieldName", message: "Edited.fieldName must not be empty" }); }
}


                }







                return errors;













            }

            export function editedValidateFields(
                _partial: Partial<Edited>
            ): Array<{ field: string; message: string }> {const errors: Array<{ field: string; message: string }> = [];
