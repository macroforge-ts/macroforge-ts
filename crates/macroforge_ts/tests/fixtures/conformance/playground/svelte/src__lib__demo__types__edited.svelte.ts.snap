/** Parses FormData and validates it, returning a Result with the parsed data or errors. Delegates validation to decode() from @derive(Decode).  */
        export function editedFromFormData(formData: FormData): Exit.Exit<Edited, Array<{ field: string; message: string }>> {
            const obj: Record<string, unknown> = {};

            
            obj.fieldName = formData.get("fieldName") ?? "";
            obj.oldValue = formData.get("oldValue") ?? "";
            obj.newValue = formData.get("newValue") ?? "";


            return toExit(editedDecode(obj));
        }

