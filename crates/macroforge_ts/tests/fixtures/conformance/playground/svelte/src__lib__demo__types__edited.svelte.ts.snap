            setError: (value: Option.Option<Array<string>>) => { errors.newValue = value; },
            getTainted: () => tainted.newValue,
            setTainted: (value: Option.Option<boolean>) => { tainted.newValue = value; },
            validate: () => editedValidateField("newValue", data.newValue).map((e: { field: string; message: string }) => e.message),
            
            constraints: {},
            
            
            disabled: false,
            readonly: false,
        },



        } as unknown as EditedFieldControllers;


            function validate(): Exit.Exit<Edited, Array<{ field: string; message: string }>> {
                return toExit(editedDecode(data));
            }


