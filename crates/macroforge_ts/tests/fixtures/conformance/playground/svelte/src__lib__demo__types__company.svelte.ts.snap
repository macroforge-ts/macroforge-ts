                export function companyEncodeWithContext(value: Company, ctx: __mf_EncodeContext): Record<string, unknown> {

                    const existingId = ctx.getId(value);
                    if (existingId !== undefined) {
                        return { __ref: existingId };
                    }


                    const __id = ctx.register(value);

                    const result: Record<string, unknown> = {
                        "__type": "Company",
                        __id,
                    };result.id = value.id;result.legalName = value.legalName;result.headquarters = typeof value.headquarters === "string"
