    | 'Represents'
    | 'Ordered';

export function tableDefaultValue(): Table {
                            return "Account";
                        }

/** Encodes a value to a JSON string. @param value - The value to encode @param keepMetadata - If true, preserves __type and __id fields in the output @returns JSON string representation  */
                        export function tableEncode(value: Table, keepMetadata?: boolean): string {
                            const ctx = __mf_EncodeContext.create();
                            const __raw = tableEncodeWithContext(value, ctx);
                            if (keepMetadata) return JSON.stringify(__raw);
                            return JSON.stringify(__raw, (key, val) => key === "__type" || key === "__id" ? undefined : val);
                        }

                        /** Encodes with an existing context for nested/cyclic object graphs. @param value - The value to encode @param ctx - The encoding context  */
                        export function tableEncodeWithContext(value: Table, ctx: __mf_EncodeContext): unknown {
                            let __variant: unknown;
                            let __matched = false;
                            if (typeof (value as any)?.encodeWithContext === "function") {
                                __variant = (value as any).encodeWithContext(ctx);
                                __matched = true;
                            }



















                            if (!__matched) {
                                __variant = value;
                            }if (__variant !== null && typeof __variant === "object" && "__type" in (__variant as any)) {
                                    const { __type: __typeName, ...fields } = __variant as any;
                                    return { "__type": (value as any)["__type"] ?? __typeName, ...fields };
                                }
                                return __variant;




































                        }

/** Decodes a literal union value. Validates input against known variants. @param input - Value to validate @returns Result containing the validated value or error  */
            export function tableDecode(input: unknown): { success: true; value: Table } | { success: false; errors: Array<{ field: string; message: string }> } {
                switch (input) {
                    case 'Account':
                    case 'Did':
                    case 'Appointment':
                    case 'Lead':
                    case 'TaxRate':
                    case 'Site':
                    case 'Employee':
                    case 'Route':
                    case 'Company':
                    case 'Product':
                    case 'Service':
                    case 'User':
                    case 'Order':
                    case 'Payment':
                    case 'Package':
                    case 'Promotion':
                    case 'Represents':
                    case 'Ordered':


                        return { success: true, value: input as Table };
                    default:
                        return { success: false, errors: [{ field: "_root", message: "Invalid value for Table: expected one of " + ['Account', 'Did', 'Appointment', 'Lead', 'TaxRate', 'Site', 'Employee', 'Route', 'Company', 'Product', 'Service', 'User', 'Order', 'Payment', 'Package', 'Promotion', 'Represents', 'Ordered'].map(v => JSON.stringify(v)).join(", ") + ", got " + JSON.stringify(input) }] };
                }
            }

            /** Decodes with an existing context (validates against known variants). A literal holds no references, so the context goes unread.  */
            export function tableDecodeWithContext(value: any, _ctx: __mf_DecodeContext): Table | __mf_PendingRef {
                switch (value) {
                    case 'Account':
                    case 'Did':
                    case 'Appointment':
                    case 'Lead':
                    case 'TaxRate':
                    case 'Site':
                    case 'Employee':
                    case 'Route':
                    case 'Company':
                    case 'Product':
                    case 'Service':
                    case 'User':
                    case 'Order':
                    case 'Payment':
                    case 'Package':
                    case 'Promotion':
                    case 'Represents':
                    case 'Ordered':


                        return value as Table;
                    default:
                        throw new __mf_DecodeError([{
                            field: "_root",
                            message: "Invalid value for Table: expected one of " + ['Account', 'Did', 'Appointment', 'Lead', 'TaxRate', 'Site', 'Employee', 'Route', 'Company', 'Product', 'Service', 'User', 'Order', 'Payment', 'Package', 'Promotion', 'Represents', 'Ordered'].map(v => JSON.stringify(v)).join(", ") + ", got " + JSON.stringify(value)
                        }]);
                }
            }

