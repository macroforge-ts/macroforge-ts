                    ctx.register(obj.__id as number, instance);
                }

                ctx.trackForFreeze(instance);{
                                const __raw_initialData = obj["initialData"] as string | null;if (!(typeof __raw_initialData === "string" || __raw_initialData === null)) {
                                                        errors.push({ field: "initialData", message: "expected string | null" });
                                                    } else {
                                                        instance.initialData = __raw_initialData;
                                                    }


































































































































































































































































































                            }




































































































































































































































































































































































































































































































































































































































































                ctx.pushErrors(errors);

