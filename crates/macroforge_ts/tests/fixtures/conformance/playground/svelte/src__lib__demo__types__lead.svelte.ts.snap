            function validate(): Exit.Exit<Lead, Array<{ field: string; message: string }>> {
                return toExit(leadDecode(data));
            }


            function reset(newOverrides?: Partial<Lead>): void {
                data = { ...leadDefaultValue(), ...newOverrides };
                errors = {
            _errors: Option.none(),
            id: Option.none(),
            number: Option.none(),
            accepted: Option.none(),
            probability: Option.none(),
            priority: Option.none(),
            dueDate: Option.none(),
            closeDate: Option.none(),
