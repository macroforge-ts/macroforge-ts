            subtype: Option.none(),
            isTaxExempt: Option.none(),
            paymentTerms: Option.none(),
            tags: Option.none(),
            customFields: Option.none(),


        };
                tainted = {
            id: Option.none(),
            number: Option.none(),
            accepted: Option.none(),
            probability: Option.none(),
            priority: Option.none(),
            dueDate: Option.none(),
            closeDate: Option.none(),
