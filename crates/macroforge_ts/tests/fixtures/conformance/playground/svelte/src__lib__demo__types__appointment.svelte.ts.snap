                    }
                    current[parts[parts.length - 1]!] = value;
                }
            }
            obj.description = descriptionObj;
        }
            {

            const colorsObj: Record<string, unknown> = {};
            for (const [key, value] of Array.from(formData.entries())) {
                if (key.startsWith("colors.")) {
                    const fieldName = key.slice("colors.".length);

                    const parts = fieldName.split(".");
                    let current = colorsObj;
                    for (let i = 0; i < parts.length - 1; i++) {
                        const part = parts[i]!;
                        if (!(part in current)) {
                            current[part] = {};
                        }
                        current = current[part] as Record<string, unknown>;
                    }
                    current[parts[parts.length - 1]!] = value;
                }
            }
            obj.colors = colorsObj;
        }
            {

            const recurrenceRuleObj: Record<string, unknown> = {};
            for (const [key, value] of Array.from(formData.entries())) {
                if (key.startsWith("recurrenceRule.")) {
                    const fieldName = key.slice("recurrenceRule.".length);

