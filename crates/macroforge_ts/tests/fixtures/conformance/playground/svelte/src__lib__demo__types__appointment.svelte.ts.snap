                    let current = recurrenceRuleObj;
                    for (let i = 0; i < parts.length - 1; i++) {
                        const part = parts[i]!;
                        if (!(part in current)) {
                            current[part] = {};
                        }
                        current = current[part] as Record<string, unknown>;
                    }
                    current[parts[parts.length - 1]!] = value;
                }
            }
            obj.recurrenceRule = recurrenceRuleObj;
        }


            return toExit(appointmentDecode(obj));
        }

