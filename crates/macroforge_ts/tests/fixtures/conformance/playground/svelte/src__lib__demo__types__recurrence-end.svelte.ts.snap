import { EncodeContext as __mf_EncodeContext } from "@macroforge/core/endec";
import { DecodeContext as __mf_DecodeContext } from "@macroforge/core/endec";
import { DecodeError as __mf_DecodeError } from "@macroforge/core/endec";
import type { DecodeOptions as __mf_DecodeOptions } from "@macroforge/core/endec";
import { PendingRef as __mf_PendingRef } from "@macroforge/core/endec";
import { Option } from "effect";
import { Exit } from "effect";
import type { FieldController } from "@playground/macro/gigaform";
import { toExit } from "@playground/macro/gigaform";
/** import macro {Gigaform} from "@playground/macro"; */


export type RecurrenceEnd = /** @default(0) */ number | string;

export function recurrenceEndDefaultValue(): RecurrenceEnd {
                            return 0;
                        }

/** Encodes a value to a JSON string. @param value - The value to encode @param keepMetadata - If true, preserves __type and __id fields in the output @returns JSON string representation  */
                        export function recurrenceEndEncode(value: RecurrenceEnd, keepMetadata?: boolean): string {
                            const ctx = __mf_EncodeContext.create();
                            const __raw = recurrenceEndEncodeWithContext(value, ctx);
                            if (keepMetadata) return JSON.stringify(__raw);
                            return JSON.stringify(__raw, (key, val) => key === "__type" || key === "__id" ? undefined : val);
                        }

                        /** Encodes with an existing context for nested/cyclic object graphs. @param value - The value to encode @param ctx - The encoding context  */
                        export function recurrenceEndEncodeWithContext(value: RecurrenceEnd, ctx: __mf_EncodeContext): unknown {
                            let __variant: unknown;
                            let __matched = false;
                            if (typeof (value as any)?.encodeWithContext === "function") {
                                __variant = (value as any).encodeWithContext(ctx);
                                __matched = true;
                            }



















                            if (!__matched) {
                                __variant = value;
                            }if (__variant !== null && typeof __variant === "object" && "__type" in (__variant as any)) {
                                    const { __type: __typeName, ...fields } = __variant as any;
                                    return { "__type": (value as any)["__type"] ?? __typeName, ...fields };
                                }
                                return __variant;




































                        }

/** Decodes input to this type. @param input - Value to decode @param opts - Optional decoding options @returns Result containing the decoded value or validation errors  */
        export function recurrenceEndDecode(input: unknown, opts?: __mf_DecodeOptions): { success: true; value: RecurrenceEnd } | { success: false; errors: Array<{ field: string; message: string }> } {
            try {
                const data = input;

                const ctx = __mf_DecodeContext.create();
                const resultOrRef = recurrenceEndDecodeWithContext(data, ctx);

                if (__mf_PendingRef.is(resultOrRef)) {
                    return ({
	success: false,
	errors: [{
		field: "_root",
		message: "RecurrenceEnd.decode: root cannot be a forward reference"
	}]
});
                }

                ctx.applyPatches();
                if (opts?.freeze) {
                    ctx.freezeAll();
                }

                const __errors = ctx.getErrors();
                if (__errors.length > 0) {
                    return ({
	success: false,
	errors: __errors
});
                }

                return ({
	success: true,
	value: resultOrRef
});
            } catch (e) {
                if (e instanceof __mf_DecodeError) {
                    return ({
	success: false,
	errors: e.errors
});
                }
                const message = e instanceof Error ? e.message : String(e);
                return ({
	success: false,
	errors: [{
		field: "_root",
		message
	}]
});
            }
        }

        /** Decodes with an existing context for nested/cyclic object graphs. @param value - The raw value to decode @param ctx - The decoding context  */
        export function recurrenceEndDecodeWithContext(value: any, ctx: __mf_DecodeContext): RecurrenceEnd | __mf_PendingRef {
                        if (value?.__ref !== undefined) {
                            return ctx.getOrDefer(value.__ref) as RecurrenceEnd | __mf_PendingRef;
                        }if (typeof value === "number") {
                                    return value as RecurrenceEnd;
                                }if (typeof value === "string") {
                                    return value as RecurrenceEnd;
                                }





                            throw new __mf_DecodeError([{
                                field: "_root",
                                message: "RecurrenceEnd.decodeWithContext: expected number, string, got " + typeof value
                            }]);

















































































































































































































































































































































































































































































































































        }

        export function recurrenceEndHasShape(value: unknown): boolean {return typeof value === "number" || typeof value === "string";






































































































































































        }

        export function recurrenceEndIs(value: unknown): value is RecurrenceEnd {
            return recurrenceEndHasShape(value);
        }

