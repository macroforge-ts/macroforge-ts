import { EncodeContext as __mf_EncodeContext } from "@macroforge/core/endec";
import { DecodeContext as __mf_DecodeContext } from "@macroforge/core/endec";
import { DecodeError as __mf_DecodeError } from "@macroforge/core/endec";
import type { DecodeOptions as __mf_DecodeOptions } from "@macroforge/core/endec";
import { PendingRef as __mf_PendingRef } from "@macroforge/core/endec";
import { Option } from "effect";
