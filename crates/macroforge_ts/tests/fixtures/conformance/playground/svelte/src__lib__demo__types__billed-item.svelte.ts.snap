            for (const [key, value] of Array.from(formData.entries())) {
                if (key.startsWith("item.")) {
                    const fieldName = key.slice("item.".length);

                    const parts = fieldName.split(".");
                    let current = itemObj;
                    for (let i = 0; i < parts.length - 1; i++) {
                        const part = parts[i]!;
                        if (!(part in current)) {
