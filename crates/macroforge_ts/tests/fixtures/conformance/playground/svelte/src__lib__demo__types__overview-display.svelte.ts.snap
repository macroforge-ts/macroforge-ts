export type OverviewDisplay = /** @default */ 'Card' | 'Table';

export function overviewDisplayDefaultValue(): OverviewDisplay {
                            return "Card";
                        }

/** Serializes a value to a JSON string. @param value - The value to serialize @param keepMetadata - If true, preserves __type and __id fields in the output @returns JSON string representation  */
                        export function overviewDisplaySerialize(value: OverviewDisplay, keepMetadata?: boolean): string {
                            const ctx = __mf_SerializeContext.create();
                            const __raw = overviewDisplaySerializeWithContext(value, ctx);
                            if (keepMetadata) return JSON.stringify(__raw);
                            return JSON.stringify(__raw, (key, val) => key === "__type" || key === "__id" ? undefined : val);
                        }

                        /** Serializes with an existing context for nested/cyclic object graphs. @param value - The value to serialize @param ctx - The serialization context  */
                        export function overviewDisplaySerializeWithContext(value: OverviewDisplay, ctx: __mf_SerializeContext): unknown {
                            let __variant: unknown;
                            let __matched = false;
                            if (typeof (value as any)?.serializeWithContext === "function") {
                                __variant = (value as any).serializeWithContext(ctx);
                                __matched = true;
                            }



















                            if (!__matched) {
                                __variant = value;
                            }if (__variant !== null && typeof __variant === "object" && "__type" in (__variant as any)) {
                                    const { __type: __typeName, ...fields } = __variant as any;
                                    return { "__type": (value as any)["__type"] ?? __typeName, ...fields };
                                }
                                return __variant;




































                        }

/** Deserializes a literal union value. Validates input against known variants. @param input - Value to validate @returns Result containing the validated value or error  */
            export function overviewDisplayDeserialize(input: unknown): { success: true; value: OverviewDisplay } | { success: false; errors: Array<{ field: string; message: string }> } {
                switch (input) {
                    case 'Card':
                    case 'Table':


                        return { success: true, value: input as OverviewDisplay };
                    default:
                        return { success: false, errors: [{ field: "_root", message: "Invalid value for OverviewDisplay: expected one of " + ['Card', 'Table'].map(v => JSON.stringify(v)).join(", ") + ", got " + JSON.stringify(input) }] };
                }
            }

            /** Deserializes with an existing context (validates against known variants).  */
            export function overviewDisplayDeserializeWithContext(value: any, ctx: __mf_DeserializeContext): OverviewDisplay | __mf_PendingRef {
