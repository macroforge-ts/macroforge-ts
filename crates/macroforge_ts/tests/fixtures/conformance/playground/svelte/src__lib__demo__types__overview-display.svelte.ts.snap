/** import macro {Gigaform} from "@playground/macro"; */


export type OverviewDisplay = /** @default */ 'Card' | 'Table';

export function overviewDisplayDefaultValue(): OverviewDisplay {
                            return "Card";
                        }

/** Encodes a value to a JSON string. @param value - The value to encode @param keepMetadata - If true, preserves __type and __id fields in the output @returns JSON string representation  */
                        export function overviewDisplayEncode(value: OverviewDisplay, keepMetadata?: boolean): string {
                            const ctx = __mf_EncodeContext.create();
                            const __raw = overviewDisplayEncodeWithContext(value, ctx);
                            if (keepMetadata) return JSON.stringify(__raw);
                            return JSON.stringify(__raw, (key, val) => key === "__type" || key === "__id" ? undefined : val);
                        }

                        /** Encodes with an existing context for nested/cyclic object graphs. @param value - The value to encode @param ctx - The encoding context  */
                        export function overviewDisplayEncodeWithContext(value: OverviewDisplay, ctx: __mf_EncodeContext): unknown {
                            let __variant: unknown;
                            let __matched = false;
                            if (typeof (value as any)?.encodeWithContext === "function") {
                                __variant = (value as any).encodeWithContext(ctx);
                                __matched = true;
                            }



















                            if (!__matched) {
                                __variant = value;
                            }if (__variant !== null && typeof __variant === "object" && "__type" in (__variant as any)) {
                                    const { __type: __typeName, ...fields } = __variant as any;
                                    return { "__type": (value as any)["__type"] ?? __typeName, ...fields };
                                }
                                return __variant;




































                        }

/** Decodes a literal union value. Validates input against known variants. @param input - Value to validate @returns Result containing the validated value or error  */
            export function overviewDisplayDecode(input: unknown): { success: true; value: OverviewDisplay } | { success: false; errors: Array<{ field: string; message: string }> } {
                switch (input) {
                    case 'Card':
                    case 'Table':


                        return { success: true, value: input as OverviewDisplay };
                    default:
                        return { success: false, errors: [{ field: "_root", message: "Invalid value for OverviewDisplay: expected one of " + ['Card', 'Table'].map(v => JSON.stringify(v)).join(", ") + ", got " + JSON.stringify(input) }] };
                }
            }

            /** Decodes with an existing context (validates against known variants). A literal holds no references, so the context goes unread.  */
            export function overviewDisplayDecodeWithContext(value: any, _ctx: __mf_DecodeContext): OverviewDisplay | __mf_PendingRef {
                switch (value) {
                    case 'Card':
                    case 'Table':


                        return value as OverviewDisplay;
                    default:
                        throw new __mf_DecodeError([{
                            field: "_root",
                            message: "Invalid value for OverviewDisplay: expected one of " + ['Card', 'Table'].map(v => JSON.stringify(v)).join(", ") + ", got " + JSON.stringify(value)
                        }]);
                }
            }

            export function overviewDisplayHasShape(value: unknown): boolean {
                switch (value) {
                    case 'Card':
                    case 'Table':


                        return true;
                    default:
                        return false;
                }
            }

            export function overviewDisplayIs(value: unknown): value is OverviewDisplay {
                return overviewDisplayHasShape(value);
            }

