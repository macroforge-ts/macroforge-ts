                            errors.push({ field: "recipient", message: "missing required field" });
                        }if (!("method" in obj)) {
                            errors.push({ field: "method", message: "missing required field" });
                        }







                const instance: any = {};

                if (obj.__id !== undefined) {
                    ctx.register(obj.__id as number, instance);
                }

                ctx.trackForFreeze(instance);{
                                const __raw_recipient = obj["recipient"] as string | null;if (!(typeof __raw_recipient === "string" || __raw_recipient === null)) {
                                                        errors.push({ field: "recipient", message: "expected string | null" });
                                                    } else {
                                                        instance.recipient = __raw_recipient;
                                                    }


































































































































































































































































































                            }{
                                const __raw_method = obj["method"] as string | null;if (!(typeof __raw_method === "string" || __raw_method === null)) {
                                                        errors.push({ field: "method", message: "expected string | null" });
                                                    } else {
                                                        instance.method = __raw_method;
                                                    }


































































































































































































































































































                            }




































































































































































































































































































































































































































































































































































































































































                ctx.pushErrors(errors);

                return instance as Sent;
            }

