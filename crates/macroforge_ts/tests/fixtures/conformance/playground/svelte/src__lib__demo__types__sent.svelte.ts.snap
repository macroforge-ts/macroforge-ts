            path: ["method"],
            get: () => data.method,
            set: (value: string | null) => { data.method = value; },
            getError: () => errors.method,
            setError: (value: Option.Option<Array<string>>) => { errors.method = value; },
            getTainted: () => tainted.method,
            setTainted: (value: Option.Option<boolean>) => { tainted.method = value; },
            validate: () => sentValidateField("method", data.method).map((e: { field: string; message: string }) => e.message),
            
            constraints: {},
            
            
            disabled: false,
            readonly: false,
        },



        } as unknown as SentFieldControllers;


            function validate(): Exit.Exit<Sent, Array<{ field: string; message: string }>> {
                return toExit(sentDecode(data));
            }


            function reset(newOverrides?: Partial<Sent>): void {
                data = { ...sentDefaultValue(), ...newOverrides };
                errors = {
            _errors: Option.none(),
            recipient: Option.none(),
            method: Option.none(),


        };
                tainted = {
            recipient: Option.none(),
            method: Option.none(),


        };
            }

            return {
                get data() { return data; },
                set data(v) { data = v; },
                get errors() { return errors; },
                set errors(v) { errors = v; },
                get tainted() { return tainted; },
