                    if (existingId !== undefined) {
                        return { __ref: existingId };
                    }


                    const __id = ctx.register(value);

                    const result: Record<string, unknown> = {
                        "__type": "Customer",
                        __id,
                    };result.name = personNameSerializeWithContext(value.name, ctx);result.email = value.email;































































































                    return result;
                }

