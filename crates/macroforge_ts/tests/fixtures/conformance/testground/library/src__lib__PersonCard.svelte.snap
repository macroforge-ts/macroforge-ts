        heading: "",
    };
}

/** Encodes a value to a JSON string. @param value - The value to encode @param keepMetadata - If true, preserves __type and __id fields in the output @returns JSON string representation  */
export function cardLabelsEncode(value: CardLabels, keepMetadata?: boolean): string {
    const ctx = __mf_EncodeContext.create();
    const __raw = cardLabelsEncodeWithContext(value, ctx);
    return keepMetadata ? __mf_encodedText(__raw) : __mf_encodedTextWithoutMetadata(__raw, "__type");
}

/** Encodes with an existing context for nested/cyclic object graphs. @param value - The value to encode @param ctx - The encoding context  */
export function cardLabelsEncodeWithContext(value: CardLabels, ctx: __mf_EncodeContext): Record<string, unknown> {
    const existingId = ctx.getId(value);
    if (existingId !== undefined) {
        return __mf_encodedReference(ctx, existingId);
    }
    const result = __mf_encodedAs(ctx, ctx.register(value), { "__type": "CardLabels" });
    cardLabelsEncodeFields(value, ctx, result, undefined);
    return result;
}

/** Encodes the fields a partial value has, with an existing context. A value encoded this way is written out wherever it is held: no reference stands for it. @param value - The value to encode @param ctx - The encoding context @param fields - The fields a `Pick` or `Omit` keeps: every field when left out  */
export function cardLabelsEncodePartialWithContext(value: Partial<CardLabels>, ctx: __mf_EncodeContext, fields?: __mf_FieldSelection<keyof CardLabels>): Record<string, unknown> {
    return __mf_encodeSelection(ctx, value, () => {
        const result: Record<string, unknown> = { "__type": "CardLabels" };
        cardLabelsEncodeFields(value as CardLabels, ctx, result, fields === undefined ? undefined : __mf_fieldRequirement(fields));
        return result;
    });
}

function cardLabelsEncodeFields(value: CardLabels, _ctx: __mf_EncodeContext, result: Record<string, unknown>, __fields: __mf_FieldRequirement | undefined): void {
    if (__fields === undefined || __fields.keeps("heading")) {
        if (value.heading !== undefined) {
            result.heading = value.heading;
        }
    }
}

export const CardLabels: {
  readonly defaultValue: typeof cardLabelsDefaultValue;
  readonly encode: typeof cardLabelsEncode;
