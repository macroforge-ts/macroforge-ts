import type { FieldSelection as __mf_FieldSelection, FieldRequirement as __mf_FieldRequirement, DecodeOptions as __mf_DecodeOptions } from "@macroforge/core/endec";
import type { PersonName } from './person-name.js';


export interface Customer {
    name: PersonName;
    email: string;
}

export function customerDefaultValue(): Customer {
    return {
        name: personNameDefaultValue(),
        email: "",
    };
}

/** Encodes a value to a JSON string. @param value - The value to encode @param keepMetadata - If true, preserves __type and __id fields in the output @returns JSON string representation  */
export function customerEncode(value: Customer, keepMetadata?: boolean): string {
    const ctx = __mf_EncodeContext.create();
    const __raw = customerEncodeWithContext(value, ctx);
    return keepMetadata ? __mf_encodedText(__raw) : __mf_encodedTextWithoutMetadata(__raw, "__type");
}

/** Encodes with an existing context for nested/cyclic object graphs. @param value - The value to encode @param ctx - The encoding context  */
export function customerEncodeWithContext(value: Customer, ctx: __mf_EncodeContext): Record<string, unknown> {
    const existingId = ctx.getId(value);
    if (existingId !== undefined) {
        return __mf_encodedReference(ctx, existingId);
    }
    const result = __mf_encodedAs(ctx, ctx.register(value), { "__type": "Customer" });
    customerEncodeFields(value, ctx, result, undefined);
    return result;
}

/** Encodes the fields a partial value has, with an existing context. A value encoded this way is written out wherever it is held: no reference stands for it. @param value - The value to encode @param ctx - The encoding context @param fields - The fields a `Pick` or `Omit` keeps: every field when left out  */
export function customerEncodePartialWithContext(value: Partial<Customer>, ctx: __mf_EncodeContext, fields?: __mf_FieldSelection<keyof Customer>): Record<string, unknown> {
    return __mf_encodeSelection(ctx, value, () => {
        const result: Record<string, unknown> = { "__type": "Customer" };
        customerEncodeFields(value as Customer, ctx, result, fields === undefined ? undefined : __mf_fieldRequirement(fields));
        return result;
    });
}

function customerEncodeFields(value: Customer, ctx: __mf_EncodeContext, result: Record<string, unknown>, __fields: __mf_FieldRequirement | undefined): void {
    if (__fields === undefined || __fields.keeps("name")) {
        if (value.name !== undefined) {
            result["name"] = personNameEncodeWithContext(value.name, ctx);
        }
    }
    if (__fields === undefined || __fields.keeps("email")) {
        if (value.email !== undefined) {
            result["email"] = value.email;
        }
    }
}

/** Decodes input to this type. Automatically detects whether input is a JSON string or object. @param input - JSON string or object to decode @param opts - Optional decoding options @returns Result containing the decoded value or validation errors  */
export function customerDecode(input: unknown, opts?: __mf_DecodeOptions): { success: true; value: Customer } | { success: false; errors: Array<{ field: string; message: string }> } {
    try {

        const data = typeof input === "string" ? __mf_parsedText(input) : input;

        const ctx = __mf_DecodeContext.create();
        const resultOrRef = customerDecodeWithContext(data, ctx);

        if (__mf_PendingRef.is(resultOrRef)) {
            return ({
	success: false,
	errors: [{
		field: "_root",
		message: "Customer.decode: root cannot be a forward reference"
	}]
});
        }

        ctx.applyPatches();
        if (opts?.freeze) {
            ctx.freezeAll();
        }

        const __errors = ctx.getErrors();
        if (__errors.length > 0) {
            return ({
	success: false,
	errors: __errors
});
        }

        return ({
	success: true,
	value: resultOrRef
});
    } catch (e) {
        if (e instanceof __mf_DecodeError) {
            return ({
	success: false,
	errors: e.errors
});
        }
        const message = e instanceof Error ? e.message : String(e);
        return ({
	success: false,
	errors: [{
		field: "_root",
		message
	}]
});
    }
}
/** Decodes with an existing context for nested/cyclic object graphs. @param value - The raw value to decode @param ctx - The decoding context  */
export function customerDecodeWithContext(value: unknown, ctx: __mf_DecodeContext): Customer | __mf_PendingRef;
/** Decodes the fields `fields` keeps, and no other. @param value - The raw value to decode @param ctx - The decoding context @param fields - Which fields the value has and has to have  */
export function customerDecodeWithContext(value: unknown, ctx: __mf_DecodeContext, fields: __mf_FieldRequirement): Partial<Customer> | __mf_PendingRef;
export function customerDecodeWithContext(value: unknown, ctx: __mf_DecodeContext, __fields?: __mf_FieldRequirement): Partial<Customer> | __mf_PendingRef {
    if (__fields !== undefined && typeof value === "object" && value !== null && "__ref" in value) {
        throw new __mf_DecodeError([{ field: "_root", message: "Customer.decodeWithContext: a value holding a selection of fields cannot be a reference" }]);
    }
    if (typeof value === "object" && value !== null && "__ref" in value) {
        if (typeof value.__ref !== "number") {
            throw new __mf_DecodeError([{ field: "__ref", message: "Customer.decodeWithContext: __ref must be a number" }]);
        }
        return ctx.getOrDefer(value.__ref, "Customer") as Customer | __mf_PendingRef;
    }

    if (typeof value !== "object" || value === null || Array.isArray(value)) {
        throw new __mf_DecodeError([{ field: "_root", message: "Customer.decodeWithContext: expected an object" }]);
    }

    const obj = __mf_ownMembers(value);
    const errors: Array<{ field: string; message: string }> = [];
    if ((__fields === undefined || __fields.requires("name")) && !("name" in obj)) {
        errors.push({ field: "name", message: "missing required field" });
    }
    if ((__fields === undefined || __fields.requires("email")) && !("email" in obj)) {
        errors.push({ field: "email", message: "missing required field" });
    }

    const instance: any = {};

    if (__fields === undefined && obj.__id !== undefined) {
        ctx.register(obj.__id as number, instance, "Customer");
    }

    ctx.trackForFreeze(instance);

    if ((__fields === undefined || __fields.requires("name")) ? "name" in obj : (__fields.keeps("name") && obj["name"] !== undefined)) {
        const __raw_name = obj["name"] as PersonName;

        ctx.pushScope("name");
        try {
            const __result = personNameDecodeWithContext(__raw_name, ctx);
            ctx.assignOrDefer(instance, "name", __result);
        } catch (__e) {
            if (__e instanceof __mf_DecodeError) {
                for (const __err of __e.errors) {
                    errors.push({
                        field: __err.field === "_root" ? "name" : "name." + __err.field,
                        message: __err.message
                    });
                }
            } else {

                errors.push({ field: "name", message: __e instanceof Error ? __e.message : String(__e) });
            }
        } finally {
            ctx.popScope();
        }
    }
    if ((__fields === undefined || __fields.requires("email")) ? "email" in obj : (__fields.keeps("email") && obj["email"] !== undefined)) {
        const __raw_email = obj["email"] as string;

        if (!(typeof __raw_email === "string")) {
            errors.push({ field: "email", message: __raw_email == null ? "Customer.email is required" : "expected string" });
        } else {
            instance.email = __raw_email;
