import { personNameDecodeWithContext, personNameEncodeWithContext, personNameDefaultValue } from "./person-name.js";
import { EncodeContext as __mf_EncodeContext, DecodeContext as __mf_DecodeContext, DecodeError as __mf_DecodeError, PendingRef as __mf_PendingRef } from "@macroforge/core/endec";
import type { DecodeOptions as __mf_DecodeOptions } from "@macroforge/core/endec";
import type { PersonName } from './person-name.js';


export interface Customer {
    name: PersonName;
    email: string;
}

export function customerDefaultValue(): Customer {
    return {
        name: personNameDefaultValue(),
        email: "",
    };
}

/** Encodes a value to a JSON string. @param value - The value to encode @param keepMetadata - If true, preserves __type and __id fields in the output @returns JSON string representation  */
export function customerEncode(value: Customer, keepMetadata?: boolean): string {
    const ctx = __mf_EncodeContext.create();
    const __raw = customerEncodeWithContext(value, ctx);
    if (keepMetadata) return JSON.stringify(__raw);
    return JSON.stringify(__raw, (key, val) => key === "__type" || key === "__id" ? undefined : val);
}

/** Encodes with an existing context for nested/cyclic object graphs. @param value - The value to encode @param ctx - The encoding context  */
export function customerEncodeWithContext(value: Customer, ctx: __mf_EncodeContext): Record<string, unknown> {

    const existingId = ctx.getId(value);
    if (existingId !== undefined) {
        return { __ref: existingId };
    }

    const __id = ctx.register(value);

    const result: Record<string, unknown> = {
        "__type": "Customer",
        __id,
    };

    
    result.name = personNameEncodeWithContext(value.name, ctx);
    result.email = value.email;

    return result;
}

/** Decodes input to this type. Automatically detects whether input is a JSON string or object. @param input - JSON string or object to decode @param opts - Optional decoding options @returns Result containing the decoded value or validation errors  */
export function customerDecode(input: unknown, opts?: __mf_DecodeOptions): { success: true; value: Customer } | { success: false; errors: Array<{ field: string; message: string }> } {
    try {

        const data = typeof input === "string" ? JSON.parse(input) : input;

        const ctx = __mf_DecodeContext.create();
        const resultOrRef = customerDecodeWithContext(data, ctx);

        if (__mf_PendingRef.is(resultOrRef)) {
            return ({
	success: false,
	errors: [{
		field: "_root",
		message: "Customer.decode: root cannot be a forward reference"
	}]
});
        }

        ctx.applyPatches();
        if (opts?.freeze) {
            ctx.freezeAll();
        }

        const __errors = ctx.getErrors();
        if (__errors.length > 0) {
            return ({
	success: false,
	errors: __errors
});
        }

        return ({
	success: true,
	value: resultOrRef
});
    } catch (e) {
        if (e instanceof __mf_DecodeError) {
            return ({
	success: false,
	errors: e.errors
});
        }
        const message = e instanceof Error ? e.message : String(e);
        return ({
	success: false,
	errors: [{
		field: "_root",
		message
	}]
});
    }
}
/** Decodes with an existing context for nested/cyclic object graphs. @param value - The raw value to decode @param ctx - The decoding context  */
export function customerDecodeWithContext(value: unknown, ctx: __mf_DecodeContext): Customer | __mf_PendingRef {
    if (typeof value === "object" && value !== null && "__ref" in value) {
        if (typeof value.__ref !== "number") {
            throw new __mf_DecodeError([{ field: "__ref", message: "Customer.decodeWithContext: __ref must be a number" }]);
        }
        return ctx.getOrDefer(value.__ref) as Customer | __mf_PendingRef;
    }

    if (typeof value !== "object" || value === null || Array.isArray(value)) {
        throw new __mf_DecodeError([{ field: "_root", message: "Customer.decodeWithContext: expected an object" }]);
    }

    const obj = value as Record<string, unknown>;
    const errors: Array<{ field: string; message: string }> = [];
    if (!("name" in obj)) {
        errors.push({ field: "name", message: "missing required field" });
    }
    if (!("email" in obj)) {
        errors.push({ field: "email", message: "missing required field" });
    }

    const instance: any = {};

    if (obj.__id !== undefined) {
        ctx.register(obj.__id as number, instance);
    }

    ctx.trackForFreeze(instance);

    {
        const __raw_name = obj["name"] as PersonName;

        ctx.pushScope("name");
        try {
            const __result = personNameDecodeWithContext(__raw_name, ctx);
            ctx.assignOrDefer(instance, "name", __result);
        } catch (__e) {
            if (__e instanceof __mf_DecodeError) {
                for (const __err of __e.errors) {
                    errors.push({
                        field: __err.field === "_root" ? "name" : "name." + __err.field,
                        message: __err.message
                    });
                }
            } else {
                throw __e;
            }
        } finally {
            ctx.popScope();
        }
    }
    {
        const __raw_email = obj["email"] as string;

        if (!(typeof __raw_email === "string")) {
            errors.push({ field: "email", message: __raw_email == null ? "Customer.email is required" : "expected string" });
        } else {
            instance.email = __raw_email;
        }
    }

    ctx.pushErrors(errors);

    return instance as Customer;
}
export function customerValidateField<K extends keyof Customer>(field: K, value: unknown): Array<{ field: string; message: string }>;
export function customerValidateField(): Array<{ field: string; message: string }> {
    return [];
}

export function customerValidateFields(partial: { readonly [K in keyof Customer]?: unknown }): Array<{ field: string; message: string }>;
export function customerValidateFields(): Array<{ field: string; message: string }> {
    return [];
}
export function customerHasShape(obj: unknown): boolean {
    if (typeof obj !== "object" || obj === null || Array.isArray(obj)) {
        return false;
    }
    const o = obj as Record<string, unknown>;
    return "name" in o && "email" in o;
}

export function customerIs(obj: unknown): obj is Customer {
    return customerHasShape(obj) && customerDecode(obj).success;
}

export const Customer: {
  readonly defaultValue: typeof customerDefaultValue;
  readonly encode: typeof customerEncode;
  readonly encodeWithContext: typeof customerEncodeWithContext;
  readonly decode: typeof customerDecode;
  readonly decodeWithContext: typeof customerDecodeWithContext;
  readonly validateField: typeof customerValidateField;
  readonly validateFields: typeof customerValidateFields;
  readonly hasShape: typeof customerHasShape;
  readonly is: typeof customerIs;
} = {
  defaultValue: customerDefaultValue,
  encode: customerEncode,
  encodeWithContext: customerEncodeWithContext,
  decode: customerDecode,
  decodeWithContext: customerDecodeWithContext,
  validateField: customerValidateField,
  validateFields: customerValidateFields,
  hasShape: customerHasShape,
  is: customerIs
};

