import { debuggedWithin as __mf_debuggedWithin, clonedWith as __mf_clonedWith, equalWithin as __mf_equalWithin, hashedWithin as __mf_hashedWithin } from "@macroforge/core/structural";
import { encodedText as __mf_encodedText, encodedTextWithoutMetadata as __mf_encodedTextWithoutMetadata, encodeSelection as __mf_encodeSelection, encodedAs as __mf_encodedAs, encodedReference as __mf_encodedReference, EncodeContext as __mf_EncodeContext, fieldRequirement as __mf_fieldRequirement, parsedText as __mf_parsedText, ownMembers as __mf_ownMembers, holdsAll as __mf_holdsAll, DecodeContext as __mf_DecodeContext, DecodeError as __mf_DecodeError, PendingRef as __mf_PendingRef } from "@macroforge/core/endec";
import type { FieldSelection as __mf_FieldSelection, FieldRequirement as __mf_FieldRequirement, DecodeOptions as __mf_DecodeOptions } from "@macroforge/core/endec";
/**
 * An intersection with a type held from another module under another name:
 * its fields are that type's, read through the import.
 */

import type { EdgeItem as Item } from './edge-types';

/** @derive(Debug, Clone, PartialEq, Hash, Default, Encode, Decode) */
export type NameMixed = Item & { extra: string };

export function nameMixedToString(value: NameMixed): string {
    return __mf_debuggedWithin(value, () => {
        const parts: string[] = [];
    parts.push("id: " + String(value.id));
    parts.push("score: " + String(value.score));
    parts.push("extra: " + String(value.extra));
        return "NameMixed { " + parts.join(", ") + " }";
    });
}

export function nameMixedClone(value: NameMixed): NameMixed {
    return __mf_clonedWith(value, (): NameMixed => ({
	id: value.id,
	score: value.score,
	extra: value.extra
}));
}

export function nameMixedEquals(a: NameMixed, b: NameMixed): boolean {
    if (a === b) return true;
    return __mf_equalWithin(a, b, () => {
    return [
        () => a.id === b.id,
        () => a.score === b.score || a.score !== a.score && b.score !== b.score,
        () => a.extra === b.extra,
    ].every((same) => same());
});
}

export function nameMixedHashCode(value: NameMixed): number {
    return __mf_hashedWithin(value, () => {
        let hash = 17;
    hash = (hash * 31 + ((value.id ?? "").split("").reduce<number>((h, c) => h * 31 + c.charCodeAt(0) | 0, 0))) | 0;
    hash = (hash * 31 + (Number.isInteger(value.score) ? value.score | 0 : value.score.toString().split("").reduce<number>((h, c) => h * 31 + c.charCodeAt(0) | 0, 0))) | 0;
    hash = (hash * 31 + ((value.extra ?? "").split("").reduce<number>((h, c) => h * 31 + c.charCodeAt(0) | 0, 0))) | 0;
        return hash;
    });
}

export function nameMixedDefaultValue(): NameMixed {
    return {
        id: "",
        score: 0,
        extra: "",
    };
}

/** Encodes a value to a JSON string. @param value - The value to encode @param keepMetadata - If true, preserves __type and __id fields in the output @returns JSON string representation  */
export function nameMixedEncode(value: NameMixed, keepMetadata?: boolean): string {
    const ctx = __mf_EncodeContext.create();
    const __raw = nameMixedEncodeWithContext(value, ctx);
    return keepMetadata ? __mf_encodedText(__raw) : __mf_encodedTextWithoutMetadata(__raw, "__type");
}

/** Encodes with an existing context for nested/cyclic object graphs. @param value - The value to encode @param ctx - The encoding context  */
export function nameMixedEncodeWithContext(value: NameMixed, ctx: __mf_EncodeContext): Record<string, unknown> {
    const existingId = ctx.getId(value);
    if (existingId !== undefined) {
        return __mf_encodedReference(ctx, existingId);
    }
    const result = __mf_encodedAs(ctx, ctx.register(value), { "__type": "NameMixed" });
    nameMixedEncodeFields(value, ctx, result, undefined);
    return result;
}

/** Encodes the fields a partial value has, with an existing context. A value encoded this way is written out wherever it is held: no reference stands for it. @param value - The value to encode @param ctx - The encoding context @param fields - The fields a `Pick` or `Omit` keeps: every field when left out  */
export function nameMixedEncodePartialWithContext(value: Partial<NameMixed>, ctx: __mf_EncodeContext, fields?: __mf_FieldSelection<keyof NameMixed>): Record<string, unknown> {
    return __mf_encodeSelection(ctx, value, () => {
        const result: Record<string, unknown> = { "__type": "NameMixed" };
        nameMixedEncodeFields(value as NameMixed, ctx, result, fields === undefined ? undefined : __mf_fieldRequirement(fields));
        return result;
    });
}

function nameMixedEncodeFields(value: NameMixed, _ctx: __mf_EncodeContext, result: Record<string, unknown>, __fields: __mf_FieldRequirement | undefined): void {
    for (const __part of [
        () => {
            if (__fields === undefined || __fields.keeps("id")) {
                if (value.id !== undefined) {
                    result["id"] = value.id;
                }
            }
        },
        () => {
            if (__fields === undefined || __fields.keeps("score")) {
                if (value.score !== undefined) {
                    result["score"] = value.score;
                }
            }
        },
        () => {
            if (__fields === undefined || __fields.keeps("extra")) {
                if (value.extra !== undefined) {
                    result["extra"] = value.extra;
                }
            }
        },
    ]) {
        __part();
    }
}

/** Decodes input to this type. Automatically detects whether input is a JSON string or object. @param input - JSON string or object to decode @param opts - Optional decoding options @returns Result containing the decoded value or validation errors  */
export function nameMixedDecode(input: unknown, opts?: __mf_DecodeOptions): { success: true; value: NameMixed } | { success: false; errors: Array<{ field: string; message: string }> } {
    try {

        const data = typeof input === "string" ? __mf_parsedText(input) : input;

        const ctx = __mf_DecodeContext.create();
        const resultOrRef = nameMixedDecodeWithContext(data, ctx);

        if (__mf_PendingRef.is(resultOrRef)) {
            return ({
	success: false,
	errors: [{
		field: "_root",
		message: "NameMixed.decode: root cannot be a forward reference"
	}]
});
        }

        ctx.applyPatches();
        if (opts?.freeze) {
            ctx.freezeAll();
        }

        const __errors = ctx.getErrors();
        if (__errors.length > 0) {
            return ({
	success: false,
	errors: __errors
});
        }

        return ({
	success: true,
	value: resultOrRef
});
    } catch (e) {
        if (e instanceof __mf_DecodeError) {
            return ({
	success: false,
	errors: e.errors
});
        }
        const message = e instanceof Error ? e.message : String(e);
        return ({
	success: false,
	errors: [{
		field: "_root",
		message
	}]
});
    }
}
/** Decodes with an existing context for nested/cyclic object graphs. @param value - The raw value to decode @param ctx - The decoding context  */
export function nameMixedDecodeWithContext(value: unknown, ctx: __mf_DecodeContext): NameMixed | __mf_PendingRef;
/** Decodes the fields `fields` keeps, and no other. @param value - The raw value to decode @param ctx - The decoding context @param fields - Which fields the value has and has to have  */
export function nameMixedDecodeWithContext(value: unknown, ctx: __mf_DecodeContext, fields: __mf_FieldRequirement): Partial<NameMixed> | __mf_PendingRef;
export function nameMixedDecodeWithContext(value: unknown, ctx: __mf_DecodeContext, __fields?: __mf_FieldRequirement): Partial<NameMixed> | __mf_PendingRef {
    if (__fields !== undefined && typeof value === "object" && value !== null && "__ref" in value) {
        throw new __mf_DecodeError([{ field: "_root", message: "NameMixed.decodeWithContext: a value holding a selection of fields cannot be a reference" }]);
    }
    if (typeof value === "object" && value !== null && "__ref" in value) {
        if (typeof value.__ref !== "number") {
            throw new __mf_DecodeError([{ field: "__ref", message: "NameMixed.decodeWithContext: __ref must be a number" }]);
        }
        return ctx.getOrDefer(value.__ref, "NameMixed") as NameMixed | __mf_PendingRef;
    }

    if (typeof value !== "object" || value === null || Array.isArray(value)) {
        throw new __mf_DecodeError([{ field: "_root", message: "NameMixed.decodeWithContext: expected an object" }]);
    }

    const obj = __mf_ownMembers(value);
    const errors: Array<{ field: string; message: string }> = [];

    const __requiredKeys: ReadonlyArray<readonly [string, string]> = [["id", "id"], ["score", "score"], ["extra", "extra"]];
    for (const [__name, __key] of __requiredKeys) {
        if ((__fields === undefined || __fields.requires(__name)) && !(__key in obj)) {
            errors.push({ field: __key, message: "missing required field" });
        }
    }

    const instance: any = {};

    if (__fields === undefined && obj["__id"] !== undefined) {
        ctx.register(obj["__id"] as number, instance, "NameMixed");
    }

    ctx.trackForFreeze(instance);

    for (const __part of [
        () => {
            if ((__fields === undefined || __fields.requires("id")) ? "id" in obj : (__fields.keeps("id") && obj["id"] !== undefined)) {
                const __raw_id = obj["id"] as string;

                if (!(typeof __raw_id === "string")) {
                    errors.push({ field: "id", message: __raw_id == null ? "NameMixed.id is required" : "expected string" });
                } else {
                    instance.id = __raw_id;
                }
            }
        },
        () => {
            if ((__fields === undefined || __fields.requires("score")) ? "score" in obj : (__fields.keeps("score") && obj["score"] !== undefined)) {
                const __raw_score = obj["score"] as number;

                if (!(typeof __raw_score === "number" && globalThis.Number.isFinite(__raw_score))) {
                    errors.push({ field: "score", message: __raw_score == null ? "NameMixed.score is required" : "expected number" });
                } else {
                    instance.score = __raw_score;
                }
            }
        },
        () => {
            if ((__fields === undefined || __fields.requires("extra")) ? "extra" in obj : (__fields.keeps("extra") && obj["extra"] !== undefined)) {
                const __raw_extra = obj["extra"] as string;

                if (!(typeof __raw_extra === "string")) {
                    errors.push({ field: "extra", message: __raw_extra == null ? "NameMixed.extra is required" : "expected string" });
                } else {
                    instance.extra = __raw_extra;
                }
            }
        },
    ]) {
        __part();
    }

    ctx.pushErrors(errors);

    return instance as NameMixed;
}

