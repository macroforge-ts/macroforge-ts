import { metersDecode, metersDecodeWithContext, metersEncodeWithContext } from "./newtype-validator-tests.ts";
import { EncodeContext as __mf_EncodeContext, DecodeContext as __mf_DecodeContext, DecodeError as __mf_DecodeError, PendingRef as __mf_PendingRef } from "@macroforge/core/endec";
import type { DecodeOptions as __mf_DecodeOptions } from "@macroforge/core/endec";
/**
 * Consumes newtypes from another module, so the type-check covers exported
 * brands, their convenience consts and guard narrowing across files.
 */

import { Meters, type Run, Username } from './newtype-validator-tests.ts';

/** @derive(Encode, Decode) */
export interface Trip {
    leg: Meters;
    legs: Meters[];
}

/** Encodes a value to a JSON string. @param value - The value to encode @param keepMetadata - If true, preserves __type and __id fields in the output @returns JSON string representation  */
export function tripEncode(value: Trip, keepMetadata?: boolean): string {
    const ctx = __mf_EncodeContext.create();
    const __raw = tripEncodeWithContext(value, ctx);
    if (keepMetadata) return JSON.stringify(__raw);
    return JSON.stringify(__raw, (key, val) => key === "__type" || key === "__id" ? undefined : val);
}

/** Encodes with an existing context for nested/cyclic object graphs. @param value - The value to encode @param ctx - The encoding context  */
export function tripEncodeWithContext(value: Trip, ctx: __mf_EncodeContext): Record<string, unknown> {

    const existingId = ctx.getId(value);
    if (existingId !== undefined) {
        return { __ref: existingId };
    }

    const __id = ctx.register(value);

    const result: Record<string, unknown> = {
        "__type": "Trip",
        __id,
    };

    
    result.leg = metersEncodeWithContext(value.leg, ctx);
    result.legs = value.legs.map(
        (item) => metersEncodeWithContext(item, ctx)
    );

    return result;
}

/** Decodes input to this type. Automatically detects whether input is a JSON string or object. @param input - JSON string or object to decode @param opts - Optional decoding options @returns Result containing the decoded value or validation errors  */
export function tripDecode(input: unknown, opts?: __mf_DecodeOptions): { success: true; value: Trip } | { success: false; errors: Array<{ field: string; message: string }> } {
    try {

        const data = typeof input === "string" ? JSON.parse(input) : input;

        const ctx = __mf_DecodeContext.create();
        const resultOrRef = tripDecodeWithContext(data, ctx);

        if (__mf_PendingRef.is(resultOrRef)) {
            return ({
	success: false,
	errors: [{
		field: "_root",
		message: "Trip.decode: root cannot be a forward reference"
	}]
});
        }

        ctx.applyPatches();
        if (opts?.freeze) {
            ctx.freezeAll();
        }

        const __errors = ctx.getErrors();
        if (__errors.length > 0) {
            return ({
	success: false,
	errors: __errors
});
        }

        return ({
	success: true,
	value: resultOrRef
});
    } catch (e) {
        if (e instanceof __mf_DecodeError) {
            return ({
	success: false,
	errors: e.errors
});
        }
        const message = e instanceof Error ? e.message : String(e);
        return ({
	success: false,
	errors: [{
		field: "_root",
		message
	}]
});
    }
}
/** Decodes with an existing context for nested/cyclic object graphs. @param value - The raw value to decode @param ctx - The decoding context  */
export function tripDecodeWithContext(value: unknown, ctx: __mf_DecodeContext): Trip | __mf_PendingRef {
    if (typeof value === "object" && value !== null && "__ref" in value) {
        if (typeof value.__ref !== "number") {
            throw new __mf_DecodeError([{ field: "__ref", message: "Trip.decodeWithContext: __ref must be a number" }]);
        }
        return ctx.getOrDefer(value.__ref) as Trip | __mf_PendingRef;
    }

    if (typeof value !== "object" || value === null || Array.isArray(value)) {
        throw new __mf_DecodeError([{ field: "_root", message: "Trip.decodeWithContext: expected an object" }]);
    }

    const obj = value as Record<string, unknown>;
    const errors: Array<{ field: string; message: string }> = [];
    if (!("leg" in obj)) {
        errors.push({ field: "leg", message: "missing required field" });
    }
    if (!("legs" in obj)) {
        errors.push({ field: "legs", message: "missing required field" });
    }

    const instance: any = {};

    if (obj.__id !== undefined) {
        ctx.register(obj.__id as number, instance);
    }

    ctx.trackForFreeze(instance);

    {
        const __raw_leg = obj["leg"] as Meters;

        ctx.pushScope("leg");
        try {
            const __result = metersDecodeWithContext(__raw_leg, ctx);
            ctx.assignOrDefer(instance, "leg", __result);
        } catch (__e) {
            if (__e instanceof __mf_DecodeError) {
                for (const __err of __e.errors) {
                    errors.push({
                        field: __err.field === "_root" ? "leg" : "leg." + __err.field,
                        message: __err.message
                    });
                }
            } else {
                throw __e;
            }
        } finally {
            ctx.popScope();
        }
    }
    {
        const __raw_legs = obj["legs"] as Meters[];

        if (Array.isArray(__raw_legs)) {
            const __arr = __raw_legs.map((item: Meters | { __ref: number }, idx) => {
                if (typeof item === "object" && item !== null && "__ref" in item) {
                    const result = ctx.getOrDefer(item.__ref);
                    if (__mf_PendingRef.is(result)) {
                        return { __pendingIdx: idx, __refId: result.id };
                    }
                    return result;
                }
                const __elemResult = metersDecode(item);
                if (!__elemResult.success) {
                    for (const __err of __elemResult.errors) {
                        errors.push({
                            field: __err.field === "_root"
                                ? "legs[" + idx + "]"
                                : "legs[" + idx + "]." + __err.field,
                            message: __err.message
                        });
                    }
                }
                return __elemResult.success ? __elemResult.value : item;
            });
            instance.legs = __arr;
            __arr.forEach((item, idx) => {
                if (item && typeof item === "object" && "__pendingIdx" in item) {
                    ctx.addPatch(instance.legs, idx, (item as any).__refId);
                }
            });
        }
    }

    ctx.pushErrors(errors);

    return instance as Trip;
}
export function tripValidateField<K extends keyof Trip>(field: K, value: unknown): Array<{ field: string; message: string }>;
export function tripValidateField(): Array<{ field: string; message: string }> {
    return [];
}

export function tripValidateFields(partial: { readonly [K in keyof Trip]?: unknown }): Array<{ field: string; message: string }>;
export function tripValidateFields(): Array<{ field: string; message: string }> {
    return [];
}
export function tripHasShape(obj: unknown): boolean {
    if (typeof obj !== "object" || obj === null || Array.isArray(obj)) {
        return false;
    }
    const o = obj as Record<string, unknown>;
    return "leg" in o && "legs" in o;
}

export function tripIs(obj: unknown): obj is Trip {
    return tripHasShape(obj) && tripDecode(obj).success;
}

export const Trip: {
  readonly encode: typeof tripEncode;
  readonly encodeWithContext: typeof tripEncodeWithContext;
  readonly decode: typeof tripDecode;
  readonly decodeWithContext: typeof tripDecodeWithContext;
  readonly validateField: typeof tripValidateField;
  readonly validateFields: typeof tripValidateFields;
  readonly hasShape: typeof tripHasShape;
  readonly is: typeof tripIs;
} = {
  encode: tripEncode,
  encodeWithContext: tripEncodeWithContext,
  decode: tripDecode,
  decodeWithContext: tripDecodeWithContext,
  validateField: tripValidateField,
  validateFields: tripValidateFields,
  hasShape: tripHasShape,
  is: tripIs
};

export function totalDistance(run: Run): Meters {
    const total = run.splits.reduce((sum, split) => sum + split, 0);
    return Meters.is(total) ? total : Meters.defaultValue();
}

export function greet(name: string): string {
    const decoded = Username.decode(name);
    return decoded.success ? `hello ${decoded.value}` : 'hello stranger';
}

