import { Meters, type Run, Username } from './newtype-validator-tests.ts';

/** @derive(Encode, Decode) */
export interface Trip {
    leg: Meters;
    legs: Meters[];
}

/** Encodes a value to a JSON string. @param value - The value to encode @param keepMetadata - If true, preserves __type and __id fields in the output @returns JSON string representation  */
export function tripEncode(value: Trip, keepMetadata?: boolean): string {
    const ctx = __mf_EncodeContext.create();
    const __raw = tripEncodeWithContext(value, ctx);
    return keepMetadata ? __mf_encodedText(__raw) : __mf_encodedTextWithoutMetadata(__raw, "__type");
}

/** Encodes with an existing context for nested/cyclic object graphs. @param value - The value to encode @param ctx - The encoding context  */
export function tripEncodeWithContext(value: Trip, ctx: __mf_EncodeContext): Record<string, unknown> {
    const existingId = ctx.getId(value);
    if (existingId !== undefined) {
        return __mf_encodedReference(ctx, existingId);
    }
    const result = __mf_encodedAs(ctx, ctx.register(value), { "__type": "Trip" });
    tripEncodeFields(value, ctx, result, undefined);
    return result;
}

/** Encodes the fields a partial value has, with an existing context. A value encoded this way is written out wherever it is held: no reference stands for it. @param value - The value to encode @param ctx - The encoding context @param fields - The fields a `Pick` or `Omit` keeps: every field when left out  */
export function tripEncodePartialWithContext(value: Partial<Trip>, ctx: __mf_EncodeContext, fields?: __mf_FieldSelection<keyof Trip>): Record<string, unknown> {
    return __mf_encodeSelection(ctx, value, () => {
        const result: Record<string, unknown> = { "__type": "Trip" };
        tripEncodeFields(value as Trip, ctx, result, fields === undefined ? undefined : __mf_fieldRequirement(fields));
        return result;
    });
}

function tripEncodeFields(value: Trip, ctx: __mf_EncodeContext, result: Record<string, unknown>, __fields: __mf_FieldRequirement | undefined): void {
    if (__fields === undefined || __fields.keeps("leg")) {
        if (value.leg !== undefined) {
            result["leg"] = metersEncodeWithContext(value.leg, ctx);
        }
    }
    if (__fields === undefined || __fields.keeps("legs")) {
        if (value.legs !== undefined) {
            result["legs"] = value.legs.map((__item0) => metersEncodeWithContext(__item0, ctx));
        }
    }
}

/** Decodes input to this type. Automatically detects whether input is a JSON string or object. @param input - JSON string or object to decode @param opts - Optional decoding options @returns Result containing the decoded value or validation errors  */
export function tripDecode(input: unknown, opts?: __mf_DecodeOptions): { success: true; value: Trip } | { success: false; errors: Array<{ field: string; message: string }> } {
    try {

        const data = typeof input === "string" ? __mf_parsedText(input) : input;

        const ctx = __mf_DecodeContext.create();
        const resultOrRef = tripDecodeWithContext(data, ctx);

        if (__mf_PendingRef.is(resultOrRef)) {
            return ({
	success: false,
	errors: [{
		field: "_root",
		message: "Trip.decode: root cannot be a forward reference"
	}]
});
        }

        ctx.applyPatches();
        if (opts?.freeze) {
            ctx.freezeAll();
        }

        const __errors = ctx.getErrors();
        if (__errors.length > 0) {
            return ({
	success: false,
	errors: __errors
});
        }

        return ({
	success: true,
	value: resultOrRef
});
    } catch (e) {
        if (e instanceof __mf_DecodeError) {
            return ({
	success: false,
	errors: e.errors
});
        }
        const message = e instanceof Error ? e.message : String(e);
        return ({
