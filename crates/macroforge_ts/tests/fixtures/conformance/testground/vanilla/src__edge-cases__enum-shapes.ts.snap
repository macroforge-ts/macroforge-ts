/** @derive(Debug, Clone, PartialEq, Eq, PartialOrd, Ord) */
export interface EnumOrdered {
    counted: EnumCounted;
    mixed: EnumMixed;
    text: EnumText;
}

export function enumOrderedToString(value: EnumOrdered): string {
    const parts: string[] = [];
    parts.push("counted: " + enumCountedToString(value.counted));
    parts.push("mixed: " + enumMixedToString(value.mixed));
    parts.push("text: " + enumTextToString(value.text));
    return "EnumOrdered { " + parts.join(", ") + " }";
}

export function enumOrderedClone(value: EnumOrdered): EnumOrdered {
    return ({
	counted: enumCountedClone(value.counted),
	mixed: enumMixedClone(value.mixed),
	text: enumTextClone(value.text)
});
}

export function enumOrderedEquals(a: EnumOrdered, b: EnumOrdered): boolean {
    if (a === b) return true;
    return enumCountedEquals(a.counted, b.counted) && enumMixedEquals(a.mixed, b.mixed) && enumTextEquals(a.text, b.text);
}

export function enumOrderedPartialCompare(a: EnumOrdered, b: EnumOrdered): number | null {
    if (a === b) return 0;
    const cmp0 = enumCountedPartialCompare(a.counted, b.counted);
    if (cmp0 === null) return null;
    if (cmp0 !== 0) return cmp0;
    const cmp1 = enumMixedPartialCompare(a.mixed, b.mixed);
    if (cmp1 === null) return null;
    if (cmp1 !== 0) return cmp1;
    const cmp2 = enumTextPartialCompare(a.text, b.text);
    if (cmp2 === null) return null;
    if (cmp2 !== 0) return cmp2;
    return 0;
}

export function enumOrderedCompare(a: EnumOrdered, b: EnumOrdered): number {
    if (a === b) return 0;
    const cmp0 = enumCountedCompare(a.counted, b.counted);
    if (cmp0 !== 0) return cmp0;
    const cmp1 = enumMixedCompare(a.mixed, b.mixed);
    if (cmp1 !== 0) return cmp1;
    const cmp2 = enumTextCompare(a.text, b.text);
    if (cmp2 !== 0) return cmp2;
    return 0;
}

export const EnumOrdered: {
  readonly toString: typeof enumOrderedToString;
  readonly clone: typeof enumOrderedClone;
  readonly equals: typeof enumOrderedEquals;
  readonly partialCompare: typeof enumOrderedPartialCompare;
  readonly compare: typeof enumOrderedCompare;
} = {
  toString: enumOrderedToString,
  clone: enumOrderedClone,
  equals: enumOrderedEquals,
  partialCompare: enumOrderedPartialCompare,
  compare: enumOrderedCompare
};

