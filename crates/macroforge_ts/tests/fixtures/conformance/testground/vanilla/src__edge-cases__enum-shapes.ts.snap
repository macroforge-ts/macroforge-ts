/** @derive(Debug, Clone, PartialEq, Eq, Hash, PartialOrd, Ord, Default, Encode, Decode) */
export enum EnumCounted {
    /** @default */
    First,
    Second,
    Third
}

export function enumCountedToString(value: EnumCounted): string {

    const held: unknown = value;
    if (held === EnumCounted["First"]) {
        return "EnumCounted.First";
    }
    if (held === EnumCounted["Second"]) {
        return "EnumCounted.Second";
    }
    if (held === EnumCounted["Third"]) {
        return "EnumCounted.Third";
    }
    return "EnumCounted(" + String(value) + ")";
}

export function enumCountedClone(value: EnumCounted): EnumCounted {
    return value;
}

export function enumCountedEquals(a: EnumCounted, b: EnumCounted): boolean {
    return a === b;
}

export function enumCountedHashCode(value: EnumCounted): number {
    return (Number.isInteger(value) ? value | 0 : value.toString().split("").reduce<number>((h, c) => (h * 31 + c.charCodeAt(0)) | 0, 0));
}

export function enumCountedPartialCompare(a: EnumCounted, b: EnumCounted): number | null {
    if (typeof a === "number" && typeof b === "number") {
        return a < b ? -1 : a > b ? 1 : 0;
    }
    return 0;
}

export function enumCountedCompare(a: EnumCounted, b: EnumCounted): number {
    if (typeof a === "number" && typeof b === "number") {
        return a < b ? -1 : a > b ? 1 : 0;
    }
    return 0;
}

export function enumCountedDefaultValue(): EnumCounted {
    return EnumCounted.First;
}

/** Encodes this enum value to a JSON string.  */
export function enumCountedEncode(value: EnumCounted): string {
    return __mf_encodedText(value);
}

/** Encodes with an existing context for nested/cyclic object graphs.  */
export function enumCountedEncodeWithContext(value: EnumCounted, ctx: __mf_EncodeContext): string | number;
export function enumCountedEncodeWithContext(value: EnumCounted): string | number {
    return value;
}

/** Decodes input to an enum value. @param input - Value to decode @returns The enum value @throws Error if the value is not a valid enum member  */
export function enumCountedDecode(input: unknown): EnumCounted {

    return enumCountedDecodeWithContext(__mf_textOrValue(input, enumCountedIs));
}

/** Decodes with an existing context (for consistency with other types).  */
export function enumCountedDecodeWithContext(data: unknown, ctx?: __mf_DecodeContext): EnumCounted;
export function enumCountedDecodeWithContext(data: unknown): EnumCounted {
    if (EnumCounted["First"] === data) {
        return EnumCounted["First"];
    }
    if (EnumCounted["Second"] === data) {
        return EnumCounted["Second"];
    }
    if (EnumCounted["Third"] === data) {
        return EnumCounted["Third"];
    }
    throw new __mf_DecodeError([{ field: "_root", message: "Invalid EnumCounted value: " + JSON.stringify(data) }]);
}

export function enumCountedIs(value: unknown): value is EnumCounted {
    if (EnumCounted["First"] === value) {
        return true;
    }
    if (EnumCounted["Second"] === value) {
        return true;
    }
    if (EnumCounted["Third"] === value) {
        return true;
    }
    return false;
}

