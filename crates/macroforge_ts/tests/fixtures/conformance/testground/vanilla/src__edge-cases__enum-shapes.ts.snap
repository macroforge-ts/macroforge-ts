export function enumTextIs(value: unknown): value is EnumText {
    if (EnumText["Empty"] === value) {
        return true;
    }
    if (EnumText["Quoted"] === value) {
        return true;
    }
    if (EnumText["Spaced"] === value) {
        return true;
    }
    if (EnumText["Slashed"] === value) {
        return true;
    }
    return false;
}

