/** @derive(Default) */
export class Greeter {
    name: string = 'world';
    greet: () => string = function (this: Greeter): string {
        return `hello ${this.name}`;
    };

static defaultValue(): Greeter {

    const instance: Greeter = Object.create(Greeter.prototype);
    instance.name = "world";
    instance.greet = (function(this: Greeter): string {
	return `hello ${this.name}`;
});
    return instance;
}
}

export function greeterDefaultValue(): Greeter {
    return Greeter.defaultValue();
}

