    static validateField(): Array<{ field: string; message: string }> {
        return [];
    }

    static validateFields(partial: { readonly [K in keyof Settings]?: unknown }): Array<{ field: string; message: string }>;
    static validateFields(): Array<{ field: string; message: string }> {
        return [];
    }

    static hasShape(obj: unknown): boolean {
        if (typeof obj !== "object" || obj === null || Array.isArray(obj)) {
            return false;
        }
        const o = obj as Record<string, unknown>;
        return "theme" in o && "tags" in o && "limit" in o && "createdAt" in o;
    }

    static is(obj: unknown): obj is Settings {
        if (obj instanceof Settings) {
            return true;
        }
        if (!Settings.hasShape(obj)) {
            return false;
        }
        const result = Settings.decode(obj);
        return result.success;
    }
}

