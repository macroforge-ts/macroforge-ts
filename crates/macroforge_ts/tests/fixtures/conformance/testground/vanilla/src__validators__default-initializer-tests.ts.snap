import { DecodeContext as __mf_DecodeContext, DecodeError as __mf_DecodeError, PendingRef as __mf_PendingRef, EncodeContext as __mf_EncodeContext } from "@macroforge/core/endec";
import type { DecodeOptions as __mf_DecodeOptions } from "@macroforge/core/endec";
// Default on classes whose fields have initializers, derived beside Decode,
// whose constructor takes arguments.

/** @derive(Default, Decode) */
export class Settings {
    theme: string = 'dark';
    retries?: number = 3;
    label?: string;
    tags: string[] = ['general'];
    /** @default(7) */
    limit: number = 5;
    createdAt: number = Date.now();
    static instances: number = 0;

    static defaultValue(): Settings {

        const instance: Settings = Object.create(Settings.prototype);
        instance.theme = "dark";
        instance.retries = 3;
        instance.tags = ["general"];
        instance.limit = 7;
        instance.createdAt = Date.now();
        return instance;
    }

    constructor(props: { theme: string; retries?: number; label?: string; tags: string[]; limit: number; createdAt: number }) {
        this.theme = props.theme;
        this.retries = props.retries;
        this.label = props.label;
        this.tags = props.tags;
        this.limit = props.limit;
        this.createdAt = props.createdAt;
    }

    /** Decodes input to an instance of this class. Automatically detects whether input is a JSON string or object. @param input - JSON string or object to decode @param opts - Optional decoding options @returns Result containing the decoded instance or validation errors  */
    static decode(input: unknown, opts?: __mf_DecodeOptions): { success: true; value: Settings } | { success: false; errors: Array<{ field: string; message: string }> } {
        try {

            const data = typeof input === "string" ? JSON.parse(input) : input;

            const ctx = __mf_DecodeContext.create();
            const resultOrRef = Settings.decodeWithContext(data, ctx);

            if (__mf_PendingRef.is(resultOrRef)) {
                return ({
    	success: false,
    	errors: [{
    		field: "_root",
    		message: "Settings.decode: root cannot be a forward reference"
    	}]
    });
            }

            ctx.applyPatches();
            if (opts?.freeze) {
                ctx.freezeAll();
            }

            const __errors = ctx.getErrors();
            if (__errors.length > 0) {
                return ({
    	success: false,
    	errors: __errors
    });
            }

            return ({
    	success: true,
    	value: resultOrRef
    });
        } catch (e) {
            if (e instanceof __mf_DecodeError) {
                return ({
    	success: false,
    	errors: e.errors
    });
            }
            const message = e instanceof Error ? e.message : String(e);
            return ({
    	success: false,
    	errors: [{
    		field: "_root",
    		message
    	}]
    });
        }
    }

    /** Decodes with an existing context for nested/cyclic object graphs. @param value - The raw value to decode @param ctx - The decoding context  */
    static decodeWithContext(value: unknown, ctx: __mf_DecodeContext): Settings | __mf_PendingRef {
        if (typeof value === "object" && value !== null && "__ref" in value) {
            if (typeof value.__ref !== "number") {
                throw new __mf_DecodeError([{ field: "__ref", message: "Settings.decodeWithContext: __ref must be a number" }]);
            }
            return ctx.getOrDefer(value.__ref) as Settings | __mf_PendingRef;
        }

        if (typeof value !== "object" || value === null || Array.isArray(value)) {
            throw new __mf_DecodeError([{ field: "_root", message: "Settings.decodeWithContext: expected an object" }]);
        }

        const obj = value as Record<string, unknown>;
        const errors: Array<{ field: string; message: string }> = [];
        if (!("theme" in obj)) {
            errors.push({ field: "theme", message: "missing required field" });
        }
        if (!("tags" in obj)) {
            errors.push({ field: "tags", message: "missing required field" });
        }
        if (!("limit" in obj)) {
            errors.push({ field: "limit", message: "missing required field" });
        }
        if (!("createdAt" in obj)) {
            errors.push({ field: "createdAt", message: "missing required field" });
        }

        const instance = Object.create(Settings.prototype) as Settings;

        if (obj.__id !== undefined) {
            ctx.register(obj.__id as number, instance);
        }

        ctx.trackForFreeze(instance);

        {
            const __raw_theme = obj["theme"] as string;

            if (!(typeof __raw_theme === "string")) {
                errors.push({ field: "theme", message: __raw_theme == null ? "Settings.theme is required" : "expected string" });
            } else {
                instance.theme = __raw_theme;
            }
        }
        if ("retries" in obj && obj["retries"] !== undefined) {
            const __raw_retries = obj["retries"] as number;

            if (!(typeof __raw_retries === "number")) {
                errors.push({ field: "retries", message: "expected number" });
            } else {
                instance.retries = __raw_retries;
            }
        }
        if ("label" in obj && obj["label"] !== undefined) {
            const __raw_label = obj["label"] as string;

            if (!(typeof __raw_label === "string")) {
                errors.push({ field: "label", message: "expected string" });
            } else {
                instance.label = __raw_label;
            }
        }
        {
            const __raw_tags = obj["tags"] as string[];

            if (Array.isArray(__raw_tags)) {
                instance.tags = __raw_tags as string[];
            }
        }
        {
            const __raw_limit = obj["limit"] as number;

            if (!(typeof __raw_limit === "number")) {
                errors.push({ field: "limit", message: __raw_limit == null ? "Settings.limit is required" : "expected number" });
            } else {
                instance.limit = __raw_limit;
            }
        }
        {
            const __raw_createdAt = obj["createdAt"] as number;

            if (!(typeof __raw_createdAt === "number")) {
                errors.push({ field: "createdAt", message: __raw_createdAt == null ? "Settings.createdAt is required" : "expected number" });
            } else {
                instance.createdAt = __raw_createdAt;
