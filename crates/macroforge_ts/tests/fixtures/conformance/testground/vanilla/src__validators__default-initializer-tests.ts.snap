export function counterToString(value: Counter): string {
    const parts: string[] = [];
    parts.push("count: " + String(value.count));
    return "Counter { " + parts.join(", ") + " }";
}

export function counterClone(value: Counter): Counter {
    const cloned = Object.create(Object.getPrototypeOf(value));
    cloned.count = value.count;
    return cloned;
}

export function counterEquals(a: Counter, b: Counter): boolean {
    if (a === b) return true;
    return a.count === b.count;
}

export function counterHashCode(value: Counter): number {
    let hash = 17;
    hash = (hash * 31 + (Number.isInteger(value.count) ? value.count | 0 : value.count.toString().split("").reduce((h, c) => h * 31 + c.charCodeAt(0) | 0, 0))) | 0;
    return hash;
}

export function counterPartialCompare(a: Counter, b: Counter): number | null {
    if (a === b) return 0;
    const cmp0 = (a.count < b.count ? -1 : a.count > b.count ? 1 : a.count === b.count ? 0 : null);
    if (cmp0 === null) return null;
    if (cmp0 !== 0) return cmp0;
    return 0;
}

export function counterCompare(a: Counter, b: Counter): number {
    if (a === b) return 0;
    const cmp0 = a.count < b.count ? -1 : a.count > b.count ? 1 : 0;
    if (cmp0 !== 0) return cmp0;
    return 0;
}

