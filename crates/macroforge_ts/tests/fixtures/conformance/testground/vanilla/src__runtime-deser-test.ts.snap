import { DecodeContext as __mf_DecodeContext, DecodeError as __mf_DecodeError, PendingRef as __mf_PendingRef } from "@macroforge/core/endec";
import type { DecodeOptions as __mf_DecodeOptions } from "@macroforge/core/endec";
/** @derive(Decode) */
export interface Inner {
    name: string;
    createdAt: Date;
    score: number;
}

/** Decodes input to this type. Automatically detects whether input is a JSON string or object. @param input - JSON string or object to decode @param opts - Optional decoding options @returns Result containing the decoded value or validation errors  */
export function innerDecode(input: unknown, opts?: __mf_DecodeOptions): { success: true; value: Inner } | { success: false; errors: Array<{ field: string; message: string }> } {
    try {

        const data = typeof input === "string" ? JSON.parse(input) : input;

        const ctx = __mf_DecodeContext.create();
        const resultOrRef = innerDecodeWithContext(data, ctx);

        if (__mf_PendingRef.is(resultOrRef)) {
            return ({
	success: false,
	errors: [{
		field: "_root",
		message: "Inner.decode: root cannot be a forward reference"
	}]
});
        }

        ctx.applyPatches();
        if (opts?.freeze) {
            ctx.freezeAll();
        }

        const __errors = ctx.getErrors();
        if (__errors.length > 0) {
            return ({
	success: false,
	errors: __errors
});
        }

        return ({
	success: true,
	value: resultOrRef
});
    } catch (e) {
        if (e instanceof __mf_DecodeError) {
            return ({
	success: false,
	errors: e.errors
});
        }
        const message = e instanceof Error ? e.message : String(e);
        return ({
	success: false,
	errors: [{
		field: "_root",
		message
	}]
});
    }
}
/** Decodes with an existing context for nested/cyclic object graphs. @param value - The raw value to decode @param ctx - The decoding context  */
export function innerDecodeWithContext(value: unknown, ctx: __mf_DecodeContext): Inner | __mf_PendingRef {
    if (typeof value === "object" && value !== null && "__ref" in value) {
        if (typeof value.__ref !== "number") {
            throw new __mf_DecodeError([{ field: "__ref", message: "Inner.decodeWithContext: __ref must be a number" }]);
        }
        return ctx.getOrDefer(value.__ref) as Inner | __mf_PendingRef;
    }

    if (typeof value !== "object" || value === null || Array.isArray(value)) {
        throw new __mf_DecodeError([{ field: "_root", message: "Inner.decodeWithContext: expected an object" }]);
    }

    const obj = value as Record<string, unknown>;
    const errors: Array<{ field: string; message: string }> = [];
    if (!("name" in obj)) {
        errors.push({ field: "name", message: "missing required field" });
    }
    if (!("createdAt" in obj)) {
        errors.push({ field: "createdAt", message: "missing required field" });
    }
    if (!("score" in obj)) {
        errors.push({ field: "score", message: "missing required field" });
    }

    const instance: any = {};

    if (obj.__id !== undefined) {
        ctx.register(obj.__id as number, instance);
    }

    ctx.trackForFreeze(instance);

    {
        const __raw_name = obj["name"] as string;

        if (!(typeof __raw_name === "string")) {
            errors.push({ field: "name", message: __raw_name == null ? "Inner.name is required" : "expected string" });
        } else {
            instance.name = __raw_name;
        }
    }
    {
        const __raw_createdAt = obj["createdAt"] as string | Date;

        {
            const __dateVal = typeof __raw_createdAt === "string" ? new Date(__raw_createdAt) : __raw_createdAt as Date;
            instance.createdAt = __dateVal;
        }
    }
    {
        const __raw_score = obj["score"] as number;

        if (!(typeof __raw_score === "number")) {
            errors.push({ field: "score", message: __raw_score == null ? "Inner.score is required" : "expected number" });
        } else {
            instance.score = __raw_score;
        }
    }

    ctx.pushErrors(errors);

    return instance as Inner;
}
export function innerValidateField<K extends keyof Inner>(field: K, value: unknown): Array<{ field: string; message: string }>;
export function innerValidateField(): Array<{ field: string; message: string }> {
    return [];
}

export function innerValidateFields(partial: { readonly [K in keyof Inner]?: unknown }): Array<{ field: string; message: string }>;
export function innerValidateFields(): Array<{ field: string; message: string }> {
    return [];
}
export function innerHasShape(obj: unknown): boolean {
    if (typeof obj !== "object" || obj === null || Array.isArray(obj)) {
        return false;
    }
    const o = obj as Record<string, unknown>;
    return "name" in o && "createdAt" in o && "score" in o;
}

export function innerIs(obj: unknown): obj is Inner {
    return innerHasShape(obj) && innerDecode(obj).success;
}

export const Inner: {
  readonly decode: typeof innerDecode;
  readonly decodeWithContext: typeof innerDecodeWithContext;
  readonly validateField: typeof innerValidateField;
  readonly validateFields: typeof innerValidateFields;
  readonly hasShape: typeof innerHasShape;
  readonly is: typeof innerIs;
} = {
  decode: innerDecode,
  decodeWithContext: innerDecodeWithContext,
  validateField: innerValidateField,
  validateFields: innerValidateFields,
  hasShape: innerHasShape,
  is: innerIs
};

/** @derive(Decode) */
export interface Container {
    items: Inner[];
}

/** Decodes input to this type. Automatically detects whether input is a JSON string or object. @param input - JSON string or object to decode @param opts - Optional decoding options @returns Result containing the decoded value or validation errors  */
export function containerDecode(input: unknown, opts?: __mf_DecodeOptions): { success: true; value: Container } | { success: false; errors: Array<{ field: string; message: string }> } {
    try {

        const data = typeof input === "string" ? JSON.parse(input) : input;

        const ctx = __mf_DecodeContext.create();
        const resultOrRef = containerDecodeWithContext(data, ctx);

        if (__mf_PendingRef.is(resultOrRef)) {
            return ({
	success: false,
	errors: [{
		field: "_root",
		message: "Container.decode: root cannot be a forward reference"
	}]
});
        }

        ctx.applyPatches();
        if (opts?.freeze) {
            ctx.freezeAll();
        }

        const __errors = ctx.getErrors();
        if (__errors.length > 0) {
            return ({
	success: false,
	errors: __errors
});
        }

        return ({
	success: true,
	value: resultOrRef
});
    } catch (e) {
        if (e instanceof __mf_DecodeError) {
            return ({
	success: false,
	errors: e.errors
});
        }
        const message = e instanceof Error ? e.message : String(e);
        return ({
	success: false,
	errors: [{
		field: "_root",
		message
	}]
});
    }
}
/** Decodes with an existing context for nested/cyclic object graphs. @param value - The raw value to decode @param ctx - The decoding context  */
export function containerDecodeWithContext(value: unknown, ctx: __mf_DecodeContext): Container | __mf_PendingRef {
    if (typeof value === "object" && value !== null && "__ref" in value) {
        if (typeof value.__ref !== "number") {
            throw new __mf_DecodeError([{ field: "__ref", message: "Container.decodeWithContext: __ref must be a number" }]);
        }
        return ctx.getOrDefer(value.__ref) as Container | __mf_PendingRef;
    }

    if (typeof value !== "object" || value === null || Array.isArray(value)) {
        throw new __mf_DecodeError([{ field: "_root", message: "Container.decodeWithContext: expected an object" }]);
    }

    const obj = value as Record<string, unknown>;
    const errors: Array<{ field: string; message: string }> = [];
    if (!("items" in obj)) {
        errors.push({ field: "items", message: "missing required field" });
    }

    const instance: any = {};

    if (obj.__id !== undefined) {
        ctx.register(obj.__id as number, instance);
    }

    ctx.trackForFreeze(instance);

    {
        const __raw_items = obj["items"] as Inner[];

        if (Array.isArray(__raw_items)) {
            const __arr = __raw_items.map((item: Inner | { __ref: number }, idx) => {
                if (typeof item === "object" && item !== null && "__ref" in item) {
                    const result = ctx.getOrDefer(item.__ref);
                    if (__mf_PendingRef.is(result)) {
                        return { __pendingIdx: idx, __refId: result.id };
                    }
                    return result;
                }
                const __elemResult = innerDecode(item);
                if (!__elemResult.success) {
                    for (const __err of __elemResult.errors) {
                        errors.push({
                            field: __err.field === "_root"
                                ? "items[" + idx + "]"
                                : "items[" + idx + "]." + __err.field,
                            message: __err.message
                        });
                    }
                }
                return __elemResult.success ? __elemResult.value : item;
            });
            instance.items = __arr;
            __arr.forEach((item, idx) => {
                if (item && typeof item === "object" && "__pendingIdx" in item) {
                    ctx.addPatch(instance.items, idx, (item as any).__refId);
                }
            });
        }
    }

    ctx.pushErrors(errors);

    return instance as Container;
}
export function containerValidateField<K extends keyof Container>(field: K, value: unknown): Array<{ field: string; message: string }>;
export function containerValidateField(): Array<{ field: string; message: string }> {
    return [];
}

export function containerValidateFields(partial: { readonly [K in keyof Container]?: unknown }): Array<{ field: string; message: string }>;
export function containerValidateFields(): Array<{ field: string; message: string }> {
    return [];
}
export function containerHasShape(obj: unknown): boolean {
    if (typeof obj !== "object" || obj === null || Array.isArray(obj)) {
        return false;
    }
    const o = obj as Record<string, unknown>;
    return "items" in o;
}

export function containerIs(obj: unknown): obj is Container {
    return containerHasShape(obj) && containerDecode(obj).success;
}

export const Container: {
  readonly decode: typeof containerDecode;
  readonly decodeWithContext: typeof containerDecodeWithContext;
  readonly validateField: typeof containerValidateField;
  readonly validateFields: typeof containerValidateFields;
  readonly hasShape: typeof containerHasShape;
  readonly is: typeof containerIs;
} = {
  decode: containerDecode,
  decodeWithContext: containerDecodeWithContext,
  validateField: containerValidateField,
  validateFields: containerValidateFields,
  hasShape: containerHasShape,
  is: containerIs
};

export function testNormal() {
    return Container.decode({
        items: [
            { name: 'Alice', createdAt: '2024-01-15T10:30:00Z', score: 95 }
        ]
    });
}

export function testMissingFields() {
    return Container.decode({
        items: [
            { name: 'Bob' } // missing createdAt and score
        ]
    });
}

export function testNullElement() {
    return Container.decode({
        items: [null]
    });
}

export function testMixedElements() {
    return Container.decode({
        items: [
            { name: 'Alice', createdAt: '2024-01-15T10:30:00Z', score: 95 },
            { name: 'Bob' } // missing fields
        ]
    });
}

type ContainerFailure = Extract<ReturnType<typeof Container.decode>, { success: false }>;

export type RecursiveDeserResult =
    | { success: false; errors: ContainerFailure['errors'] }
    | {
        success: true;
        itemCount: number;
        firstIsDate: boolean;
        firstDateISO: string | undefined;
        secondIsDate: boolean;
        secondDateISO: string | undefined;
    };

/** The item's ISO date when decoding produced a real `Date`. */
function isoDate(item: Inner | undefined): string | undefined {
    return item?.createdAt instanceof Date ? item.createdAt.toISOString() : undefined;
}

export function testRecursiveActual(): RecursiveDeserResult {
    const result = Container.decode({
        items: [
            { name: 'Alice', createdAt: '2024-01-15T10:30:00Z', score: 95 },
            { name: 'Bob', createdAt: '2024-06-20T14:00:00Z', score: 87 }
        ]
    });
    if (!result.success) return { success: false, errors: result.errors };
    const [first, second] = result.value.items;
    return {
        success: true,
        itemCount: result.value.items.length,
        firstIsDate: first?.createdAt instanceof Date,
        firstDateISO: isoDate(first),
        secondIsDate: second?.createdAt instanceof Date,
        secondDateISO: isoDate(second)
    };
}

