    return __mf_hashedWithin(value, () => {
        let hash = 17;
    hash = (hash * 31 + ((value.id ?? "").split("").reduce<number>((h, c) => h * 31 + c.charCodeAt(0) | 0, 0))) | 0;
    hash = (hash * 31 + ((value.tag ?? "").split("").reduce<number>((h, c) => h * 31 + c.charCodeAt(0) | 0, 0))) | 0;
    hash = (hash * 31 + (__mf_structuralHash(value.held))) | 0;
    hash = (hash * 31 + (0)) | 0;
    hash = (hash * 31 + (__mf_structuralHash(value.choice))) | 0;
        return hash;
    });
}

