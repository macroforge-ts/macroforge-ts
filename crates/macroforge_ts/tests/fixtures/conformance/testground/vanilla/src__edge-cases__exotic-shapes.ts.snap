/**
 * Types at the edge of what a type can say: template literal types, `object`,
 * a lone `null`, unions of literals of several kinds, types with nothing in
 * them, an interface that declares methods, and records by the kind of key
 * they are over.
 */

/** @derive(Debug, Clone, PartialEq, Hash, Default, Encode, Decode) */
export interface ExoticScalars {
    id: `id-${number}`;
    tag: `${string}-${boolean}`;
    held: object;
    nothing: null;
    choice: 'a' | 'b' | 3 | true;
}

export function exoticScalarsToString(value: ExoticScalars): string {
    return __mf_debuggedWithin(value, () => {
        const parts: string[] = [];
    parts.push("id: " + String(value.id));
    parts.push("tag: " + String(value.tag));
    parts.push("held: " + __mf_structuralDebug(value.held));
    parts.push("nothing: " + String(value.nothing));
    parts.push("choice: " + __mf_structuralDebug(value.choice));
        return "ExoticScalars { " + parts.join(", ") + " }";
    });
}

