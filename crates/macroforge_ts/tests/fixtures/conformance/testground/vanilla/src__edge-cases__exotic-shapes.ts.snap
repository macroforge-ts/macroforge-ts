    if (a === b) return true;
    return __mf_equalWithin(a, b, () => a.id === b.id && a.tag === b.tag && __mf_structuralEquals(a.held, b.held) && a.nothing === b.nothing && __mf_structuralEquals(a.choice, b.choice));
