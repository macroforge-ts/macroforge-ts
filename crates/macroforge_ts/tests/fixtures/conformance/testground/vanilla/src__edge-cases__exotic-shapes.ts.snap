/**
 * Types at the edge of what a type can say: template literal types, `object`,
 * a lone `null`, unions of literals of several kinds, types with nothing in
 * them, and an interface that declares methods.
 */

/** @derive(Debug, Clone, PartialEq, Hash, Default, Encode, Decode) */
export interface ExoticScalars {
    id: `id-${number}`;
    tag: `${string}-${boolean}`;
    held: object;
    nothing: null;
    choice: 'a' | 'b' | 3 | true;
}

export function exoticScalarsToString(value: ExoticScalars): string {
    return __mf_debuggedWithin(value, () => {
        const parts: string[] = [];
    parts.push("id: " + String(value.id));
    parts.push("tag: " + String(value.tag));
    parts.push("held: " + __mf_structuralDebug(value.held));
    parts.push("nothing: " + String(value.nothing));
    parts.push("choice: " + __mf_structuralDebug(value.choice));
        return "ExoticScalars { " + parts.join(", ") + " }";
    });
}

export function exoticScalarsClone(value: ExoticScalars): ExoticScalars {
    return __mf_clonedWith(value, (): ExoticScalars => ({
	id: value.id,
	tag: value.tag,
	held: __mf_structuralClone(value.held),
	nothing: value.nothing,
	choice: __mf_structuralClone(value.choice)
}));
}

export function exoticScalarsEquals(a: ExoticScalars, b: ExoticScalars): boolean {
    if (a === b) return true;
    return __mf_equalWithin(a, b, () => a.id === b.id && a.tag === b.tag && __mf_structuralEquals(a.held, b.held) && a.nothing === b.nothing && __mf_structuralEquals(a.choice, b.choice));
}

export function exoticScalarsHashCode(value: ExoticScalars): number {
    return __mf_hashedWithin(value, () => {
        let hash = 17;
    hash = (hash * 31 + ((value.id ?? "").split("").reduce<number>((h, c) => h * 31 + c.charCodeAt(0) | 0, 0))) | 0;
    hash = (hash * 31 + ((value.tag ?? "").split("").reduce<number>((h, c) => h * 31 + c.charCodeAt(0) | 0, 0))) | 0;
    hash = (hash * 31 + (__mf_structuralHash(value.held))) | 0;
    hash = (hash * 31 + (0)) | 0;
    hash = (hash * 31 + (__mf_structuralHash(value.choice))) | 0;
        return hash;
    });
}

export function exoticScalarsDefaultValue(): ExoticScalars {
