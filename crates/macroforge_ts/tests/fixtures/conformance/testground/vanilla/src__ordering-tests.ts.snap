/** @derive(PartialEq, Eq, PartialOrd, Ord) */
export interface Scores {
    values: number[];
}

export function scoresEquals(a: Scores, b: Scores): boolean {
    if (a === b) return true;
    return __mf_equalWithin(a, b, () => a.values.length === b.values.length && a.values.every((__item0, __index0) => {
	const __other0 = b.values[__index0];
	return __other0 === undefined ? __item0 === undefined : __item0 === __other0;
}));
}

export function scoresPartialCompare(a: Scores, b: Scores): number | null {
    if (a === b) return 0;
    return __mf_comparedWithin(a, b, () => {
    const cmp0 = (() => {
        const __left0 = a.values;
        const __right0 = b.values;
        const __shared0 = Math.min(__left0.length, __right0.length);
        for (let __index0 = 0; __index0 < __shared0; __index0++) {
            const __item0 = __left0[__index0];
            const __other0 = __right0[__index0];
            const __order0 = __item0 === undefined || __other0 === undefined
                ? __mf_structuralCompare(__item0, __other0)
                : (__item0 < __other0 ? -1 : __item0 > __other0 ? 1 : __item0 === __other0 ? 0 : null);
            if (__order0 !== 0) return __order0;
        }
        return __left0.length < __right0.length ? -1
            : __left0.length > __right0.length ? 1 : 0;
    })();
    if (cmp0 === null) return null;
    if (cmp0 !== 0) return cmp0;
        return 0;
    });
}

export function scoresCompare(a: Scores, b: Scores): number {
    if (a === b) return 0;
    return __mf_comparedWithin(a, b, () => {
    const cmp0 = (() => {
	const __left0 = a.values;
