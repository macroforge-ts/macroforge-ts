/** @derive(PartialEq, Eq, PartialOrd, Ord) */
export class Version {
    major: number = 0;
    minor: number = 0;

    static equals(a: Version, b: Version): boolean {
        return versionEquals(a, b);
    }

    static partialCompare(a: Version, b: Version): number | null {
        return versionPartialCompare(a, b);
    }

    static compare(a: Version, b: Version): number {
        return versionCompare(a, b);
    }
}

export function versionEquals(a: Version, b: Version): boolean {
    if (a === b) return true;
    return a.major === b.major && a.minor === b.minor;
}

export function versionPartialCompare(a: Version, b: Version): number | null {
    if (a === b) return 0;
    const cmp0 = (a.major < b.major ? -1 : a.major > b.major ? 1 : a.major === b.major ? 0 : null);
    if (cmp0 === null) return null;
    if (cmp0 !== 0) return cmp0;
    const cmp1 = (a.minor < b.minor ? -1 : a.minor > b.minor ? 1 : a.minor === b.minor ? 0 : null);
    if (cmp1 === null) return null;
    if (cmp1 !== 0) return cmp1;
    return 0;
}

export function versionCompare(a: Version, b: Version): number {
    if (a === b) return 0;
    const cmp0 = a.major < b.major ? -1 : a.major > b.major ? 1 : 0;
    if (cmp0 !== 0) return cmp0;
    const cmp1 = a.minor < b.minor ? -1 : a.minor > b.minor ? 1 : 0;
    if (cmp1 !== 0) return cmp1;
    return 0;
}

