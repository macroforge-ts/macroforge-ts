/** @derive(Debug, Clone, PartialEq, Eq, Hash, PartialOrd, Ord, Default, Encode, Decode) */
export enum ShapeLevel {
    /** @default */
    Low = 'low',
    High = 'high'
}

export function shapeLevelToString(value: ShapeLevel): string {
    const key = ShapeLevel[value as unknown as keyof typeof ShapeLevel];
    if (key !== undefined) {
        return "ShapeLevel." + key;
    }
    return "ShapeLevel(" + String(value) + ")";
}

export function shapeLevelClone(value: ShapeLevel): ShapeLevel {
    return value;
}

export function shapeLevelEquals(a: ShapeLevel, b: ShapeLevel): boolean {
    return a === b;
}

export function shapeLevelHashCode(value: ShapeLevel): number {
    let hash = 0;
    for (let i = 0; i < value.length; i++) {
        hash = (hash * 31 + value.charCodeAt(i)) | 0;
    }
    return hash;
}

export function shapeLevelPartialCompare(a: ShapeLevel, b: ShapeLevel): number | null {
    if (typeof a === "string" && typeof b === "string") {
        return a.localeCompare(b);
    }
    return a === b ? 0 : null;
}

export function shapeLevelCompare(a: ShapeLevel, b: ShapeLevel): number {
    if (typeof a === "string" && typeof b === "string") {
        const cmp = a.localeCompare(b);
        return cmp < 0 ? -1 : cmp > 0 ? 1 : 0;
    }
    return 0;
}

