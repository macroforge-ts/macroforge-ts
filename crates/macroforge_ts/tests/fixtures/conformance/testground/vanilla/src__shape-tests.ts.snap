/** @derive(Debug, Clone, PartialEq, Eq, Hash, PartialOrd, Ord, Default, Encode, Decode) */
export interface ShapeItem {
    id: string;
    score: number;
}

export function shapeItemToString(value: ShapeItem): string {
    const parts: string[] = [];
    parts.push("id: " + String(value.id));
    parts.push("score: " + String(value.score));
    return "ShapeItem { " + parts.join(", ") + " }";
}

export function shapeItemClone(value: ShapeItem): ShapeItem {
    return ({
	id: value.id,
	score: value.score
});
}

export function shapeItemEquals(a: ShapeItem, b: ShapeItem): boolean {
    if (a === b) return true;
    return a.id === b.id && a.score === b.score;
}

export function shapeItemHashCode(value: ShapeItem): number {
    let hash = 17;
    hash = (hash * 31 + ((value.id ?? "").split("").reduce((h, c) => h * 31 + c.charCodeAt(0) | 0, 0))) | 0;
    hash = (hash * 31 + (Number.isInteger(value.score) ? value.score | 0 : value.score.toString().split("").reduce((h, c) => h * 31 + c.charCodeAt(0) | 0, 0))) | 0;
    return hash;
}

export function shapeItemPartialCompare(a: ShapeItem, b: ShapeItem): number | null {
    if (a === b) return 0;
    const cmp0 = (a.id < b.id ? -1 : a.id > b.id ? 1 : 0);
    if (cmp0 === null) return null;
    if (cmp0 !== 0) return cmp0;
    const cmp1 = (a.score < b.score ? -1 : a.score > b.score ? 1 : a.score === b.score ? 0 : null);
    if (cmp1 === null) return null;
    if (cmp1 !== 0) return cmp1;
    return 0;
}

export function shapeItemCompare(a: ShapeItem, b: ShapeItem): number {
    if (a === b) return 0;
    const cmp0 = a.id < b.id ? -1 : a.id > b.id ? 1 : 0;
    if (cmp0 !== 0) return cmp0;
    const cmp1 = a.score < b.score ? -1 : a.score > b.score ? 1 : 0;
    if (cmp1 !== 0) return cmp1;
    return 0;
}

export function shapeItemDefaultValue(): ShapeItem {
    return {
        id: "",
        score: 0,
    };
}

/** Encodes a value to a JSON string. @param value - The value to encode @param keepMetadata - If true, preserves __type and __id fields in the output @returns JSON string representation  */
export function shapeItemEncode(value: ShapeItem, keepMetadata?: boolean): string {
