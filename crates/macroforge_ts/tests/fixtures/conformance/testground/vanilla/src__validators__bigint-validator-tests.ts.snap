import { DecodeContext as __mf_DecodeContext, DecodeError as __mf_DecodeError, PendingRef as __mf_PendingRef } from "@macroforge/core/endec";
import type { DecodeOptions as __mf_DecodeOptions } from "@macroforge/core/endec";
/**
 * BigInt validator test classes for comprehensive decoder validation testing.
 */

// GreaterThanBigInt validator
/** @derive(Decode) */
export class GreaterThanBigIntValidator {
    /** @endec({ validate: ["greaterThanBigInt(0)"] }) */
    value: bigint;

    constructor(props: { value: bigint }) {
        this.value = props.value;
    }

    /** Decodes input to an instance of this class. Automatically detects whether input is a JSON string or object. @param input - JSON string or object to decode @param opts - Optional decoding options @returns Result containing the decoded instance or validation errors  */
    static decode(input: unknown, opts?: __mf_DecodeOptions): { success: true; value: GreaterThanBigIntValidator } | { success: false; errors: Array<{ field: string; message: string }> } {
        try {

            const data = typeof input === "string" ? JSON.parse(input) : input;

            const ctx = __mf_DecodeContext.create();
            const resultOrRef = GreaterThanBigIntValidator.decodeWithContext(data, ctx);

            if (__mf_PendingRef.is(resultOrRef)) {
                return ({
    	success: false,
    	errors: [{
    		field: "_root",
    		message: "GreaterThanBigIntValidator.decode: root cannot be a forward reference"
    	}]
    });
            }

            ctx.applyPatches();
            if (opts?.freeze) {
                ctx.freezeAll();
            }

            const __errors = ctx.getErrors();
            if (__errors.length > 0) {
                return ({
    	success: false,
    	errors: __errors
    });
            }

            return ({
    	success: true,
    	value: resultOrRef
    });
        } catch (e) {
            if (e instanceof __mf_DecodeError) {
                return ({
    	success: false,
    	errors: e.errors
    });
            }
            const message = e instanceof Error ? e.message : String(e);
            return ({
    	success: false,
    	errors: [{
    		field: "_root",
    		message
    	}]
    });
        }
    }

    /** Decodes with an existing context for nested/cyclic object graphs. @param value - The raw value to decode @param ctx - The decoding context  */
    static decodeWithContext(value: unknown, ctx: __mf_DecodeContext): GreaterThanBigIntValidator | __mf_PendingRef {
        if (typeof value === "object" && value !== null && "__ref" in value) {
            if (typeof value.__ref !== "number") {
                throw new __mf_DecodeError([{ field: "__ref", message: "GreaterThanBigIntValidator.decodeWithContext: __ref must be a number" }]);
            }
            return ctx.getOrDefer(value.__ref) as GreaterThanBigIntValidator | __mf_PendingRef;
        }

        if (typeof value !== "object" || value === null || Array.isArray(value)) {
            throw new __mf_DecodeError([{ field: "_root", message: "GreaterThanBigIntValidator.decodeWithContext: expected an object" }]);
        }

        const obj = value as Record<string, unknown>;
        const errors: Array<{ field: string; message: string }> = [];
        if (!("value" in obj)) {
            errors.push({ field: "value", message: "missing required field" });
        }

        const instance = Object.create(GreaterThanBigIntValidator.prototype) as GreaterThanBigIntValidator;

        if (obj.__id !== undefined) {
            ctx.register(obj.__id as number, instance);
        }

        ctx.trackForFreeze(instance);

        try {
            const __convertedVal = ((v) => BigInt(v as string))(obj["value"]);
            if (__convertedVal == null) { errors.push({ field: "value", message: "GreaterThanBigIntValidator.value is required" }); } else {
                if (__convertedVal <= 0n) { errors.push({ field: "value", message: "GreaterThanBigIntValidator.value must be greater than 0" }); }
            }
            instance.value = __convertedVal;
        } catch (__error) {
            errors.push({ field: "value", message: __error instanceof Error ? __error.message : String(__error) });
        }

        ctx.pushErrors(errors);

        return instance;
    }
    static validateField<K extends keyof GreaterThanBigIntValidator>(field: K, value: unknown): Array<{ field: string; message: string }> {
        const errors: Array<{ field: string; message: string }> = [];
        if (field === "value") {
            const __val = value as bigint;
            if (__val == null) { errors.push({ field: "value", message: "GreaterThanBigIntValidator.value is required" }); } else {
                if (__val <= 0n) { errors.push({ field: "value", message: "GreaterThanBigIntValidator.value must be greater than 0" }); }
            }
        }
        return errors;
    }

    static validateFields(partial: { readonly [K in keyof GreaterThanBigIntValidator]?: unknown }): Array<{ field: string; message: string }> {
        const errors: Array<{ field: string; message: string }> = [];
        if ("value" in partial && partial.value !== undefined) {
            const __val = partial.value as bigint;
            if (__val == null) { errors.push({ field: "value", message: "GreaterThanBigIntValidator.value is required" }); } else {
                if (__val <= 0n) { errors.push({ field: "value", message: "GreaterThanBigIntValidator.value must be greater than 0" }); }
            }
        }
        return errors;
    }

    static hasShape(obj: unknown): boolean {
        if (typeof obj !== "object" || obj === null || Array.isArray(obj)) {
            return false;
        }
        const o = obj as Record<string, unknown>;
        return "value" in o;
    }

    static is(obj: unknown): obj is GreaterThanBigIntValidator {
        if (obj instanceof GreaterThanBigIntValidator) {
            return true;
        }
        if (!GreaterThanBigIntValidator.hasShape(obj)) {
            return false;
        }
        const result = GreaterThanBigIntValidator.decode(obj);
        return result.success;
    }
}

/** Decodes input to an instance. Automatically detects whether input is a JSON string or object. @param input - JSON string or object to decode @param opts - Optional decoding options @returns Result containing the decoded instance or validation errors  */
export function greaterThanBigIntValidatorDecode(input: unknown, opts?: __mf_DecodeOptions): { success: true; value: GreaterThanBigIntValidator } | { success: false; errors: Array<{ field: string; message: string }> } {
    return GreaterThanBigIntValidator.decode(input, opts);
}

/** Decodes with an existing context for nested/cyclic object graphs. @param value - The raw value to decode @param ctx - The decoding context  */
export function greaterThanBigIntValidatorDecodeWithContext(value: unknown, ctx: __mf_DecodeContext): GreaterThanBigIntValidator | __mf_PendingRef {
    return GreaterThanBigIntValidator.decodeWithContext(value, ctx);
}

/** Type guard: checks if a value can be successfully decoded. @param value - The value to check @returns True if the value can be decoded to this type  */
export function greaterThanBigIntValidatorIs(value: unknown): value is GreaterThanBigIntValidator {
    return GreaterThanBigIntValidator.is(value);
}

