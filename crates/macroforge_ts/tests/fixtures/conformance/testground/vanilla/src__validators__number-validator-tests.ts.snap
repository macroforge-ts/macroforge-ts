import { DecodeContext as __mf_DecodeContext, DecodeError as __mf_DecodeError, PendingRef as __mf_PendingRef, isMultipleOf as __mf_isMultipleOf } from "@macroforge/core/endec";
import type { DecodeOptions as __mf_DecodeOptions } from "@macroforge/core/endec";
/**
 * Number validator test classes for comprehensive decoder validation testing.
 */

// GreaterThan validator
/** @derive(Decode) */
export class GreaterThanValidator {
    /** @endec({ validate: ["greaterThan(0)"] }) */
    positive: number;

    constructor(props: { positive: number }) {
        this.positive = props.positive;
    }

    /** Decodes input to an instance of this class. Automatically detects whether input is a JSON string or object. @param input - JSON string or object to decode @param opts - Optional decoding options @returns Result containing the decoded instance or validation errors  */
    static decode(input: unknown, opts?: __mf_DecodeOptions): { success: true; value: GreaterThanValidator } | { success: false; errors: Array<{ field: string; message: string }> } {
        try {

            const data = typeof input === "string" ? JSON.parse(input) : input;

            const ctx = __mf_DecodeContext.create();
            const resultOrRef = GreaterThanValidator.decodeWithContext(data, ctx);

            if (__mf_PendingRef.is(resultOrRef)) {
                return ({
    	success: false,
    	errors: [{
    		field: "_root",
    		message: "GreaterThanValidator.decode: root cannot be a forward reference"
    	}]
    });
            }

            ctx.applyPatches();
            if (opts?.freeze) {
                ctx.freezeAll();
            }

            const __errors = ctx.getErrors();
            if (__errors.length > 0) {
                return ({
    	success: false,
    	errors: __errors
    });
            }

            return ({
    	success: true,
    	value: resultOrRef
    });
        } catch (e) {
            if (e instanceof __mf_DecodeError) {
                return ({
    	success: false,
    	errors: e.errors
    });
            }
            const message = e instanceof Error ? e.message : String(e);
            return ({
    	success: false,
    	errors: [{
    		field: "_root",
    		message
    	}]
    });
        }
    }

    /** Decodes with an existing context for nested/cyclic object graphs. @param value - The raw value to decode @param ctx - The decoding context  */
    static decodeWithContext(value: unknown, ctx: __mf_DecodeContext): GreaterThanValidator | __mf_PendingRef {
        if (typeof value === "object" && value !== null && "__ref" in value) {
            if (typeof value.__ref !== "number") {
                throw new __mf_DecodeError([{ field: "__ref", message: "GreaterThanValidator.decodeWithContext: __ref must be a number" }]);
            }
            return ctx.getOrDefer(value.__ref) as GreaterThanValidator | __mf_PendingRef;
        }

        if (typeof value !== "object" || value === null || Array.isArray(value)) {
            throw new __mf_DecodeError([{ field: "_root", message: "GreaterThanValidator.decodeWithContext: expected an object" }]);
        }

        const obj = value as Record<string, unknown>;
        const errors: Array<{ field: string; message: string }> = [];
        if (!("positive" in obj)) {
            errors.push({ field: "positive", message: "missing required field" });
        }

        const instance = Object.create(GreaterThanValidator.prototype) as GreaterThanValidator;

        if (obj.__id !== undefined) {
            ctx.register(obj.__id as number, instance);
        }

        ctx.trackForFreeze(instance);

        {
            const __raw_positive = obj["positive"] as number;

            if (!(typeof __raw_positive === "number")) {
                errors.push({ field: "positive", message: __raw_positive == null ? "GreaterThanValidator.positive is required" : "expected number" });
            } else {
                if (__raw_positive == null) { errors.push({ field: "positive", message: "GreaterThanValidator.positive is required" }); } else {
                    if (__raw_positive <= 0) { errors.push({ field: "positive", message: "GreaterThanValidator.positive must be greater than 0" }); }
                }
                instance.positive = __raw_positive;
            }
        }

        ctx.pushErrors(errors);

        return instance;
    }
    static validateField<K extends keyof GreaterThanValidator>(field: K, value: unknown): Array<{ field: string; message: string }> {
        const errors: Array<{ field: string; message: string }> = [];
        if (field === "positive") {
            const __val = value as number;
            if (__val == null) { errors.push({ field: "positive", message: "GreaterThanValidator.positive is required" }); } else {
                if (__val <= 0) { errors.push({ field: "positive", message: "GreaterThanValidator.positive must be greater than 0" }); }
            }
        }
        return errors;
    }

    static validateFields(partial: { readonly [K in keyof GreaterThanValidator]?: unknown }): Array<{ field: string; message: string }> {
        const errors: Array<{ field: string; message: string }> = [];
        if ("positive" in partial && partial.positive !== undefined) {
            const __val = partial.positive as number;
            if (__val == null) { errors.push({ field: "positive", message: "GreaterThanValidator.positive is required" }); } else {
                if (__val <= 0) { errors.push({ field: "positive", message: "GreaterThanValidator.positive must be greater than 0" }); }
            }
        }
        return errors;
    }

    static hasShape(obj: unknown): boolean {
        if (typeof obj !== "object" || obj === null || Array.isArray(obj)) {
            return false;
        }
        const o = obj as Record<string, unknown>;
        return "positive" in o;
    }

    static is(obj: unknown): obj is GreaterThanValidator {
        if (obj instanceof GreaterThanValidator) {
            return true;
        }
        if (!GreaterThanValidator.hasShape(obj)) {
            return false;
        }
        const result = GreaterThanValidator.decode(obj);
        return result.success;
    }
}

/** Decodes input to an instance. Automatically detects whether input is a JSON string or object. @param input - JSON string or object to decode @param opts - Optional decoding options @returns Result containing the decoded instance or validation errors  */
export function greaterThanValidatorDecode(input: unknown, opts?: __mf_DecodeOptions): { success: true; value: GreaterThanValidator } | { success: false; errors: Array<{ field: string; message: string }> } {
    return GreaterThanValidator.decode(input, opts);
}

