    const errors: Array<{ field: string; message: string }> = [];
    if (!("stops" in obj)) {
        errors.push({ field: "stops", message: "missing required field" });
    }
    if (!("named" in obj)) {
        errors.push({ field: "named", message: "missing required field" });
    }

    const instance: any = {};

    if (obj.__id !== undefined) {
        ctx.register(obj.__id as number, instance);
    }

