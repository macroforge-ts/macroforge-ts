                    for (const __err of __elemResult.errors) {
                        errors.push({
                            field: __err.field === "_root"
                                ? "stops[" + idx + "]"
                                : "stops[" + idx + "]." + __err.field,
                            message: __err.message
                        });
                    }
                }
                return __elemResult.success ? __elemResult.value : item;
            });
            instance.stops = __arr;
            __arr.forEach((item, idx) => {
                if (item && typeof item === "object" && "__pendingIdx" in item) {
                    ctx.addPatch(instance.stops, idx, (item as any).__refId);
                }
            });
        }
    }
    {
        const __raw_named = obj["named"] as Record<string, Point>;

        if (typeof __raw_named === "object" && __raw_named !== null) {
            instance.named = Object.fromEntries(
                Object.entries(__raw_named).map(([k, v]) => {
                    const __vResult = pointDecode(v);
                    if (!__vResult.success) {
                        for (const __err of __vResult.errors) {
                            errors.push({
                                field: __err.field === "_root"
                                    ? "named." + k
                                    : "named." + k + "." + __err.field,
                                message: __err.message
