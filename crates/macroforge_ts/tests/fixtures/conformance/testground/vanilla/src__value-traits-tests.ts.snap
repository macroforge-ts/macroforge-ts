        }
        return ctx.getOrDefer(value.__ref, "Keyed") as Keyed<K> | __mf_PendingRef;
    }

    if (typeof value !== "object" || value === null || Array.isArray(value)) {
        throw new __mf_DecodeError([{ field: "_root", message: "Keyed.decodeWithContext: expected an object" }]);
    }

    const obj = value as Record<string, unknown>;
    const errors: Array<{ field: string; message: string }> = [];
    if ((__fields === undefined || __fields.requires("key")) && !("key" in obj)) {
        errors.push({ field: "key", message: "missing required field" });
    }
    if ((__fields === undefined || __fields.requires("rank")) && !("rank" in obj)) {
        errors.push({ field: "rank", message: "missing required field" });
