    		message: "Ledger.decode: root cannot be a forward reference"
    	}]
    });
            }

            ctx.applyPatches();
            if (opts?.freeze) {
                ctx.freezeAll();
            }

            const __errors = ctx.getErrors();
            if (__errors.length > 0) {
                return ({
    	success: false,
    	errors: __errors
    });
            }

            return ({
    	success: true,
    	value: resultOrRef
    });
        } catch (e) {
            if (e instanceof __mf_DecodeError) {
                return ({
    	success: false,
    	errors: e.errors
    });
            }
            const message = e instanceof Error ? e.message : String(e);
            return ({
    	success: false,
    	errors: [{
    		field: "_root",
    		message
    	}]
    });
        }
    }

    /** Decodes with an existing context for nested/cyclic object graphs. @param value - The raw value to decode @param ctx - The decoding context  */
    static decodeWithContext(value: unknown, ctx: __mf_DecodeContext): Ledger | __mf_PendingRef {
        if (typeof value === "object" && value !== null && "__ref" in value) {
            if (typeof value.__ref !== "number") {
                throw new __mf_DecodeError([{ field: "__ref", message: "Ledger.decodeWithContext: __ref must be a number" }]);
            }
            return ctx.getOrDefer(value.__ref) as Ledger | __mf_PendingRef;
        }

        if (typeof value !== "object" || value === null || Array.isArray(value)) {
            throw new __mf_DecodeError([{ field: "_root", message: "Ledger.decodeWithContext: expected an object" }]);
        }

        const obj = value as Record<string, unknown>;
        const errors: Array<{ field: string; message: string }> = [];
        if (!("entries" in obj)) {
            errors.push({ field: "entries", message: "missing required field" });
        }

        const instance = Object.create(Ledger.prototype) as Ledger;

        if (obj.__id !== undefined) {
            ctx.register(obj.__id as number, instance);
        }

        ctx.trackForFreeze(instance);

        {
            const __raw_entries = obj["entries"] as Record<string, number>;

            if (typeof __raw_entries === "object" && __raw_entries !== null) {
                instance.entries = new Map(
                    Object.entries(__raw_entries).map(([k, v]) => [k as string, v as number])
                );
            }
        }

        ctx.pushErrors(errors);

        return instance;
    }
    static validateField<K extends keyof Ledger>(field: K, value: unknown): Array<{ field: string; message: string }>;
    static validateField(): Array<{ field: string; message: string }> {
        return [];
    }

    static validateFields(partial: { readonly [K in keyof Ledger]?: unknown }): Array<{ field: string; message: string }>;
    static validateFields(): Array<{ field: string; message: string }> {
        return [];
    }

    static hasShape(obj: unknown): boolean {
        if (typeof obj !== "object" || obj === null || Array.isArray(obj)) {
            return false;
        }
        const o = obj as Record<string, unknown>;
        return "entries" in o;
    }

    static is(obj: unknown): obj is Ledger {
        if (obj instanceof Ledger) {
            return true;
        }
        if (!Ledger.hasShape(obj)) {
            return false;
        }
        const result = Ledger.decode(obj);
        return result.success;
