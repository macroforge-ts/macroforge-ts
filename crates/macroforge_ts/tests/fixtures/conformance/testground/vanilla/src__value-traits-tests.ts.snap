import { structuralEquals as __mf_structuralEquals, structuralHash as __mf_structuralHash, structuralClone as __mf_structuralClone, structuralDebug as __mf_structuralDebug, structuralCompare as __mf_structuralCompare } from "@macroforge/core/structural";
import { EncodeContext as __mf_EncodeContext, DecodeContext as __mf_DecodeContext, DecodeError as __mf_DecodeError, PendingRef as __mf_PendingRef, derivedEncoder as __mf_derivedEncoder } from "@macroforge/core/endec";
import type { DecodeOptions as __mf_DecodeOptions } from "@macroforge/core/endec";
/**
 * PartialEq, Hash and Clone over built-in, collection, optional, union and
 * tuple types. The three must agree: a clone equals its source, and equal
 * values hash the same.
 */

/** @derive(PartialEq, Hash, Clone) */
export interface Timeline {
    events: Date[];
    labels: Map<string, Date>;
    started?: Date;
    note: string | null;
}

export function timelineEquals(a: Timeline, b: Timeline): boolean {
    if (a === b) return true;
    return a.events.length === b.events.length && a.events.every((__item0, __index0) => {
	const __other0 = b.events[__index0];
	return __other0 === undefined ? __item0 === undefined : __item0.getTime() === __other0.getTime();
}) && a.labels.size === b.labels.size && Array.from(a.labels).every(([__key0, __item0]) => {
	const __other0 = b.labels.get(__key0);
	return b.labels.has(__key0) && (__other0 === undefined ? __item0 === undefined : __item0.getTime() === __other0.getTime());
}) && (a.started == null || b.started == null ? a.started === b.started : a.started.getTime() === b.started.getTime()) && a.note === b.note;
}

export function timelineHashCode(value: Timeline): number {
    let hash = 17;
    hash = (hash * 31 + (value.events.reduce((__hash0, __item0) => __hash0 * 31 + (__item0.getTime() | 0) | 0, 1))) | 0;
    hash = (hash * 31 + (Array.from(value.labels).reduce((__hash0, [__key0, __item0]) => __hash0 + ((__key0 ?? "").split("").reduce((h, c) => h * 31 + c.charCodeAt(0) | 0, 0) * 31 + (__item0.getTime() | 0) | 0) | 0, 0))) | 0;
    hash = (hash * 31 + (value.started == null ? 0 : value.started.getTime() | 0)) | 0;
    hash = (hash * 31 + (value.note == null ? 0 : (value.note ?? "").split("").reduce((h, c) => h * 31 + c.charCodeAt(0) | 0, 0))) | 0;
    return hash;
}

export function timelineClone(value: Timeline): Timeline {
    return ({
	events: value.events.map((__item0) => new Date(__item0.getTime())),
	labels: (() => {
		const __copy0 = new Map(value.labels);
		for (const [__key0, __item0] of value.labels) __copy0.set(__key0, new Date(__item0.getTime()));
		return __copy0;
	})(),
	..."started" in value ? { started: value.started == null ? value.started : new Date(value.started.getTime()) } : {},
	note: value.note
});
}

export const Timeline: {
  readonly equals: typeof timelineEquals;
  readonly hashCode: typeof timelineHashCode;
  readonly clone: typeof timelineClone;
} = {
  equals: timelineEquals,
  hashCode: timelineHashCode,
  clone: timelineClone
};

/** @derive(PartialEq, Hash, Clone) */
export class Badge {
    label: string = '';

    static equals(a: Badge, b: Badge): boolean {
        return badgeEquals(a, b);
    }

    static hashCode(value: Badge): number {
        return badgeHashCode(value);
    }

    static clone(value: Badge): Badge {
        return badgeClone(value);
    }
}

export function badgeEquals(a: Badge, b: Badge): boolean {
    if (a === b) return true;
    return a.label === b.label;
}

export function badgeHashCode(value: Badge): number {
    let hash = 17;
    hash = (hash * 31 + ((value.label ?? "").split("").reduce((h, c) => h * 31 + c.charCodeAt(0) | 0, 0))) | 0;
    return hash;
}

export function badgeClone(value: Badge): Badge {
    const cloned = Object.create(Object.getPrototypeOf(value));
    cloned.label = value.label;
    return cloned;
}

/** @derive(PartialEq, Hash, Clone) */
export interface Wall {
    badges: Set<Badge>;
    pinned: unknown;
}

export function wallEquals(a: Wall, b: Wall): boolean {
    if (a === b) return true;
    return a.badges.size === b.badges.size && Array.from(a.badges).every((__item0) => b.badges.has(__item0) || Array.from(b.badges).some((__other0) => badgeEquals(__item0, __other0))) && __mf_structuralEquals(a.pinned, b.pinned);
}

export function wallHashCode(value: Wall): number {
    let hash = 17;
    hash = (hash * 31 + (Array.from(value.badges).reduce((__hash0, __item0) => __hash0 + badgeHashCode(__item0) | 0, 0))) | 0;
    hash = (hash * 31 + (__mf_structuralHash(value.pinned))) | 0;
    return hash;
}

export function wallClone(value: Wall): Wall {
    return ({
	badges: new Set(Array.from(value.badges, (__item0) => badgeClone(__item0))),
	pinned: __mf_structuralClone(value.pinned)
});
}

export const Wall: {
  readonly equals: typeof wallEquals;
  readonly hashCode: typeof wallHashCode;
  readonly clone: typeof wallClone;
} = {
  equals: wallEquals,
  hashCode: wallHashCode,
  clone: wallClone
};

/** @derive(PartialEq, Hash, Clone) */
export type Shape =
    | { kind: 'circle'; radius: number }
    | { kind: 'square'; side: number; at: Date };

export function shapeEquals(a: Shape, b: Shape): boolean {
