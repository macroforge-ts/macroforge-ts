/** Decodes with an existing context for nested/cyclic object graphs. @param value - The raw value to decode @param ctx - The decoding context  */
export function ledgerPairDecodeWithContext(value: unknown, ctx: __mf_DecodeContext): LedgerPair {
    if (typeof value === "object" && value !== null && "__ref" in value) {
        if (typeof value.__ref !== "number") {
            throw new __mf_DecodeError([{ field: "__ref", message: "LedgerPair.decodeWithContext: __ref must be a number" }]);
        }
        return ctx.getOrDefer(value.__ref) as LedgerPair;
    }
    if (!Array.isArray(value)) {
        throw new __mf_DecodeError([{ field: "_root", message: "LedgerPair.decodeWithContext: expected an array" }]);
    }
    const errors: Array<{ field: string; message: string }> = [];
    if (value.length <= 0) {
        errors.push({ field: "0", message: "missing required element" });
    }
    if (value.length <= 1) {
        errors.push({ field: "1", message: "missing required element" });
    }
    if (value.length > 2) {
        errors.push({ field: "_root", message: "too many elements" });
    }
    const obj: Record<string, unknown> = {};
    for (let __index = 0; __index < Math.min(value.length, 2); __index++) {
        obj[__index] = value[__index];
    }

    const tuple: unknown[] = [];
    const instance: any = {};
    Object.defineProperty(instance, "e0", {
        get: () => tuple[0],
        set: (item: unknown) => {
            tuple[0] = item;
        }
    });
    Object.defineProperty(instance, "e1", {
        get: () => tuple[1],
        set: (item: unknown) => {
            tuple[1] = item;
        }
    });
    ctx.trackForFreeze(tuple);

    {
        const __raw_e0 = obj["0"] as Ledger;

        ctx.pushScope("0");
        try {
            const __result = ledgerDecodeWithContext(__raw_e0, ctx);
            ctx.assignOrDefer(instance, "e0", __result);
        } catch (__e) {
            if (__e instanceof __mf_DecodeError) {
                for (const __err of __e.errors) {
                    errors.push({
                        field: __err.field === "_root" ? "0" : "0." + __err.field,
                        message: __err.message
                    });
                }
            } else {
                throw __e;
            }
        } finally {
            ctx.popScope();
        }
    }
    {
        const __raw_e1 = obj["1"] as Ledger;

        ctx.pushScope("1");
        try {
            const __result = ledgerDecodeWithContext(__raw_e1, ctx);
            ctx.assignOrDefer(instance, "e1", __result);
        } catch (__e) {
            if (__e instanceof __mf_DecodeError) {
                for (const __err of __e.errors) {
                    errors.push({
                        field: __err.field === "_root" ? "1" : "1." + __err.field,
                        message: __err.message
                    });
                }
            } else {
                throw __e;
            }
        } finally {
            ctx.popScope();
        }
    }

    ctx.pushErrors(errors);
    return tuple as LedgerPair;
}

export function ledgerPairHasShape(value: unknown): boolean {
    return Array.isArray(value) && value.length >= 2 && value.length <= 2;
}

