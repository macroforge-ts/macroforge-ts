};

/** @derive(PartialEq, Hash, Clone) */
export type Moment = [label: string, at: Date];

export function momentEquals(a: Moment, b: Moment): boolean {
    if (a === b) return true;
    return a[0] === b[0] && a[1].getTime() === b[1].getTime();
}

export function momentHashCode(value: Moment): number {
    return (1 * 31 + (value[0] ?? "").split("").reduce((h, c) => h * 31 + c.charCodeAt(0) | 0, 0) | 0) * 31 + (value[1].getTime() | 0) | 0;
}

export function momentClone(value: Moment): Moment {
    return [value[0], new Date(value[1].getTime())];
}

export const Moment: {
  readonly equals: typeof momentEquals;
  readonly hashCode: typeof momentHashCode;
  readonly clone: typeof momentClone;
} = {
  equals: momentEquals,
  hashCode: momentHashCode,
  clone: momentClone
};

