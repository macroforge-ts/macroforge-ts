export function ledgerPairEncodeWithContext(value: LedgerPair, ctx: __mf_EncodeContext): unknown {
    const __view: { e0: Ledger; e1: Ledger } = {
        e0: value[0],
        e1: value[1],
    };
    return ((value: { e0: Ledger; e1: Ledger }): unknown[] => {
        const result: Record<string, unknown> = {};

        result.e0 = ledgerEncodeWithContext(value.e0, ctx);
        result.e1 = ledgerEncodeWithContext(value.e1, ctx);
        const __tuple: unknown[] = [];
        if ("e0" in result) {
            __tuple.push(result.e0);
        }
        if ("e1" in result) {
            __tuple.push(result.e1);
        }
        return __tuple;
    })(__view);
