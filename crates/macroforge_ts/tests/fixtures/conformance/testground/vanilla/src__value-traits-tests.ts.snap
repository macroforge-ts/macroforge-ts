export function mainLedgerEncodeWithContext(value: MainLedger, ctx: __mf_EncodeContext): unknown {
    return ((value: { value: Ledger }): unknown => {
        const result: Record<string, unknown> = {};

        result.value = ledgerEncodeWithContext(value.value, ctx);
        return result.value;
    })({ value });
}

