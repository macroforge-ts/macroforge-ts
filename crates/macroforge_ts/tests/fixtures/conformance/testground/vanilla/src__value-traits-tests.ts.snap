export function keyedDecodeWithContext<K extends string>(value: unknown, ctx: __mf_DecodeContext, fields: __mf_FieldRequirement): Partial<Keyed<K>> | __mf_PendingRef;
export function keyedDecodeWithContext<K extends string>(value: unknown, ctx: __mf_DecodeContext, __fields?: __mf_FieldRequirement): Partial<Keyed<K>> | __mf_PendingRef {
