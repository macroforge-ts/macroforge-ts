        const ctx = __mf_DecodeContext.create();
        const result = mainLedgerDecodeWithContext(data, ctx);
        ctx.applyPatches();
        if (opts?.freeze) {
            ctx.freezeAll();
        }

        const __errors = ctx.getErrors();
        if (__errors.length > 0) {
            return ({
	success: false,
	errors: __errors
});
        }

        return ({
	success: true,
	value: result
});
    } catch (e) {
        if (e instanceof __mf_DecodeError) {
            return ({
	success: false,
	errors: e.errors
});
        }
        const message = e instanceof Error ? e.message : String(e);
        return ({
	success: false,
	errors: [{
		field: "_root",
		message
	}]
});
    }
}

export function mainLedgerIs(value: unknown): value is MainLedger {
    return mainLedgerHasShape(value);
}
/** Decodes with an existing context for nested/cyclic object graphs. @param value - The raw value to decode @param ctx - The decoding context  */
export function mainLedgerDecodeWithContext(value: unknown, ctx: __mf_DecodeContext): MainLedger {
    if (typeof value === "object" && value !== null && "__ref" in value) {
        if (typeof value.__ref !== "number") {
            throw new __mf_DecodeError([{ field: "__ref", message: "MainLedger.decodeWithContext: __ref must be a number" }]);
        }
        return ctx.getOrDefer(value.__ref) as MainLedger;
    }
    const obj: Record<string, unknown> = { _root: value };
    const errors: Array<{ field: string; message: string }> = [];
    const instance: any = {};

    {
        const __raw__root = obj["_root"] as Ledger;

        ctx.pushScope("_root");
        try {
            const __result = ledgerDecodeWithContext(__raw__root, ctx);
            ctx.assignOrDefer(instance, "_root", __result);
        } catch (__e) {
            if (__e instanceof __mf_DecodeError) {
                for (const __err of __e.errors) {
                    errors.push({
                        field: __err.field === "_root" ? "_root" : "_root." + __err.field,
                        message: __err.message
                    });
                }
            } else {
                throw __e;
            }
        } finally {
            ctx.popScope();
        }
    }

    ctx.pushErrors(errors);
    return instance._root as MainLedger;
}

export function mainLedgerHasShape(value: unknown): boolean {
