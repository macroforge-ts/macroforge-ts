export function keyedCompare<K extends string>(a: Keyed<K>, b: Keyed<K>): number {
    if (a === b) return 0;
    const cmp0 = __mf_structuralCompare(a.key, b.key);
    if (cmp0 !== 0) return cmp0;
    const cmp1 = a.rank < b.rank ? -1 : a.rank > b.rank ? 1 : 0;
