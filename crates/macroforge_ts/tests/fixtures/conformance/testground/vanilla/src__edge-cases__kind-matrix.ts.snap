import { debuggedWithin as __mf_debuggedWithin, equalWithin as __mf_equalWithin, comparedWithin as __mf_comparedWithin, hashedWithin as __mf_hashedWithin, clonedWith as __mf_clonedWith } from "@macroforge/core/structural";
/**
 * Each built-in derive on the kinds of declaration no other edge case derives
 * it on: Default on an enum, the orderings on an object alias, and the value
 * traits on an intersection alias.
 */

/** @derive(Default) */
export enum KindShade {
    Dark = 'dark',
    /** @default */
    Light = 'light'
}

export function kindShadeDefaultValue(): KindShade {
    return KindShade.Light;
}

export namespace KindShade {
  export const defaultValue: typeof kindShadeDefaultValue = kindShadeDefaultValue;
}

/** @derive(Debug, PartialEq, Eq, PartialOrd, Ord, Hash) */
export type KindPoint = { x: number; y: number };

export function kindPointToString(value: KindPoint): string {
    return __mf_debuggedWithin(value, () => {
        const parts: string[] = [];
    parts.push("x: " + String(value.x));
    parts.push("y: " + String(value.y));
        return "KindPoint { " + parts.join(", ") + " }";
    });
}

export function kindPointEquals(a: KindPoint, b: KindPoint): boolean {
    if (a === b) return true;
    return __mf_equalWithin(a, b, () => {
    return [
        () => a.x === b.x || a.x !== a.x && b.x !== b.x,
        () => a.y === b.y || a.y !== a.y && b.y !== b.y,
    ].every((same) => same());
});
}

export function kindPointPartialCompare(a: KindPoint, b: KindPoint): number | null {
    if (a === b) return 0;
    return __mf_comparedWithin(a, b, () => {
    for (const __order of [
        () => (a.x < b.x ? -1 : a.x > b.x ? 1 : a.x === b.x || (a.x !== a.x && b.x !== b.x) ? 0 : null),
        () => (a.y < b.y ? -1 : a.y > b.y ? 1 : a.y === b.y || (a.y !== a.y && b.y !== b.y) ? 0 : null),
    ]) {
        const __result = __order();
        if (__result !== 0) return __result;
    }
    return 0;
    });
}

export function kindPointCompare(a: KindPoint, b: KindPoint): number {
    if (a === b) return 0;
    return __mf_comparedWithin(a, b, () => {
    for (const __order of [
        () => a.x < b.x ? -1 : a.x > b.x ? 1 : a.x === b.x ? 0 : a.x !== a.x ? b.x !== b.x ? 0 : 1 : -1,
        () => a.y < b.y ? -1 : a.y > b.y ? 1 : a.y === b.y ? 0 : a.y !== a.y ? b.y !== b.y ? 0 : 1 : -1,
    ]) {
        const __result = __order();
        if (__result !== 0) return __result;
    }
    return 0;
    });
}

export function kindPointHashCode(value: KindPoint): number {
    return __mf_hashedWithin(value, () => {
        let hash = 17;
    hash = (hash * 31 + (Number.isInteger(value.x) ? value.x | 0 : value.x.toString().split("").reduce<number>((h, c) => h * 31 + c.charCodeAt(0) | 0, 0))) | 0;
    hash = (hash * 31 + (Number.isInteger(value.y) ? value.y | 0 : value.y.toString().split("").reduce<number>((h, c) => h * 31 + c.charCodeAt(0) | 0, 0))) | 0;
        return hash;
    });
}

export const KindPoint: {
  readonly toString: typeof kindPointToString;
  readonly equals: typeof kindPointEquals;
  readonly partialCompare: typeof kindPointPartialCompare;
  readonly compare: typeof kindPointCompare;
  readonly hashCode: typeof kindPointHashCode;
} = {
  toString: kindPointToString,
  equals: kindPointEquals,
  partialCompare: kindPointPartialCompare,
  compare: kindPointCompare,
  hashCode: kindPointHashCode
};

/** @derive(Debug, Clone, PartialEq, Hash) */
export interface KindNamed {
    name: string;
}

export function kindNamedToString(value: KindNamed): string {
    return __mf_debuggedWithin(value, () => {
        const parts: string[] = [];
    parts.push("name: " + String(value.name));
        return "KindNamed { " + parts.join(", ") + " }";
    });
}

export function kindNamedClone(value: KindNamed): KindNamed {
    return __mf_clonedWith(value, (): KindNamed => ({ name: value.name }));
}

export function kindNamedEquals(a: KindNamed, b: KindNamed): boolean {
    if (a === b) return true;
    return __mf_equalWithin(a, b, () => {
        return a.name === b.name;
    });
}

export function kindNamedHashCode(value: KindNamed): number {
    return __mf_hashedWithin(value, () => {
        let hash = 17;
    hash = (hash * 31 + ((value.name ?? "").split("").reduce<number>((h, c) => h * 31 + c.charCodeAt(0) | 0, 0))) | 0;
        return hash;
    });
}

export const KindNamed: {
