import { structuralDebug as __mf_structuralDebug, debuggedWithin as __mf_debuggedWithin, clonedWith as __mf_clonedWith } from "@macroforge/core/structural";
/** @derive(Debug, Clone) */
export class Store {
    items: string[];
    count: number;

    constructor(items: string[], count: number) {
        this.items = items;
        this.count = count;
    }

    static toString(value: Store): string {
        return __mf_debuggedWithin(value, () => {
            const parts: string[] = [];
        parts.push("items: " + __mf_structuralDebug(value.items));
        parts.push("count: " + String(value.count));
            return "Store { " + parts.join(", ") + " }";
        });
    }

    static clone(value: Store): Store {
        return __mf_clonedWith(value, () => ({
        	items: [...value.items],
        	count: value.count
        }));
    }
}

export function storeToString(value: Store): string {
    return Store.toString(value);
}

export function storeClone(value: Store): Store {
    return Store.clone(value);
}

