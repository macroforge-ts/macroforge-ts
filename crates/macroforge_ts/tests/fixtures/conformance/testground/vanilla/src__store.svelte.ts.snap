import { structuralDebug as __mf_structuralDebug } from "@macroforge/core/structural";
/** @derive(Debug, Clone) */
export class Store {
    items: string[];
    count: number;

    constructor(items: string[], count: number) {
        this.items = items;
        this.count = count;
    }

    static toString(value: Store): string {
        return storeToString(value);
    }

    static clone(value: Store): Store {
        return storeClone(value);
    }
}

export function storeToString(value: Store): string {
    const parts: string[] = [];
    parts.push("items: " + __mf_structuralDebug(value.items));
    parts.push("count: " + String(value.count));
    return "Store { " + parts.join(", ") + " }";
}

export function storeClone(value: Store): Store {
    const cloned = Object.create(Object.getPrototypeOf(value));
    cloned.items = [...value.items];
    cloned.count = value.count;
    return cloned;
}

