/** @derive(Decode) */
export type Contact = /** @endec(email) */ string | number;

/** Decodes input to this type. @param input - Value to decode @param opts - Optional decoding options @returns Result containing the decoded value or validation errors  */
export function contactDecode(input: unknown, opts?: __mf_DecodeOptions): { success: true; value: Contact } | { success: false; errors: Array<{ field: string; message: string }> } {
    try {
        const data = input;

        const ctx = __mf_DecodeContext.create();
        const resultOrRef = contactDecodeWithContext(data, ctx);

        if (__mf_PendingRef.is(resultOrRef)) {
            return ({
	success: false,
	errors: [{
		field: "_root",
		message: "Contact.decode: root cannot be a forward reference"
	}]
});
        }

        ctx.applyPatches();
        if (opts?.freeze) {
            ctx.freezeAll();
        }

        const __errors = ctx.getErrors();
        if (__errors.length > 0) {
            return ({
	success: false,
	errors: __errors
});
        }

        return ({
	success: true,
	value: resultOrRef
});
    } catch (e) {
        if (e instanceof __mf_DecodeError) {
            return ({
	success: false,
	errors: e.errors
});
        }
        const message = e instanceof Error ? e.message : String(e);
        return ({
	success: false,
	errors: [{
		field: "_root",
		message
	}]
});
    }
}
/** Decodes with an existing context for nested/cyclic object graphs. @param value - The raw value to decode @param ctx - The decoding context  */
export function contactDecodeWithContext(value: unknown, ctx: __mf_DecodeContext): Contact | __mf_PendingRef {
    if (typeof value === "object" && value !== null && "__ref" in value) {
        if (typeof value.__ref !== "number") {
            throw new __mf_DecodeError([{ field: "__ref", message: "Contact.decodeWithContext: __ref must be a number" }]);
        }
        return ctx.getOrDefer(value.__ref) as Contact | __mf_PendingRef;
    }

    
    if (typeof value === "string") {
        const errors: Array<{ field: string; message: string }> = [];
        if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value)) { errors.push({ field: "_root", message: "Contact must be a valid email" }); }
        ctx.pushErrors(errors);
        return value as Contact;
    }
    if (typeof value === "number") {
        return value as Contact;
    }

    throw new __mf_DecodeError([{
        field: "_root",
        message: "Contact.decodeWithContext: expected string, number, got " + typeof value
    }]);
}
export function contactHasShape(value: unknown): boolean {
                return typeof value === "string" || typeof value === "number";
}
export function contactIs(value: unknown): value is Contact {
    return contactHasShape(value) && contactDecode(value).success;
}

