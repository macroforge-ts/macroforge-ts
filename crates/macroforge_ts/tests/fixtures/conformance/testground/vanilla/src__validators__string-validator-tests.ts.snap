import { DecodeContext as __mf_DecodeContext, DecodeError as __mf_DecodeError, PendingRef as __mf_PendingRef, fieldRequirement as __mf_fieldRequirement } from "@macroforge/core/endec";
import type { DecodeOptions as __mf_DecodeOptions, FieldSelection as __mf_FieldSelection, FieldRequirement as __mf_FieldRequirement } from "@macroforge/core/endec";
/**
 * String validator test classes for comprehensive decoder validation testing.
 * Each class tests a single validator for isolation.
 */

// Email validator
/** @derive(Decode) */
export class EmailValidator {
    /** @endec({ validate: ["email"] }) */
    email: string;

constructor(props: { email: string }) {
    this.email = props.email;
}

/** Decodes input to an instance of this class. Automatically detects whether input is a JSON string or object. @param input - JSON string or object to decode @param opts - Optional decoding options @returns Result containing the decoded instance or validation errors  */
static decode(input: unknown, opts?: __mf_DecodeOptions): { success: true; value: EmailValidator } | { success: false; errors: Array<{ field: string; message: string }> } {
    try {

        const data = typeof input === "string" ? JSON.parse(input) : input;

        const ctx = __mf_DecodeContext.create();
        const resultOrRef = EmailValidator.decodeWithContext(data, ctx);

        if (__mf_PendingRef.is(resultOrRef)) {
            return ({
	success: false,
	errors: [{
		field: "_root",
		message: "EmailValidator.decode: root cannot be a forward reference"
	}]
});
        }

        ctx.applyPatches();
        if (opts?.freeze) {
            ctx.freezeAll();
        }

        const __errors = ctx.getErrors();
        if (__errors.length > 0) {
            return ({
	success: false,
	errors: __errors
});
        }

        return ({
	success: true,
	value: resultOrRef
});
    } catch (e) {
        if (e instanceof __mf_DecodeError) {
            return ({
	success: false,
	errors: e.errors
});
        }
        const message = e instanceof Error ? e.message : String(e);
        return ({
	success: false,
	errors: [{
		field: "_root",
		message
	}]
});
    }
}

/** Decodes with an existing context for nested/cyclic object graphs. @param value - The raw value to decode @param ctx - The decoding context  */
static decodeWithContext(value: unknown, ctx: __mf_DecodeContext): EmailValidator | __mf_PendingRef;
/** Decodes the fields `fields` keeps, and no other. @param value - The raw value to decode @param ctx - The decoding context @param fields - Which fields the value has and has to have  */
static decodeWithContext(value: unknown, ctx: __mf_DecodeContext, fields: __mf_FieldRequirement): Partial<EmailValidator> | __mf_PendingRef;
static decodeWithContext(value: unknown, ctx: __mf_DecodeContext, __fields?: __mf_FieldRequirement): Partial<EmailValidator> | __mf_PendingRef {
    if (__fields !== undefined && typeof value === "object" && value !== null && "__ref" in value) {
        throw new __mf_DecodeError([{ field: "_root", message: "EmailValidator.decodeWithContext: a value holding a selection of fields cannot be a reference" }]);
    }
    if (typeof value === "object" && value !== null && "__ref" in value) {
        if (typeof value.__ref !== "number") {
            throw new __mf_DecodeError([{ field: "__ref", message: "EmailValidator.decodeWithContext: __ref must be a number" }]);
        }
        return ctx.getOrDefer(value.__ref) as EmailValidator | __mf_PendingRef;
    }

    if (typeof value !== "object" || value === null || Array.isArray(value)) {
        throw new __mf_DecodeError([{ field: "_root", message: "EmailValidator.decodeWithContext: expected an object" }]);
    }

    const obj = value as Record<string, unknown>;
    const errors: Array<{ field: string; message: string }> = [];
    if ((__fields === undefined || __fields.requires("email")) && !("email" in obj)) {
        errors.push({ field: "email", message: "missing required field" });
    }
    const instance = Object.create(EmailValidator.prototype) as EmailValidator;

    if (__fields === undefined && obj.__id !== undefined) {
        ctx.register(obj.__id as number, instance);
    }

    ctx.trackForFreeze(instance);

    if ((__fields === undefined || __fields.requires("email")) || (__fields.keeps("email") && obj["email"] !== undefined)) {
        const __raw_email = obj["email"] as string;

        if (!(typeof __raw_email === "string")) {
            errors.push({ field: "email", message: __raw_email == null ? "EmailValidator.email is required" : "expected string" });
        } else {
            if (__raw_email == null) { errors.push({ field: "email", message: "EmailValidator.email is required" }); } else {
                if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(__raw_email)) { errors.push({ field: "email", message: "EmailValidator.email must be a valid email" }); }
            }
            instance.email = __raw_email;
        }
    }

    ctx.pushErrors(errors);

    return instance;
}
static validateField<K extends keyof EmailValidator>(field: K, value: unknown): Array<{ field: string; message: string }> {
    const errors: Array<{ field: string; message: string }> = [];
    if (field === "email") {
        const __val = value as string;
        if (__val == null) { errors.push({ field: "email", message: "EmailValidator.email is required" }); } else {
            if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(__val)) { errors.push({ field: "email", message: "EmailValidator.email must be a valid email" }); }
        }
    }
    return errors;
}

static validateFields(partial: { readonly [K in keyof EmailValidator]?: unknown }): Array<{ field: string; message: string }> {
    const errors: Array<{ field: string; message: string }> = [];
    if ("email" in partial && partial.email !== undefined) {
        const __val = partial.email as string;
        if (__val == null) { errors.push({ field: "email", message: "EmailValidator.email is required" }); } else {
            if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(__val)) { errors.push({ field: "email", message: "EmailValidator.email must be a valid email" }); }
        }
    }
    return errors;
}

static hasShape(obj: unknown): boolean {
    if (typeof obj !== "object" || obj === null || Array.isArray(obj)) {
        return false;
    }
    const o = obj as Record<string, unknown>;
    return "email" in o;
}

static is(obj: unknown): obj is EmailValidator {
    if (obj instanceof EmailValidator) {
        return true;
    }
    if (!EmailValidator.hasShape(obj)) {
        return false;
    }
    const result = EmailValidator.decode(obj);
    return result.success;
}
}

