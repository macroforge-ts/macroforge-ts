    const cmp1 = (a.count < b.count ? -1 : a.count > b.count ? 1 : a.count === b.count ? 0 : null);
    if (cmp1 === null) return null;
    if (cmp1 !== 0) return cmp1;
    const cmp2 = (a.at == null || b.at == null ? __mf_structuralCompare(a.at, b.at) : (a.at.getTime() < b.at.getTime() ? -1 : a.at.getTime() > b.at.getTime() ? 1 : a.at.getTime() === b.at.getTime() ? 0 : null));
    if (cmp2 === null) return null;
