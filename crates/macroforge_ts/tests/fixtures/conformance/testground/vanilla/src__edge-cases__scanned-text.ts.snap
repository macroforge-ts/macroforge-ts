/**
 * Type text a derive reads by scanning it: a literal ending in an escaped
 * backslash, a function whose return type is a union, a template literal
 * alias whose parameter is substituted where it is used, and an empty pattern.
 */

export type ScannedKey<T extends string> = `key-${T}`;

/** @derive(Debug, Clone, PartialEq, Hash, Encode, Decode) */
export interface ScannedText {
    separator: '\\' | '/';
    key: ScannedKey<'a' | 'b'>;
    /** @endec({ validate: ['pattern("")'] }) */
    note: string;
}

export function scannedTextToString(value: ScannedText): string {
    return __mf_debuggedWithin(value, () => {
        const parts: string[] = [];
    parts.push("separator: " + String(value.separator));
    parts.push("key: " + __mf_structuralDebug(value.key));
    parts.push("note: " + String(value.note));
        return "ScannedText { " + parts.join(", ") + " }";
    });
}

export function scannedTextClone(value: ScannedText): ScannedText {
    return __mf_clonedWith(value, (): ScannedText => ({
	separator: value.separator,
	key: __mf_structuralClone(value.key),
	note: value.note
}));
}

export function scannedTextEquals(a: ScannedText, b: ScannedText): boolean {
    if (a === b) return true;
    return __mf_equalWithin(a, b, () => {
        return [
            () => a.separator === b.separator,
            () => __mf_structuralEquals(a.key, b.key),
            () => a.note === b.note,
        ].every((same) => same());
    });
}

export function scannedTextHashCode(value: ScannedText): number {
    return __mf_hashedWithin(value, () => {
        let hash = 17;
    hash = (hash * 31 + ((value.separator ?? "").split("").reduce<number>((h, c) => h * 31 + c.charCodeAt(0) | 0, 0))) | 0;
    hash = (hash * 31 + (__mf_structuralHash(value.key))) | 0;
    hash = (hash * 31 + ((value.note ?? "").split("").reduce<number>((h, c) => h * 31 + c.charCodeAt(0) | 0, 0))) | 0;
        return hash;
    });
}

/** Encodes a value to a JSON string. @param value - The value to encode @param keepMetadata - If true, preserves __type and __id fields in the output @returns JSON string representation  */
export function scannedTextEncode(value: ScannedText, keepMetadata?: boolean): string {
    const ctx = __mf_EncodeContext.create();
    const __raw = scannedTextEncodeWithContext(value, ctx);
    return keepMetadata ? __mf_encodedText(__raw) : __mf_encodedTextWithoutMetadata(__raw, "__type");
