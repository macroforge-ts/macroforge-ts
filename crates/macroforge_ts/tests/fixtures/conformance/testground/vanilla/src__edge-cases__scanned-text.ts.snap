    if (ScannedShade["Light"] === data) {
        return ScannedShade["Light"];
    }
    if (ScannedShade["Dark"] === data) {
        return ScannedShade["Dark"];
    }
    throw new __mf_DecodeError([{ field: "_root", message: "Invalid ScannedShade value: " + JSON.stringify(data) }]);
}

