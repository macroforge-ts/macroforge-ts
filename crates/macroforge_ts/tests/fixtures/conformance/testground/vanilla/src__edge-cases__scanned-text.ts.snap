export function scannedTextEncodePartialWithContext(value: Partial<ScannedText>, ctx: __mf_EncodeContext, fields?: __mf_FieldSelection<keyof ScannedText>): Record<string, unknown> {
    return __mf_encodeSelection(ctx, value, () => {
