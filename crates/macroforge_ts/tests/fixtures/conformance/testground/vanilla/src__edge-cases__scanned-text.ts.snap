/** @derive(Debug, Clone, PartialEq, Default, Encode, Decode) */
export enum ScannedShade {
    /** @default */
    Light = 'light',
    Dark = 'dark',
}

export function scannedShadeToString(value: ScannedShade): string {

    const held: unknown = value;
    if (held === ScannedShade["Light"]) {
        return "ScannedShade.Light";
    }
    if (held === ScannedShade["Dark"]) {
        return "ScannedShade.Dark";
    }
    return "ScannedShade(" + String(value) + ")";
}

export function scannedShadeClone(value: ScannedShade): ScannedShade {
    return value;
}

export function scannedShadeEquals(a: ScannedShade, b: ScannedShade): boolean {
    return a === b;
}

