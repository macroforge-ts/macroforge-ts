    return priorityDecodeWithContext(__mf_textOrValue(input, priorityIs));
}

/** Decodes with an existing context (for consistency with other types).  */
export function priorityDecodeWithContext(data: unknown, ctx?: __mf_DecodeContext): Priority;
export function priorityDecodeWithContext(data: unknown): Priority {
    if (Priority["Low"] === data) {
        return Priority["Low"];
    }
    if (Priority["Medium"] === data) {
        return Priority["Medium"];
    }
    if (Priority["High"] === data) {
        return Priority["High"];
    }
    if (Priority["Critical"] === data) {
        return Priority["Critical"];
    }
    throw new __mf_DecodeError([{ field: "_root", message: "Invalid Priority value: " + JSON.stringify(data) }]);
