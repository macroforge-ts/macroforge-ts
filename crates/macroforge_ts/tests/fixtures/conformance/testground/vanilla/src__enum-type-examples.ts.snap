/** @derive(Debug, Clone, PartialEq, Hash, Encode, Decode) */
export type UserProfile = {
    id: string;
    username: string;
    email: string;
    age: number;
    isVerified: boolean;
};

export function userProfileToString(value: UserProfile): string {
    return __mf_debuggedWithin(value, () => {
        const parts: string[] = [];
    parts.push("id: " + String(value.id));
    parts.push("username: " + String(value.username));
    parts.push("email: " + String(value.email));
    parts.push("age: " + String(value.age));
    parts.push("isVerified: " + String(value.isVerified));
        return "UserProfile { " + parts.join(", ") + " }";
    });
}

export function userProfileClone(value: UserProfile): UserProfile {
    return __mf_clonedWith(value, (): UserProfile => ({
	id: value.id,
	username: value.username,
	email: value.email,
	age: value.age,
	isVerified: value.isVerified
}));
}

export function userProfileEquals(a: UserProfile, b: UserProfile): boolean {
    if (a === b) return true;
    return __mf_equalWithin(a, b, () => {
    return [
        () => a.id === b.id,
        () => a.username === b.username,
        () => a.email === b.email,
        () => a.age === b.age || a.age !== a.age && b.age !== b.age,
        () => a.isVerified === b.isVerified,
    ].every((same) => same());
});
}

export function userProfileHashCode(value: UserProfile): number {
    return __mf_hashedWithin(value, () => {
        let hash = 17;
    hash = (hash * 31 + ((value.id ?? "").split("").reduce<number>((h, c) => h * 31 + c.charCodeAt(0) | 0, 0))) | 0;
    hash = (hash * 31 + ((value.username ?? "").split("").reduce<number>((h, c) => h * 31 + c.charCodeAt(0) | 0, 0))) | 0;
    hash = (hash * 31 + ((value.email ?? "").split("").reduce<number>((h, c) => h * 31 + c.charCodeAt(0) | 0, 0))) | 0;
    hash = (hash * 31 + (Number.isInteger(value.age) ? value.age | 0 : value.age.toString().split("").reduce<number>((h, c) => h * 31 + c.charCodeAt(0) | 0, 0))) | 0;
    hash = (hash * 31 + (value.isVerified ? 1231 : 1237)) | 0;
        return hash;
    });
}

/** Encodes a value to a JSON string. @param value - The value to encode @param keepMetadata - If true, preserves __type and __id fields in the output @returns JSON string representation  */
export function userProfileEncode(value: UserProfile, keepMetadata?: boolean): string {
    const ctx = __mf_EncodeContext.create();
    const __raw = userProfileEncodeWithContext(value, ctx);
    return keepMetadata ? __mf_encodedText(__raw) : __mf_encodedTextWithoutMetadata(__raw, "__type");
}

/** Encodes with an existing context for nested/cyclic object graphs. @param value - The value to encode @param ctx - The encoding context  */
export function userProfileEncodeWithContext(value: UserProfile, ctx: __mf_EncodeContext): Record<string, unknown> {
    const existingId = ctx.getId(value);
    if (existingId !== undefined) {
        return __mf_encodedReference(ctx, existingId);
    }
    const result = __mf_encodedAs(ctx, ctx.register(value), { "__type": "UserProfile" });
    userProfileEncodeFields(value, ctx, result, undefined);
    return result;
}

/** Encodes the fields a partial value has, with an existing context. A value encoded this way is written out wherever it is held: no reference stands for it. @param value - The value to encode @param ctx - The encoding context @param fields - The fields a `Pick` or `Omit` keeps: every field when left out  */
export function userProfileEncodePartialWithContext(value: Partial<UserProfile>, ctx: __mf_EncodeContext, fields?: __mf_FieldSelection<keyof UserProfile>): Record<string, unknown> {
    return __mf_encodeSelection(ctx, value, () => {
        const result: Record<string, unknown> = { "__type": "UserProfile" };
