// ==================== TYPE ALIAS EXAMPLES ====================

/** @derive(Debug, Clone, PartialEq, Hash, Encode, Decode) */
export type Point = {
    x: number;
    y: number;
};

export function pointToString(value: Point): string {
    const parts: string[] = [];
    parts.push("x: " + String(value.x));
    parts.push("y: " + String(value.y));
    return "Point { " + parts.join(", ") + " }";
}

export function pointClone(value: Point): Point {
    return ({
	x: value.x,
	y: value.y
});
}

export function pointEquals(a: Point, b: Point): boolean {
    if (a === b) return true;
    return a.x === b.x && a.y === b.y;
}

export function pointHashCode(value: Point): number {
    let hash = 17;
    hash = (hash * 31 + (Number.isInteger(value.x) ? value.x | 0 : value.x.toString().split("").reduce((h, c) => h * 31 + c.charCodeAt(0) | 0, 0))) | 0;
    hash = (hash * 31 + (Number.isInteger(value.y) ? value.y | 0 : value.y.toString().split("").reduce((h, c) => h * 31 + c.charCodeAt(0) | 0, 0))) | 0;
    return hash;
}

/** Encodes a value to a JSON string. @param value - The value to encode @param keepMetadata - If true, preserves __type and __id fields in the output @returns JSON string representation  */
export function pointEncode(value: Point, keepMetadata?: boolean): string {
    const ctx = __mf_EncodeContext.create();
    const __raw = pointEncodeWithContext(value, ctx);
    if (keepMetadata) return JSON.stringify(__raw);
    return JSON.stringify(__raw, (key, val) => key === "__type" || key === "__id" ? undefined : val);
}

/** Encodes with an existing context for nested/cyclic object graphs. @param value - The value to encode @param ctx - The encoding context  */
export function pointEncodeWithContext(value: Point, ctx: __mf_EncodeContext): Record<string, unknown> {

    const existingId = ctx.getId(value);
    if (existingId !== undefined) {
        return { __ref: existingId };
    }

    const __id = ctx.register(value);

    const result: Record<string, unknown> = {
        "__type": "Point",
        __id,
    };

    
    result.x = value.x;
    result.y = value.y;

    return result;
}

/** Decodes input to this type. Automatically detects whether input is a JSON string or object. @param input - JSON string or object to decode @param opts - Optional decoding options @returns Result containing the decoded value or validation errors  */
export function pointDecode(input: unknown, opts?: __mf_DecodeOptions): { success: true; value: Point } | { success: false; errors: Array<{ field: string; message: string }> } {
    try {

        const data = typeof input === "string" ? JSON.parse(input) : input;

        const ctx = __mf_DecodeContext.create();
        const resultOrRef = pointDecodeWithContext(data, ctx);

        if (__mf_PendingRef.is(resultOrRef)) {
            return ({
	success: false,
	errors: [{
		field: "_root",
		message: "Point.decode: root cannot be a forward reference"
	}]
});
        }

        ctx.applyPatches();
        if (opts?.freeze) {
            ctx.freezeAll();
        }

        const __errors = ctx.getErrors();
        if (__errors.length > 0) {
            return ({
	success: false,
	errors: __errors
});
        }

        return ({
	success: true,
	value: resultOrRef
});
    } catch (e) {
        if (e instanceof __mf_DecodeError) {
            return ({
	success: false,
	errors: e.errors
});
        }
        const message = e instanceof Error ? e.message : String(e);
        return ({
	success: false,
	errors: [{
		field: "_root",
		message
	}]
});
    }
}
/** Decodes with an existing context for nested/cyclic object graphs. @param value - The raw value to decode @param ctx - The decoding context  */
export function pointDecodeWithContext(value: unknown, ctx: __mf_DecodeContext): Point | __mf_PendingRef {
    if (typeof value === "object" && value !== null && "__ref" in value) {
        if (typeof value.__ref !== "number") {
            throw new __mf_DecodeError([{ field: "__ref", message: "Point.decodeWithContext: __ref must be a number" }]);
        }
        return ctx.getOrDefer(value.__ref) as Point | __mf_PendingRef;
    }

    if (typeof value !== "object" || value === null || Array.isArray(value)) {
        throw new __mf_DecodeError([{ field: "_root", message: "Point.decodeWithContext: expected an object" }]);
    }

    const obj = value as Record<string, unknown>;
    const errors: Array<{ field: string; message: string }> = [];
    if (!("x" in obj)) {
        errors.push({ field: "x", message: "missing required field" });
    }
    if (!("y" in obj)) {
        errors.push({ field: "y", message: "missing required field" });
    }

    const instance: any = {};

    if (obj.__id !== undefined) {
        ctx.register(obj.__id as number, instance);
    }

    ctx.trackForFreeze(instance);

    {
        const __raw_x = obj["x"] as number;

        if (!(typeof __raw_x === "number")) {
            errors.push({ field: "x", message: __raw_x == null ? "Point.x is required" : "expected number" });
        } else {
            instance.x = __raw_x;
        }
    }
    {
        const __raw_y = obj["y"] as number;

        if (!(typeof __raw_y === "number")) {
            errors.push({ field: "y", message: __raw_y == null ? "Point.y is required" : "expected number" });
        } else {
            instance.y = __raw_y;
        }
    }

    ctx.pushErrors(errors);

    return instance as Point;
}
export function pointValidateField<K extends keyof Point>(field: K, value: unknown): Array<{ field: string; message: string }>;
export function pointValidateField(): Array<{ field: string; message: string }> {
    return [];
}

export function pointValidateFields(partial: { readonly [K in keyof Point]?: unknown }): Array<{ field: string; message: string }>;
export function pointValidateFields(): Array<{ field: string; message: string }> {
    return [];
}
export function pointHasShape(obj: unknown): boolean {
    if (typeof obj !== "object" || obj === null || Array.isArray(obj)) {
        return false;
    }
    const o = obj as Record<string, unknown>;
    return "x" in o && "y" in o;
}

export function pointIs(obj: unknown): obj is Point {
    return pointHasShape(obj) && pointDecode(obj).success;
}

export const Point: {
  readonly toString: typeof pointToString;
  readonly clone: typeof pointClone;
  readonly equals: typeof pointEquals;
  readonly hashCode: typeof pointHashCode;
  readonly encode: typeof pointEncode;
  readonly encodeWithContext: typeof pointEncodeWithContext;
  readonly decode: typeof pointDecode;
  readonly decodeWithContext: typeof pointDecodeWithContext;
  readonly validateField: typeof pointValidateField;
  readonly validateFields: typeof pointValidateFields;
  readonly hasShape: typeof pointHasShape;
  readonly is: typeof pointIs;
} = {
  toString: pointToString,
  clone: pointClone,
  equals: pointEquals,
  hashCode: pointHashCode,
  encode: pointEncode,
  encodeWithContext: pointEncodeWithContext,
  decode: pointDecode,
  decodeWithContext: pointDecodeWithContext,
  validateField: pointValidateField,
  validateFields: pointValidateFields,
  hasShape: pointHasShape,
  is: pointIs
};

/** @derive(Debug, Clone, PartialEq, Hash, Encode, Decode) */
export type UserProfile = {
    id: string;
    username: string;
    email: string;
    age: number;
    isVerified: boolean;
};

export function userProfileToString(value: UserProfile): string {
    const parts: string[] = [];
    parts.push("id: " + String(value.id));
    parts.push("username: " + String(value.username));
    parts.push("email: " + String(value.email));
    parts.push("age: " + String(value.age));
    parts.push("isVerified: " + String(value.isVerified));
    return "UserProfile { " + parts.join(", ") + " }";
}

export function userProfileClone(value: UserProfile): UserProfile {
    return ({
	id: value.id,
	username: value.username,
	email: value.email,
	age: value.age,
	isVerified: value.isVerified
});
}

export function userProfileEquals(a: UserProfile, b: UserProfile): boolean {
    if (a === b) return true;
    return a.id === b.id && a.username === b.username && a.email === b.email && a.age === b.age && a.isVerified === b.isVerified;
}

export function userProfileHashCode(value: UserProfile): number {
    let hash = 17;
    hash = (hash * 31 + ((value.id ?? "").split("").reduce((h, c) => h * 31 + c.charCodeAt(0) | 0, 0))) | 0;
    hash = (hash * 31 + ((value.username ?? "").split("").reduce((h, c) => h * 31 + c.charCodeAt(0) | 0, 0))) | 0;
    hash = (hash * 31 + ((value.email ?? "").split("").reduce((h, c) => h * 31 + c.charCodeAt(0) | 0, 0))) | 0;
    hash = (hash * 31 + (Number.isInteger(value.age) ? value.age | 0 : value.age.toString().split("").reduce((h, c) => h * 31 + c.charCodeAt(0) | 0, 0))) | 0;
    hash = (hash * 31 + (value.isVerified ? 1231 : 1237)) | 0;
    return hash;
}

/** Encodes a value to a JSON string. @param value - The value to encode @param keepMetadata - If true, preserves __type and __id fields in the output @returns JSON string representation  */
export function userProfileEncode(value: UserProfile, keepMetadata?: boolean): string {
    const ctx = __mf_EncodeContext.create();
    const __raw = userProfileEncodeWithContext(value, ctx);
    if (keepMetadata) return JSON.stringify(__raw);
    return JSON.stringify(__raw, (key, val) => key === "__type" || key === "__id" ? undefined : val);
}

/** Encodes with an existing context for nested/cyclic object graphs. @param value - The value to encode @param ctx - The encoding context  */
export function userProfileEncodeWithContext(value: UserProfile, ctx: __mf_EncodeContext): Record<string, unknown> {

    const existingId = ctx.getId(value);
    if (existingId !== undefined) {
        return { __ref: existingId };
    }

    const __id = ctx.register(value);

    const result: Record<string, unknown> = {
        "__type": "UserProfile",
        __id,
    };

    
    result.id = value.id;
    result.username = value.username;
    result.email = value.email;
    result.age = value.age;
    result.isVerified = value.isVerified;

    return result;
}

/** Decodes input to this type. Automatically detects whether input is a JSON string or object. @param input - JSON string or object to decode @param opts - Optional decoding options @returns Result containing the decoded value or validation errors  */
export function userProfileDecode(input: unknown, opts?: __mf_DecodeOptions): { success: true; value: UserProfile } | { success: false; errors: Array<{ field: string; message: string }> } {
    try {

        const data = typeof input === "string" ? JSON.parse(input) : input;

        const ctx = __mf_DecodeContext.create();
        const resultOrRef = userProfileDecodeWithContext(data, ctx);

        if (__mf_PendingRef.is(resultOrRef)) {
            return ({
	success: false,
	errors: [{
		field: "_root",
		message: "UserProfile.decode: root cannot be a forward reference"
	}]
});
        }

        ctx.applyPatches();
        if (opts?.freeze) {
            ctx.freezeAll();
        }

        const __errors = ctx.getErrors();
        if (__errors.length > 0) {
            return ({
	success: false,
	errors: __errors
});
        }

        return ({
	success: true,
	value: resultOrRef
});
    } catch (e) {
        if (e instanceof __mf_DecodeError) {
            return ({
	success: false,
	errors: e.errors
});
        }
        const message = e instanceof Error ? e.message : String(e);
        return ({
	success: false,
	errors: [{
		field: "_root",
		message
	}]
});
    }
}
/** Decodes with an existing context for nested/cyclic object graphs. @param value - The raw value to decode @param ctx - The decoding context  */
export function userProfileDecodeWithContext(value: unknown, ctx: __mf_DecodeContext): UserProfile | __mf_PendingRef {
    if (typeof value === "object" && value !== null && "__ref" in value) {
        if (typeof value.__ref !== "number") {
            throw new __mf_DecodeError([{ field: "__ref", message: "UserProfile.decodeWithContext: __ref must be a number" }]);
        }
