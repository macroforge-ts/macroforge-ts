        return true;
    }
    if (Priority["High"] === value) {
        return true;
    }
    if (Priority["Critical"] === value) {
        return true;
    }
    return false;
}

export namespace Priority {
  export const toString: typeof priorityToString = priorityToString;
  export const clone: typeof priorityClone = priorityClone;
  export const equals: typeof priorityEquals = priorityEquals;
  export const hashCode: typeof priorityHashCode = priorityHashCode;
  export const encode: typeof priorityEncode = priorityEncode;
  export const encodeWithContext: typeof priorityEncodeWithContext = priorityEncodeWithContext;
  export const decode: typeof priorityDecode = priorityDecode;
  export const decodeWithContext: typeof priorityDecodeWithContext = priorityDecodeWithContext;
  export const is: typeof priorityIs = priorityIs;
