export function userProfileDecodeWithContext(value: unknown, ctx: __mf_DecodeContext, __fields?: __mf_FieldRequirement): Partial<UserProfile> | __mf_PendingRef {
    if (__fields !== undefined && typeof value === "object" && value !== null && "__ref" in value) {
        throw new __mf_DecodeError([{ field: "_root", message: "UserProfile.decodeWithContext: a value holding a selection of fields cannot be a reference" }]);
    }
    if (typeof value === "object" && value !== null && "__ref" in value) {
        if (typeof value.__ref !== "number") {
            throw new __mf_DecodeError([{ field: "__ref", message: "UserProfile.decodeWithContext: __ref must be a number" }]);
        }
        return ctx.getOrDefer(value.__ref, "UserProfile") as UserProfile | __mf_PendingRef;
    }

    if (typeof value !== "object" || value === null || Array.isArray(value)) {
        throw new __mf_DecodeError([{ field: "_root", message: "UserProfile.decodeWithContext: expected an object" }]);
    }

    const obj = __mf_ownMembers(value);
    const errors: Array<{ field: string; message: string }> = [];

    const __requiredKeys: ReadonlyArray<readonly [string, string]> = [["id", "id"], ["username", "username"], ["email", "email"], ["age", "age"], ["isVerified", "isVerified"]];
    for (const [__name, __key] of __requiredKeys) {
        if ((__fields === undefined || __fields.requires(__name)) && !(__key in obj)) {
            errors.push({ field: __key, message: "missing required field" });
        }
    }

    const instance: { "id"?: string | undefined; "username"?: string | undefined; "email"?: string | undefined; "age"?: number | undefined; "isVerified"?: boolean | undefined } = {};

    if (__fields === undefined && obj["__id"] !== undefined) {
        ctx.register(obj["__id"] as number, instance, "UserProfile");
    }

    ctx.trackForFreeze(instance);

    for (const __part of [
        () => {
            if ((__fields === undefined || __fields.requires("id")) ? "id" in obj : (__fields.keeps("id") && obj["id"] !== undefined)) {
                const __raw_id = obj["id"] as string;

                if (!(typeof __raw_id === "string")) {
                    errors.push({ field: "id", message: __raw_id == null ? "UserProfile.id is required" : "expected string" });
                } else {
                    instance.id = __raw_id;
                }
            }
        },
        () => {
            if ((__fields === undefined || __fields.requires("username")) ? "username" in obj : (__fields.keeps("username") && obj["username"] !== undefined)) {
                const __raw_username = obj["username"] as string;

                if (!(typeof __raw_username === "string")) {
                    errors.push({ field: "username", message: __raw_username == null ? "UserProfile.username is required" : "expected string" });
                } else {
                    instance.username = __raw_username;
                }
            }
        },
        () => {
            if ((__fields === undefined || __fields.requires("email")) ? "email" in obj : (__fields.keeps("email") && obj["email"] !== undefined)) {
                const __raw_email = obj["email"] as string;

                if (!(typeof __raw_email === "string")) {
                    errors.push({ field: "email", message: __raw_email == null ? "UserProfile.email is required" : "expected string" });
                } else {
                    instance.email = __raw_email;
                }
            }
        },
        () => {
            if ((__fields === undefined || __fields.requires("age")) ? "age" in obj : (__fields.keeps("age") && obj["age"] !== undefined)) {
                const __raw_age = obj["age"] as number;

                if (!(typeof __raw_age === "number" && globalThis.Number.isFinite(__raw_age))) {
                    errors.push({ field: "age", message: __raw_age == null ? "UserProfile.age is required" : "expected number" });
                } else {
                    instance.age = __raw_age;
                }
            }
        },
        () => {
            if ((__fields === undefined || __fields.requires("isVerified")) ? "isVerified" in obj : (__fields.keeps("isVerified") && obj["isVerified"] !== undefined)) {
                const __raw_isVerified = obj["isVerified"] as boolean;

                if (!(typeof __raw_isVerified === "boolean")) {
                    errors.push({ field: "isVerified", message: __raw_isVerified == null ? "UserProfile.isVerified is required" : "expected boolean" });
                } else {
