        canEmail: {
            name: "canEmail",
            label: "Can Email",
            type: "checkbox",
            optional: false,
            array: false,
            path: ["canEmail"],
            get: () => data.canEmail,
            set: (value: boolean) => { data.canEmail = value; },
            getError: () => errors.canEmail,
            setError: (value: Option.Option<Array<string>>) => { errors.canEmail = value; },
            getTainted: () => tainted.canEmail,
            setTainted: (value: Option.Option<boolean>) => { tainted.canEmail = value; },
            validate: () => emailValidateField("canEmail", data.canEmail).map((e: { field: string; message: string }) => e.message),

            constraints: {},


            disabled: false,
            readonly: false,
        },
        emailString: {
            name: "emailString",
            label: "Email",
            type: "text",
            optional: false,
            array: false,
            path: ["emailString"],
            get: () => data.emailString,
            set: (value: string) => { data.emailString = value; },
            getError: () => errors.emailString,
            setError: (value: Option.Option<Array<string>>) => { errors.emailString = value; },
            getTainted: () => tainted.emailString,
            setTainted: (value: Option.Option<boolean>) => { tainted.emailString = value; },
            validate: () => emailValidateField("emailString", data.emailString).map((e: { field: string; message: string }) => e.message),

            constraints: { type: "email" },


            disabled: false,
            readonly: false,
        },
    } as unknown as EmailFieldControllers;

    function validate(): Exit.Exit<Email, Array<{ field: string; message: string }>> {
        return toExit(emailDecode(data));
    }

    function reset(newOverrides?: Partial<Email>): void {
        data = { ...emailDefaultValue(), ...newOverrides };
        errors = {
            _errors: Option.none(),
            canEmail: Option.none(),
            emailString: Option.none(),
        };
        tainted = {
            canEmail: Option.none(),
            emailString: Option.none(),
        };
    }

    return {
        get data() { return data; },
        set data(v) { data = v; },
        get errors() { return errors; },
        set errors(v) { errors = v; },
