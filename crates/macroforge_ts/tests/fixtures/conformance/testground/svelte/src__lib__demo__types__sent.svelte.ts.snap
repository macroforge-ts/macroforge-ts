import { encodedText as __mf_encodedText, encodedTextWithoutMetadata as __mf_encodedTextWithoutMetadata, EncodeContext as __mf_EncodeContext, fieldRequirement as __mf_fieldRequirement, DecodeContext as __mf_DecodeContext, DecodeError as __mf_DecodeError, PendingRef as __mf_PendingRef } from "@macroforge/core/endec";
import type { FieldSelection as __mf_FieldSelection, FieldRequirement as __mf_FieldRequirement, DecodeOptions as __mf_DecodeOptions } from "@macroforge/core/endec";
import { Option, Exit } from "effect";
import type { FieldController } from "@testground/macro/gigaform";
import { toExit } from "@testground/macro/gigaform";
/** import macro {Gigaform} from "@testground/macro"; */


export interface Sent {
    recipient: string | null;
    method: string | null;
}

export function sentDefaultValue(): Sent {
    return {
        recipient: null,
        method: null,
    };
}

/** Encodes a value to a JSON string. @param value - The value to encode @param keepMetadata - If true, preserves __type and __id fields in the output @returns JSON string representation  */
export function sentEncode(value: Sent, keepMetadata?: boolean): string {
    const ctx = __mf_EncodeContext.create();
    const __raw = sentEncodeWithContext(value, ctx);
    return keepMetadata ? __mf_encodedText(__raw) : __mf_encodedTextWithoutMetadata(__raw, "__type");
}

/** Encodes with an existing context for nested/cyclic object graphs. @param value - The value to encode @param ctx - The encoding context  */
export function sentEncodeWithContext(value: Sent, ctx: __mf_EncodeContext): Record<string, unknown> {
    return sentEncodePartialWithContext(value, ctx);
}

/** Encodes the fields a partial value has, with an existing context. @param value - The value to encode @param ctx - The encoding context @param fields - The fields a `Pick` or `Omit` keeps: every field when left out  */
export function sentEncodePartialWithContext(value: Partial<Sent>, ctx: __mf_EncodeContext, fields?: __mf_FieldSelection<keyof Sent>): Record<string, unknown> {
    const __fields = fields === undefined ? undefined : __mf_fieldRequirement(fields);

    let __id: number | undefined;
    if (__fields === undefined) {
        const existingId = ctx.getId(value);
        if (existingId !== undefined) {
            return { __ref: existingId };
        }
        __id = ctx.register(value);
    }

    const result: Record<string, unknown> = {
        "__type": "Sent",
        __id,
    };

    if (__fields === undefined || __fields.keeps("recipient")) {
        if (value.recipient !== undefined) {

            result.recipient = value.recipient;
        }
    }
    if (__fields === undefined || __fields.keeps("method")) {
        if (value.method !== undefined) {

            result.method = value.method;
        }
    }

    return result;
}

/** Decodes input to this type. Automatically detects whether input is a JSON string or object. @param input - JSON string or object to decode @param opts - Optional decoding options @returns Result containing the decoded value or validation errors  */
export function sentDecode(input: unknown, opts?: __mf_DecodeOptions): { success: true; value: Sent } | { success: false; errors: Array<{ field: string; message: string }> } {
    try {

        const data = typeof input === "string" ? JSON.parse(input) : input;

        const ctx = __mf_DecodeContext.create();
        const resultOrRef = sentDecodeWithContext(data, ctx);

        if (__mf_PendingRef.is(resultOrRef)) {
            return ({
	success: false,
	errors: [{
		field: "_root",
		message: "Sent.decode: root cannot be a forward reference"
	}]
});
        }

        ctx.applyPatches();
        if (opts?.freeze) {
            ctx.freezeAll();
        }

        const __errors = ctx.getErrors();
        if (__errors.length > 0) {
            return ({
	success: false,
	errors: __errors
});
        }

        return ({
	success: true,
	value: resultOrRef
});
    } catch (e) {
        if (e instanceof __mf_DecodeError) {
            return ({
	success: false,
	errors: e.errors
});
        }
        const message = e instanceof Error ? e.message : String(e);
        return ({
	success: false,
	errors: [{
		field: "_root",
		message
	}]
});
    }
}
/** Decodes with an existing context for nested/cyclic object graphs. @param value - The raw value to decode @param ctx - The decoding context  */
export function sentDecodeWithContext(value: unknown, ctx: __mf_DecodeContext): Sent | __mf_PendingRef;
/** Decodes the fields `fields` keeps, and no other. @param value - The raw value to decode @param ctx - The decoding context @param fields - Which fields the value has and has to have  */
export function sentDecodeWithContext(value: unknown, ctx: __mf_DecodeContext, fields: __mf_FieldRequirement): Partial<Sent> | __mf_PendingRef;
export function sentDecodeWithContext(value: unknown, ctx: __mf_DecodeContext, __fields?: __mf_FieldRequirement): Partial<Sent> | __mf_PendingRef {
    if (__fields !== undefined && typeof value === "object" && value !== null && "__ref" in value) {
        throw new __mf_DecodeError([{ field: "_root", message: "Sent.decodeWithContext: a value holding a selection of fields cannot be a reference" }]);
    }
    if (typeof value === "object" && value !== null && "__ref" in value) {
        if (typeof value.__ref !== "number") {
            throw new __mf_DecodeError([{ field: "__ref", message: "Sent.decodeWithContext: __ref must be a number" }]);
        }
        return ctx.getOrDefer(value.__ref) as Sent | __mf_PendingRef;
    }

    if (typeof value !== "object" || value === null || Array.isArray(value)) {
        throw new __mf_DecodeError([{ field: "_root", message: "Sent.decodeWithContext: expected an object" }]);
    }

    const obj = value as Record<string, unknown>;
    const errors: Array<{ field: string; message: string }> = [];
    if ((__fields === undefined || __fields.requires("recipient")) && !("recipient" in obj)) {
        errors.push({ field: "recipient", message: "missing required field" });
    }
    if ((__fields === undefined || __fields.requires("method")) && !("method" in obj)) {
        errors.push({ field: "method", message: "missing required field" });
    }

    const instance: any = {};

    if (__fields === undefined && obj.__id !== undefined) {
        ctx.register(obj.__id as number, instance);
    }

    ctx.trackForFreeze(instance);

    if ((__fields === undefined || __fields.requires("recipient")) || (__fields.keeps("recipient") && obj["recipient"] !== undefined)) {
        const __raw_recipient = obj["recipient"] as string | null;

        if (!(typeof __raw_recipient === "string" || __raw_recipient === null)) {
            errors.push({ field: "recipient", message: "expected string | null" });
        } else {
            instance.recipient = __raw_recipient;
        }
    }
    if ((__fields === undefined || __fields.requires("method")) || (__fields.keeps("method") && obj["method"] !== undefined)) {
        const __raw_method = obj["method"] as string | null;

        if (!(typeof __raw_method === "string" || __raw_method === null)) {
            errors.push({ field: "method", message: "expected string | null" });
        } else {
            instance.method = __raw_method;
        }
    }

    ctx.pushErrors(errors);

    return instance as Sent;
}

/** Decodes a `Partial`, `Pick` or `Omit` of this type with an existing context. @param value - The raw value to decode @param ctx - The decoding context @param fields - The fields the value has to have: none when left out  */
export function sentDecodePartialWithContext(value: unknown, ctx: __mf_DecodeContext, fields?: __mf_FieldSelection<keyof Sent>): Partial<Sent> | __mf_PendingRef {
    return sentDecodeWithContext(value, ctx, __mf_fieldRequirement(fields));
}
export function sentValidateField<K extends keyof Sent>(field: K, value: unknown): Array<{ field: string; message: string }>;
export function sentValidateField(): Array<{ field: string; message: string }> {
    return [];
}

export function sentValidateFields(partial: { readonly [K in keyof Sent]?: unknown }): Array<{ field: string; message: string }>;
export function sentValidateFields(): Array<{ field: string; message: string }> {
    return [];
}
export function sentHasShape(obj: unknown): boolean {
    if (typeof obj !== "object" || obj === null || Array.isArray(obj)) {
        return false;
    }
    const o = obj as Record<string, unknown>;
    return "recipient" in o && "method" in o;
}

export function sentIs(obj: unknown): obj is Sent {
    return sentHasShape(obj) && sentDecode(obj).success;
}

/** Nested error structure matching the data shape  */
export type SentErrors = {
    _errors: Option.Option<Array<string>>;
    recipient: Option.Option<Array<string>>;
    method: Option.Option<Array<string>>;
};

/** Nested boolean structure for tracking touched/dirty fields  */
export type SentTainted = {
    recipient: Option.Option<boolean>;
    method: Option.Option<boolean>;
};

/** Type-safe field controllers for this form  */
export interface SentFieldControllers {
    readonly recipient: FieldController<string | null>;
    readonly method: FieldController<string | null>;
}

/** Gigaform instance containing reactive state and field controllers  */
export interface SentGigaform {
    readonly data: Sent;
    readonly errors: SentErrors;
    readonly tainted: SentTainted;
    readonly fields: SentFieldControllers;
    validate(): Exit.Exit<Sent, Array<{ field: string; message: string }>>;
    reset(overrides?: Partial<Sent>): void;
}
/** Creates a new Gigaform instance with reactive state and field controllers.  */
export function sentCreateForm(overrides?: Partial<Sent>): SentGigaform {
    let data = $state({ ...sentDefaultValue(), ...overrides });
    let errors = $state<SentErrors>({
        _errors: Option.none(),
        recipient: Option.none(),
        method: Option.none(),
    });
    let tainted = $state<SentTainted>({
        recipient: Option.none(),
        method: Option.none(),
    });
    const fields = {
        recipient: {
            name: "recipient",
            label: "recipient",
            type: "text",
            optional: false,
            array: false,
            path: ["recipient"],
            get: () => data.recipient,
            set: (value: string | null) => { data.recipient = value; },
            getError: () => errors.recipient,
            setError: (value: Option.Option<Array<string>>) => { errors.recipient = value; },
            getTainted: () => tainted.recipient,
            setTainted: (value: Option.Option<boolean>) => { tainted.recipient = value; },
            validate: () => sentValidateField("recipient", data.recipient).map((e: { field: string; message: string }) => e.message),

            constraints: {},


            disabled: false,
            readonly: false,
        },
        method: {
            name: "method",
            label: "method",
            type: "text",
            optional: false,
            array: false,
            path: ["method"],
            get: () => data.method,
            set: (value: string | null) => { data.method = value; },
            getError: () => errors.method,
            setError: (value: Option.Option<Array<string>>) => { errors.method = value; },
            getTainted: () => tainted.method,
            setTainted: (value: Option.Option<boolean>) => { tainted.method = value; },
            validate: () => sentValidateField("method", data.method).map((e: { field: string; message: string }) => e.message),

            constraints: {},


            disabled: false,
            readonly: false,
        },
    } as unknown as SentFieldControllers;

    function validate(): Exit.Exit<Sent, Array<{ field: string; message: string }>> {
        return toExit(sentDecode(data));
    }

    function reset(newOverrides?: Partial<Sent>): void {
        data = { ...sentDefaultValue(), ...newOverrides };
        errors = {
            _errors: Option.none(),
            recipient: Option.none(),
            method: Option.none(),
        };
        tainted = {
            recipient: Option.none(),
            method: Option.none(),
        };
    }

    return {
        get data() { return data; },
        set data(v) { data = v; },
        get errors() { return errors; },
        set errors(v) { errors = v; },
        get tainted() { return tainted; },
        set tainted(v) { tainted = v; },
        fields,
        validate,
        reset,
    };
}
/** Parses FormData and validates it, returning a Result with the parsed data or errors. Delegates validation to decode() from @derive(Decode).  */
export function sentFromFormData(formData: FormData): Exit.Exit<Sent, Array<{ field: string; message: string }>> {
    const obj: Record<string, unknown> = {};

    
    obj.recipient = formData.get("recipient") ?? "";
    obj.method = formData.get("method") ?? "";

    return toExit(sentDecode(obj));
}

export const Sent: {
  readonly defaultValue: typeof sentDefaultValue;
  readonly encode: typeof sentEncode;
  readonly encodeWithContext: typeof sentEncodeWithContext;
  readonly encodePartialWithContext: typeof sentEncodePartialWithContext;
  readonly decode: typeof sentDecode;
  readonly decodeWithContext: typeof sentDecodeWithContext;
  readonly decodePartialWithContext: typeof sentDecodePartialWithContext;
  readonly validateField: typeof sentValidateField;
  readonly validateFields: typeof sentValidateFields;
  readonly hasShape: typeof sentHasShape;
  readonly is: typeof sentIs;
  readonly createForm: typeof sentCreateForm;
  readonly fromFormData: typeof sentFromFormData;
} = {
  defaultValue: sentDefaultValue,
  encode: sentEncode,
  encodeWithContext: sentEncodeWithContext,
  encodePartialWithContext: sentEncodePartialWithContext,
  decode: sentDecode,
  decodeWithContext: sentDecodeWithContext,
  decodePartialWithContext: sentDecodePartialWithContext,
  validateField: sentValidateField,
  validateFields: sentValidateFields,
  hasShape: sentHasShape,
  is: sentIs,
  createForm: sentCreateForm,
  fromFormData: sentFromFormData
};

