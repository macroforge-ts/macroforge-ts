        const __raw_hue = obj["hue"] as number;

        if (!(typeof __raw_hue === "number")) {
            errors.push({ field: "hue", message: __raw_hue == null ? "DirectionHue.hue is required" : "expected number" });
        } else {
            instance.hue = __raw_hue;
        }
    }

    ctx.pushErrors(errors);

    return instance as DirectionHue;
