    if (!("bearing" in obj)) {
        errors.push({ field: "bearing", message: "missing required field" });
    }
    if (!("hue" in obj)) {
        errors.push({ field: "hue", message: "missing required field" });
    }

    const instance: any = {};

    if (obj.__id !== undefined) {
        ctx.register(obj.__id as number, instance);
    }

    ctx.trackForFreeze(instance);

    {
        const __raw_bearing = obj["bearing"] as number;

        if (!(typeof __raw_bearing === "number")) {
            errors.push({ field: "bearing", message: __raw_bearing == null ? "DirectionHue.bearing is required" : "expected number" });
        } else {
