/** Decodes a `Partial`, `Pick` or `Omit` of this type with an existing context. @param value - The raw value to decode @param ctx - The decoding context @param fields - The fields the value has to have: none when left out  */
export function didDecodePartialWithContext(value: unknown, ctx: __mf_DecodeContext, fields?: __mf_FieldSelection<keyof Did>): Partial<Did> | __mf_PendingRef {
    return didDecodeWithContext(value, ctx, __mf_fieldRequirement(fields));
}
export function didValidateField<K extends keyof Did>(field: K, value: unknown): Array<{ field: string; message: string }>;
export function didValidateField(): Array<{ field: string; message: string }> {
    return [];
}

export function didValidateFields(partial: { readonly [K in keyof Did]?: unknown }): Array<{ field: string; message: string }>;
export function didValidateFields(): Array<{ field: string; message: string }> {
