export function didHasShape(obj: unknown): boolean {
    if (typeof obj !== "object" || obj === null || Array.isArray(obj)) {
        return false;
    }
    const o = obj as Record<string, unknown>;
    return "in" in o && "out" in o && "id" in o && "activityType" in o && "createdAt" in o && "metadata" in o;
}

export function didIs(obj: unknown): obj is Did {
    return didHasShape(obj) && didDecode(obj).success;
}

/** Nested error structure matching the data shape  */
export type DidErrors = {
    _errors: Option.Option<Array<string>>;
    in: Option.Option<Array<string>>;
    out: Option.Option<Array<string>>;
    id: Option.Option<Array<string>>;
    activityType: Option.Option<Array<string>>;
    createdAt: Option.Option<Array<string>>;
    metadata: Option.Option<Array<string>>;
};

/** Nested boolean structure for tracking touched/dirty fields  */
export type DidTainted = {
    in: Option.Option<boolean>;
    out: Option.Option<boolean>;
    id: Option.Option<boolean>;
    activityType: Option.Option<boolean>;
    createdAt: Option.Option<boolean>;
    metadata: Option.Option<boolean>;
};

/** Type-safe field controllers for this form  */
export interface DidFieldControllers {
    readonly in: FieldController<string | Actor>;
    readonly out: FieldController<string | Target>;
    readonly id: FieldController<string>;
    readonly activityType: FieldController<ActivityType>;
    readonly createdAt: FieldController<string>;
    readonly metadata: FieldController<string | null>;
}

/** Gigaform instance containing reactive state and field controllers  */
export interface DidGigaform {
    readonly data: Did;
    readonly errors: DidErrors;
    readonly tainted: DidTainted;
    readonly fields: DidFieldControllers;
    validate(): Exit.Exit<Did, Array<{ field: string; message: string }>>;
    reset(overrides?: Partial<Did>): void;
}
/** Creates a new Gigaform instance with reactive state and field controllers.  */
export function didCreateForm(overrides?: Partial<Did>): DidGigaform {
    let data = $state({ ...didDefaultValue(), ...overrides });
    let errors = $state<DidErrors>({
        _errors: Option.none(),
        in: Option.none(),
        out: Option.none(),
        id: Option.none(),
        activityType: Option.none(),
        createdAt: Option.none(),
        metadata: Option.none(),
    });
    let tainted = $state<DidTainted>({
        in: Option.none(),
        out: Option.none(),
        id: Option.none(),
        activityType: Option.none(),
        createdAt: Option.none(),
        metadata: Option.none(),
    });
    const fields = {
        in: {
            name: "in",
            label: "in",
            type: "text",
            optional: false,
            array: false,
            path: ["in"],
            get: () => data.in,
            set: (value: string | Actor) => { data.in = value; },
            getError: () => errors.in,
            setError: (value: Option.Option<Array<string>>) => { errors.in = value; },
            getTainted: () => tainted.in,
            setTainted: (value: Option.Option<boolean>) => { tainted.in = value; },
            validate: () => didValidateField("in", data.in).map((e: { field: string; message: string }) => e.message),

            constraints: {},


            disabled: false,
            readonly: false,
        },
        out: {
            name: "out",
            label: "out",
            type: "text",
            optional: false,
            array: false,
            path: ["out"],
            get: () => data.out,
            set: (value: string | Target) => { data.out = value; },
            getError: () => errors.out,
            setError: (value: Option.Option<Array<string>>) => { errors.out = value; },
            getTainted: () => tainted.out,
            setTainted: (value: Option.Option<boolean>) => { tainted.out = value; },
            validate: () => didValidateField("out", data.out).map((e: { field: string; message: string }) => e.message),

            constraints: {},


            disabled: false,
            readonly: false,
        },
        id: {
            name: "id",
            label: "id",
            type: "text",
            optional: false,
            array: false,
            path: ["id"],
            get: () => data.id,
            set: (value: string) => { data.id = value; },
            getError: () => errors.id,
            setError: (value: Option.Option<Array<string>>) => { errors.id = value; },
            getTainted: () => tainted.id,
            setTainted: (value: Option.Option<boolean>) => { tainted.id = value; },
            validate: () => didValidateField("id", data.id).map((e: { field: string; message: string }) => e.message),

            constraints: {},


            disabled: false,
            readonly: false,
        },
        activityType: {
            name: "activityType",
            label: "activityType",
            type: "text",
            optional: false,
            array: false,
            path: ["activityType"],
            get: () => data.activityType,
            set: (value: ActivityType) => { data.activityType = value; },
            getError: () => errors.activityType,
            setError: (value: Option.Option<Array<string>>) => { errors.activityType = value; },
            getTainted: () => tainted.activityType,
            setTainted: (value: Option.Option<boolean>) => { tainted.activityType = value; },
            validate: () => didValidateField("activityType", data.activityType).map((e: { field: string; message: string }) => e.message),

            constraints: {},


            disabled: false,
            readonly: false,
        },
        createdAt: {
            name: "createdAt",
            label: "createdAt",
            type: "text",
            optional: false,
            array: false,
            path: ["createdAt"],
            get: () => data.createdAt,
            set: (value: string) => { data.createdAt = value; },
            getError: () => errors.createdAt,
            setError: (value: Option.Option<Array<string>>) => { errors.createdAt = value; },
            getTainted: () => tainted.createdAt,
            setTainted: (value: Option.Option<boolean>) => { tainted.createdAt = value; },
            validate: () => didValidateField("createdAt", data.createdAt).map((e: { field: string; message: string }) => e.message),

            constraints: {},


            disabled: false,
            readonly: false,
        },
        metadata: {
            name: "metadata",
            label: "metadata",
            type: "text",
            optional: false,
            array: false,
            path: ["metadata"],
            get: () => data.metadata,
            set: (value: string | null) => { data.metadata = value; },
            getError: () => errors.metadata,
            setError: (value: Option.Option<Array<string>>) => { errors.metadata = value; },
            getTainted: () => tainted.metadata,
            setTainted: (value: Option.Option<boolean>) => { tainted.metadata = value; },
            validate: () => didValidateField("metadata", data.metadata).map((e: { field: string; message: string }) => e.message),

            constraints: {},


            disabled: false,
            readonly: false,
        },
    } as unknown as DidFieldControllers;

    function validate(): Exit.Exit<Did, Array<{ field: string; message: string }>> {
        return toExit(didDecode(data));
    }

    function reset(newOverrides?: Partial<Did>): void {
        data = { ...didDefaultValue(), ...newOverrides };
        errors = {
            _errors: Option.none(),
            in: Option.none(),
            out: Option.none(),
            id: Option.none(),
            activityType: Option.none(),
            createdAt: Option.none(),
            metadata: Option.none(),
        };
        tainted = {
            in: Option.none(),
            out: Option.none(),
            id: Option.none(),
            activityType: Option.none(),
            createdAt: Option.none(),
            metadata: Option.none(),
        };
    }

    return {
        get data() { return data; },
        set data(v) { data = v; },
        get errors() { return errors; },
        set errors(v) { errors = v; },
        get tainted() { return tainted; },
        set tainted(v) { tainted = v; },
        fields,
        validate,
        reset,
    };
}
/** Parses FormData and validates it, returning a Result with the parsed data or errors. Delegates validation to decode() from @derive(Decode).  */
export function didFromFormData(formData: FormData): Exit.Exit<Did, Array<{ field: string; message: string }>> {
    const obj: Record<string, unknown> = {};

    
    obj.in = formData.get("in") ?? "";
    obj.out = formData.get("out") ?? "";
    obj.id = formData.get("id") ?? "";
    {

        const activityTypeObj: Record<string, unknown> = {};
        for (const [key, value] of Array.from(formData.entries())) {
            if (key.startsWith("activityType.")) {
                const fieldName = key.slice("activityType.".length);

                const parts = fieldName.split(".");
                let current = activityTypeObj;
                for (let i = 0; i < parts.length - 1; i++) {
                    const part = parts[i]!;
                    if (!(part in current)) {
                        current[part] = {};
                    }
                    current = current[part] as Record<string, unknown>;
                }
                current[parts[parts.length - 1]!] = value;
            }
        }
        obj.activityType = activityTypeObj;
    }
    obj.createdAt = formData.get("createdAt") ?? "";
    obj.metadata = formData.get("metadata") ?? "";

    return toExit(didDecode(obj));
}

export const Did: {
  readonly defaultValue: typeof didDefaultValue;
  readonly encode: typeof didEncode;
  readonly encodeWithContext: typeof didEncodeWithContext;
  readonly encodePartialWithContext: typeof didEncodePartialWithContext;
  readonly decode: typeof didDecode;
  readonly decodeWithContext: typeof didDecodeWithContext;
  readonly decodePartialWithContext: typeof didDecodePartialWithContext;
  readonly validateField: typeof didValidateField;
  readonly validateFields: typeof didValidateFields;
  readonly hasShape: typeof didHasShape;
  readonly is: typeof didIs;
  readonly createForm: typeof didCreateForm;
  readonly fromFormData: typeof didFromFormData;
} = {
  defaultValue: didDefaultValue,
  encode: didEncode,
  encodeWithContext: didEncodeWithContext,
  encodePartialWithContext: didEncodePartialWithContext,
  decode: didDecode,
  decodeWithContext: didDecodeWithContext,
  decodePartialWithContext: didDecodePartialWithContext,
  validateField: didValidateField,
  validateFields: didValidateFields,
  hasShape: didHasShape,
  is: didIs,
  createForm: didCreateForm,
  fromFormData: didFromFormData
};

