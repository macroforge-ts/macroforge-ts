/** import macro {Gigaform} from "@testground/macro"; */

import type { ActivityType } from './activity-type.svelte';
import type { Actor } from './actor.svelte';
import type { Target } from './target.svelte';


export interface Did {
    
    in: string | Actor;
    
    out: string | Target;
    id: string;
    activityType: ActivityType;
    createdAt: string;
    metadata: string | null;
}

export function didDefaultValue(): Did {
    return {
        in: "",
        out: "",
        id: "",
        activityType: activityTypeDefaultValue(),
        createdAt: "",
        metadata: null,
    };
}

/** Encodes a value to a JSON string. @param value - The value to encode @param keepMetadata - If true, preserves __type and __id fields in the output @returns JSON string representation  */
export function didEncode(value: Did, keepMetadata?: boolean): string {
    const ctx = __mf_EncodeContext.create();
    const __raw = didEncodeWithContext(value, ctx);
    return keepMetadata ? __mf_encodedText(__raw) : __mf_encodedTextWithoutMetadata(__raw, "__type");
}

/** Encodes with an existing context for nested/cyclic object graphs. @param value - The value to encode @param ctx - The encoding context  */
export function didEncodeWithContext(value: Did, ctx: __mf_EncodeContext): Record<string, unknown> {
    return didEncodePartialWithContext(value, ctx);
}

/** Encodes the fields a partial value has, with an existing context. @param value - The value to encode @param ctx - The encoding context @param fields - The fields a `Pick` or `Omit` keeps: every field when left out  */
export function didEncodePartialWithContext(value: Partial<Did>, ctx: __mf_EncodeContext, fields?: __mf_FieldSelection<keyof Did>): Record<string, unknown> {
    const __fields = fields === undefined ? undefined : __mf_fieldRequirement(fields);

    let __id: number | undefined;
    if (__fields === undefined) {
        const existingId = ctx.getId(value);
        if (existingId !== undefined) {
            return { __ref: existingId };
        }
        __id = ctx.register(value);
    }

    const result: Record<string, unknown> = {
        "__type": "Did",
        __id,
    };

    if (__fields === undefined || __fields.keeps("in")) {

        if (value.in !== undefined) {
            result.in = typeof value.in === "string"
                ? value.in
                : actorEncodeWithContext(value.in, ctx);
        }
    }
    if (__fields === undefined || __fields.keeps("out")) {

        if (value.out !== undefined) {
            result.out = typeof value.out === "string"
                ? value.out
                : targetEncodeWithContext(value.out, ctx);
        }
    }
    if (__fields === undefined || __fields.keeps("id")) {

        if (value.id !== undefined) {
            result.id = value.id;
        }
    }
    if (__fields === undefined || __fields.keeps("activityType")) {

        if (value.activityType !== undefined) {
            result.activityType = activityTypeEncodeWithContext(value.activityType, ctx);
        }
    }
    if (__fields === undefined || __fields.keeps("createdAt")) {

        if (value.createdAt !== undefined) {
            result.createdAt = value.createdAt;
        }
    }
    if (__fields === undefined || __fields.keeps("metadata")) {
        if (value.metadata !== undefined) {

            result.metadata = value.metadata;
        }
    }

    return result;
}

/** Decodes input to this type. Automatically detects whether input is a JSON string or object. @param input - JSON string or object to decode @param opts - Optional decoding options @returns Result containing the decoded value or validation errors  */
export function didDecode(input: unknown, opts?: __mf_DecodeOptions): { success: true; value: Did } | { success: false; errors: Array<{ field: string; message: string }> } {
    try {

        const data = typeof input === "string" ? JSON.parse(input) : input;

        const ctx = __mf_DecodeContext.create();
        const resultOrRef = didDecodeWithContext(data, ctx);

        if (__mf_PendingRef.is(resultOrRef)) {
            return ({
	success: false,
	errors: [{
		field: "_root",
		message: "Did.decode: root cannot be a forward reference"
	}]
});
        }

        ctx.applyPatches();
        if (opts?.freeze) {
            ctx.freezeAll();
        }

        const __errors = ctx.getErrors();
        if (__errors.length > 0) {
            return ({
	success: false,
	errors: __errors
});
        }

        return ({
	success: true,
	value: resultOrRef
});
    } catch (e) {
        if (e instanceof __mf_DecodeError) {
            return ({
	success: false,
	errors: e.errors
});
        }
        const message = e instanceof Error ? e.message : String(e);
        return ({
	success: false,
	errors: [{
		field: "_root",
		message
	}]
});
    }
}
