            optional: false,
            array: false,
            path: ["defaults"],
            get: () => data.defaults,
            set: (value: ProductDefaults) => { data.defaults = value; },
            getError: () => errors.defaults,
            setError: (value: Option.Option<Array<string>>) => { errors.defaults = value; },
            getTainted: () => tainted.defaults,
            setTainted: (value: Option.Option<boolean>) => { tainted.defaults = value; },
            validate: () => productValidateField("defaults", data.defaults).map((e: { field: string; message: string }) => e.message),

            constraints: {},


            disabled: false,
            readonly: false,
        },
    } as unknown as ProductFieldControllers;

    function validate(): Exit.Exit<Product, Array<{ field: string; message: string }>> {
        return toExit(productDecode(data));
    }

    function reset(newOverrides?: Partial<Product>): void {
        data = { ...productDefaultValue(), ...newOverrides };
        errors = {
            _errors: Option.none(),
            id: Option.none(),
            name: Option.none(),
            quickCode: Option.none(),
            group: Option.none(),
            subgroup: Option.none(),
            unit: Option.none(),
