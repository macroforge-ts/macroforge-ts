import { productDefaultsDecodeWithContext, productDefaultsEncodeWithContext, productDefaultsDefaultValue } from "./product-defaults.svelte";
import { EncodeContext as __mf_EncodeContext, DecodeContext as __mf_DecodeContext, DecodeError as __mf_DecodeError, PendingRef as __mf_PendingRef } from "@macroforge/core/endec";
import type { DecodeOptions as __mf_DecodeOptions } from "@macroforge/core/endec";
import { Option, Exit } from "effect";
import type { FieldController } from "@testground/macro/gigaform";
import { toExit } from "@testground/macro/gigaform";
/** import macro {Gigaform} from "@testground/macro"; */

import type { ProductDefaults } from './product-defaults.svelte';


export interface Product {
    
    id: string;
    
    
    name: string;
    
    
    quickCode: string;
    
    group: string | null;
    
    subgroup: string | null;
    
    unit: string | null;
    
    active: boolean;
    
    commission: boolean;
    
    favorite: boolean;
    defaults: ProductDefaults;
}

export function productDefaultValue(): Product {
    return {
        id: "",
        name: "",
        quickCode: "",
        group: null,
        subgroup: null,
        unit: null,
        active: false,
        commission: false,
        favorite: false,
        defaults: productDefaultsDefaultValue(),
    };
}

/** Encodes a value to a JSON string. @param value - The value to encode @param keepMetadata - If true, preserves __type and __id fields in the output @returns JSON string representation  */
export function productEncode(value: Product, keepMetadata?: boolean): string {
    const ctx = __mf_EncodeContext.create();
    const __raw = productEncodeWithContext(value, ctx);
    if (keepMetadata) return JSON.stringify(__raw);
    return JSON.stringify(__raw, (key, val) => key === "__type" || key === "__id" ? undefined : val);
}

/** Encodes with an existing context for nested/cyclic object graphs. @param value - The value to encode @param ctx - The encoding context  */
export function productEncodeWithContext(value: Product, ctx: __mf_EncodeContext): Record<string, unknown> {

    const existingId = ctx.getId(value);
    if (existingId !== undefined) {
        return { __ref: existingId };
    }

    const __id = ctx.register(value);

    const result: Record<string, unknown> = {
        "__type": "Product",
        __id,
    };

    
    result.id = value.id;
    result.name = value.name;
    result.quickCode = value.quickCode;
    result.group = value.group;
    result.subgroup = value.subgroup;
    result.unit = value.unit;
    result.active = value.active;
    result.commission = value.commission;
    result.favorite = value.favorite;
    result.defaults = productDefaultsEncodeWithContext(value.defaults, ctx);

    return result;
}

/** Decodes input to this type. Automatically detects whether input is a JSON string or object. @param input - JSON string or object to decode @param opts - Optional decoding options @returns Result containing the decoded value or validation errors  */
export function productDecode(input: unknown, opts?: __mf_DecodeOptions): { success: true; value: Product } | { success: false; errors: Array<{ field: string; message: string }> } {
    try {

        const data = typeof input === "string" ? JSON.parse(input) : input;

        const ctx = __mf_DecodeContext.create();
        const resultOrRef = productDecodeWithContext(data, ctx);

        if (__mf_PendingRef.is(resultOrRef)) {
            return ({
	success: false,
	errors: [{
		field: "_root",
		message: "Product.decode: root cannot be a forward reference"
	}]
});
        }

        ctx.applyPatches();
        if (opts?.freeze) {
            ctx.freezeAll();
        }

        const __errors = ctx.getErrors();
        if (__errors.length > 0) {
            return ({
	success: false,
	errors: __errors
});
        }

        return ({
	success: true,
	value: resultOrRef
});
    } catch (e) {
        if (e instanceof __mf_DecodeError) {
            return ({
	success: false,
	errors: e.errors
});
        }
        const message = e instanceof Error ? e.message : String(e);
        return ({
	success: false,
	errors: [{
		field: "_root",
		message
	}]
});
    }
}
/** Decodes with an existing context for nested/cyclic object graphs. @param value - The raw value to decode @param ctx - The decoding context  */
export function productDecodeWithContext(value: unknown, ctx: __mf_DecodeContext): Product | __mf_PendingRef {
    if (typeof value === "object" && value !== null && "__ref" in value) {
        if (typeof value.__ref !== "number") {
            throw new __mf_DecodeError([{ field: "__ref", message: "Product.decodeWithContext: __ref must be a number" }]);
        }
        return ctx.getOrDefer(value.__ref) as Product | __mf_PendingRef;
    }

    if (typeof value !== "object" || value === null || Array.isArray(value)) {
        throw new __mf_DecodeError([{ field: "_root", message: "Product.decodeWithContext: expected an object" }]);
    }

    const obj = value as Record<string, unknown>;
    const errors: Array<{ field: string; message: string }> = [];
    if (!("id" in obj)) {
        errors.push({ field: "id", message: "missing required field" });
    }
    if (!("name" in obj)) {
        errors.push({ field: "name", message: "missing required field" });
    }
    if (!("quickCode" in obj)) {
        errors.push({ field: "quickCode", message: "missing required field" });
    }
    if (!("group" in obj)) {
        errors.push({ field: "group", message: "missing required field" });
    }
    if (!("subgroup" in obj)) {
        errors.push({ field: "subgroup", message: "missing required field" });
    }
    if (!("unit" in obj)) {
        errors.push({ field: "unit", message: "missing required field" });
    }
    if (!("active" in obj)) {
        errors.push({ field: "active", message: "missing required field" });
    }
    if (!("commission" in obj)) {
        errors.push({ field: "commission", message: "missing required field" });
    }
    if (!("favorite" in obj)) {
        errors.push({ field: "favorite", message: "missing required field" });
    }
    if (!("defaults" in obj)) {
        errors.push({ field: "defaults", message: "missing required field" });
    }

    const instance: any = {};

    if (obj.__id !== undefined) {
        ctx.register(obj.__id as number, instance);
    }

    ctx.trackForFreeze(instance);

    {
        const __raw_id = obj["id"] as string;

        if (!(typeof __raw_id === "string")) {
            errors.push({ field: "id", message: __raw_id == null ? "Product.id is required" : "expected string" });
        } else {
            instance.id = __raw_id;
        }
    }
    {
        const __raw_name = obj["name"] as string;

        if (!(typeof __raw_name === "string")) {
            errors.push({ field: "name", message: __raw_name == null ? "Product.name is required" : "expected string" });
        } else {
            if (__raw_name == null) { errors.push({ field: "name", message: "Product.name is required" }); } else {
                if (__raw_name.length === 0) { errors.push({ field: "name", message: "Product.name must not be empty" }); }
            }
            instance.name = __raw_name;
        }
    }
    {
        const __raw_quickCode = obj["quickCode"] as string;

        if (!(typeof __raw_quickCode === "string")) {
            errors.push({ field: "quickCode", message: __raw_quickCode == null ? "Product.quickCode is required" : "expected string" });
        } else {
            if (__raw_quickCode == null) { errors.push({ field: "quickCode", message: "Product.quickCode is required" }); } else {
                if (__raw_quickCode.length === 0) { errors.push({ field: "quickCode", message: "Product.quickCode must not be empty" }); }
            }
            instance.quickCode = __raw_quickCode;
        }
    }
    {
        const __raw_group = obj["group"] as string | null;

        if (!(typeof __raw_group === "string" || __raw_group === null)) {
            errors.push({ field: "group", message: "expected string | null" });
        } else {
            instance.group = __raw_group;
        }
    }
    {
        const __raw_subgroup = obj["subgroup"] as string | null;

        if (!(typeof __raw_subgroup === "string" || __raw_subgroup === null)) {
            errors.push({ field: "subgroup", message: "expected string | null" });
        } else {
            instance.subgroup = __raw_subgroup;
        }
    }
    {
        const __raw_unit = obj["unit"] as string | null;

        if (!(typeof __raw_unit === "string" || __raw_unit === null)) {
            errors.push({ field: "unit", message: "expected string | null" });
        } else {
            instance.unit = __raw_unit;
        }
    }
    {
        const __raw_active = obj["active"] as boolean;

        if (!(typeof __raw_active === "boolean")) {
            errors.push({ field: "active", message: __raw_active == null ? "Product.active is required" : "expected boolean" });
        } else {
            instance.active = __raw_active;
        }
    }
    {
        const __raw_commission = obj["commission"] as boolean;

        if (!(typeof __raw_commission === "boolean")) {
            errors.push({ field: "commission", message: __raw_commission == null ? "Product.commission is required" : "expected boolean" });
        } else {
            instance.commission = __raw_commission;
        }
    }
    {
        const __raw_favorite = obj["favorite"] as boolean;

        if (!(typeof __raw_favorite === "boolean")) {
            errors.push({ field: "favorite", message: __raw_favorite == null ? "Product.favorite is required" : "expected boolean" });
        } else {
            instance.favorite = __raw_favorite;
        }
    }
    {
        const __raw_defaults = obj["defaults"] as ProductDefaults;

        ctx.pushScope("defaults");
        try {
            const __result = productDefaultsDecodeWithContext(__raw_defaults, ctx);
            ctx.assignOrDefer(instance, "defaults", __result);
        } catch (__e) {
            if (__e instanceof __mf_DecodeError) {
                for (const __err of __e.errors) {
                    errors.push({
                        field: __err.field === "_root" ? "defaults" : "defaults." + __err.field,
                        message: __err.message
