            group: Option.none(),
            subgroup: Option.none(),
            unit: Option.none(),
            active: Option.none(),
            commission: Option.none(),
            favorite: Option.none(),
            defaults: Option.none(),
        };
    }

    return {
        get data() { return data; },
        set data(v) { data = v; },
        get errors() { return errors; },
        set errors(v) { errors = v; },
        get tainted() { return tainted; },
        set tainted(v) { tainted = v; },
        fields,
        validate,
        reset,
    };
