export interface Gradient {
    startHue: number;
}

export function gradientDefaultValue(): Gradient {
    return {
        startHue: 0,
    };
}

/** Encodes a value to a JSON string. @param value - The value to encode @param keepMetadata - If true, preserves __type and __id fields in the output @returns JSON string representation  */
export function gradientEncode(value: Gradient, keepMetadata?: boolean): string {
    const ctx = __mf_EncodeContext.create();
    const __raw = gradientEncodeWithContext(value, ctx);
    return keepMetadata ? __mf_encodedText(__raw) : __mf_encodedTextWithoutMetadata(__raw, "__type");
}

/** Encodes with an existing context for nested/cyclic object graphs. @param value - The value to encode @param ctx - The encoding context  */
export function gradientEncodeWithContext(value: Gradient, ctx: __mf_EncodeContext): Record<string, unknown> {
    return gradientEncodePartialWithContext(value, ctx);
}

/** Encodes the fields a partial value has, with an existing context. @param value - The value to encode @param ctx - The encoding context @param fields - The fields a `Pick` or `Omit` keeps: every field when left out  */
export function gradientEncodePartialWithContext(value: Partial<Gradient>, ctx: __mf_EncodeContext, fields?: __mf_FieldSelection<keyof Gradient>): Record<string, unknown> {
    const __fields = fields === undefined ? undefined : __mf_fieldRequirement(fields);

    let __id: number | undefined;
    if (__fields === undefined) {
        const existingId = ctx.getId(value);
        if (existingId !== undefined) {
            return { __ref: existingId };
        }
        __id = ctx.register(value);
    }

    const result: Record<string, unknown> = {
        "__type": "Gradient",
        __id,
    };

    if (__fields === undefined || __fields.keeps("startHue")) {

        if (value.startHue !== undefined) {
            result.startHue = value.startHue;
        }
    }

    return result;
}

/** Decodes input to this type. Automatically detects whether input is a JSON string or object. @param input - JSON string or object to decode @param opts - Optional decoding options @returns Result containing the decoded value or validation errors  */
export function gradientDecode(input: unknown, opts?: __mf_DecodeOptions): { success: true; value: Gradient } | { success: false; errors: Array<{ field: string; message: string }> } {
    try {

        const data = typeof input === "string" ? JSON.parse(input) : input;

        const ctx = __mf_DecodeContext.create();
        const resultOrRef = gradientDecodeWithContext(data, ctx);

        if (__mf_PendingRef.is(resultOrRef)) {
            return ({
	success: false,
	errors: [{
		field: "_root",
		message: "Gradient.decode: root cannot be a forward reference"
	}]
});
        }

        ctx.applyPatches();
        if (opts?.freeze) {
            ctx.freezeAll();
        }

        const __errors = ctx.getErrors();
        if (__errors.length > 0) {
            return ({
	success: false,
	errors: __errors
});
        }

        return ({
	success: true,
	value: resultOrRef
});
    } catch (e) {
        if (e instanceof __mf_DecodeError) {
            return ({
	success: false,
	errors: e.errors
});
        }
        const message = e instanceof Error ? e.message : String(e);
        return ({
	success: false,
	errors: [{
		field: "_root",
		message
	}]
});
    }
}
/** Decodes with an existing context for nested/cyclic object graphs. @param value - The raw value to decode @param ctx - The decoding context  */
export function gradientDecodeWithContext(value: unknown, ctx: __mf_DecodeContext): Gradient | __mf_PendingRef;
/** Decodes the fields `fields` keeps, and no other. @param value - The raw value to decode @param ctx - The decoding context @param fields - Which fields the value has and has to have  */
export function gradientDecodeWithContext(value: unknown, ctx: __mf_DecodeContext, fields: __mf_FieldRequirement): Partial<Gradient> | __mf_PendingRef;
export function gradientDecodeWithContext(value: unknown, ctx: __mf_DecodeContext, __fields?: __mf_FieldRequirement): Partial<Gradient> | __mf_PendingRef {
    if (__fields !== undefined && typeof value === "object" && value !== null && "__ref" in value) {
        throw new __mf_DecodeError([{ field: "_root", message: "Gradient.decodeWithContext: a value holding a selection of fields cannot be a reference" }]);
    }
    if (typeof value === "object" && value !== null && "__ref" in value) {
        if (typeof value.__ref !== "number") {
            throw new __mf_DecodeError([{ field: "__ref", message: "Gradient.decodeWithContext: __ref must be a number" }]);
        }
        return ctx.getOrDefer(value.__ref) as Gradient | __mf_PendingRef;
    }

    if (typeof value !== "object" || value === null || Array.isArray(value)) {
        throw new __mf_DecodeError([{ field: "_root", message: "Gradient.decodeWithContext: expected an object" }]);
    }

    const obj = value as Record<string, unknown>;
    const errors: Array<{ field: string; message: string }> = [];
    if ((__fields === undefined || __fields.requires("startHue")) && !("startHue" in obj)) {
        errors.push({ field: "startHue", message: "missing required field" });
    }

    const instance: any = {};

    if (__fields === undefined && obj.__id !== undefined) {
        ctx.register(obj.__id as number, instance);
    }

    ctx.trackForFreeze(instance);

    if ((__fields === undefined || __fields.requires("startHue")) || (__fields.keeps("startHue") && obj["startHue"] !== undefined)) {
        const __raw_startHue = obj["startHue"] as number;

        if (!(typeof __raw_startHue === "number")) {
            errors.push({ field: "startHue", message: __raw_startHue == null ? "Gradient.startHue is required" : "expected number" });
        } else {
            instance.startHue = __raw_startHue;
        }
    }

    ctx.pushErrors(errors);

    return instance as Gradient;
}

/** Decodes a `Partial`, `Pick` or `Omit` of this type with an existing context. @param value - The raw value to decode @param ctx - The decoding context @param fields - The fields the value has to have: none when left out  */
export function gradientDecodePartialWithContext(value: unknown, ctx: __mf_DecodeContext, fields?: __mf_FieldSelection<keyof Gradient>): Partial<Gradient> | __mf_PendingRef {
    return gradientDecodeWithContext(value, ctx, __mf_fieldRequirement(fields));
}
