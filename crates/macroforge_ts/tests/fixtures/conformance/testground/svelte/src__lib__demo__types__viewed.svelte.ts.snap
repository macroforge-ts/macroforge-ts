import { encodedText as __mf_encodedText, encodedTextWithoutMetadata as __mf_encodedTextWithoutMetadata, EncodeContext as __mf_EncodeContext, fieldRequirement as __mf_fieldRequirement, DecodeContext as __mf_DecodeContext, DecodeError as __mf_DecodeError, PendingRef as __mf_PendingRef } from "@macroforge/core/endec";
import type { FieldSelection as __mf_FieldSelection, FieldRequirement as __mf_FieldRequirement, DecodeOptions as __mf_DecodeOptions } from "@macroforge/core/endec";
import { Option, Exit } from "effect";
import type { FieldController } from "@testground/macro/gigaform";
import { toExit } from "@testground/macro/gigaform";
/** import macro {Gigaform} from "@testground/macro"; */


export interface Viewed {
    durationSeconds: number | null;
    source: string | null;
}

export function viewedDefaultValue(): Viewed {
    return {
        durationSeconds: null,
        source: null,
    };
}

/** Encodes a value to a JSON string. @param value - The value to encode @param keepMetadata - If true, preserves __type and __id fields in the output @returns JSON string representation  */
export function viewedEncode(value: Viewed, keepMetadata?: boolean): string {
    const ctx = __mf_EncodeContext.create();
    const __raw = viewedEncodeWithContext(value, ctx);
    return keepMetadata ? __mf_encodedText(__raw) : __mf_encodedTextWithoutMetadata(__raw, "__type");
}

/** Encodes with an existing context for nested/cyclic object graphs. @param value - The value to encode @param ctx - The encoding context  */
export function viewedEncodeWithContext(value: Viewed, ctx: __mf_EncodeContext): Record<string, unknown> {
    return viewedEncodePartialWithContext(value, ctx);
}

/** Encodes the fields a partial value has, with an existing context. @param value - The value to encode @param ctx - The encoding context @param fields - The fields a `Pick` or `Omit` keeps: every field when left out  */
export function viewedEncodePartialWithContext(value: Partial<Viewed>, ctx: __mf_EncodeContext, fields?: __mf_FieldSelection<keyof Viewed>): Record<string, unknown> {
    const __fields = fields === undefined ? undefined : __mf_fieldRequirement(fields);

    let __id: number | undefined;
    if (__fields === undefined) {
        const existingId = ctx.getId(value);
        if (existingId !== undefined) {
            return { __ref: existingId };
        }
        __id = ctx.register(value);
    }

    const result: Record<string, unknown> = {
        "__type": "Viewed",
        __id,
    };

    if (__fields === undefined || __fields.keeps("durationSeconds")) {
        if (value.durationSeconds !== undefined) {

            result.durationSeconds = value.durationSeconds;
        }
    }
    if (__fields === undefined || __fields.keeps("source")) {
        if (value.source !== undefined) {

            result.source = value.source;
        }
    }

    return result;
}

/** Decodes input to this type. Automatically detects whether input is a JSON string or object. @param input - JSON string or object to decode @param opts - Optional decoding options @returns Result containing the decoded value or validation errors  */
export function viewedDecode(input: unknown, opts?: __mf_DecodeOptions): { success: true; value: Viewed } | { success: false; errors: Array<{ field: string; message: string }> } {
    try {

        const data = typeof input === "string" ? JSON.parse(input) : input;

        const ctx = __mf_DecodeContext.create();
        const resultOrRef = viewedDecodeWithContext(data, ctx);

        if (__mf_PendingRef.is(resultOrRef)) {
            return ({
	success: false,
	errors: [{
		field: "_root",
		message: "Viewed.decode: root cannot be a forward reference"
	}]
});
        }

        ctx.applyPatches();
        if (opts?.freeze) {
            ctx.freezeAll();
        }

        const __errors = ctx.getErrors();
        if (__errors.length > 0) {
            return ({
	success: false,
	errors: __errors
});
        }

        return ({
	success: true,
	value: resultOrRef
});
    } catch (e) {
        if (e instanceof __mf_DecodeError) {
            return ({
	success: false,
	errors: e.errors
});
        }
        const message = e instanceof Error ? e.message : String(e);
        return ({
	success: false,
	errors: [{
		field: "_root",
		message
	}]
});
    }
}
/** Decodes with an existing context for nested/cyclic object graphs. @param value - The raw value to decode @param ctx - The decoding context  */
export function viewedDecodeWithContext(value: unknown, ctx: __mf_DecodeContext): Viewed | __mf_PendingRef;
/** Decodes the fields `fields` keeps, and no other. @param value - The raw value to decode @param ctx - The decoding context @param fields - Which fields the value has and has to have  */
export function viewedDecodeWithContext(value: unknown, ctx: __mf_DecodeContext, fields: __mf_FieldRequirement): Partial<Viewed> | __mf_PendingRef;
export function viewedDecodeWithContext(value: unknown, ctx: __mf_DecodeContext, __fields?: __mf_FieldRequirement): Partial<Viewed> | __mf_PendingRef {
    if (__fields !== undefined && typeof value === "object" && value !== null && "__ref" in value) {
        throw new __mf_DecodeError([{ field: "_root", message: "Viewed.decodeWithContext: a value holding a selection of fields cannot be a reference" }]);
    }
    if (typeof value === "object" && value !== null && "__ref" in value) {
        if (typeof value.__ref !== "number") {
            throw new __mf_DecodeError([{ field: "__ref", message: "Viewed.decodeWithContext: __ref must be a number" }]);
        }
        return ctx.getOrDefer(value.__ref) as Viewed | __mf_PendingRef;
    }

    if (typeof value !== "object" || value === null || Array.isArray(value)) {
        throw new __mf_DecodeError([{ field: "_root", message: "Viewed.decodeWithContext: expected an object" }]);
    }

    const obj = value as Record<string, unknown>;
    const errors: Array<{ field: string; message: string }> = [];
    if ((__fields === undefined || __fields.requires("durationSeconds")) && !("durationSeconds" in obj)) {
        errors.push({ field: "durationSeconds", message: "missing required field" });
    }
    if ((__fields === undefined || __fields.requires("source")) && !("source" in obj)) {
        errors.push({ field: "source", message: "missing required field" });
    }

    const instance: any = {};

    if (__fields === undefined && obj.__id !== undefined) {
        ctx.register(obj.__id as number, instance);
    }

    ctx.trackForFreeze(instance);

    if ((__fields === undefined || __fields.requires("durationSeconds")) || (__fields.keeps("durationSeconds") && obj["durationSeconds"] !== undefined)) {
        const __raw_durationSeconds = obj["durationSeconds"] as number | null;

        if (!(typeof __raw_durationSeconds === "number" || __raw_durationSeconds === null)) {
            errors.push({ field: "durationSeconds", message: "expected number | null" });
        } else {
            instance.durationSeconds = __raw_durationSeconds;
        }
    }
    if ((__fields === undefined || __fields.requires("source")) || (__fields.keeps("source") && obj["source"] !== undefined)) {
        const __raw_source = obj["source"] as string | null;

        if (!(typeof __raw_source === "string" || __raw_source === null)) {
            errors.push({ field: "source", message: "expected string | null" });
        } else {
            instance.source = __raw_source;
        }
    }

    ctx.pushErrors(errors);

    return instance as Viewed;
}

/** Decodes a `Partial`, `Pick` or `Omit` of this type with an existing context. @param value - The raw value to decode @param ctx - The decoding context @param fields - The fields the value has to have: none when left out  */
export function viewedDecodePartialWithContext(value: unknown, ctx: __mf_DecodeContext, fields?: __mf_FieldSelection<keyof Viewed>): Partial<Viewed> | __mf_PendingRef {
    return viewedDecodeWithContext(value, ctx, __mf_fieldRequirement(fields));
}
