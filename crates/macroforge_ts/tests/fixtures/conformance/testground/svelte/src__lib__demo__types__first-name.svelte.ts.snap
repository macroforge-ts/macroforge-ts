            set: (value: string) => { data.name = value; },
            getError: () => errors.name,
            setError: (value: Option.Option<Array<string>>) => { errors.name = value; },
            getTainted: () => tainted.name,
            setTainted: (value: Option.Option<boolean>) => { tainted.name = value; },
