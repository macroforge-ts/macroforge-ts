        return toExit(firstNameDecode(data));
    }

    function reset(newOverrides?: Partial<FirstName>): void {
        data = { ...firstNameDefaultValue(), ...newOverrides };
        errors = {
            _errors: Option.none(),
            name: Option.none(),
        };
        tainted = {
