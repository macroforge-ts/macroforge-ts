import { accountDecodeWithContext, accountEncodeWithContext } from "./account.svelte";
import { employeeDecodeWithContext, employeeEncodeWithContext } from "./employee.svelte";
import { EncodeContext as __mf_EncodeContext, DecodeContext as __mf_DecodeContext, DecodeError as __mf_DecodeError, PendingRef as __mf_PendingRef } from "@macroforge/core/endec";
import type { DecodeOptions as __mf_DecodeOptions } from "@macroforge/core/endec";
import { Option, Exit } from "effect";
import type { FieldController } from "@testground/macro/gigaform";
import { toExit } from "@testground/macro/gigaform";
/** import macro {Gigaform} from "@testground/macro"; */

import type { Account } from './account.svelte';
import type { Employee } from './employee.svelte';


export interface Represents {
    
    in: string | Employee;
    
    out: string | Account;
    id: string;
    dateStarted: string;
}

export function representsDefaultValue(): Represents {
    return {
        in: "",
        out: "",
        id: "",
        dateStarted: "",
    };
}

/** Encodes a value to a JSON string. @param value - The value to encode @param keepMetadata - If true, preserves __type and __id fields in the output @returns JSON string representation  */
export function representsEncode(value: Represents, keepMetadata?: boolean): string {
    const ctx = __mf_EncodeContext.create();
    const __raw = representsEncodeWithContext(value, ctx);
    if (keepMetadata) return JSON.stringify(__raw);
    return JSON.stringify(__raw, (key, val) => key === "__type" || key === "__id" ? undefined : val);
}

/** Encodes with an existing context for nested/cyclic object graphs. @param value - The value to encode @param ctx - The encoding context  */
export function representsEncodeWithContext(value: Represents, ctx: __mf_EncodeContext): Record<string, unknown> {

    const existingId = ctx.getId(value);
    if (existingId !== undefined) {
        return { __ref: existingId };
    }

    const __id = ctx.register(value);

    const result: Record<string, unknown> = {
        "__type": "Represents",
        __id,
    };

    
    result.in = typeof value.in === "string"
        ? value.in
        : employeeEncodeWithContext(value.in, ctx);
    result.out = typeof value.out === "string"
        ? value.out
        : accountEncodeWithContext(value.out, ctx);
    result.id = value.id;
    result.dateStarted = value.dateStarted;

    return result;
}

/** Decodes input to this type. Automatically detects whether input is a JSON string or object. @param input - JSON string or object to decode @param opts - Optional decoding options @returns Result containing the decoded value or validation errors  */
export function representsDecode(input: unknown, opts?: __mf_DecodeOptions): { success: true; value: Represents } | { success: false; errors: Array<{ field: string; message: string }> } {
    try {

        const data = typeof input === "string" ? JSON.parse(input) : input;

        const ctx = __mf_DecodeContext.create();
        const resultOrRef = representsDecodeWithContext(data, ctx);

        if (__mf_PendingRef.is(resultOrRef)) {
            return ({
	success: false,
	errors: [{
		field: "_root",
		message: "Represents.decode: root cannot be a forward reference"
	}]
});
        }

        ctx.applyPatches();
        if (opts?.freeze) {
            ctx.freezeAll();
        }

        const __errors = ctx.getErrors();
        if (__errors.length > 0) {
            return ({
	success: false,
	errors: __errors
});
        }

        return ({
	success: true,
	value: resultOrRef
});
    } catch (e) {
        if (e instanceof __mf_DecodeError) {
            return ({
	success: false,
	errors: e.errors
});
        }
        const message = e instanceof Error ? e.message : String(e);
        return ({
	success: false,
	errors: [{
		field: "_root",
		message
	}]
});
    }
}
/** Decodes with an existing context for nested/cyclic object graphs. @param value - The raw value to decode @param ctx - The decoding context  */
export function representsDecodeWithContext(value: unknown, ctx: __mf_DecodeContext): Represents | __mf_PendingRef {
    if (typeof value === "object" && value !== null && "__ref" in value) {
        if (typeof value.__ref !== "number") {
            throw new __mf_DecodeError([{ field: "__ref", message: "Represents.decodeWithContext: __ref must be a number" }]);
        }
        return ctx.getOrDefer(value.__ref) as Represents | __mf_PendingRef;
    }

    if (typeof value !== "object" || value === null || Array.isArray(value)) {
        throw new __mf_DecodeError([{ field: "_root", message: "Represents.decodeWithContext: expected an object" }]);
    }

    const obj = value as Record<string, unknown>;
    const errors: Array<{ field: string; message: string }> = [];
    if (!("in" in obj)) {
        errors.push({ field: "in", message: "missing required field" });
    }
    if (!("out" in obj)) {
        errors.push({ field: "out", message: "missing required field" });
    }
    if (!("id" in obj)) {
        errors.push({ field: "id", message: "missing required field" });
    }
    if (!("dateStarted" in obj)) {
        errors.push({ field: "dateStarted", message: "missing required field" });
    }

    const instance: any = {};

    if (obj.__id !== undefined) {
        ctx.register(obj.__id as number, instance);
    }

    ctx.trackForFreeze(instance);

    {
        const __raw_in = obj["in"] as string | Employee;

        if (typeof __raw_in === "string") {
            instance.in = __raw_in;
        } else {
            ctx.pushScope("in");
            try {
                const __result = employeeDecodeWithContext(__raw_in, ctx);
                ctx.assignOrDefer(instance, "in", __result);
            } catch (__e) {
                if (__e instanceof __mf_DecodeError) {
                    for (const __err of __e.errors) {
                        errors.push({
                            field: __err.field === "_root" ? "in" : "in." + __err.field,
                            message: __err.message
                        });
                    }
                } else {
                    throw __e;
                }
            } finally {
                ctx.popScope();
            }
        }
    }
    {
        const __raw_out = obj["out"] as string | Account;

        if (typeof __raw_out === "string") {
            instance.out = __raw_out;
        } else {
            ctx.pushScope("out");
            try {
                const __result = accountDecodeWithContext(__raw_out, ctx);
                ctx.assignOrDefer(instance, "out", __result);
            } catch (__e) {
                if (__e instanceof __mf_DecodeError) {
                    for (const __err of __e.errors) {
                        errors.push({
                            field: __err.field === "_root" ? "out" : "out." + __err.field,
                            message: __err.message
                        });
                    }
                } else {
                    throw __e;
                }
            } finally {
                ctx.popScope();
            }
        }
    }
    {
        const __raw_id = obj["id"] as string;

        if (!(typeof __raw_id === "string")) {
            errors.push({ field: "id", message: __raw_id == null ? "Represents.id is required" : "expected string" });
        } else {
            instance.id = __raw_id;
        }
    }
    {
        const __raw_dateStarted = obj["dateStarted"] as string;

        if (!(typeof __raw_dateStarted === "string")) {
            errors.push({ field: "dateStarted", message: __raw_dateStarted == null ? "Represents.dateStarted is required" : "expected string" });
        } else {
            instance.dateStarted = __raw_dateStarted;
        }
    }

    ctx.pushErrors(errors);

    return instance as Represents;
}
export function representsValidateField<K extends keyof Represents>(field: K, value: unknown): Array<{ field: string; message: string }>;
export function representsValidateField(): Array<{ field: string; message: string }> {
    return [];
}

export function representsValidateFields(partial: { readonly [K in keyof Represents]?: unknown }): Array<{ field: string; message: string }>;
export function representsValidateFields(): Array<{ field: string; message: string }> {
    return [];
}
export function representsHasShape(obj: unknown): boolean {
    if (typeof obj !== "object" || obj === null || Array.isArray(obj)) {
        return false;
    }
    const o = obj as Record<string, unknown>;
    return "in" in o && "out" in o && "id" in o && "dateStarted" in o;
}

export function representsIs(obj: unknown): obj is Represents {
    return representsHasShape(obj) && representsDecode(obj).success;
}

/** Nested error structure matching the data shape  */
export type RepresentsErrors = {
    _errors: Option.Option<Array<string>>;
    in: Option.Option<Array<string>>;
    out: Option.Option<Array<string>>;
    id: Option.Option<Array<string>>;
    dateStarted: Option.Option<Array<string>>;
};

/** Nested boolean structure for tracking touched/dirty fields  */
export type RepresentsTainted = {
    in: Option.Option<boolean>;
    out: Option.Option<boolean>;
    id: Option.Option<boolean>;
    dateStarted: Option.Option<boolean>;
};

/** Type-safe field controllers for this form  */
export interface RepresentsFieldControllers {
    readonly in: FieldController<string | Employee>;
    readonly out: FieldController<string | Account>;
    readonly id: FieldController<string>;
    readonly dateStarted: FieldController<string>;
}

/** Gigaform instance containing reactive state and field controllers  */
export interface RepresentsGigaform {
    readonly data: Represents;
    readonly errors: RepresentsErrors;
    readonly tainted: RepresentsTainted;
    readonly fields: RepresentsFieldControllers;
    validate(): Exit.Exit<Represents, Array<{ field: string; message: string }>>;
    reset(overrides?: Partial<Represents>): void;
}
/** Creates a new Gigaform instance with reactive state and field controllers.  */
export function representsCreateForm(overrides?: Partial<Represents>): RepresentsGigaform {
    let data = $state({ ...representsDefaultValue(), ...overrides });
    let errors = $state<RepresentsErrors>({
        _errors: Option.none(),
        in: Option.none(),
        out: Option.none(),
        id: Option.none(),
        dateStarted: Option.none(),
    });
    let tainted = $state<RepresentsTainted>({
        in: Option.none(),
        out: Option.none(),
        id: Option.none(),
        dateStarted: Option.none(),
    });
    const fields = {
        in: {
            name: "in",
            label: "in",
            type: "text",
            optional: false,
            array: false,
            path: ["in"],
            get: () => data.in,
            set: (value: string | Employee) => { data.in = value; },
            getError: () => errors.in,
            setError: (value: Option.Option<Array<string>>) => { errors.in = value; },
            getTainted: () => tainted.in,
            setTainted: (value: Option.Option<boolean>) => { tainted.in = value; },
            validate: () => representsValidateField("in", data.in).map((e: { field: string; message: string }) => e.message),

            constraints: {},


            disabled: false,
            readonly: false,
        },
        out: {
            name: "out",
            label: "out",
            type: "text",
            optional: false,
            array: false,
            path: ["out"],
            get: () => data.out,
            set: (value: string | Account) => { data.out = value; },
            getError: () => errors.out,
            setError: (value: Option.Option<Array<string>>) => { errors.out = value; },
            getTainted: () => tainted.out,
            setTainted: (value: Option.Option<boolean>) => { tainted.out = value; },
            validate: () => representsValidateField("out", data.out).map((e: { field: string; message: string }) => e.message),

            constraints: {},


            disabled: false,
            readonly: false,
        },
        id: {
            name: "id",
            label: "id",
            type: "text",
            optional: false,
            array: false,
            path: ["id"],
            get: () => data.id,
            set: (value: string) => { data.id = value; },
            getError: () => errors.id,
            setError: (value: Option.Option<Array<string>>) => { errors.id = value; },
            getTainted: () => tainted.id,
            setTainted: (value: Option.Option<boolean>) => { tainted.id = value; },
            validate: () => representsValidateField("id", data.id).map((e: { field: string; message: string }) => e.message),

            constraints: {},


            disabled: false,
            readonly: false,
        },
        dateStarted: {
            name: "dateStarted",
            label: "dateStarted",
            type: "text",
            optional: false,
            array: false,
            path: ["dateStarted"],
            get: () => data.dateStarted,
            set: (value: string) => { data.dateStarted = value; },
            getError: () => errors.dateStarted,
            setError: (value: Option.Option<Array<string>>) => { errors.dateStarted = value; },
            getTainted: () => tainted.dateStarted,
            setTainted: (value: Option.Option<boolean>) => { tainted.dateStarted = value; },
            validate: () => representsValidateField("dateStarted", data.dateStarted).map((e: { field: string; message: string }) => e.message),

            constraints: {},


            disabled: false,
            readonly: false,
        },
    } as unknown as RepresentsFieldControllers;

    function validate(): Exit.Exit<Represents, Array<{ field: string; message: string }>> {
        return toExit(representsDecode(data));
    }

    function reset(newOverrides?: Partial<Represents>): void {
        data = { ...representsDefaultValue(), ...newOverrides };
        errors = {
            _errors: Option.none(),
            in: Option.none(),
            out: Option.none(),
            id: Option.none(),
            dateStarted: Option.none(),
        };
        tainted = {
            in: Option.none(),
            out: Option.none(),
            id: Option.none(),
            dateStarted: Option.none(),
        };
    }

    return {
        get data() { return data; },
        set data(v) { data = v; },
        get errors() { return errors; },
        set errors(v) { errors = v; },
        get tainted() { return tainted; },
        set tainted(v) { tainted = v; },
        fields,
        validate,
        reset,
    };
}
/** Parses FormData and validates it, returning a Result with the parsed data or errors. Delegates validation to decode() from @derive(Decode).  */
export function representsFromFormData(formData: FormData): Exit.Exit<Represents, Array<{ field: string; message: string }>> {
    const obj: Record<string, unknown> = {};

    
    obj.in = formData.get("in") ?? "";
    obj.out = formData.get("out") ?? "";
    obj.id = formData.get("id") ?? "";
    obj.dateStarted = formData.get("dateStarted") ?? "";

    return toExit(representsDecode(obj));
}

