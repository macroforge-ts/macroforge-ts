import { EncodeContext as __mf_EncodeContext, derivedEncoder as __mf_derivedEncoder, DecodeContext as __mf_DecodeContext, DecodeError as __mf_DecodeError, PendingRef as __mf_PendingRef } from "@macroforge/core/endec";
import type { DecodeOptions as __mf_DecodeOptions } from "@macroforge/core/endec";
import { Option, Exit } from "effect";
import type { FieldController } from "@testground/macro/gigaform";
import { toExit } from "@testground/macro/gigaform";
/** import macro {Gigaform} from "@testground/macro"; */


export type Weekday =
    | /** @default */ 'Monday'
    | 'Tuesday'
    | 'Wednesday'
    | 'Thursday'
    | 'Friday'
    | 'Saturday'
    | 'Sunday';

export function weekdayDefaultValue(): Weekday {
    return "Monday";
}

/** Encodes a value to a JSON string. @param value - The value to encode @param keepMetadata - If true, preserves __type and __id fields in the output @returns JSON string representation  */
export function weekdayEncode(value: Weekday, keepMetadata?: boolean): string {
    const ctx = __mf_EncodeContext.create();
    const __raw = weekdayEncodeWithContext(value, ctx);
    if (keepMetadata) return JSON.stringify(__raw);
    return JSON.stringify(__raw, (key, val) => key === "__type" || key === "__id" ? undefined : val);
}

/** Encodes with an existing context for nested/cyclic object graphs. @param value - The value to encode @param ctx - The encoding context  */
export function weekdayEncodeWithContext(value: Weekday, ctx: __mf_EncodeContext): unknown {
    let __variant: unknown;
    let __matched = false;
    const __encoder = __mf_derivedEncoder(value);
    if (__encoder) {
        __variant = __encoder(value, ctx);
        __matched = true;
    }
    
    if (!__matched) {
        __variant = value;
    }

    if (__variant !== null && typeof __variant === "object" && "__type" in (__variant as any)) {
        const { __type: __typeName, ...fields } = __variant as any;
        return { "__type": (value as any)["__type"] ?? __typeName, ...fields };
    }
    return __variant;
}

/** Decodes a literal union value. Validates input against known variants. @param input - Value to validate @returns Result containing the validated value or error  */
export function weekdayDecode(input: unknown): { success: true; value: Weekday } | { success: false; errors: Array<{ field: string; message: string }> } {
    switch (input) {
        case 'Monday':
        case 'Tuesday':
        case 'Wednesday':
        case 'Thursday':
        case 'Friday':
        case 'Saturday':
        case 'Sunday':
            return { success: true, value: input as Weekday };
        default:
            return { success: false, errors: [{ field: "_root", message: "Invalid value for Weekday: expected one of " + ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'].map(v => JSON.stringify(v)).join(", ") + ", got " + JSON.stringify(input) }] };
    }
}

/** Decodes with an existing context (validates against known variants). A literal holds no references, so the context goes unread.  */
export function weekdayDecodeWithContext(value: unknown, _ctx: __mf_DecodeContext): Weekday | __mf_PendingRef {
    switch (value) {
        case 'Monday':
        case 'Tuesday':
        case 'Wednesday':
        case 'Thursday':
        case 'Friday':
        case 'Saturday':
        case 'Sunday':
            return value as Weekday;
        default:
            throw new __mf_DecodeError([{
                field: "_root",
                message: "Invalid value for Weekday: expected one of " + ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'].map(v => JSON.stringify(v)).join(", ") + ", got " + JSON.stringify(value)
            }]);
    }
}

export function weekdayHasShape(value: unknown): boolean {
    switch (value) {
        case 'Monday':
        case 'Tuesday':
        case 'Wednesday':
        case 'Thursday':
        case 'Friday':
        case 'Saturday':
        case 'Sunday':
            return true;
        default:
            return false;
    }
}

export function weekdayIs(value: unknown): value is Weekday {
    return weekdayHasShape(value);
}

