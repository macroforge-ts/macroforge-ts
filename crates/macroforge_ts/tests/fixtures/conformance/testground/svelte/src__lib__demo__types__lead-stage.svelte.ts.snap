import { EncodeContext as __mf_EncodeContext, derivedEncoder as __mf_derivedEncoder, DecodeContext as __mf_DecodeContext, DecodeError as __mf_DecodeError, PendingRef as __mf_PendingRef } from "@macroforge/core/endec";
import type { DecodeOptions as __mf_DecodeOptions } from "@macroforge/core/endec";
import { Option, Exit } from "effect";
import type { FieldController } from "@testground/macro/gigaform";
import { toExit } from "@testground/macro/gigaform";
/** import macro {Gigaform} from "@testground/macro"; */


export type LeadStage =
    | /** @default */ 'Open'
    | 'InitialContact'
    | 'Qualified'
    | 'Estimate'
    | 'Negotiation';

export function leadStageDefaultValue(): LeadStage {
    return "Open";
}

/** Encodes a value to a JSON string. @param value - The value to encode @param keepMetadata - If true, preserves __type and __id fields in the output @returns JSON string representation  */
export function leadStageEncode(value: LeadStage, keepMetadata?: boolean): string {
    const ctx = __mf_EncodeContext.create();
    const __raw = leadStageEncodeWithContext(value, ctx);
    if (keepMetadata) return JSON.stringify(__raw);
    return JSON.stringify(__raw, (key, val) => key === "__type" || key === "__id" ? undefined : val);
}

/** Encodes with an existing context for nested/cyclic object graphs. @param value - The value to encode @param ctx - The encoding context  */
export function leadStageEncodeWithContext(value: LeadStage, ctx: __mf_EncodeContext): unknown {
    let __variant: unknown;
    let __matched = false;
    const __encoder = __mf_derivedEncoder(value);
    if (__encoder) {
        __variant = __encoder(value, ctx);
        __matched = true;
    }
    
    if (!__matched) {
        __variant = value;
    }

    if (__variant !== null && typeof __variant === "object" && "__type" in (__variant as any)) {
        const { __type: __typeName, ...fields } = __variant as any;
        return { "__type": (value as any)["__type"] ?? __typeName, ...fields };
    }
    return __variant;
}

/** Decodes a literal union value. Validates input against known variants. @param input - Value to validate @returns Result containing the validated value or error  */
export function leadStageDecode(input: unknown): { success: true; value: LeadStage } | { success: false; errors: Array<{ field: string; message: string }> } {
    switch (input) {
        case 'Open':
        case 'InitialContact':
        case 'Qualified':
        case 'Estimate':
        case 'Negotiation':
            return { success: true, value: input as LeadStage };
        default:
            return { success: false, errors: [{ field: "_root", message: "Invalid value for LeadStage: expected one of " + ['Open', 'InitialContact', 'Qualified', 'Estimate', 'Negotiation'].map(v => JSON.stringify(v)).join(", ") + ", got " + JSON.stringify(input) }] };
    }
}

/** Decodes with an existing context (validates against known variants). A literal holds no references, so the context goes unread.  */
export function leadStageDecodeWithContext(value: unknown, _ctx: __mf_DecodeContext): LeadStage | __mf_PendingRef {
    switch (value) {
        case 'Open':
        case 'InitialContact':
        case 'Qualified':
        case 'Estimate':
        case 'Negotiation':
            return value as LeadStage;
        default:
            throw new __mf_DecodeError([{
                field: "_root",
                message: "Invalid value for LeadStage: expected one of " + ['Open', 'InitialContact', 'Qualified', 'Estimate', 'Negotiation'].map(v => JSON.stringify(v)).join(", ") + ", got " + JSON.stringify(value)
            }]);
    }
}

export function leadStageHasShape(value: unknown): boolean {
    switch (value) {
        case 'Open':
        case 'InitialContact':
        case 'Qualified':
        case 'Estimate':
        case 'Negotiation':
            return true;
        default:
            return false;
    }
}

export function leadStageIs(value: unknown): value is LeadStage {
    return leadStageHasShape(value);
}

/** Per-variant error types  */

export type LeadStageOpenErrors = {
    _errors: Option.Option<Array<string>>;
};
export type LeadStageInitialContactErrors = {
