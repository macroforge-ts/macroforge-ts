/** Union error type  */
export type LeadStageErrors = ({ _value: "Open" } & LeadStageOpenErrors) | ({ _value: "InitialContact" } & LeadStageInitialContactErrors) | ({ _value: "Qualified" } & LeadStageQualifiedErrors) | ({ _value: "Estimate" } & LeadStageEstimateErrors) | ({ _value: "Negotiation" } & LeadStageNegotiationErrors);

/** Union tainted type  */
export type LeadStageTainted = ({ _value: "Open" } & LeadStageOpenTainted) | ({ _value: "InitialContact" } & LeadStageInitialContactTainted) | ({ _value: "Qualified" } & LeadStageQualifiedTainted) | ({ _value: "Estimate" } & LeadStageEstimateTainted) | ({ _value: "Negotiation" } & LeadStageNegotiationTainted);

