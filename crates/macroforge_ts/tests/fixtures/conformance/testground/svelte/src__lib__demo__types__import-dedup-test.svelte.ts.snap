import { parsedText as __mf_parsedText, ownMembers as __mf_ownMembers, fieldRequirement as __mf_fieldRequirement, holdsAll as __mf_holdsAll, DecodeContext as __mf_DecodeContext, DecodeError as __mf_DecodeError, PendingRef as __mf_PendingRef } from "@macroforge/core/endec";
import type { FieldSelection as __mf_FieldSelection, FieldRequirement as __mf_FieldRequirement, DecodeOptions as __mf_DecodeOptions } from "@macroforge/core/endec";
import { equalWithin as __mf_equalWithin, comparedWithin as __mf_comparedWithin } from "@macroforge/core/structural";
/**
 * Stress test for aliased imports and tree-shaking.
 *
 * Macroforge now imports specific functions with `__mf_` prefixed aliases
 * to avoid any risk of collision with user imports:
 *
 * - `import { succeed as __mf_exitSucceed } from "effect/Exit";`
 * - `import { some as __mf_optionSome } from "effect/Option";`
 *
 * This approach:
 * - Eliminates namespace collisions with user imports
 * - Enables better tree-shaking (only specific functions imported)
 * - Is explicit about what macroforge uses
 *
 * The user's `import { Exit, Option } from "effect"` is preserved and works
 * alongside the aliased imports without any conflict.
 */

import { Exit, Option } from 'effect';

// Test 1: Type with Decode (uses Exit for return type)

export interface UserWithDecode {
    name: string;
    age: number;
    email: string;
}

/** Decodes input to this type. Automatically detects whether input is a JSON string or object. @param input - JSON string or object to decode @param opts - Optional decoding options @returns Result containing the decoded value or validation errors  */
export function userWithDecodeDecode(input: unknown, opts?: __mf_DecodeOptions): { success: true; value: UserWithDecode } | { success: false; errors: Array<{ field: string; message: string }> } {
    try {

        const data = typeof input === "string" ? __mf_parsedText(input) : input;

        const ctx = __mf_DecodeContext.create();
        const resultOrRef = userWithDecodeDecodeWithContext(data, ctx);

        if (__mf_PendingRef.is(resultOrRef)) {
            return ({
	success: false,
	errors: [{
		field: "_root",
		message: "UserWithDecode.decode: root cannot be a forward reference"
	}]
});
        }

        ctx.applyPatches();
        if (opts?.freeze) {
            ctx.freezeAll();
        }

        const __errors = ctx.getErrors();
        if (__errors.length > 0) {
            return ({
	success: false,
	errors: __errors
});
        }

        return ({
	success: true,
	value: resultOrRef
});
    } catch (e) {
        if (e instanceof __mf_DecodeError) {
            return ({
	success: false,
	errors: e.errors
});
        }
        const message = e instanceof Error ? e.message : String(e);
        return ({
	success: false,
	errors: [{
		field: "_root",
		message
	}]
});
    }
}
/** Decodes with an existing context for nested/cyclic object graphs. @param value - The raw value to decode @param ctx - The decoding context  */
export function userWithDecodeDecodeWithContext(value: unknown, ctx: __mf_DecodeContext): UserWithDecode | __mf_PendingRef;
/** Decodes the fields `fields` keeps, and no other. @param value - The raw value to decode @param ctx - The decoding context @param fields - Which fields the value has and has to have  */
export function userWithDecodeDecodeWithContext(value: unknown, ctx: __mf_DecodeContext, fields: __mf_FieldRequirement): Partial<UserWithDecode> | __mf_PendingRef;
export function userWithDecodeDecodeWithContext(value: unknown, ctx: __mf_DecodeContext, __fields?: __mf_FieldRequirement): Partial<UserWithDecode> | __mf_PendingRef {
    if (__fields !== undefined && typeof value === "object" && value !== null && "__ref" in value) {
        throw new __mf_DecodeError([{ field: "_root", message: "UserWithDecode.decodeWithContext: a value holding a selection of fields cannot be a reference" }]);
    }
    if (typeof value === "object" && value !== null && "__ref" in value) {
        if (typeof value.__ref !== "number") {
            throw new __mf_DecodeError([{ field: "__ref", message: "UserWithDecode.decodeWithContext: __ref must be a number" }]);
        }
        return ctx.getOrDefer(value.__ref, "UserWithDecode") as UserWithDecode | __mf_PendingRef;
    }

    if (typeof value !== "object" || value === null || Array.isArray(value)) {
        throw new __mf_DecodeError([{ field: "_root", message: "UserWithDecode.decodeWithContext: expected an object" }]);
    }

    const obj = __mf_ownMembers(value);
    const errors: Array<{ field: string; message: string }> = [];

    const __requiredKeys: ReadonlyArray<readonly [string, string]> = [["name", "name"], ["age", "age"], ["email", "email"]];
    for (const [__name, __key] of __requiredKeys) {
        if ((__fields === undefined || __fields.requires(__name)) && !(__key in obj)) {
            errors.push({ field: __key, message: "missing required field" });
        }
    }

    const instance: any = {};

    if (__fields === undefined && obj["__id"] !== undefined) {
        ctx.register(obj["__id"] as number, instance, "UserWithDecode");
    }

    ctx.trackForFreeze(instance);

    for (const __part of [
        () => {
            if ((__fields === undefined || __fields.requires("name")) ? "name" in obj : (__fields.keeps("name") && obj["name"] !== undefined)) {
                const __raw_name = obj["name"] as string;

                if (!(typeof __raw_name === "string")) {
                    errors.push({ field: "name", message: __raw_name == null ? "UserWithDecode.name is required" : "expected string" });
                } else {
                    instance.name = __raw_name;
                }
            }
        },
        () => {
            if ((__fields === undefined || __fields.requires("age")) ? "age" in obj : (__fields.keeps("age") && obj["age"] !== undefined)) {
                const __raw_age = obj["age"] as number;

                if (!(typeof __raw_age === "number" && globalThis.Number.isFinite(__raw_age))) {
                    errors.push({ field: "age", message: __raw_age == null ? "UserWithDecode.age is required" : "expected number" });
                } else {
                    instance.age = __raw_age;
                }
            }
        },
        () => {
            if ((__fields === undefined || __fields.requires("email")) ? "email" in obj : (__fields.keeps("email") && obj["email"] !== undefined)) {
                const __raw_email = obj["email"] as string;

                if (!(typeof __raw_email === "string")) {
                    errors.push({ field: "email", message: __raw_email == null ? "UserWithDecode.email is required" : "expected string" });
                } else {
                    instance.email = __raw_email;
                }
            }
        },
    ]) {
        __part();
    }

    ctx.pushErrors(errors);

    return instance as UserWithDecode;
}

