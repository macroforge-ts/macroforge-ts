export function userWithDecodeDecodePartialWithContext(value: unknown, ctx: __mf_DecodeContext, fields?: __mf_FieldSelection<keyof UserWithDecode>): Partial<UserWithDecode> | __mf_PendingRef {
    return userWithDecodeDecodeWithContext(value, ctx, __mf_fieldRequirement(fields));
}
