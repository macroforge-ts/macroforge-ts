        errors.push({ field: "hover", message: "missing required field" });
    }
    if (!("active" in obj)) {
        errors.push({ field: "active", message: "missing required field" });
    }

    const instance: any = {};

    if (obj.__id !== undefined) {
        ctx.register(obj.__id as number, instance);
    }

    ctx.trackForFreeze(instance);

    {
        const __raw_main = obj["main"] as string;

        if (!(typeof __raw_main === "string")) {
            errors.push({ field: "main", message: __raw_main == null ? "Colors.main is required" : "expected string" });
        } else {
            if (__raw_main == null) { errors.push({ field: "main", message: "Colors.main is required" }); } else {
                if (__raw_main.length === 0) { errors.push({ field: "main", message: "Colors.main must not be empty" }); }
            }
            instance.main = __raw_main;
        }
    }
    {
        const __raw_hover = obj["hover"] as string;

        if (!(typeof __raw_hover === "string")) {
            errors.push({ field: "hover", message: __raw_hover == null ? "Colors.hover is required" : "expected string" });
        } else {
            if (__raw_hover == null) { errors.push({ field: "hover", message: "Colors.hover is required" }); } else {
                if (__raw_hover.length === 0) { errors.push({ field: "hover", message: "Colors.hover must not be empty" }); }
            }
            instance.hover = __raw_hover;
        }
    }
    {
