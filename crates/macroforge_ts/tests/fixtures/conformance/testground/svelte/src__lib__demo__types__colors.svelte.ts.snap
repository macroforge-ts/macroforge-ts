export function colorsHasShape(obj: unknown): boolean {
    if (typeof obj !== "object" || obj === null || Array.isArray(obj)) {
        return false;
    }
    const o = obj as Record<string, unknown>;
    return "main" in o && "hover" in o && "active" in o;
}

export function colorsIs(obj: unknown): obj is Colors {
    return colorsHasShape(obj) && colorsDecode(obj).success;
}

/** Nested error structure matching the data shape  */
export type ColorsErrors = {
    _errors: Option.Option<Array<string>>;
    main: Option.Option<Array<string>>;
    hover: Option.Option<Array<string>>;
    active: Option.Option<Array<string>>;
};

/** Nested boolean structure for tracking touched/dirty fields  */
export type ColorsTainted = {
    main: Option.Option<boolean>;
    hover: Option.Option<boolean>;
    active: Option.Option<boolean>;
};

/** Type-safe field controllers for this form  */
export interface ColorsFieldControllers {
    readonly main: FieldController<string>;
    readonly hover: FieldController<string>;
    readonly active: FieldController<string>;
}

/** Gigaform instance containing reactive state and field controllers  */
export interface ColorsGigaform {
    readonly data: Colors;
    readonly errors: ColorsErrors;
    readonly tainted: ColorsTainted;
    readonly fields: ColorsFieldControllers;
    validate(): Exit.Exit<Colors, Array<{ field: string; message: string }>>;
    reset(overrides?: Partial<Colors>): void;
}
/** Creates a new Gigaform instance with reactive state and field controllers.  */
export function colorsCreateForm(overrides?: Partial<Colors>): ColorsGigaform {
    let data = $state({ ...colorsDefaultValue(), ...overrides });
    let errors = $state<ColorsErrors>({
        _errors: Option.none(),
        main: Option.none(),
        hover: Option.none(),
        active: Option.none(),
    });
    let tainted = $state<ColorsTainted>({
        main: Option.none(),
        hover: Option.none(),
        active: Option.none(),
    });
    const fields = {
        main: {
            name: "main",
            label: "main",
            type: "text",
            optional: false,
            array: false,
            path: ["main"],
            get: () => data.main,
            set: (value: string) => { data.main = value; },
            getError: () => errors.main,
            setError: (value: Option.Option<Array<string>>) => { errors.main = value; },
            getTainted: () => tainted.main,
            setTainted: (value: Option.Option<boolean>) => { tainted.main = value; },
            validate: () => colorsValidateField("main", data.main).map((e: { field: string; message: string }) => e.message),

            constraints: {},


            disabled: false,
            readonly: false,
        },
        hover: {
            name: "hover",
            label: "hover",
            type: "text",
            optional: false,
            array: false,
            path: ["hover"],
            get: () => data.hover,
            set: (value: string) => { data.hover = value; },
            getError: () => errors.hover,
            setError: (value: Option.Option<Array<string>>) => { errors.hover = value; },
            getTainted: () => tainted.hover,
            setTainted: (value: Option.Option<boolean>) => { tainted.hover = value; },
            validate: () => colorsValidateField("hover", data.hover).map((e: { field: string; message: string }) => e.message),

            constraints: {},


            disabled: false,
            readonly: false,
        },
        active: {
            name: "active",
            label: "active",
            type: "text",
            optional: false,
            array: false,
            path: ["active"],
            get: () => data.active,
            set: (value: string) => { data.active = value; },
            getError: () => errors.active,
            setError: (value: Option.Option<Array<string>>) => { errors.active = value; },
            getTainted: () => tainted.active,
            setTainted: (value: Option.Option<boolean>) => { tainted.active = value; },
            validate: () => colorsValidateField("active", data.active).map((e: { field: string; message: string }) => e.message),

            constraints: {},


            disabled: false,
            readonly: false,
        },
    } as unknown as ColorsFieldControllers;

    function validate(): Exit.Exit<Colors, Array<{ field: string; message: string }>> {
        return toExit(colorsDecode(data));
    }

    function reset(newOverrides?: Partial<Colors>): void {
        data = { ...colorsDefaultValue(), ...newOverrides };
        errors = {
            _errors: Option.none(),
            main: Option.none(),
            hover: Option.none(),
            active: Option.none(),
        };
        tainted = {
            main: Option.none(),
            hover: Option.none(),
            active: Option.none(),
        };
    }

    return {
        get data() { return data; },
        set data(v) { data = v; },
        get errors() { return errors; },
        set errors(v) { errors = v; },
        get tainted() { return tainted; },
        set tainted(v) { tainted = v; },
        fields,
        validate,
        reset,
    };
}
/** Parses FormData and validates it, returning a Result with the parsed data or errors. Delegates validation to decode() from @derive(Decode).  */
export function colorsFromFormData(formData: FormData): Exit.Exit<Colors, Array<{ field: string; message: string }>> {
    const obj: Record<string, unknown> = {};

    
    obj.main = formData.get("main") ?? "";
    obj.hover = formData.get("hover") ?? "";
    obj.active = formData.get("active") ?? "";

    return toExit(colorsDecode(obj));
}

