            errors.push({ field: "active", message: __raw_active == null ? "Colors.active is required" : "expected string" });
        } else {
            if (__raw_active == null) { errors.push({ field: "active", message: "Colors.active is required" }); } else {
                if (__raw_active.length === 0) { errors.push({ field: "active", message: "Colors.active must not be empty" }); }
            }
            instance.active = __raw_active;
        }
    }

    ctx.pushErrors(errors);

    return instance as Colors;
}
export function colorsValidateField<K extends keyof Colors>(field: K, value: unknown): Array<{ field: string; message: string }> {
    const errors: Array<{ field: string; message: string }> = [];
