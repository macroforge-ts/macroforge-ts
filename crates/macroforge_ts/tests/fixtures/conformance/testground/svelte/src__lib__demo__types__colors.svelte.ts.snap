export function colorsValidateFields(partial: { readonly [K in keyof Colors]?: unknown }): Array<{ field: string; message: string }> {
    const errors: Array<{ field: string; message: string }> = [];
    if ("main" in partial && partial.main !== undefined) {
        const __val = partial.main as string;
        if (__val == null) { errors.push({ field: "main", message: "Colors.main is required" }); } else {
