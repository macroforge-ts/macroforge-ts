    if (typeof value !== "object" || value === null || Array.isArray(value)) {
        throw new __mf_DecodeError([{ field: "_root", message: "Feature.decodeWithContext: expected an object" }]);
    }

    const obj = value as Record<string, unknown>;
    const errors: Array<{ field: string; message: string }> = [];
    if ((__fields === undefined || __fields.requires("name")) && !("name" in obj)) {
        errors.push({ field: "name", message: "missing required field" });
    }
    if ((__fields === undefined || __fields.requires("enabledAt")) && !("enabledAt" in obj)) {
        errors.push({ field: "enabledAt", message: "missing required field" });
    }

    const instance: any = {};

    if (__fields === undefined && obj.__id !== undefined) {
        ctx.register(obj.__id as number, instance);
