        }
    }
    if (__fields === undefined || __fields.keeps("projects")) {

        if (value.projects !== undefined) {
            result.projects = value.projects.map(
                (item) => projectEncodeWithContext(item, ctx)
            );
        }
    }
    if (__fields === undefined || __fields.keeps("hireDate")) {

        if (value.hireDate !== undefined) {
            result.hireDate = value.hireDate.toISOString();
        }
    }
    if (__fields === undefined || __fields.keeps("terminatedAt")) {
        if (value.terminatedAt !== undefined) {

