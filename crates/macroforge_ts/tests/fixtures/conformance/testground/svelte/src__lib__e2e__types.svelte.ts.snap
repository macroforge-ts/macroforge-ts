export function projectDecodeWithContext(value: unknown, ctx: __mf_DecodeContext, __fields?: __mf_FieldRequirement): Partial<Project> | __mf_PendingRef {
    if (__fields !== undefined && typeof value === "object" && value !== null && "__ref" in value) {
        throw new __mf_DecodeError([{ field: "_root", message: "Project.decodeWithContext: a value holding a selection of fields cannot be a reference" }]);
    }
    if (typeof value === "object" && value !== null && "__ref" in value) {
