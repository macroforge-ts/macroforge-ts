export function projectEncodePartialWithContext(value: Partial<Project>, ctx: __mf_EncodeContext, fields?: __mf_FieldSelection<keyof Project>): Record<string, unknown> {
    const __fields = fields === undefined ? undefined : __mf_fieldRequirement(fields);

    let __id: number | undefined;
