    if (__fields === undefined) {
        const existingId = ctx.getId(value);
        if (existingId !== undefined) {
            return { __ref: existingId };
        }
        __id = ctx.register(value);
    }

    const result: Record<string, unknown> = {
        "__type": "Employee",
        __id,
    };

    if (__fields === undefined || __fields.keeps("id")) {

        if (value.id !== undefined) {
            result.id = value.id;
        }
    }
    if (__fields === undefined || __fields.keeps("name")) {

        if (value.name !== undefined) {
            result.name = value.name;
        }
    }
    if (__fields === undefined || __fields.keeps("email")) {

        if (value.email !== undefined) {
            result.email = value.email;
        }
    }
    if (__fields === undefined || __fields.keeps("address")) {

        if (value.address !== undefined) {
            result.address = addressEncodeWithContext(value.address, ctx);
        }
    }
    if (__fields === undefined || __fields.keeps("skills")) {

        if (value.skills !== undefined) {
