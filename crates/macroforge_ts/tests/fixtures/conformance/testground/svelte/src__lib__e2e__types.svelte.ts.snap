    if (__fields === undefined || __fields.keeps("id")) {

        if (value.id !== undefined) {
            result.id = value.id;
        }
    }
    if (__fields === undefined || __fields.keeps("name")) {

        if (value.name !== undefined) {
            result.name = value.name;
        }
    }
    if (__fields === undefined || __fields.keeps("milestones")) {

        if (value.milestones !== undefined) {
            result.milestones = value.milestones.map(
                (item) => milestoneEncodeWithContext(item, ctx)
