function recurrenceEndGetDefaultForVariant(variant: string): RecurrenceEnd {
    if (variant === "number") { return 0 as RecurrenceEnd; }
    if (variant === "string") { return "" as RecurrenceEnd; }
    return 0 as RecurrenceEnd;
}

