}

export function addressValidateFields(partial: { readonly [K in keyof Address]?: unknown }): Array<{ field: string; message: string }> {
    const errors: Array<{ field: string; message: string }> = [];
    if ("street" in partial && partial.street !== undefined) {
        const __val = partial.street as string;
        if (__val == null) { errors.push({ field: "street", message: "Address.street is required" }); } else {
            if (__val.length === 0) { errors.push({ field: "street", message: "Address.street must not be empty" }); }
        }
    }
