    reset(overrides?: Partial<Address>): void;
}
/** Creates a new Gigaform instance with reactive state and field controllers.  */
export function addressCreateForm(overrides?: Partial<Address>): AddressGigaform {
    let data = $state({ ...addressDefaultValue(), ...overrides });
    let errors = $state<AddressErrors>({
        _errors: Option.none(),
        street: Option.none(),
        city: Option.none(),
        state: Option.none(),
        zipcode: Option.none(),
    });
    let tainted = $state<AddressTainted>({
        street: Option.none(),
        city: Option.none(),
        state: Option.none(),
        zipcode: Option.none(),
    });
    const fields = {
        street: {
            name: "street",
            label: "street",
            type: "text",
            optional: false,
            array: false,
            path: ["street"],
            get: () => data.street,
            set: (value: string) => { data.street = value; },
            getError: () => errors.street,
            setError: (value: Option.Option<Array<string>>) => { errors.street = value; },
            getTainted: () => tainted.street,
            setTainted: (value: Option.Option<boolean>) => { tainted.street = value; },
            validate: () => addressValidateField("street", data.street).map((e: { field: string; message: string }) => e.message),

            constraints: {},


            disabled: false,
            readonly: false,
        },
        city: {
            name: "city",
            label: "city",
            type: "text",
            optional: false,
            array: false,
            path: ["city"],
            get: () => data.city,
            set: (value: string) => { data.city = value; },
            getError: () => errors.city,
            setError: (value: Option.Option<Array<string>>) => { errors.city = value; },
            getTainted: () => tainted.city,
            setTainted: (value: Option.Option<boolean>) => { tainted.city = value; },
            validate: () => addressValidateField("city", data.city).map((e: { field: string; message: string }) => e.message),

            constraints: {},


            disabled: false,
            readonly: false,
        },
        state: {
            name: "state",
            label: "state",
            type: "text",
            optional: false,
            array: false,
            path: ["state"],
            get: () => data.state,
            set: (value: string) => { data.state = value; },
            getError: () => errors.state,
            setError: (value: Option.Option<Array<string>>) => { errors.state = value; },
            getTainted: () => tainted.state,
            setTainted: (value: Option.Option<boolean>) => { tainted.state = value; },
            validate: () => addressValidateField("state", data.state).map((e: { field: string; message: string }) => e.message),

            constraints: {},


            disabled: false,
            readonly: false,
        },
        zipcode: {
            name: "zipcode",
            label: "zipcode",
            type: "text",
            optional: false,
            array: false,
            path: ["zipcode"],
            get: () => data.zipcode,
            set: (value: string) => { data.zipcode = value; },
            getError: () => errors.zipcode,
            setError: (value: Option.Option<Array<string>>) => { errors.zipcode = value; },
            getTainted: () => tainted.zipcode,
            setTainted: (value: Option.Option<boolean>) => { tainted.zipcode = value; },
            validate: () => addressValidateField("zipcode", data.zipcode).map((e: { field: string; message: string }) => e.message),

            constraints: {},


            disabled: false,
            readonly: false,
        },
    } as unknown as AddressFieldControllers;

    function validate(): Exit.Exit<Address, Array<{ field: string; message: string }>> {
        return toExit(addressDecode(data));
    }

    function reset(newOverrides?: Partial<Address>): void {
        data = { ...addressDefaultValue(), ...newOverrides };
        errors = {
            _errors: Option.none(),
            street: Option.none(),
            city: Option.none(),
            state: Option.none(),
            zipcode: Option.none(),
        };
        tainted = {
            street: Option.none(),
            city: Option.none(),
            state: Option.none(),
            zipcode: Option.none(),
        };
    }

    return {
        get data() { return data; },
        set data(v) { data = v; },
        get errors() { return errors; },
        set errors(v) { errors = v; },
        get tainted() { return tainted; },
        set tainted(v) { tainted = v; },
        fields,
        validate,
        reset,
    };
}
/** Parses FormData and validates it, returning a Result with the parsed data or errors. Delegates validation to decode() from @derive(Decode).  */
export function addressFromFormData(formData: FormData): Exit.Exit<Address, Array<{ field: string; message: string }>> {
    const obj: Record<string, unknown> = {};

    
    obj.street = formData.get("street") ?? "";
    obj.city = formData.get("city") ?? "";
    obj.state = formData.get("state") ?? "";
    obj.zipcode = formData.get("zipcode") ?? "";

    return toExit(addressDecode(obj));
}

