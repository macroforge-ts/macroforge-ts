        const __val = partial.city as string;
        if (__val == null) { errors.push({ field: "city", message: "Address.city is required" }); } else {
            if (__val.length === 0) { errors.push({ field: "city", message: "Address.city must not be empty" }); }
        }
    }
    if ("state" in partial && partial.state !== undefined) {
