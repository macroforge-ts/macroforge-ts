                if (__raw_zipcode.length === 0) { errors.push({ field: "zipcode", message: "Address.zipcode must not be empty" }); }
            }
            instance.zipcode = __raw_zipcode;
        }
    }

    ctx.pushErrors(errors);

    return instance as Address;
}
export function addressValidateField<K extends keyof Address>(field: K, value: unknown): Array<{ field: string; message: string }> {
    const errors: Array<{ field: string; message: string }> = [];
    if (field === "street") {
