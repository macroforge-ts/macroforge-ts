    result.cardOrRow = overviewDisplayEncodeWithContext(value.cardOrRow, ctx);
    result.perPage = value.perPage;
    result.columnConfigs = value.columnConfigs.map(
        (item) => columnConfigEncodeWithContext(item, ctx)
    );

    return result;
}

