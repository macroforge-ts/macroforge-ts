		field: "_root",
		message
	}]
});
    }
}
/** Decodes with an existing context for nested/cyclic object graphs. @param value - The raw value to decode @param ctx - The decoding context  */
export function lastNameDecodeWithContext(value: unknown, ctx: __mf_DecodeContext): LastName | __mf_PendingRef {
    if (typeof value === "object" && value !== null && "__ref" in value) {
        if (typeof value.__ref !== "number") {
            throw new __mf_DecodeError([{ field: "__ref", message: "LastName.decodeWithContext: __ref must be a number" }]);
        }
