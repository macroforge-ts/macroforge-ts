import { EncodeContext as __mf_EncodeContext, DecodeContext as __mf_DecodeContext, DecodeError as __mf_DecodeError, PendingRef as __mf_PendingRef } from "@macroforge/core/endec";
import type { DecodeOptions as __mf_DecodeOptions } from "@macroforge/core/endec";
import { Option, Exit } from "effect";
import type { FieldController } from "@testground/macro/gigaform";
import { toExit } from "@testground/macro/gigaform";
/** import macro {Gigaform} from "@testground/macro"; */


export interface Edited {
    
    fieldName: string;
    oldValue: string | null;
    newValue: string | null;
}

export function editedDefaultValue(): Edited {
    return {
        fieldName: "",
        oldValue: null,
        newValue: null,
    };
}

/** Encodes a value to a JSON string. @param value - The value to encode @param keepMetadata - If true, preserves __type and __id fields in the output @returns JSON string representation  */
export function editedEncode(value: Edited, keepMetadata?: boolean): string {
    const ctx = __mf_EncodeContext.create();
    const __raw = editedEncodeWithContext(value, ctx);
    if (keepMetadata) return JSON.stringify(__raw);
    return JSON.stringify(__raw, (key, val) => key === "__type" || key === "__id" ? undefined : val);
}

/** Encodes with an existing context for nested/cyclic object graphs. @param value - The value to encode @param ctx - The encoding context  */
export function editedEncodeWithContext(value: Edited, ctx: __mf_EncodeContext): Record<string, unknown> {

    const existingId = ctx.getId(value);
    if (existingId !== undefined) {
        return { __ref: existingId };
    }

    const __id = ctx.register(value);

    const result: Record<string, unknown> = {
        "__type": "Edited",
        __id,
    };

    
    result.fieldName = value.fieldName;
    result.oldValue = value.oldValue;
    result.newValue = value.newValue;

    return result;
}

/** Decodes input to this type. Automatically detects whether input is a JSON string or object. @param input - JSON string or object to decode @param opts - Optional decoding options @returns Result containing the decoded value or validation errors  */
export function editedDecode(input: unknown, opts?: __mf_DecodeOptions): { success: true; value: Edited } | { success: false; errors: Array<{ field: string; message: string }> } {
    try {

        const data = typeof input === "string" ? JSON.parse(input) : input;

        const ctx = __mf_DecodeContext.create();
        const resultOrRef = editedDecodeWithContext(data, ctx);

        if (__mf_PendingRef.is(resultOrRef)) {
            return ({
	success: false,
	errors: [{
		field: "_root",
		message: "Edited.decode: root cannot be a forward reference"
	}]
});
        }

        ctx.applyPatches();
        if (opts?.freeze) {
            ctx.freezeAll();
        }

        const __errors = ctx.getErrors();
        if (__errors.length > 0) {
            return ({
	success: false,
	errors: __errors
});
        }

        return ({
	success: true,
	value: resultOrRef
});
    } catch (e) {
        if (e instanceof __mf_DecodeError) {
            return ({
	success: false,
	errors: e.errors
});
        }
        const message = e instanceof Error ? e.message : String(e);
        return ({
	success: false,
	errors: [{
		field: "_root",
		message
	}]
});
    }
}
/** Decodes with an existing context for nested/cyclic object graphs. @param value - The raw value to decode @param ctx - The decoding context  */
export function editedDecodeWithContext(value: unknown, ctx: __mf_DecodeContext): Edited | __mf_PendingRef {
    if (typeof value === "object" && value !== null && "__ref" in value) {
        if (typeof value.__ref !== "number") {
            throw new __mf_DecodeError([{ field: "__ref", message: "Edited.decodeWithContext: __ref must be a number" }]);
        }
        return ctx.getOrDefer(value.__ref) as Edited | __mf_PendingRef;
    }

    if (typeof value !== "object" || value === null || Array.isArray(value)) {
        throw new __mf_DecodeError([{ field: "_root", message: "Edited.decodeWithContext: expected an object" }]);
    }

    const obj = value as Record<string, unknown>;
    const errors: Array<{ field: string; message: string }> = [];
    if (!("fieldName" in obj)) {
        errors.push({ field: "fieldName", message: "missing required field" });
    }
    if (!("oldValue" in obj)) {
        errors.push({ field: "oldValue", message: "missing required field" });
    }
    if (!("newValue" in obj)) {
        errors.push({ field: "newValue", message: "missing required field" });
    }

    const instance: any = {};

    if (obj.__id !== undefined) {
        ctx.register(obj.__id as number, instance);
    }

    ctx.trackForFreeze(instance);

    {
        const __raw_fieldName = obj["fieldName"] as string;

        if (!(typeof __raw_fieldName === "string")) {
            errors.push({ field: "fieldName", message: __raw_fieldName == null ? "Edited.fieldName is required" : "expected string" });
        } else {
            if (__raw_fieldName == null) { errors.push({ field: "fieldName", message: "Edited.fieldName is required" }); } else {
                if (__raw_fieldName.length === 0) { errors.push({ field: "fieldName", message: "Edited.fieldName must not be empty" }); }
            }
            instance.fieldName = __raw_fieldName;
        }
    }
    {
        const __raw_oldValue = obj["oldValue"] as string | null;

        if (!(typeof __raw_oldValue === "string" || __raw_oldValue === null)) {
            errors.push({ field: "oldValue", message: "expected string | null" });
        } else {
            instance.oldValue = __raw_oldValue;
        }
    }
    {
        const __raw_newValue = obj["newValue"] as string | null;

        if (!(typeof __raw_newValue === "string" || __raw_newValue === null)) {
            errors.push({ field: "newValue", message: "expected string | null" });
        } else {
            instance.newValue = __raw_newValue;
        }
    }

    ctx.pushErrors(errors);

    return instance as Edited;
}
export function editedValidateField<K extends keyof Edited>(field: K, value: unknown): Array<{ field: string; message: string }> {
    const errors: Array<{ field: string; message: string }> = [];
    if (field === "fieldName") {
        const __val = value as string;
        if (__val == null) { errors.push({ field: "fieldName", message: "Edited.fieldName is required" }); } else {
            if (__val.length === 0) { errors.push({ field: "fieldName", message: "Edited.fieldName must not be empty" }); }
        }
    }
    return errors;
}

export function editedValidateFields(partial: { readonly [K in keyof Edited]?: unknown }): Array<{ field: string; message: string }> {
    const errors: Array<{ field: string; message: string }> = [];
    if ("fieldName" in partial && partial.fieldName !== undefined) {
        const __val = partial.fieldName as string;
        if (__val == null) { errors.push({ field: "fieldName", message: "Edited.fieldName is required" }); } else {
            if (__val.length === 0) { errors.push({ field: "fieldName", message: "Edited.fieldName must not be empty" }); }
        }
    }
    return errors;
}
export function editedHasShape(obj: unknown): boolean {
    if (typeof obj !== "object" || obj === null || Array.isArray(obj)) {
        return false;
    }
    const o = obj as Record<string, unknown>;
    return "fieldName" in o && "oldValue" in o && "newValue" in o;
}

export function editedIs(obj: unknown): obj is Edited {
    return editedHasShape(obj) && editedDecode(obj).success;
}

/** Nested error structure matching the data shape  */
export type EditedErrors = {
    _errors: Option.Option<Array<string>>;
    fieldName: Option.Option<Array<string>>;
    oldValue: Option.Option<Array<string>>;
    newValue: Option.Option<Array<string>>;
};

/** Nested boolean structure for tracking touched/dirty fields  */
export type EditedTainted = {
    fieldName: Option.Option<boolean>;
    oldValue: Option.Option<boolean>;
    newValue: Option.Option<boolean>;
};

/** Type-safe field controllers for this form  */
export interface EditedFieldControllers {
    readonly fieldName: FieldController<string>;
    readonly oldValue: FieldController<string | null>;
    readonly newValue: FieldController<string | null>;
}

/** Gigaform instance containing reactive state and field controllers  */
export interface EditedGigaform {
    readonly data: Edited;
    readonly errors: EditedErrors;
    readonly tainted: EditedTainted;
    readonly fields: EditedFieldControllers;
    validate(): Exit.Exit<Edited, Array<{ field: string; message: string }>>;
    reset(overrides?: Partial<Edited>): void;
}
/** Creates a new Gigaform instance with reactive state and field controllers.  */
export function editedCreateForm(overrides?: Partial<Edited>): EditedGigaform {
    let data = $state({ ...editedDefaultValue(), ...overrides });
    let errors = $state<EditedErrors>({
        _errors: Option.none(),
        fieldName: Option.none(),
        oldValue: Option.none(),
        newValue: Option.none(),
    });
    let tainted = $state<EditedTainted>({
        fieldName: Option.none(),
        oldValue: Option.none(),
        newValue: Option.none(),
    });
    const fields = {
        fieldName: {
            name: "fieldName",
            label: "fieldName",
            type: "text",
            optional: false,
            array: false,
            path: ["fieldName"],
            get: () => data.fieldName,
            set: (value: string) => { data.fieldName = value; },
            getError: () => errors.fieldName,
            setError: (value: Option.Option<Array<string>>) => { errors.fieldName = value; },
            getTainted: () => tainted.fieldName,
            setTainted: (value: Option.Option<boolean>) => { tainted.fieldName = value; },
            validate: () => editedValidateField("fieldName", data.fieldName).map((e: { field: string; message: string }) => e.message),

            constraints: {},


            disabled: false,
            readonly: false,
        },
        oldValue: {
            name: "oldValue",
            label: "oldValue",
            type: "text",
            optional: false,
            array: false,
            path: ["oldValue"],
            get: () => data.oldValue,
            set: (value: string | null) => { data.oldValue = value; },
            getError: () => errors.oldValue,
            setError: (value: Option.Option<Array<string>>) => { errors.oldValue = value; },
            getTainted: () => tainted.oldValue,
            setTainted: (value: Option.Option<boolean>) => { tainted.oldValue = value; },
            validate: () => editedValidateField("oldValue", data.oldValue).map((e: { field: string; message: string }) => e.message),

            constraints: {},


            disabled: false,
            readonly: false,
        },
        newValue: {
            name: "newValue",
            label: "newValue",
            type: "text",
            optional: false,
            array: false,
            path: ["newValue"],
            get: () => data.newValue,
            set: (value: string | null) => { data.newValue = value; },
            getError: () => errors.newValue,
            setError: (value: Option.Option<Array<string>>) => { errors.newValue = value; },
            getTainted: () => tainted.newValue,
            setTainted: (value: Option.Option<boolean>) => { tainted.newValue = value; },
            validate: () => editedValidateField("newValue", data.newValue).map((e: { field: string; message: string }) => e.message),

            constraints: {},


            disabled: false,
            readonly: false,
        },
    } as unknown as EditedFieldControllers;

    function validate(): Exit.Exit<Edited, Array<{ field: string; message: string }>> {
        return toExit(editedDecode(data));
    }

    function reset(newOverrides?: Partial<Edited>): void {
        data = { ...editedDefaultValue(), ...newOverrides };
        errors = {
            _errors: Option.none(),
            fieldName: Option.none(),
            oldValue: Option.none(),
            newValue: Option.none(),
        };
        tainted = {
            fieldName: Option.none(),
            oldValue: Option.none(),
            newValue: Option.none(),
        };
    }

    return {
        get data() { return data; },
        set data(v) { data = v; },
        get errors() { return errors; },
        set errors(v) { errors = v; },
        get tainted() { return tainted; },
        set tainted(v) { tainted = v; },
        fields,
        validate,
        reset,
    };
}
/** Parses FormData and validates it, returning a Result with the parsed data or errors. Delegates validation to decode() from @derive(Decode).  */
export function editedFromFormData(formData: FormData): Exit.Exit<Edited, Array<{ field: string; message: string }>> {
    const obj: Record<string, unknown> = {};

    
    obj.fieldName = formData.get("fieldName") ?? "";
    obj.oldValue = formData.get("oldValue") ?? "";
    obj.newValue = formData.get("newValue") ?? "";

    return toExit(editedDecode(obj));
}

export const Edited: {
  readonly defaultValue: typeof editedDefaultValue;
  readonly encode: typeof editedEncode;
  readonly encodeWithContext: typeof editedEncodeWithContext;
  readonly decode: typeof editedDecode;
  readonly decodeWithContext: typeof editedDecodeWithContext;
  readonly validateField: typeof editedValidateField;
  readonly validateFields: typeof editedValidateFields;
  readonly hasShape: typeof editedHasShape;
  readonly is: typeof editedIs;
  readonly createForm: typeof editedCreateForm;
  readonly fromFormData: typeof editedFromFormData;
} = {
  defaultValue: editedDefaultValue,
  encode: editedEncode,
  encodeWithContext: editedEncodeWithContext,
  decode: editedDecode,
  decodeWithContext: editedDecodeWithContext,
  validateField: editedValidateField,
  validateFields: editedValidateFields,
  hasShape: editedHasShape,
  is: editedIs,
  createForm: editedCreateForm,
  fromFormData: editedFromFormData
};

