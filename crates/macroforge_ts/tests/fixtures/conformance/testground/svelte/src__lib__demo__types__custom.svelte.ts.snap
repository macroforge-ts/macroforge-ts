/** Creates a new Gigaform instance with reactive state and field controllers.  */
export function customCreateForm(overrides?: Partial<Custom>): CustomGigaform {
    let data = $state({ ...customDefaultValue(), ...overrides });
    let errors = $state<CustomErrors>({
        _errors: Option.none(),
        mappings: Option.none(),
    });
    let tainted = $state<CustomTainted>({
        mappings: Option.none(),
    });
    const fields = {
        mappings: {
            name: "mappings",
            label: "mappings",
            type: "fieldset",
            optional: false,
            array: true,
            path: ["mappings"],
            get: () => data.mappings,
            set: (value: Array<DirectionHue>) => { data.mappings = value; },
            getError: () => errors.mappings,
            setError: (value: Option.Option<Array<string>>) => { errors.mappings = value; },
            getTainted: () => tainted.mappings,
            setTainted: (value: Option.Option<boolean>) => { tainted.mappings = value; },
            validate: () => customValidateField("mappings", data.mappings).map((e: { field: string; message: string }) => e.message),
            at: (index: number) => ({
                get: () => data.mappings[index],
                set: (value: DirectionHue) => { data.mappings[index] = value; },
                getError: () => errors.mappings,
                setError: (value: Option.Option<Array<string>>) => { errors.mappings = value; },
            }),
            push: (item: DirectionHue) => { data.mappings.push(item); },
            remove: (index: number) => { data.mappings.splice(index, 1); },
            swap: (a: number, b: number) => {
                const temp = data.mappings[a];
                data.mappings[a] = data.mappings[b];
                data.mappings[b] = temp;
            },
            constraints: {},


            disabled: false,
            readonly: false,
        },
    } as unknown as CustomFieldControllers;

    function validate(): Exit.Exit<Custom, Array<{ field: string; message: string }>> {
        return toExit(customDecode(data));
    }

    function reset(newOverrides?: Partial<Custom>): void {
        data = { ...customDefaultValue(), ...newOverrides };
        errors = {
            _errors: Option.none(),
            mappings: Option.none(),
        };
        tainted = {
            mappings: Option.none(),
        };
    }

    return {
        get data() { return data; },
        set data(v) { data = v; },
        get errors() { return errors; },
        set errors(v) { errors = v; },
        get tainted() { return tainted; },
        set tainted(v) { tainted = v; },
