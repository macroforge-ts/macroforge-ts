import { debuggedWithin as __mf_debuggedWithin, equalWithin as __mf_equalWithin, hashedWithin as __mf_hashedWithin } from "@macroforge/core/structural";
import { encodedText as __mf_encodedText, encodedTextWithoutMetadata as __mf_encodedTextWithoutMetadata, encodeSelection as __mf_encodeSelection, encodedAs as __mf_encodedAs, encodedReference as __mf_encodedReference, EncodeContext as __mf_EncodeContext, fieldRequirement as __mf_fieldRequirement } from "@macroforge/core/endec";
import type { FieldSelection as __mf_FieldSelection, FieldRequirement as __mf_FieldRequirement } from "@macroforge/core/endec";
/**
 * A class whose fields are runes. The derives that only read an instance
 * work over it, and read through the runes like any other code does.
 */


export class RuneCounter {
    label: string = $state('clicks');
    count: number = $state(0);
    doubled: number = $derived(this.count * 2);

    increment(): void {
        this.count += 1;
    }

    static toString(value: RuneCounter): string {
        return __mf_debuggedWithin(value, () => {
            const parts: string[] = [];
        parts.push("label: " + String(value.label));
        parts.push("count: " + String(value.count));
        parts.push("doubled: " + String(value.doubled));
            return "RuneCounter { " + parts.join(", ") + " }";
        });
    }

    static equals(a: RuneCounter, b: RuneCounter): boolean {
        if (a === b) return true;
        return __mf_equalWithin(a, b, () => {
                return [
                    () => a.label === b.label,
                    () => a.count === b.count || a.count !== a.count && b.count !== b.count,
                    () => a.doubled === b.doubled || a.doubled !== a.doubled && b.doubled !== b.doubled,
                ].every((same) => same());
            });
    }

    static hashCode(value: RuneCounter): number {
        return __mf_hashedWithin(value, () => {
            let hash = 17;
        hash = (hash * 31 + ((value.label ?? "").split("").reduce<number>((h, c) => h * 31 + c.charCodeAt(0) | 0, 0))) | 0;
        hash = (hash * 31 + (Number.isInteger(value.count) ? value.count | 0 : value.count.toString().split("").reduce<number>((h, c) => h * 31 + c.charCodeAt(0) | 0, 0))) | 0;
        hash = (hash * 31 + (Number.isInteger(value.doubled) ? value.doubled | 0 : value.doubled.toString().split("").reduce<number>((h, c) => h * 31 + c.charCodeAt(0) | 0, 0))) | 0;
            return hash;
        });
    }

/** @internal Encodes with an existing context for nested/cyclic object graphs. @param value - The value to encode @param ctx - The encoding context  */
static encodeWithContext(value: RuneCounter, ctx: __mf_EncodeContext): Record<string, unknown> {
    const existingId = ctx.getId(value);
    if (existingId !== undefined) {
        return __mf_encodedReference(ctx, existingId);
    }
    const result = __mf_encodedAs(ctx, ctx.register(value), { "__type": "RuneCounter" });
    RuneCounter.#encodeFields(value, ctx, result, undefined);
    return result;
}

/** @internal Encodes the fields a partial value has, with an existing context. @param value - The value to encode @param ctx - The encoding context @param fields - The fields a `Pick` or `Omit` keeps: every field when left out  */
static encodePartialWithContext(value: Partial<RuneCounter>, ctx: __mf_EncodeContext, fields?: __mf_FieldSelection<keyof RuneCounter>): Record<string, unknown> {
    return __mf_encodeSelection(ctx, value, () => {
        const result: Record<string, unknown> = { "__type": "RuneCounter" };
        RuneCounter.#encodeFields(value as RuneCounter, ctx, result, fields === undefined ? undefined : __mf_fieldRequirement(fields));
        return result;
    });
}

static #encodeFields(value: RuneCounter, _ctx: __mf_EncodeContext, result: Record<string, unknown>, __fields: __mf_FieldRequirement | undefined): void {
    for (const __part of [
        () => {
            if (__fields === undefined || __fields.keeps("label")) {
                if (value.label !== undefined) {
                    result["label"] = value.label;
                }
            }
