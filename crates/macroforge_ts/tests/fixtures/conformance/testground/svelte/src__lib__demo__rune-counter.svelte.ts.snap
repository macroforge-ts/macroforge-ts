                if (value.count !== undefined) {
                    result["count"] = value.count;
                }
            }
        },
        () => {
            if (__fields === undefined || __fields.keeps("doubled")) {
                if (value.doubled !== undefined) {
                    result["doubled"] = value.doubled;
                }
            }
        },
    ]) {
        __part();
    }
}

    /** Encodes a value to a JSON string. @param value - The value to encode @param keepMetadata - If true, preserves __type and __id fields in the output @returns JSON string representation  */
    static encode(value: RuneCounter, keepMetadata?: boolean): string {
        return runeCounterEncode(value, keepMetadata);
    }
}

export function runeCounterToString(value: RuneCounter): string {
    return RuneCounter.toString(value);
}

export function runeCounterEquals(a: RuneCounter, b: RuneCounter): boolean {
    return RuneCounter.equals(a, b);
}

export function runeCounterHashCode(value: RuneCounter): number {
    return RuneCounter.hashCode(value);
}

/** Encodes a value to a JSON string. @param value - The value to encode @param keepMetadata - If true, preserves __type and __id fields in the output @returns JSON string representation  */
export function runeCounterEncode(value: RuneCounter, keepMetadata?: boolean): string {
