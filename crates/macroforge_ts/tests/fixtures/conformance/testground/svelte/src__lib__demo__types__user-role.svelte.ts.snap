export type UserRole =
    | /** @default */ 'Administrator'
    | 'SalesRepresentative'
    | 'Technician'
    | 'HumanResources'
    | 'InformationTechnology';

export function userRoleDefaultValue(): UserRole {
    return "Administrator";
}

/** Encodes a value to a JSON string. @param value - The value to encode @param keepMetadata - If true, preserves __type and __id fields in the output @returns JSON string representation  */
export function userRoleEncode(value: UserRole, keepMetadata?: boolean): string {
    const ctx = __mf_EncodeContext.create();
    const __raw = userRoleEncodeWithContext(value, ctx);
    return keepMetadata ? __mf_encodedText(__raw) : __mf_encodedTextWithoutMetadata(__raw, "__type");
}

/** Encodes with an existing context for nested/cyclic object graphs. @param value - The value to encode @param ctx - The encoding context  */
export function userRoleEncodeWithContext(value: UserRole, ctx: __mf_EncodeContext): unknown {
    const __encoder = __mf_derivedEncoder(value);
    const __variant: unknown = __encoder !== undefined ? __encoder(value, ctx) : value;

    if (__variant !== null && typeof __variant === "object" && "__type" in __variant) {
        const { __type: __typeName, ...fields } = __variant as Record<string, unknown>;
        const __tagged = { "__type": __mf_member(value, "__type") ?? __typeName, ...fields };

        const __idVal = fields["__id"];
        return typeof __idVal === "number" ? __mf_encodedAs(ctx, __idVal, __tagged) : __tagged;
    }
    return __variant;
}

/** Decodes a value to a member of this literal union; JSON text decodes through `fromString`. @param input - The value to check @returns Result containing the validated value or error  */
export function userRoleDecode(input: unknown): { success: true; value: UserRole } | { success: false; errors: Array<{ field: string; message: string }> } {
    switch (input) {
        case 'Administrator':
        case 'SalesRepresentative':
        case 'Technician':
        case 'HumanResources':
        case 'InformationTechnology':
            return { success: true, value: input as UserRole };
        default:
            return { success: false, errors: [{ field: "_root", message: "Invalid value for UserRole: expected one of " + ['Administrator', 'SalesRepresentative', 'Technician', 'HumanResources', 'InformationTechnology'].map(v => JSON.stringify(v)).join(", ") + ", got " + JSON.stringify(input) }] };
    }
}

/** Decodes with an existing context (validates against known variants). A literal holds no references, so the context goes unread.  */
export function userRoleDecodeWithContext(value: unknown, _ctx: __mf_DecodeContext): UserRole | __mf_PendingRef {
    switch (value) {
        case 'Administrator':
        case 'SalesRepresentative':
        case 'Technician':
        case 'HumanResources':
        case 'InformationTechnology':
            return value as UserRole;
        default:
            throw new __mf_DecodeError([{
                field: "_root",
                message: "Invalid value for UserRole: expected one of " + ['Administrator', 'SalesRepresentative', 'Technician', 'HumanResources', 'InformationTechnology'].map(v => JSON.stringify(v)).join(", ") + ", got " + JSON.stringify(value)
            }]);
    }
}

export function userRoleHasShape(value: unknown): boolean {
    switch (value) {
        case 'Administrator':
        case 'SalesRepresentative':
        case 'Technician':
        case 'HumanResources':
        case 'InformationTechnology':
            return true;
        default:
            return false;
    }
}

export function userRoleIs(value: unknown): value is UserRole {
    return userRoleHasShape(value);
}
/** Decodes JSON text, as `encode` writes it, to this type. @param text - The JSON text @returns Result containing the decoded value or validation errors  */
export function userRoleFromString(text: string): { success: true; value: UserRole } | { success: false; errors: Array<{ field: string; message: string }> } {
    return __mf_decodedText(text, (value) => userRoleDecode(value));
}

