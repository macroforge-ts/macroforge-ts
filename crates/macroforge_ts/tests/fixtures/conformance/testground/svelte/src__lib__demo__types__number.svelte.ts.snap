export function numberValidateFields(partial: { readonly [K in keyof Number]?: unknown }): Array<{ field: string; message: string }> {
    const errors: Array<{ field: string; message: string }> = [];
    if ("countryCode" in partial && partial.countryCode !== undefined) {
        const __val = partial.countryCode as string;
        if (__val == null) { errors.push({ field: "countryCode", message: "Number.countryCode is required" }); } else {
