            errors.push({ field: "localNumber", message: __raw_localNumber == null ? "Number.localNumber is required" : "expected string" });
        } else {
            if (__raw_localNumber == null) { errors.push({ field: "localNumber", message: "Number.localNumber is required" }); } else {
                if (__raw_localNumber.length === 0) { errors.push({ field: "localNumber", message: "Number.localNumber must not be empty" }); }
            }
            instance.localNumber = __raw_localNumber;
        }
    }

    ctx.pushErrors(errors);

    return instance as Number;
}
export function numberValidateField<K extends keyof Number>(field: K, value: unknown): Array<{ field: string; message: string }> {
    const errors: Array<{ field: string; message: string }> = [];
    if (field === "countryCode") {
