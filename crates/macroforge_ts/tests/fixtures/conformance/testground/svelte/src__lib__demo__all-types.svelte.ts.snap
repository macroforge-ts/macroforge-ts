    }
    if (__fields === undefined || __fields.keeps("northeast")) {
        if (value.northeast !== undefined) {
            result["northeast"] = value.northeast;
        }
    }
    if (__fields === undefined || __fields.keeps("east")) {
        if (value.east !== undefined) {
            result["east"] = value.east;
        }
    }
    if (__fields === undefined || __fields.keeps("southeast")) {
        if (value.southeast !== undefined) {
