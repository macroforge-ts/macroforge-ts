export function ordinalHasShape(obj: unknown): boolean {
    if (typeof obj !== "object" || obj === null || Array.isArray(obj)) {
        return false;
    }
    return __mf_holds(obj, "north") && __mf_holds(obj, "northeast") && __mf_holds(obj, "east") && __mf_holds(obj, "southeast") && __mf_holds(obj, "south") && __mf_holds(obj, "southwest") && __mf_holds(obj, "west") && __mf_holds(obj, "northwest");
