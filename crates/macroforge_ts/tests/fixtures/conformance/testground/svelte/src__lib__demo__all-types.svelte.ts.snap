            throw new __mf_DecodeError([{ field: "__ref", message: "Commissions.decodeWithContext: __ref must be a number" }]);
        }
        return ctx.getOrDefer(value.__ref, "Commissions") as Commissions | __mf_PendingRef;
    }

    if (typeof value !== "object" || value === null || Array.isArray(value)) {
        throw new __mf_DecodeError([{ field: "_root", message: "Commissions.decodeWithContext: expected an object" }]);
    }

    const obj = __mf_ownMembers(value);
    const errors: Array<{ field: string; message: string }> = [];
    if ((__fields === undefined || __fields.requires("technician")) && !("technician" in obj)) {
