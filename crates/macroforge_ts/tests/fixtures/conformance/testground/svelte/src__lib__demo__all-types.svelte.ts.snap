/** Decodes a literal union value. Validates input against known variants. @param input - Value to validate @returns Result containing the validated value or error  */
export function pageDecode(input: unknown): { success: true; value: Page } | { success: false; errors: Array<{ field: string; message: string }> } {

    const data = __mf_textOrValue(input, pageHasShape);
    switch (data) {
        case 'SalesHomeDashboard':
        case 'SalesHomeProducts':
        case 'SalesHomeServices':
        case 'SalesHomePackages':
        case 'SalesHomeTaxRates':
        case 'SalesLeadsOverview':
        case 'SalesLeadsActivities':
        case 'SalesLeadsCampaigns':
        case 'SalesLeadsDripCampaigns':
        case 'SalesLeadsOpportunities':
        case 'SalesLeadsPromotions':
        case 'SalesAccountsOverview':
        case 'SalesAccountsActivities':
        case 'SalesAccountsBilling':
        case 'SalesAccountsContracts':
        case 'SalesOrdersOverview':
        case 'SalesOrdersActivities':
        case 'SalesOrdersPayments':
        case 'SalesOrdersCommissions':
        case 'SalesSchedulingSchedule':
        case 'SalesSchedulingAppointments':
        case 'SalesSchedulingRecurring':
        case 'SalesSchedulingRoutes':
        case 'SalesSchedulingReminders':
        case 'UserHome':
            return { success: true, value: data as Page };
        default:
            return { success: false, errors: [{ field: "_root", message: "Invalid value for Page: expected one of " + ['SalesHomeDashboard', 'SalesHomeProducts', 'SalesHomeServices', 'SalesHomePackages', 'SalesHomeTaxRates', 'SalesLeadsOverview', 'SalesLeadsActivities', 'SalesLeadsCampaigns', 'SalesLeadsDripCampaigns', 'SalesLeadsOpportunities', 'SalesLeadsPromotions', 'SalesAccountsOverview', 'SalesAccountsActivities', 'SalesAccountsBilling', 'SalesAccountsContracts', 'SalesOrdersOverview', 'SalesOrdersActivities', 'SalesOrdersPayments', 'SalesOrdersCommissions', 'SalesSchedulingSchedule', 'SalesSchedulingAppointments', 'SalesSchedulingRecurring', 'SalesSchedulingRoutes', 'SalesSchedulingReminders', 'UserHome'].map(v => JSON.stringify(v)).join(", ") + ", got " + JSON.stringify(input) }] };
