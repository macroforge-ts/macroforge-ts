/** Parses FormData and validates it, returning a Result with the parsed data or errors. Delegates validation to decode() from @derive(Decode).  */
export function appointmentFromFormData(formData: FormData): Exit.Exit<Appointment, Array<{ field: string; message: string }>> {
    const obj: Record<string, unknown> = {};

    
    obj.id = formData.get("id") ?? "";
    obj.title = formData.get("title") ?? "";
    {

        const statusObj: Record<string, unknown> = {};
        for (const [key, value] of Array.from(formData.entries())) {
            if (key.startsWith("status.")) {
                const fieldName = key.slice("status.".length);

                const parts = fieldName.split(".");
                let current = statusObj;
                for (let i = 0; i < parts.length - 1; i++) {
                    const part = parts[i]!;
                    if (!(part in current)) {
                        current[part] = {};
                    }
                    current = current[part] as Record<string, unknown>;
                }
                current[parts[parts.length - 1]!] = value;
            }
        }
        obj.status = statusObj;
    }
    obj.begins = formData.get("begins") ?? "";
    {
        const durationStr = formData.get("duration");
        obj.duration = durationStr ? parseFloat(durationStr as string) : 0;
        if (obj.duration !== undefined && isNaN(obj.duration as number)) obj.duration = 0;
    }
    obj.timeZone = formData.get("timeZone") ?? "";
    {
        const offsetMsStr = formData.get("offsetMs");
        obj.offsetMs = offsetMsStr ? parseFloat(offsetMsStr as string) : 0;
        if (obj.offsetMs !== undefined && isNaN(obj.offsetMs as number)) obj.offsetMs = 0;
    }
    {
        const allDayVal = formData.get("allDay");
        obj.allDay = allDayVal === "true" || allDayVal === "on" || allDayVal === "1";
    }
    {
        const multiDayVal = formData.get("multiDay");
        obj.multiDay = multiDayVal === "true" || multiDayVal === "on" || multiDayVal === "1";
    }
    obj.employees = formData.getAll("employees") as Array<string>;
    obj.location = formData.get("location") ?? "";
    obj.description = formData.get("description") ?? "";
    {

        const colorsObj: Record<string, unknown> = {};
        for (const [key, value] of Array.from(formData.entries())) {
            if (key.startsWith("colors.")) {
                const fieldName = key.slice("colors.".length);

                const parts = fieldName.split(".");
                let current = colorsObj;
                for (let i = 0; i < parts.length - 1; i++) {
                    const part = parts[i]!;
                    if (!(part in current)) {
                        current[part] = {};
                    }
                    current = current[part] as Record<string, unknown>;
                }
                current[parts[parts.length - 1]!] = value;
            }
        }
        obj.colors = colorsObj;
    }
    {

        const recurrenceRuleObj: Record<string, unknown> = {};
        for (const [key, value] of Array.from(formData.entries())) {
            if (key.startsWith("recurrenceRule.")) {
                const fieldName = key.slice("recurrenceRule.".length);

                const parts = fieldName.split(".");
                let current = recurrenceRuleObj;
                for (let i = 0; i < parts.length - 1; i++) {
                    const part = parts[i]!;
                    if (!(part in current)) {
                        current[part] = {};
                    }
                    current = current[part] as Record<string, unknown>;
                }
                current[parts[parts.length - 1]!] = value;
            }
        }
        obj.recurrenceRule = recurrenceRuleObj;
    }

    return toExit(appointmentDecode(obj));
}

export const Appointment: {
  readonly defaultValue: typeof appointmentDefaultValue;
  readonly encode: typeof appointmentEncode;
  readonly encodeWithContext: typeof appointmentEncodeWithContext;
  readonly encodePartialWithContext: typeof appointmentEncodePartialWithContext;
  readonly decode: typeof appointmentDecode;
  readonly decodeWithContext: typeof appointmentDecodeWithContext;
  readonly decodePartialWithContext: typeof appointmentDecodePartialWithContext;
  readonly validateField: typeof appointmentValidateField;
  readonly validateFields: typeof appointmentValidateFields;
  readonly hasShape: typeof appointmentHasShape;
  readonly is: typeof appointmentIs;
  readonly createForm: typeof appointmentCreateForm;
  readonly fromFormData: typeof appointmentFromFormData;
} = {
  defaultValue: appointmentDefaultValue,
  encode: appointmentEncode,
  encodeWithContext: appointmentEncodeWithContext,
  encodePartialWithContext: appointmentEncodePartialWithContext,
  decode: appointmentDecode,
  decodeWithContext: appointmentDecodeWithContext,
  decodePartialWithContext: appointmentDecodePartialWithContext,
  validateField: appointmentValidateField,
  validateFields: appointmentValidateFields,
  hasShape: appointmentHasShape,
  is: appointmentIs,
  createForm: appointmentCreateForm,
  fromFormData: appointmentFromFormData
};


export interface Package {
    
    id: string;
    
    date: string;
}

export function packageDefaultValue(): Package {
    return {
        id: "",
        date: "",
    };
}

/** Encodes a value to a JSON string. @param value - The value to encode @param keepMetadata - If true, preserves __type and __id fields in the output @returns JSON string representation  */
export function packageEncode(value: Package, keepMetadata?: boolean): string {
    const ctx = __mf_EncodeContext.create();
    const __raw = packageEncodeWithContext(value, ctx);
    return keepMetadata ? __mf_encodedText(__raw) : __mf_encodedTextWithoutMetadata(__raw, "__type");
}

/** Encodes with an existing context for nested/cyclic object graphs. @param value - The value to encode @param ctx - The encoding context  */
export function packageEncodeWithContext(value: Package, ctx: __mf_EncodeContext): Record<string, unknown> {
    const existingId = ctx.getId(value);
    if (existingId !== undefined) {
        return __mf_encodedReference(ctx, existingId);
    }
    const result = __mf_encodedAs(ctx, ctx.register(value), { "__type": "Package" });
    packageEncodeFields(value, ctx, result, undefined);
