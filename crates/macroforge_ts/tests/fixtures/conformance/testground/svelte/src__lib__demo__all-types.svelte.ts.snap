/** Nested error structure matching the data shape  */
export type PaymentErrors = {
    _errors: Option.Option<Array<string>>;
    id: Option.Option<Array<string>>;
    date: Option.Option<Array<string>>;
};

/** Nested boolean structure for tracking touched/dirty fields  */
export type PaymentTainted = {
    id: Option.Option<boolean>;
    date: Option.Option<boolean>;
};

/** Type-safe field controllers for this form  */
export interface PaymentFieldControllers {
    readonly id: FieldController<string>;
    readonly date: FieldController<string>;
}

/** Gigaform instance containing reactive state and field controllers  */
export interface PaymentGigaform {
    readonly data: Payment;
    readonly errors: PaymentErrors;
    readonly tainted: PaymentTainted;
    readonly fields: PaymentFieldControllers;
    validate(): Exit.Exit<Payment, Array<{ field: string; message: string }>>;
    reset(overrides?: Partial<Payment>): void;
}
/** Creates a new Gigaform instance with reactive state and field controllers.  */
export function paymentCreateForm(overrides?: Partial<Payment>): PaymentGigaform {
    let data = $state({ ...paymentDefaultValue(), ...overrides });
    let errors = $state<PaymentErrors>({
        _errors: Option.none(),
        id: Option.none(),
        date: Option.none(),
    });
    let tainted = $state<PaymentTainted>({
        id: Option.none(),
        date: Option.none(),
    });
    const fields = {
        id: {
            name: "id",
            label: "id",
            type: "text",
            optional: false,
            array: false,
            path: ["id"],
            get: () => data.id,
            set: (value: string) => { data.id = value; },
            getError: () => errors.id,
            setError: (value: Option.Option<Array<string>>) => { errors.id = value; },
            getTainted: () => tainted.id,
            setTainted: (value: Option.Option<boolean>) => { tainted.id = value; },
            validate: () => paymentValidateField("id", data.id).map((e: { field: string; message: string }) => e.message),

            constraints: {},


            disabled: false,
            readonly: false,
        },
        date: {
            name: "date",
            label: "date",
            type: "text",
            optional: false,
            array: false,
            path: ["date"],
            get: () => data.date,
            set: (value: string) => { data.date = value; },
            getError: () => errors.date,
            setError: (value: Option.Option<Array<string>>) => { errors.date = value; },
            getTainted: () => tainted.date,
            setTainted: (value: Option.Option<boolean>) => { tainted.date = value; },
            validate: () => paymentValidateField("date", data.date).map((e: { field: string; message: string }) => e.message),

            constraints: {},


            disabled: false,
            readonly: false,
        },
    } as unknown as PaymentFieldControllers;

    function validate(): Exit.Exit<Payment, Array<{ field: string; message: string }>> {
        return toExit(paymentDecode(data));
    }

    function reset(newOverrides?: Partial<Payment>): void {
        data = { ...paymentDefaultValue(), ...newOverrides };
        errors = {
            _errors: Option.none(),
            id: Option.none(),
            date: Option.none(),
        };
        tainted = {
            id: Option.none(),
            date: Option.none(),
        };
    }

    return {
        get data() { return data; },
        set data(v) { data = v; },
        get errors() { return errors; },
        set errors(v) { errors = v; },
        get tainted() { return tainted; },
        set tainted(v) { tainted = v; },
        fields,
        validate,
        reset,
    };
}
/** Parses FormData and validates it, returning a Result with the parsed data or errors. Delegates validation to decode() from @derive(Decode).  */
export function paymentFromFormData(formData: FormData): Exit.Exit<Payment, Array<{ field: string; message: string }>> {
    const obj: Record<string, unknown> = {};

    
    obj.id = formData.get("id") ?? "";
    obj.date = formData.get("date") ?? "";

    return toExit(paymentDecode(obj));
}

export const Payment: {
  readonly defaultValue: typeof paymentDefaultValue;
  readonly encode: typeof paymentEncode;
  readonly encodeWithContext: typeof paymentEncodeWithContext;
  readonly encodePartialWithContext: typeof paymentEncodePartialWithContext;
  readonly decode: typeof paymentDecode;
  readonly decodeWithContext: typeof paymentDecodeWithContext;
  readonly decodePartialWithContext: typeof paymentDecodePartialWithContext;
  readonly validateField: typeof paymentValidateField;
  readonly validateFields: typeof paymentValidateFields;
  readonly hasShape: typeof paymentHasShape;
  readonly is: typeof paymentIs;
  readonly createForm: typeof paymentCreateForm;
  readonly fromFormData: typeof paymentFromFormData;
} = {
  defaultValue: paymentDefaultValue,
  encode: paymentEncode,
  encodeWithContext: paymentEncodeWithContext,
  encodePartialWithContext: paymentEncodePartialWithContext,
  decode: paymentDecode,
  decodeWithContext: paymentDecodeWithContext,
  decodePartialWithContext: paymentDecodePartialWithContext,
  validateField: paymentValidateField,
  validateFields: paymentValidateFields,
  hasShape: paymentHasShape,
  is: paymentIs,
  createForm: paymentCreateForm,
