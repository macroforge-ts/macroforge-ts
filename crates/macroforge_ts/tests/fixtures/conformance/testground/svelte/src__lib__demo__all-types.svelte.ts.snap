export interface Number {
    
    countryCode: string;
    
    areaCode: string;
    
    localNumber: string;
}

export function numberDefaultValue(): Number {
    return {
        countryCode: "",
        areaCode: "",
        localNumber: "",
    };
}

/** Encodes a value to a JSON string. @param value - The value to encode @param keepMetadata - If true, preserves __type and __id fields in the output @returns JSON string representation  */
export function numberEncode(value: Number, keepMetadata?: boolean): string {
    const ctx = __mf_EncodeContext.create();
    const __raw = numberEncodeWithContext(value, ctx);
    return keepMetadata ? __mf_encodedText(__raw) : __mf_encodedTextWithoutMetadata(__raw, "__type");
}

/** Encodes with an existing context for nested/cyclic object graphs. @param value - The value to encode @param ctx - The encoding context  */
export function numberEncodeWithContext(value: Number, ctx: __mf_EncodeContext): Record<string, unknown> {
    const existingId = ctx.getId(value);
    if (existingId !== undefined) {
        return __mf_encodedReference(ctx, existingId);
    }
    const result = __mf_encodedAs(ctx, ctx.register(value), { "__type": "Number" });
    numberEncodeFields(value, ctx, result, undefined);
    return result;
}

/** Encodes the fields a partial value has, with an existing context. A value encoded this way is written out wherever it is held: no reference stands for it. @param value - The value to encode @param ctx - The encoding context @param fields - The fields a `Pick` or `Omit` keeps: every field when left out  */
export function numberEncodePartialWithContext(value: Partial<Number>, ctx: __mf_EncodeContext, fields?: __mf_FieldSelection<keyof Number>): Record<string, unknown> {
    return __mf_encodeSelection(ctx, value, () => {
        const result: Record<string, unknown> = { "__type": "Number" };
        numberEncodeFields(value as Number, ctx, result, fields === undefined ? undefined : __mf_fieldRequirement(fields));
        return result;
    });
}

function numberEncodeFields(value: Number, _ctx: __mf_EncodeContext, result: Record<string, unknown>, __fields: __mf_FieldRequirement | undefined): void {
    if (__fields === undefined || __fields.keeps("countryCode")) {
        if (value.countryCode !== undefined) {
            result["countryCode"] = value.countryCode;
        }
    }
    if (__fields === undefined || __fields.keeps("areaCode")) {
        if (value.areaCode !== undefined) {
            result["areaCode"] = value.areaCode;
        }
    }
    if (__fields === undefined || __fields.keeps("localNumber")) {
        if (value.localNumber !== undefined) {
            result["localNumber"] = value.localNumber;
        }
