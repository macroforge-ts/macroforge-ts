export function colorValidateField<K extends keyof Color>(field: K, value: unknown): Array<{ field: string; message: string }>;
export function colorValidateField(): Array<{ field: string; message: string }> {
    return [];
}

export function colorValidateFields(partial: { readonly [K in keyof Color]?: unknown }): Array<{ field: string; message: string }>;
