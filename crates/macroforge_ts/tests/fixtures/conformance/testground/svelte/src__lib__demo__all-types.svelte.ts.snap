}
export function colorHasShape(obj: unknown): boolean {
    if (typeof obj !== "object" || obj === null || Array.isArray(obj)) {
        return false;
    }
    return __mf_holds(obj, "red") && __mf_holds(obj, "green") && __mf_holds(obj, "blue");
}

export function colorIs(obj: unknown): obj is Color {
    return colorHasShape(obj) && colorDecode(obj).success;
}

/** Nested error structure matching the data shape  */
export type ColorErrors = {
    _errors: Option.Option<Array<string>>;
    red: Option.Option<Array<string>>;
    green: Option.Option<Array<string>>;
    blue: Option.Option<Array<string>>;
};

/** Nested boolean structure for tracking touched/dirty fields  */
export type ColorTainted = {
    red: Option.Option<boolean>;
    green: Option.Option<boolean>;
    blue: Option.Option<boolean>;
};

/** Type-safe field controllers for this form  */
export interface ColorFieldControllers {
    readonly red: FieldController<number>;
    readonly green: FieldController<number>;
    readonly blue: FieldController<number>;
}

/** Gigaform instance containing reactive state and field controllers  */
export interface ColorGigaform {
    readonly data: Color;
    readonly errors: ColorErrors;
    readonly tainted: ColorTainted;
    readonly fields: ColorFieldControllers;
    validate(): Exit.Exit<Color, Array<{ field: string; message: string }>>;
    reset(overrides?: Partial<Color>): void;
}
/** Creates a new Gigaform instance with reactive state and field controllers.  */
export function colorCreateForm(overrides?: Partial<Color>): ColorGigaform {
    let data = $state({ ...colorDefaultValue(), ...overrides });
    let errors = $state<ColorErrors>({
        _errors: Option.none(),
        red: Option.none(),
        green: Option.none(),
        blue: Option.none(),
    });
    let tainted = $state<ColorTainted>({
        red: Option.none(),
        green: Option.none(),
        blue: Option.none(),
    });
    const fields = {
        red: {
            name: "red",
            label: "red",
            type: "number",
            optional: false,
            array: false,
            path: ["red"],
            get: () => data.red,
            set: (value: number) => { data.red = value; },
            getError: () => errors.red,
            setError: (value: Option.Option<Array<string>>) => { errors.red = value; },
            getTainted: () => tainted.red,
            setTainted: (value: Option.Option<boolean>) => { tainted.red = value; },
            validate: () => colorValidateField("red", data.red).map((e: { field: string; message: string }) => e.message),

            constraints: {},


            disabled: false,
            readonly: false,
        },
        green: {
            name: "green",
            label: "green",
            type: "number",
            optional: false,
            array: false,
            path: ["green"],
            get: () => data.green,
            set: (value: number) => { data.green = value; },
            getError: () => errors.green,
            setError: (value: Option.Option<Array<string>>) => { errors.green = value; },
            getTainted: () => tainted.green,
            setTainted: (value: Option.Option<boolean>) => { tainted.green = value; },
            validate: () => colorValidateField("green", data.green).map((e: { field: string; message: string }) => e.message),

            constraints: {},


            disabled: false,
            readonly: false,
        },
        blue: {
            name: "blue",
            label: "blue",
            type: "number",
            optional: false,
            array: false,
            path: ["blue"],
            get: () => data.blue,
            set: (value: number) => { data.blue = value; },
            getError: () => errors.blue,
            setError: (value: Option.Option<Array<string>>) => { errors.blue = value; },
            getTainted: () => tainted.blue,
            setTainted: (value: Option.Option<boolean>) => { tainted.blue = value; },
            validate: () => colorValidateField("blue", data.blue).map((e: { field: string; message: string }) => e.message),

            constraints: {},


            disabled: false,
            readonly: false,
        },
    } as unknown as ColorFieldControllers;

    function validate(): Exit.Exit<Color, Array<{ field: string; message: string }>> {
        return toExit(colorDecode(data));
    }

    function reset(newOverrides?: Partial<Color>): void {
        data = { ...colorDefaultValue(), ...newOverrides };
        errors = {
            _errors: Option.none(),
            red: Option.none(),
            green: Option.none(),
            blue: Option.none(),
        };
        tainted = {
            red: Option.none(),
            green: Option.none(),
            blue: Option.none(),
        };
    }

    return {
        get data() { return data; },
        set data(v) { data = v; },
        get errors() { return errors; },
        set errors(v) { errors = v; },
        get tainted() { return tainted; },
        set tainted(v) { tainted = v; },
        fields,
        validate,
        reset,
    };
}
/** Parses FormData and validates it, returning a Result with the parsed data or errors. Delegates validation to decode() from @derive(Decode).  */
export function colorFromFormData(formData: FormData): Exit.Exit<Color, Array<{ field: string; message: string }>> {
    const obj: Record<string, unknown> = {};

    
    {
        const redStr = formData.get("red");
        obj.red = redStr ? parseFloat(redStr as string) : 0;
        if (obj.red !== undefined && isNaN(obj.red as number)) obj.red = 0;
    }
    {
        const greenStr = formData.get("green");
        obj.green = greenStr ? parseFloat(greenStr as string) : 0;
        if (obj.green !== undefined && isNaN(obj.green as number)) obj.green = 0;
    }
    {
        const blueStr = formData.get("blue");
        obj.blue = blueStr ? parseFloat(blueStr as string) : 0;
        if (obj.blue !== undefined && isNaN(obj.blue as number)) obj.blue = 0;
    }

    return toExit(colorDecode(obj));
}

