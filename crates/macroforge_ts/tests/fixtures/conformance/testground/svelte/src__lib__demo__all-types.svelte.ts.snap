        if (value.red !== undefined) {
            result["red"] = value.red;
        }
    }
    if (__fields === undefined || __fields.keeps("green")) {
        if (value.green !== undefined) {
            result["green"] = value.green;
        }
    }
    if (__fields === undefined || __fields.keeps("blue")) {
