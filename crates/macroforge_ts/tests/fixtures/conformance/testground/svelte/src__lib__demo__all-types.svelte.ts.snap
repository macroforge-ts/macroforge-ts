export function yearlyRecurrenceRuleDecodeWithContext(value: unknown, ctx: __mf_DecodeContext, fields: __mf_FieldRequirement): Partial<YearlyRecurrenceRule> | __mf_PendingRef;
export function yearlyRecurrenceRuleDecodeWithContext(value: unknown, ctx: __mf_DecodeContext, __fields?: __mf_FieldRequirement): Partial<YearlyRecurrenceRule> | __mf_PendingRef {
