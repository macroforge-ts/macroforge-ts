    }

    const instance: any = {};

    if (__fields === undefined && obj.__id !== undefined) {
        ctx.register(obj.__id as number, instance, "Commissions");
    }

    ctx.trackForFreeze(instance);

    if ((__fields === undefined || __fields.requires("technician")) ? "technician" in obj : (__fields.keeps("technician") && obj["technician"] !== undefined)) {
        const __raw_technician = obj["technician"] as string;

