export function colorDecodeWithContext(value: unknown, ctx: __mf_DecodeContext, fields: __mf_FieldRequirement): Partial<Color> | __mf_PendingRef;
export function colorDecodeWithContext(value: unknown, ctx: __mf_DecodeContext, __fields?: __mf_FieldRequirement): Partial<Color> | __mf_PendingRef {
    if (__fields !== undefined && typeof value === "object" && value !== null && "__ref" in value) {
        throw new __mf_DecodeError([{ field: "_root", message: "Color.decodeWithContext: a value holding a selection of fields cannot be a reference" }]);
    }
    if (typeof value === "object" && value !== null && "__ref" in value) {
        if (typeof value.__ref !== "number") {
            throw new __mf_DecodeError([{ field: "__ref", message: "Color.decodeWithContext: __ref must be a number" }]);
        }
        return ctx.getOrDefer(value.__ref, "Color") as Color | __mf_PendingRef;
    }

    if (typeof value !== "object" || value === null || Array.isArray(value)) {
        throw new __mf_DecodeError([{ field: "_root", message: "Color.decodeWithContext: expected an object" }]);
    }

    const obj = __mf_ownMembers(value);
    const errors: Array<{ field: string; message: string }> = [];
    if ((__fields === undefined || __fields.requires("red")) && !("red" in obj)) {
        errors.push({ field: "red", message: "missing required field" });
    }
    if ((__fields === undefined || __fields.requires("green")) && !("green" in obj)) {
        errors.push({ field: "green", message: "missing required field" });
    }
    if ((__fields === undefined || __fields.requires("blue")) && !("blue" in obj)) {
        errors.push({ field: "blue", message: "missing required field" });
    }

