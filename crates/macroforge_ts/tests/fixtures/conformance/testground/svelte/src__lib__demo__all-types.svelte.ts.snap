/** Parses FormData and validates it, returning a Result with the parsed data or errors. Delegates validation to decode() from @derive(Decode).  */
export function serviceFromFormData(formData: FormData): Exit.Exit<Service, Array<{ field: string; message: string }>> {
    const obj: Record<string, unknown> = {};

    
    obj.id = formData.get("id") ?? "";
    obj.name = formData.get("name") ?? "";
    obj.quickCode = formData.get("quickCode") ?? "";
    obj.group = formData.get("group") ?? "";
    obj.subgroup = formData.get("subgroup") ?? "";
    obj.unit = formData.get("unit") ?? "";
    {
        const activeVal = formData.get("active");
        obj.active = activeVal === "true" || activeVal === "on" || activeVal === "1";
    }
    {
        const commissionVal = formData.get("commission");
        obj.commission = commissionVal === "true" || commissionVal === "on" || commissionVal === "1";
    }
    {
        const favoriteVal = formData.get("favorite");
        obj.favorite = favoriteVal === "true" || favoriteVal === "on" || favoriteVal === "1";
    }
    obj.averageTime = formData.get("averageTime") ?? "";
    {

        const defaultsObj: Record<string, unknown> = {};
        for (const [key, value] of Array.from(formData.entries())) {
            if (key.startsWith("defaults.")) {
                const fieldName = key.slice("defaults.".length);

                const parts = fieldName.split(".");
                let current = defaultsObj;
                for (let i = 0; i < parts.length - 1; i++) {
                    const part = parts[i]!;
                    if (!(part in current)) {
                        current[part] = {};
                    }
                    current = current[part] as Record<string, unknown>;
                }
                current[parts[parts.length - 1]!] = value;
            }
        }
        obj.defaults = defaultsObj;
    }

    return toExit(serviceDecode(obj));
}

export const Service: {
  readonly defaultValue: typeof serviceDefaultValue;
  readonly encode: typeof serviceEncode;
  readonly encodeWithContext: typeof serviceEncodeWithContext;
  readonly encodePartialWithContext: typeof serviceEncodePartialWithContext;
  readonly decode: typeof serviceDecode;
  readonly decodeWithContext: typeof serviceDecodeWithContext;
  readonly decodePartialWithContext: typeof serviceDecodePartialWithContext;
  readonly validateField: typeof serviceValidateField;
  readonly validateFields: typeof serviceValidateFields;
  readonly hasShape: typeof serviceHasShape;
  readonly is: typeof serviceIs;
  readonly createForm: typeof serviceCreateForm;
  readonly fromFormData: typeof serviceFromFormData;
} = {
  defaultValue: serviceDefaultValue,
  encode: serviceEncode,
  encodeWithContext: serviceEncodeWithContext,
  encodePartialWithContext: serviceEncodePartialWithContext,
  decode: serviceDecode,
  decodeWithContext: serviceDecodeWithContext,
  decodePartialWithContext: serviceDecodePartialWithContext,
  validateField: serviceValidateField,
  validateFields: serviceValidateFields,
  hasShape: serviceHasShape,
  is: serviceIs,
  createForm: serviceCreateForm,
  fromFormData: serviceFromFormData
};


export interface ServiceDefaults {
    
    price: number;
    
    
    description: string;
}

export function serviceDefaultsDefaultValue(): ServiceDefaults {
    return {
        price: 0,
        description: "",
    };
}

/** Encodes a value to a JSON string. @param value - The value to encode @param keepMetadata - If true, preserves __type and __id fields in the output @returns JSON string representation  */
export function serviceDefaultsEncode(value: ServiceDefaults, keepMetadata?: boolean): string {
    const ctx = __mf_EncodeContext.create();
    const __raw = serviceDefaultsEncodeWithContext(value, ctx);
