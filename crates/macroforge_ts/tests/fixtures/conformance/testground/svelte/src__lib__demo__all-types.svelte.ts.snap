                const temp = data.attendance[a];
                data.attendance[a] = data.attendance[b];
                data.attendance[b] = temp;
            },
            constraints: {},


            disabled: false,
            readonly: false,
        },
        settings: {
            name: "settings",
            label: "settings",
            type: "fieldset",
            optional: false,
            array: false,
            path: ["settings"],
            get: () => data.settings,
            set: (value: Settings) => { data.settings = value; },
            getError: () => errors.settings,
