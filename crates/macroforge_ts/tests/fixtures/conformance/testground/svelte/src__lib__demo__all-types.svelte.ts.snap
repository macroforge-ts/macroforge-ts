/** Parses FormData and validates it, returning a Result with the parsed data or errors. Delegates validation to decode() from @derive(Decode).  */
export function accountFromFormData(formData: FormData): Exit.Exit<Account, Array<{ field: string; message: string }>> {
    const obj: Record<string, unknown> = {};

    
    obj.id = formData.get("id") ?? "";
    obj.taxRate = formData.get("taxRate") ?? "";
    obj.site = formData.get("site") ?? "";
    {

        const salesRepObj: Record<string, unknown> = {};
        for (const [key, value] of Array.from(formData.entries())) {
            if (key.startsWith("salesRep.")) {
                const fieldName = key.slice("salesRep.".length);

                const parts = fieldName.split(".");
                let current = salesRepObj;
                for (let i = 0; i < parts.length - 1; i++) {
                    const part = parts[i]!;
                    if (!(part in current)) {
                        current[part] = {};
                    }
                    current = current[part] as Record<string, unknown>;
                }
                current[parts[parts.length - 1]!] = value;
            }
        }
        obj.salesRep = salesRepObj;
    }
    {

        const ordersItems: Array<Record<string, unknown>> = [];
        let idx = 0;
        while (formData.has("orders." + idx + ".") || idx === 0) {

            const hasAny = Array.from(formData.keys()).some(k => k.startsWith("orders." + idx + "."));
            if (!hasAny && idx > 0) break;
            if (hasAny) {
                const item: Record<string, unknown> = {};
                for (const [key, value] of Array.from(formData.entries())) {
                    if (key.startsWith("orders." + idx + ".")) {
                        const fieldName = key.slice("orders.".length + String(idx).length + 1);
                        item[fieldName] = value;
                    }
                }
                ordersItems.push(item);
            }
            idx++;
            if (idx > 1000) break;
        }
        obj.orders = ordersItems;
    }
    {

        const activityItems: Array<Record<string, unknown>> = [];
        let idx = 0;
        while (formData.has("activity." + idx + ".") || idx === 0) {

            const hasAny = Array.from(formData.keys()).some(k => k.startsWith("activity." + idx + "."));
            if (!hasAny && idx > 0) break;
            if (hasAny) {
                const item: Record<string, unknown> = {};
                for (const [key, value] of Array.from(formData.entries())) {
                    if (key.startsWith("activity." + idx + ".")) {
                        const fieldName = key.slice("activity.".length + String(idx).length + 1);
                        item[fieldName] = value;
                    }
                }
                activityItems.push(item);
            }
            idx++;
            if (idx > 1000) break;
        }
        obj.activity = activityItems;
    }
    {

        const customFieldsItems: Array<Record<string, unknown>> = [];
        let idx = 0;
        while (formData.has("customFields." + idx + ".") || idx === 0) {

            const hasAny = Array.from(formData.keys()).some(k => k.startsWith("customFields." + idx + "."));
            if (!hasAny && idx > 0) break;
            if (hasAny) {
                const item: Record<string, unknown> = {};
                for (const [key, value] of Array.from(formData.entries())) {
                    if (key.startsWith("customFields." + idx + ".")) {
                        const fieldName = key.slice("customFields.".length + String(idx).length + 1);
                        item[fieldName] = value;
                    }
                }
                customFieldsItems.push(item);
            }
            idx++;
            if (idx > 1000) break;
        }
        obj.customFields = customFieldsItems;
    }
    {

        const accountNameObj: Record<string, unknown> = {};
        for (const [key, value] of Array.from(formData.entries())) {
            if (key.startsWith("accountName.")) {
                const fieldName = key.slice("accountName.".length);

                const parts = fieldName.split(".");
                let current = accountNameObj;
                for (let i = 0; i < parts.length - 1; i++) {
                    const part = parts[i]!;
                    if (!(part in current)) {
                        current[part] = {};
                    }
                    current = current[part] as Record<string, unknown>;
                }
                current[parts[parts.length - 1]!] = value;
            }
        }
        obj.accountName = accountNameObj;
    }
    {

        const sectorObj: Record<string, unknown> = {};
        for (const [key, value] of Array.from(formData.entries())) {
            if (key.startsWith("sector.")) {
                const fieldName = key.slice("sector.".length);

                const parts = fieldName.split(".");
                let current = sectorObj;
                for (let i = 0; i < parts.length - 1; i++) {
                    const part = parts[i]!;
                    if (!(part in current)) {
                        current[part] = {};
                    }
                    current = current[part] as Record<string, unknown>;
                }
                current[parts[parts.length - 1]!] = value;
            }
        }
        obj.sector = sectorObj;
    }
    obj.memo = formData.get("memo") ?? "";
    {

        const phonesItems: Array<Record<string, unknown>> = [];
        let idx = 0;
        while (formData.has("phones." + idx + ".") || idx === 0) {

            const hasAny = Array.from(formData.keys()).some(k => k.startsWith("phones." + idx + "."));
            if (!hasAny && idx > 0) break;
            if (hasAny) {
                const item: Record<string, unknown> = {};
                for (const [key, value] of Array.from(formData.entries())) {
                    if (key.startsWith("phones." + idx + ".")) {
                        const fieldName = key.slice("phones.".length + String(idx).length + 1);
                        item[fieldName] = value;
                    }
                }
                phonesItems.push(item);
            }
            idx++;
            if (idx > 1000) break;
        }
        obj.phones = phonesItems;
    }
    {

        const emailObj: Record<string, unknown> = {};
        for (const [key, value] of Array.from(formData.entries())) {
            if (key.startsWith("email.")) {
                const fieldName = key.slice("email.".length);

                const parts = fieldName.split(".");
                let current = emailObj;
                for (let i = 0; i < parts.length - 1; i++) {
                    const part = parts[i]!;
                    if (!(part in current)) {
                        current[part] = {};
                    }
                    current = current[part] as Record<string, unknown>;
                }
                current[parts[parts.length - 1]!] = value;
            }
        }
        obj.email = emailObj;
    }
    obj.leadSource = formData.get("leadSource") ?? "";
    {

        const colorsObj: Record<string, unknown> = {};
        for (const [key, value] of Array.from(formData.entries())) {
            if (key.startsWith("colors.")) {
                const fieldName = key.slice("colors.".length);

                const parts = fieldName.split(".");
                let current = colorsObj;
                for (let i = 0; i < parts.length - 1; i++) {
                    const part = parts[i]!;
                    if (!(part in current)) {
                        current[part] = {};
                    }
                    current = current[part] as Record<string, unknown>;
                }
                current[parts[parts.length - 1]!] = value;
            }
        }
        obj.colors = colorsObj;
    }
    {
        const needsReviewVal = formData.get("needsReview");
        obj.needsReview = needsReviewVal === "true" || needsReviewVal === "on" || needsReviewVal === "1";
    }
    {
        const hasAlertVal = formData.get("hasAlert");
        obj.hasAlert = hasAlertVal === "true" || hasAlertVal === "on" || hasAlertVal === "1";
    }
    obj.accountType = formData.get("accountType") ?? "";
    obj.subtype = formData.get("subtype") ?? "";
    {
        const isTaxExemptVal = formData.get("isTaxExempt");
        obj.isTaxExempt = isTaxExemptVal === "true" || isTaxExemptVal === "on" || isTaxExemptVal === "1";
    }
    obj.paymentTerms = formData.get("paymentTerms") ?? "";
    obj.tags = formData.getAll("tags") as Array<string>;
    obj.dateAdded = formData.get("dateAdded") ?? "";

    return toExit(accountDecode(obj));
}

export const Account: {
  readonly defaultValue: typeof accountDefaultValue;
  readonly encode: typeof accountEncode;
  readonly encodeWithContext: typeof accountEncodeWithContext;
  readonly encodePartialWithContext: typeof accountEncodePartialWithContext;
  readonly decode: typeof accountDecode;
  readonly decodeWithContext: typeof accountDecodeWithContext;
  readonly decodePartialWithContext: typeof accountDecodePartialWithContext;
  readonly validateField: typeof accountValidateField;
  readonly validateFields: typeof accountValidateFields;
  readonly hasShape: typeof accountHasShape;
  readonly is: typeof accountIs;
  readonly createForm: typeof accountCreateForm;
  readonly fromFormData: typeof accountFromFormData;
} = {
  defaultValue: accountDefaultValue,
  encode: accountEncode,
  encodeWithContext: accountEncodeWithContext,
  encodePartialWithContext: accountEncodePartialWithContext,
  decode: accountDecode,
  decodeWithContext: accountDecodeWithContext,
  decodePartialWithContext: accountDecodePartialWithContext,
  validateField: accountValidateField,
  validateFields: accountValidateFields,
  hasShape: accountHasShape,
  is: accountIs,
  createForm: accountCreateForm,
  fromFormData: accountFromFormData
};


export interface Edited {
    
    fieldName: string;
    oldValue: string | null;
    newValue: string | null;
}

export function editedDefaultValue(): Edited {
    return {
        fieldName: "",
        oldValue: null,
        newValue: null,
    };
}

/** Encodes a value to a JSON string. @param value - The value to encode @param keepMetadata - If true, preserves __type and __id fields in the output @returns JSON string representation  */
export function editedEncode(value: Edited, keepMetadata?: boolean): string {
    const ctx = __mf_EncodeContext.create();
    const __raw = editedEncodeWithContext(value, ctx);
    return keepMetadata ? __mf_encodedText(__raw) : __mf_encodedTextWithoutMetadata(__raw, "__type");
}

/** Encodes with an existing context for nested/cyclic object graphs. @param value - The value to encode @param ctx - The encoding context  */
export function editedEncodeWithContext(value: Edited, ctx: __mf_EncodeContext): Record<string, unknown> {
    const existingId = ctx.getId(value);
    if (existingId !== undefined) {
        return __mf_encodedReference(ctx, existingId);
    }
    const result = __mf_encodedAs(ctx, ctx.register(value), { "__type": "Edited" });
    editedEncodeFields(value, ctx, result, undefined);
    return result;
}

/** Encodes the fields a partial value has, with an existing context. A value encoded this way is written out wherever it is held: no reference stands for it. @param value - The value to encode @param ctx - The encoding context @param fields - The fields a `Pick` or `Omit` keeps: every field when left out  */
export function editedEncodePartialWithContext(value: Partial<Edited>, ctx: __mf_EncodeContext, fields?: __mf_FieldSelection<keyof Edited>): Record<string, unknown> {
    return __mf_encodeSelection(ctx, value, () => {
        const result: Record<string, unknown> = { "__type": "Edited" };
        editedEncodeFields(value as Edited, ctx, result, fields === undefined ? undefined : __mf_fieldRequirement(fields));
        return result;
    });
}

function editedEncodeFields(value: Edited, _ctx: __mf_EncodeContext, result: Record<string, unknown>, __fields: __mf_FieldRequirement | undefined): void {
    if (__fields === undefined || __fields.keeps("fieldName")) {
        if (value.fieldName !== undefined) {
            result["fieldName"] = value.fieldName;
        }
    }
    if (__fields === undefined || __fields.keeps("oldValue")) {
        if (value.oldValue !== undefined) {
            result["oldValue"] = value.oldValue;
        }
    }
    if (__fields === undefined || __fields.keeps("newValue")) {
        if (value.newValue !== undefined) {
            result["newValue"] = value.newValue;
        }
    }
}

/** Decodes input to this type. Automatically detects whether input is a JSON string or object. @param input - JSON string or object to decode @param opts - Optional decoding options @returns Result containing the decoded value or validation errors  */
export function editedDecode(input: unknown, opts?: __mf_DecodeOptions): { success: true; value: Edited } | { success: false; errors: Array<{ field: string; message: string }> } {
    try {

        const data = typeof input === "string" ? JSON.parse(input) : input;

        const ctx = __mf_DecodeContext.create();
        const resultOrRef = editedDecodeWithContext(data, ctx);

        if (__mf_PendingRef.is(resultOrRef)) {
            return ({
	success: false,
	errors: [{
		field: "_root",
		message: "Edited.decode: root cannot be a forward reference"
	}]
});
        }

        ctx.applyPatches();
        if (opts?.freeze) {
            ctx.freezeAll();
        }

        const __errors = ctx.getErrors();
        if (__errors.length > 0) {
            return ({
	success: false,
	errors: __errors
});
        }

        return ({
	success: true,
	value: resultOrRef
});
    } catch (e) {
        if (e instanceof __mf_DecodeError) {
            return ({
	success: false,
	errors: e.errors
});
        }
        const message = e instanceof Error ? e.message : String(e);
        return ({
	success: false,
	errors: [{
		field: "_root",
		message
	}]
});
    }
}
/** Decodes with an existing context for nested/cyclic object graphs. @param value - The raw value to decode @param ctx - The decoding context  */
export function editedDecodeWithContext(value: unknown, ctx: __mf_DecodeContext): Edited | __mf_PendingRef;
/** Decodes the fields `fields` keeps, and no other. @param value - The raw value to decode @param ctx - The decoding context @param fields - Which fields the value has and has to have  */
export function editedDecodeWithContext(value: unknown, ctx: __mf_DecodeContext, fields: __mf_FieldRequirement): Partial<Edited> | __mf_PendingRef;
export function editedDecodeWithContext(value: unknown, ctx: __mf_DecodeContext, __fields?: __mf_FieldRequirement): Partial<Edited> | __mf_PendingRef {
    if (__fields !== undefined && typeof value === "object" && value !== null && "__ref" in value) {
        throw new __mf_DecodeError([{ field: "_root", message: "Edited.decodeWithContext: a value holding a selection of fields cannot be a reference" }]);
    }
    if (typeof value === "object" && value !== null && "__ref" in value) {
        if (typeof value.__ref !== "number") {
            throw new __mf_DecodeError([{ field: "__ref", message: "Edited.decodeWithContext: __ref must be a number" }]);
        }
        return ctx.getOrDefer(value.__ref, "Edited") as Edited | __mf_PendingRef;
    }

    if (typeof value !== "object" || value === null || Array.isArray(value)) {
        throw new __mf_DecodeError([{ field: "_root", message: "Edited.decodeWithContext: expected an object" }]);
    }

    const obj = __mf_ownMembers(value);
    const errors: Array<{ field: string; message: string }> = [];
    if ((__fields === undefined || __fields.requires("fieldName")) && !("fieldName" in obj)) {
        errors.push({ field: "fieldName", message: "missing required field" });
    }
    if ((__fields === undefined || __fields.requires("oldValue")) && !("oldValue" in obj)) {
        errors.push({ field: "oldValue", message: "missing required field" });
    }
    if ((__fields === undefined || __fields.requires("newValue")) && !("newValue" in obj)) {
        errors.push({ field: "newValue", message: "missing required field" });
    }

    const instance: any = {};

    if (__fields === undefined && obj.__id !== undefined) {
        ctx.register(obj.__id as number, instance, "Edited");
    }

    ctx.trackForFreeze(instance);

    if ((__fields === undefined || __fields.requires("fieldName")) ? "fieldName" in obj : (__fields.keeps("fieldName") && obj["fieldName"] !== undefined)) {
        const __raw_fieldName = obj["fieldName"] as string;

        if (!(typeof __raw_fieldName === "string")) {
            errors.push({ field: "fieldName", message: __raw_fieldName == null ? "Edited.fieldName is required" : "expected string" });
        } else {
            if (__raw_fieldName == null) { errors.push({ field: "fieldName", message: "Edited.fieldName is required" }); } else {
