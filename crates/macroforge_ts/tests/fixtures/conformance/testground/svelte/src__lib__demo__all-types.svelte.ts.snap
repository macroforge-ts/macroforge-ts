/** Parses FormData and validates it, returning a Result with the parsed data or errors. Delegates validation to decode() from @derive(Decode).  */
export function userFromFormData(formData: FormData): Exit.Exit<User, Array<{ field: string; message: string }>> {
    const obj: Record<string, unknown> = {};

    
    obj.id = formData.get("id") ?? "";
    obj.email = formData.get("email") ?? "";
    obj.firstName = formData.get("firstName") ?? "";
    obj.lastName = formData.get("lastName") ?? "";
    obj.password = formData.get("password") ?? "";
    {

        const metadataObj: Record<string, unknown> = {};
        for (const [key, value] of Array.from(formData.entries())) {
            if (key.startsWith("metadata.")) {
                const fieldName = key.slice("metadata.".length);

                const parts = fieldName.split(".");
                let current = metadataObj;
                for (let i = 0; i < parts.length - 1; i++) {
                    const part = parts[i]!;
                    if (!(part in current)) {
                        current[part] = {};
                    }
                    current = current[part] as Record<string, unknown>;
                }
                current[parts[parts.length - 1]!] = value;
            }
        }
        obj.metadata = metadataObj;
    }
    {

        const settingsObj: Record<string, unknown> = {};
        for (const [key, value] of Array.from(formData.entries())) {
            if (key.startsWith("settings.")) {
                const fieldName = key.slice("settings.".length);

                const parts = fieldName.split(".");
                let current = settingsObj;
                for (let i = 0; i < parts.length - 1; i++) {
                    const part = parts[i]!;
                    if (!(part in current)) {
                        current[part] = {};
                    }
                    current = current[part] as Record<string, unknown>;
                }
                current[parts[parts.length - 1]!] = value;
            }
        }
        obj.settings = settingsObj;
    }
    {

        const roleObj: Record<string, unknown> = {};
        for (const [key, value] of Array.from(formData.entries())) {
            if (key.startsWith("role.")) {
                const fieldName = key.slice("role.".length);

                const parts = fieldName.split(".");
                let current = roleObj;
                for (let i = 0; i < parts.length - 1; i++) {
                    const part = parts[i]!;
                    if (!(part in current)) {
                        current[part] = {};
                    }
                    current = current[part] as Record<string, unknown>;
                }
                current[parts[parts.length - 1]!] = value;
            }
        }
        obj.role = roleObj;
    }
    {
        const emailVerifiedVal = formData.get("emailVerified");
        obj.emailVerified = emailVerifiedVal === "true" || emailVerifiedVal === "on" || emailVerifiedVal === "1";
    }
    obj.verificationToken = formData.get("verificationToken") ?? "";
    obj.verificationExpires = formData.get("verificationExpires") ?? "";
    obj.passwordResetToken = formData.get("passwordResetToken") ?? "";
    obj.passwordResetExpires = formData.get("passwordResetExpires") ?? "";
    {

        const permissionsObj: Record<string, unknown> = {};
        for (const [key, value] of Array.from(formData.entries())) {
            if (key.startsWith("permissions.")) {
                const fieldName = key.slice("permissions.".length);

                const parts = fieldName.split(".");
                let current = permissionsObj;
                for (let i = 0; i < parts.length - 1; i++) {
                    const part = parts[i]!;
                    if (!(part in current)) {
                        current[part] = {};
                    }
                    current = current[part] as Record<string, unknown>;
                }
                current[parts[parts.length - 1]!] = value;
            }
        }
        obj.permissions = permissionsObj;
    }

    return toExit(userDecode(obj));
}

export const User: {
  readonly defaultValue: typeof userDefaultValue;
  readonly encode: typeof userEncode;
  readonly encodeWithContext: typeof userEncodeWithContext;
  readonly encodePartialWithContext: typeof userEncodePartialWithContext;
  readonly decode: typeof userDecode;
  readonly decodeWithContext: typeof userDecodeWithContext;
  readonly decodePartialWithContext: typeof userDecodePartialWithContext;
  readonly validateField: typeof userValidateField;
  readonly validateFields: typeof userValidateFields;
  readonly hasShape: typeof userHasShape;
  readonly is: typeof userIs;
  readonly createForm: typeof userCreateForm;
  readonly fromFormData: typeof userFromFormData;
} = {
  defaultValue: userDefaultValue,
  encode: userEncode,
  encodeWithContext: userEncodeWithContext,
  encodePartialWithContext: userEncodePartialWithContext,
  decode: userDecode,
  decodeWithContext: userDecodeWithContext,
  decodePartialWithContext: userDecodePartialWithContext,
  validateField: userValidateField,
  validateFields: userValidateFields,
  hasShape: userHasShape,
  is: userIs,
  createForm: userCreateForm,
  fromFormData: userFromFormData
};


export interface Service {
    
    id: string;
    
    
    name: string;
    
    
    quickCode: string;
    
    group: string | null;
    
    subgroup: string | null;
    
    unit: string | null;
    
    active: boolean;
    
    commission: boolean;
    
    favorite: boolean;
    
    averageTime: string | null;
    defaults: ServiceDefaults;
}

export function serviceDefaultValue(): Service {
    return {
        id: "",
        name: "",
        quickCode: "",
        group: null,
        subgroup: null,
        unit: null,
        active: false,
        commission: false,
        favorite: false,
        averageTime: null,
        defaults: serviceDefaultsDefaultValue(),
    };
}

/** Encodes a value to a JSON string. @param value - The value to encode @param keepMetadata - If true, preserves __type and __id fields in the output @returns JSON string representation  */
export function serviceEncode(value: Service, keepMetadata?: boolean): string {
    const ctx = __mf_EncodeContext.create();
    const __raw = serviceEncodeWithContext(value, ctx);
    return keepMetadata ? __mf_encodedText(__raw) : __mf_encodedTextWithoutMetadata(__raw, "__type");
}

/** Encodes with an existing context for nested/cyclic object graphs. @param value - The value to encode @param ctx - The encoding context  */
export function serviceEncodeWithContext(value: Service, ctx: __mf_EncodeContext): Record<string, unknown> {
    const existingId = ctx.getId(value);
    if (existingId !== undefined) {
        return __mf_encodedReference(ctx, existingId);
    }
    const result = __mf_encodedAs(ctx, ctx.register(value), { "__type": "Service" });
    serviceEncodeFields(value, ctx, result, undefined);
    return result;
}

/** Encodes the fields a partial value has, with an existing context. A value encoded this way is written out wherever it is held: no reference stands for it. @param value - The value to encode @param ctx - The encoding context @param fields - The fields a `Pick` or `Omit` keeps: every field when left out  */
export function serviceEncodePartialWithContext(value: Partial<Service>, ctx: __mf_EncodeContext, fields?: __mf_FieldSelection<keyof Service>): Record<string, unknown> {
    return __mf_encodeSelection(ctx, value, () => {
        const result: Record<string, unknown> = { "__type": "Service" };
        serviceEncodeFields(value as Service, ctx, result, fields === undefined ? undefined : __mf_fieldRequirement(fields));
        return result;
    });
}

function serviceEncodeFields(value: Service, ctx: __mf_EncodeContext, result: Record<string, unknown>, __fields: __mf_FieldRequirement | undefined): void {
    if (__fields === undefined || __fields.keeps("id")) {
        if (value.id !== undefined) {
            result["id"] = value.id;
        }
    }
    if (__fields === undefined || __fields.keeps("name")) {
        if (value.name !== undefined) {
            result["name"] = value.name;
        }
    }
    if (__fields === undefined || __fields.keeps("quickCode")) {
        if (value.quickCode !== undefined) {
            result["quickCode"] = value.quickCode;
        }
    }
    if (__fields === undefined || __fields.keeps("group")) {
        if (value.group !== undefined) {
            result["group"] = value.group;
        }
    }
    if (__fields === undefined || __fields.keeps("subgroup")) {
        if (value.subgroup !== undefined) {
            result["subgroup"] = value.subgroup;
        }
    }
    if (__fields === undefined || __fields.keeps("unit")) {
        if (value.unit !== undefined) {
            result["unit"] = value.unit;
        }
    }
    if (__fields === undefined || __fields.keeps("active")) {
        if (value.active !== undefined) {
            result["active"] = value.active;
        }
    }
    if (__fields === undefined || __fields.keeps("commission")) {
        if (value.commission !== undefined) {
            result["commission"] = value.commission;
        }
    }
    if (__fields === undefined || __fields.keeps("favorite")) {
        if (value.favorite !== undefined) {
            result["favorite"] = value.favorite;
        }
    }
    if (__fields === undefined || __fields.keeps("averageTime")) {
        if (value.averageTime !== undefined) {
            result["averageTime"] = value.averageTime;
        }
    }
    if (__fields === undefined || __fields.keeps("defaults")) {
        if (value.defaults !== undefined) {
            result["defaults"] = serviceDefaultsEncodeWithContext(value.defaults, ctx);
        }
    }
}

/** Decodes input to this type. Automatically detects whether input is a JSON string or object. @param input - JSON string or object to decode @param opts - Optional decoding options @returns Result containing the decoded value or validation errors  */
export function serviceDecode(input: unknown, opts?: __mf_DecodeOptions): { success: true; value: Service } | { success: false; errors: Array<{ field: string; message: string }> } {
    try {

        const data = typeof input === "string" ? JSON.parse(input) : input;

        const ctx = __mf_DecodeContext.create();
        const resultOrRef = serviceDecodeWithContext(data, ctx);

        if (__mf_PendingRef.is(resultOrRef)) {
            return ({
	success: false,
	errors: [{
		field: "_root",
		message: "Service.decode: root cannot be a forward reference"
	}]
});
        }

        ctx.applyPatches();
        if (opts?.freeze) {
            ctx.freezeAll();
        }

        const __errors = ctx.getErrors();
        if (__errors.length > 0) {
            return ({
	success: false,
	errors: __errors
});
        }

        return ({
	success: true,
	value: resultOrRef
});
    } catch (e) {
        if (e instanceof __mf_DecodeError) {
            return ({
	success: false,
	errors: e.errors
});
        }
        const message = e instanceof Error ? e.message : String(e);
        return ({
	success: false,
	errors: [{
		field: "_root",
		message
	}]
});
    }
}
/** Decodes with an existing context for nested/cyclic object graphs. @param value - The raw value to decode @param ctx - The decoding context  */
export function serviceDecodeWithContext(value: unknown, ctx: __mf_DecodeContext): Service | __mf_PendingRef;
/** Decodes the fields `fields` keeps, and no other. @param value - The raw value to decode @param ctx - The decoding context @param fields - Which fields the value has and has to have  */
export function serviceDecodeWithContext(value: unknown, ctx: __mf_DecodeContext, fields: __mf_FieldRequirement): Partial<Service> | __mf_PendingRef;
export function serviceDecodeWithContext(value: unknown, ctx: __mf_DecodeContext, __fields?: __mf_FieldRequirement): Partial<Service> | __mf_PendingRef {
    if (__fields !== undefined && typeof value === "object" && value !== null && "__ref" in value) {
        throw new __mf_DecodeError([{ field: "_root", message: "Service.decodeWithContext: a value holding a selection of fields cannot be a reference" }]);
    }
    if (typeof value === "object" && value !== null && "__ref" in value) {
        if (typeof value.__ref !== "number") {
            throw new __mf_DecodeError([{ field: "__ref", message: "Service.decodeWithContext: __ref must be a number" }]);
        }
        return ctx.getOrDefer(value.__ref, "Service") as Service | __mf_PendingRef;
    }

    if (typeof value !== "object" || value === null || Array.isArray(value)) {
        throw new __mf_DecodeError([{ field: "_root", message: "Service.decodeWithContext: expected an object" }]);
    }

    const obj = __mf_ownMembers(value);
    const errors: Array<{ field: string; message: string }> = [];
    if ((__fields === undefined || __fields.requires("id")) && !("id" in obj)) {
        errors.push({ field: "id", message: "missing required field" });
    }
    if ((__fields === undefined || __fields.requires("name")) && !("name" in obj)) {
        errors.push({ field: "name", message: "missing required field" });
    }
    if ((__fields === undefined || __fields.requires("quickCode")) && !("quickCode" in obj)) {
