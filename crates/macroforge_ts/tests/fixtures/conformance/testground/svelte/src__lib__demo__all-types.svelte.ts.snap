/** Nested error structure matching the data shape  */
export type PromotionErrors = {
    _errors: Option.Option<Array<string>>;
    id: Option.Option<Array<string>>;
    date: Option.Option<Array<string>>;
};

/** Nested boolean structure for tracking touched/dirty fields  */
export type PromotionTainted = {
    id: Option.Option<boolean>;
    date: Option.Option<boolean>;
};

/** Type-safe field controllers for this form  */
export interface PromotionFieldControllers {
    readonly id: FieldController<string>;
    readonly date: FieldController<string>;
}

/** Gigaform instance containing reactive state and field controllers  */
export interface PromotionGigaform {
    readonly data: Promotion;
    readonly errors: PromotionErrors;
    readonly tainted: PromotionTainted;
    readonly fields: PromotionFieldControllers;
    validate(): Exit.Exit<Promotion, Array<{ field: string; message: string }>>;
    reset(overrides?: Partial<Promotion>): void;
}
/** Creates a new Gigaform instance with reactive state and field controllers.  */
export function promotionCreateForm(overrides?: Partial<Promotion>): PromotionGigaform {
    let data = $state({ ...promotionDefaultValue(), ...overrides });
    let errors = $state<PromotionErrors>({
        _errors: Option.none(),
        id: Option.none(),
        date: Option.none(),
    });
    let tainted = $state<PromotionTainted>({
        id: Option.none(),
        date: Option.none(),
    });
    const fields = {
        id: {
            name: "id",
            label: "id",
            type: "text",
            optional: false,
            array: false,
            path: ["id"],
            get: () => data.id,
            set: (value: string) => { data.id = value; },
            getError: () => errors.id,
            setError: (value: Option.Option<Array<string>>) => { errors.id = value; },
            getTainted: () => tainted.id,
            setTainted: (value: Option.Option<boolean>) => { tainted.id = value; },
            validate: () => promotionValidateField("id", data.id).map((e: { field: string; message: string }) => e.message),

            constraints: {},


            disabled: false,
            readonly: false,
        },
        date: {
            name: "date",
            label: "date",
            type: "text",
            optional: false,
            array: false,
            path: ["date"],
            get: () => data.date,
            set: (value: string) => { data.date = value; },
            getError: () => errors.date,
            setError: (value: Option.Option<Array<string>>) => { errors.date = value; },
            getTainted: () => tainted.date,
            setTainted: (value: Option.Option<boolean>) => { tainted.date = value; },
            validate: () => promotionValidateField("date", data.date).map((e: { field: string; message: string }) => e.message),

            constraints: {},


            disabled: false,
            readonly: false,
        },
    } as unknown as PromotionFieldControllers;

    function validate(): Exit.Exit<Promotion, Array<{ field: string; message: string }>> {
        return toExit(promotionDecode(data));
    }

    function reset(newOverrides?: Partial<Promotion>): void {
        data = { ...promotionDefaultValue(), ...newOverrides };
        errors = {
            _errors: Option.none(),
            id: Option.none(),
            date: Option.none(),
        };
        tainted = {
            id: Option.none(),
            date: Option.none(),
        };
    }

    return {
        get data() { return data; },
        set data(v) { data = v; },
        get errors() { return errors; },
        set errors(v) { errors = v; },
        get tainted() { return tainted; },
        set tainted(v) { tainted = v; },
        fields,
        validate,
        reset,
    };
}
/** Parses FormData and validates it, returning a Result with the parsed data or errors. Delegates validation to decode() from @derive(Decode).  */
export function promotionFromFormData(formData: FormData): Exit.Exit<Promotion, Array<{ field: string; message: string }>> {
    const obj: Record<string, unknown> = {};

    
    obj.id = formData.get("id") ?? "";
    obj.date = formData.get("date") ?? "";

    return toExit(promotionDecode(obj));
}

export const Promotion: {
  readonly defaultValue: typeof promotionDefaultValue;
  readonly encode: typeof promotionEncode;
  readonly encodeWithContext: typeof promotionEncodeWithContext;
  readonly encodePartialWithContext: typeof promotionEncodePartialWithContext;
  readonly decode: typeof promotionDecode;
  readonly decodeWithContext: typeof promotionDecodeWithContext;
  readonly decodePartialWithContext: typeof promotionDecodePartialWithContext;
  readonly validateField: typeof promotionValidateField;
  readonly validateFields: typeof promotionValidateFields;
  readonly hasShape: typeof promotionHasShape;
  readonly is: typeof promotionIs;
  readonly createForm: typeof promotionCreateForm;
  readonly fromFormData: typeof promotionFromFormData;
} = {
  defaultValue: promotionDefaultValue,
  encode: promotionEncode,
  encodeWithContext: promotionEncodeWithContext,
  encodePartialWithContext: promotionEncodePartialWithContext,
  decode: promotionDecode,
  decodeWithContext: promotionDecodeWithContext,
  decodePartialWithContext: promotionDecodePartialWithContext,
  validateField: promotionValidateField,
  validateFields: promotionValidateFields,
  hasShape: promotionHasShape,
  is: promotionIs,
  createForm: promotionCreateForm,
  fromFormData: promotionFromFormData
};


