            if (__e instanceof __mf_DecodeError) {
                for (const __err of __e.errors) {
                    errors.push({
                        field: __err.field === "_root" ? "colors" : "colors." + __err.field,
                        message: __err.message
                    });
                }
            } else {

                errors.push({ field: "colors", message: __e instanceof Error ? __e.message : String(__e) });
            }
        } finally {
            ctx.popScope();
        }
    }
    if ((__fields === undefined || __fields.requires("recurrenceRule")) ? "recurrenceRule" in obj : (__fields.keeps("recurrenceRule") && obj["recurrenceRule"] !== undefined)) {
        const __raw_recurrenceRule = obj["recurrenceRule"] as RecurrenceRule | null;

        if (__raw_recurrenceRule === null) {
            instance.recurrenceRule = null;
        } else {
            ctx.pushScope("recurrenceRule");
            try {
                const __result = recurrenceRuleDecodeWithContext(__raw_recurrenceRule, ctx);
                ctx.assignOrDefer(instance, "recurrenceRule", __result);
            } catch (__e) {
                if (__e instanceof __mf_DecodeError) {
                    for (const __err of __e.errors) {
                        errors.push({
                            field: __err.field === "_root" ? "recurrenceRule" : "recurrenceRule." + __err.field,
                            message: __err.message
                        });
                    }
                } else {

                    errors.push({ field: "recurrenceRule", message: __e instanceof Error ? __e.message : String(__e) });
                }
            } finally {
                ctx.popScope();
            }
        }
    }

    ctx.pushErrors(errors);

    return instance as Appointment;
}

/** Decodes a `Partial`, `Pick` or `Omit` of this type with an existing context. @param value - The raw value to decode @param ctx - The decoding context @param fields - The fields the value has to have: none when left out  */
export function appointmentDecodePartialWithContext(value: unknown, ctx: __mf_DecodeContext, fields?: __mf_FieldSelection<keyof Appointment>): Partial<Appointment> | __mf_PendingRef {
    return appointmentDecodeWithContext(value, ctx, __mf_fieldRequirement(fields));
}
export function appointmentValidateField<K extends keyof Appointment>(field: K, value: unknown): Array<{ field: string; message: string }> {
    const errors: Array<{ field: string; message: string }> = [];
    if (field === "title") {
        const __val = value as string;
        if (__val == null) { errors.push({ field: "title", message: "Appointment.title is required" }); } else {
            if (__val.length === 0) { errors.push({ field: "title", message: "Appointment.title must not be empty" }); }
        }
    }
    return errors;
}

export function appointmentValidateFields(partial: { readonly [K in keyof Appointment]?: unknown }): Array<{ field: string; message: string }> {
    const errors: Array<{ field: string; message: string }> = [];
    if ("title" in partial && partial.title !== undefined) {
        const __val = partial.title as string;
        if (__val == null) { errors.push({ field: "title", message: "Appointment.title is required" }); } else {
            if (__val.length === 0) { errors.push({ field: "title", message: "Appointment.title must not be empty" }); }
        }
    }
    return errors;
}
export function appointmentHasShape(obj: unknown): boolean {
    if (typeof obj !== "object" || obj === null || Array.isArray(obj)) {
        return false;
    }
    return __mf_holds(obj, "id") && __mf_holds(obj, "title") && __mf_holds(obj, "status") && __mf_holds(obj, "begins") && __mf_holds(obj, "duration") && __mf_holds(obj, "timeZone") && __mf_holds(obj, "offsetMs") && __mf_holds(obj, "allDay") && __mf_holds(obj, "multiDay") && __mf_holds(obj, "employees") && __mf_holds(obj, "location") && __mf_holds(obj, "description") && __mf_holds(obj, "colors") && __mf_holds(obj, "recurrenceRule");
}

export function appointmentIs(obj: unknown): obj is Appointment {
    return appointmentHasShape(obj) && appointmentDecode(obj).success;
}

/** Nested error structure matching the data shape  */
export type AppointmentErrors = {
    _errors: Option.Option<Array<string>>;
    id: Option.Option<Array<string>>;
    title: Option.Option<Array<string>>;
    status: Option.Option<Array<string>>;
    begins: Option.Option<Array<string>>;
    duration: Option.Option<Array<string>>;
    timeZone: Option.Option<Array<string>>;
    offsetMs: Option.Option<Array<string>>;
    allDay: Option.Option<Array<string>>;
    multiDay: Option.Option<Array<string>>;
    employees: Option.Option<Array<string>>;
    location: Option.Option<Array<string>>;
    description: Option.Option<Array<string>>;
    colors: Option.Option<Array<string>>;
    recurrenceRule: Option.Option<Array<string>>;
};

/** Nested boolean structure for tracking touched/dirty fields  */
export type AppointmentTainted = {
    id: Option.Option<boolean>;
    title: Option.Option<boolean>;
    status: Option.Option<boolean>;
    begins: Option.Option<boolean>;
    duration: Option.Option<boolean>;
    timeZone: Option.Option<boolean>;
    offsetMs: Option.Option<boolean>;
    allDay: Option.Option<boolean>;
    multiDay: Option.Option<boolean>;
    employees: Option.Option<boolean>;
    location: Option.Option<boolean>;
    description: Option.Option<boolean>;
    colors: Option.Option<boolean>;
    recurrenceRule: Option.Option<boolean>;
};

/** Type-safe field controllers for this form  */
export interface AppointmentFieldControllers {
    readonly id: FieldController<string>;
    readonly title: FieldController<string>;
    readonly status: FieldController<Status>;
    readonly begins: FieldController<string>;
    readonly duration: FieldController<number>;
    readonly timeZone: FieldController<string>;
    readonly offsetMs: FieldController<number>;
    readonly allDay: FieldController<boolean>;
    readonly multiDay: FieldController<boolean>;
    readonly employees: ArrayFieldController<string | Employee>;
    readonly location: FieldController<string | Site>;
    readonly description: FieldController<string | null>;
    readonly colors: FieldController<Colors>;
    readonly recurrenceRule: FieldController<RecurrenceRule | null>;
}

