import { dataPathDecodeWithContext, dataPathEncodeWithContext, dataPathDefaultValue } from "./data-path.svelte";
import { EncodeContext as __mf_EncodeContext, DecodeContext as __mf_DecodeContext, DecodeError as __mf_DecodeError, PendingRef as __mf_PendingRef } from "@macroforge/core/endec";
import type { DecodeOptions as __mf_DecodeOptions } from "@macroforge/core/endec";
import { Option, Exit } from "effect";
import type { FieldController } from "@testground/macro/gigaform";
import { toExit } from "@testground/macro/gigaform";
/** import macro {Gigaform} from "@testground/macro"; */
import type { DataPath } from './data-path.svelte';


export interface ColumnConfig {
    
    heading: string;
    dataPath: DataPath;
}

export function columnConfigDefaultValue(): ColumnConfig {
    return {
        heading: "",
        dataPath: dataPathDefaultValue(),
    };
}

/** Encodes a value to a JSON string. @param value - The value to encode @param keepMetadata - If true, preserves __type and __id fields in the output @returns JSON string representation  */
export function columnConfigEncode(value: ColumnConfig, keepMetadata?: boolean): string {
    const ctx = __mf_EncodeContext.create();
    const __raw = columnConfigEncodeWithContext(value, ctx);
    if (keepMetadata) return JSON.stringify(__raw);
    return JSON.stringify(__raw, (key, val) => key === "__type" || key === "__id" ? undefined : val);
}

/** Encodes with an existing context for nested/cyclic object graphs. @param value - The value to encode @param ctx - The encoding context  */
export function columnConfigEncodeWithContext(value: ColumnConfig, ctx: __mf_EncodeContext): Record<string, unknown> {

    const existingId = ctx.getId(value);
    if (existingId !== undefined) {
        return { __ref: existingId };
    }

    const __id = ctx.register(value);

    const result: Record<string, unknown> = {
        "__type": "ColumnConfig",
        __id,
    };

    
    result.heading = value.heading;
    result.dataPath = dataPathEncodeWithContext(value.dataPath, ctx);

    return result;
}

/** Decodes input to this type. Automatically detects whether input is a JSON string or object. @param input - JSON string or object to decode @param opts - Optional decoding options @returns Result containing the decoded value or validation errors  */
export function columnConfigDecode(input: unknown, opts?: __mf_DecodeOptions): { success: true; value: ColumnConfig } | { success: false; errors: Array<{ field: string; message: string }> } {
    try {

        const data = typeof input === "string" ? JSON.parse(input) : input;

        const ctx = __mf_DecodeContext.create();
        const resultOrRef = columnConfigDecodeWithContext(data, ctx);

        if (__mf_PendingRef.is(resultOrRef)) {
            return ({
	success: false,
	errors: [{
		field: "_root",
		message: "ColumnConfig.decode: root cannot be a forward reference"
	}]
});
        }

        ctx.applyPatches();
        if (opts?.freeze) {
            ctx.freezeAll();
        }

        const __errors = ctx.getErrors();
        if (__errors.length > 0) {
            return ({
	success: false,
	errors: __errors
});
        }

        return ({
	success: true,
	value: resultOrRef
});
    } catch (e) {
        if (e instanceof __mf_DecodeError) {
            return ({
	success: false,
	errors: e.errors
});
        }
        const message = e instanceof Error ? e.message : String(e);
        return ({
	success: false,
	errors: [{
		field: "_root",
		message
	}]
});
    }
}
/** Decodes with an existing context for nested/cyclic object graphs. @param value - The raw value to decode @param ctx - The decoding context  */
export function columnConfigDecodeWithContext(value: unknown, ctx: __mf_DecodeContext): ColumnConfig | __mf_PendingRef {
    if (typeof value === "object" && value !== null && "__ref" in value) {
        if (typeof value.__ref !== "number") {
            throw new __mf_DecodeError([{ field: "__ref", message: "ColumnConfig.decodeWithContext: __ref must be a number" }]);
        }
        return ctx.getOrDefer(value.__ref) as ColumnConfig | __mf_PendingRef;
    }

    if (typeof value !== "object" || value === null || Array.isArray(value)) {
        throw new __mf_DecodeError([{ field: "_root", message: "ColumnConfig.decodeWithContext: expected an object" }]);
    }

    const obj = value as Record<string, unknown>;
    const errors: Array<{ field: string; message: string }> = [];
    if (!("heading" in obj)) {
        errors.push({ field: "heading", message: "missing required field" });
    }
    if (!("dataPath" in obj)) {
        errors.push({ field: "dataPath", message: "missing required field" });
    }

    const instance: any = {};

    if (obj.__id !== undefined) {
        ctx.register(obj.__id as number, instance);
    }

    ctx.trackForFreeze(instance);

    {
        const __raw_heading = obj["heading"] as string;

        if (!(typeof __raw_heading === "string")) {
            errors.push({ field: "heading", message: __raw_heading == null ? "ColumnConfig.heading is required" : "expected string" });
        } else {
            if (__raw_heading == null) { errors.push({ field: "heading", message: "ColumnConfig.heading is required" }); } else {
                if (__raw_heading.length === 0) { errors.push({ field: "heading", message: "ColumnConfig.heading must not be empty" }); }
            }
            instance.heading = __raw_heading;
        }
    }
    {
        const __raw_dataPath = obj["dataPath"] as DataPath;

        ctx.pushScope("dataPath");
        try {
            const __result = dataPathDecodeWithContext(__raw_dataPath, ctx);
            ctx.assignOrDefer(instance, "dataPath", __result);
        } catch (__e) {
            if (__e instanceof __mf_DecodeError) {
                for (const __err of __e.errors) {
                    errors.push({
                        field: __err.field === "_root" ? "dataPath" : "dataPath." + __err.field,
                        message: __err.message
                    });
                }
            } else {
                throw __e;
            }
        } finally {
            ctx.popScope();
        }
    }

    ctx.pushErrors(errors);

    return instance as ColumnConfig;
}
export function columnConfigValidateField<K extends keyof ColumnConfig>(field: K, value: unknown): Array<{ field: string; message: string }> {
    const errors: Array<{ field: string; message: string }> = [];
    if (field === "heading") {
        const __val = value as string;
        if (__val == null) { errors.push({ field: "heading", message: "ColumnConfig.heading is required" }); } else {
            if (__val.length === 0) { errors.push({ field: "heading", message: "ColumnConfig.heading must not be empty" }); }
        }
    }
    return errors;
}

export function columnConfigValidateFields(partial: { readonly [K in keyof ColumnConfig]?: unknown }): Array<{ field: string; message: string }> {
    const errors: Array<{ field: string; message: string }> = [];
    if ("heading" in partial && partial.heading !== undefined) {
        const __val = partial.heading as string;
        if (__val == null) { errors.push({ field: "heading", message: "ColumnConfig.heading is required" }); } else {
            if (__val.length === 0) { errors.push({ field: "heading", message: "ColumnConfig.heading must not be empty" }); }
        }
    }
    return errors;
}
export function columnConfigHasShape(obj: unknown): boolean {
    if (typeof obj !== "object" || obj === null || Array.isArray(obj)) {
        return false;
    }
    const o = obj as Record<string, unknown>;
    return "heading" in o && "dataPath" in o;
}

export function columnConfigIs(obj: unknown): obj is ColumnConfig {
    return columnConfigHasShape(obj) && columnConfigDecode(obj).success;
}

/** Nested error structure matching the data shape  */
export type ColumnConfigErrors = {
    _errors: Option.Option<Array<string>>;
    heading: Option.Option<Array<string>>;
    dataPath: Option.Option<Array<string>>;
};

/** Nested boolean structure for tracking touched/dirty fields  */
export type ColumnConfigTainted = {
    heading: Option.Option<boolean>;
    dataPath: Option.Option<boolean>;
};

/** Type-safe field controllers for this form  */
export interface ColumnConfigFieldControllers {
    readonly heading: FieldController<string>;
    readonly dataPath: FieldController<DataPath>;
}

/** Gigaform instance containing reactive state and field controllers  */
export interface ColumnConfigGigaform {
    readonly data: ColumnConfig;
    readonly errors: ColumnConfigErrors;
    readonly tainted: ColumnConfigTainted;
    readonly fields: ColumnConfigFieldControllers;
    validate(): Exit.Exit<ColumnConfig, Array<{ field: string; message: string }>>;
    reset(overrides?: Partial<ColumnConfig>): void;
}
/** Creates a new Gigaform instance with reactive state and field controllers.  */
export function columnConfigCreateForm(overrides?: Partial<ColumnConfig>): ColumnConfigGigaform {
    let data = $state({ ...columnConfigDefaultValue(), ...overrides });
    let errors = $state<ColumnConfigErrors>({
        _errors: Option.none(),
        heading: Option.none(),
        dataPath: Option.none(),
    });
    let tainted = $state<ColumnConfigTainted>({
        heading: Option.none(),
        dataPath: Option.none(),
    });
    const fields = {
        heading: {
            name: "heading",
            label: "heading",
            type: "text",
            optional: false,
            array: false,
            path: ["heading"],
            get: () => data.heading,
            set: (value: string) => { data.heading = value; },
            getError: () => errors.heading,
            setError: (value: Option.Option<Array<string>>) => { errors.heading = value; },
            getTainted: () => tainted.heading,
            setTainted: (value: Option.Option<boolean>) => { tainted.heading = value; },
            validate: () => columnConfigValidateField("heading", data.heading).map((e: { field: string; message: string }) => e.message),

            constraints: {},


            disabled: false,
            readonly: false,
        },
        dataPath: {
            name: "dataPath",
            label: "dataPath",
            type: "fieldset",
            optional: false,
            array: false,
            path: ["dataPath"],
            get: () => data.dataPath,
            set: (value: DataPath) => { data.dataPath = value; },
            getError: () => errors.dataPath,
            setError: (value: Option.Option<Array<string>>) => { errors.dataPath = value; },
            getTainted: () => tainted.dataPath,
            setTainted: (value: Option.Option<boolean>) => { tainted.dataPath = value; },
            validate: () => columnConfigValidateField("dataPath", data.dataPath).map((e: { field: string; message: string }) => e.message),

            constraints: {},


            disabled: false,
            readonly: false,
        },
    } as unknown as ColumnConfigFieldControllers;

    function validate(): Exit.Exit<ColumnConfig, Array<{ field: string; message: string }>> {
        return toExit(columnConfigDecode(data));
    }

    function reset(newOverrides?: Partial<ColumnConfig>): void {
        data = { ...columnConfigDefaultValue(), ...newOverrides };
        errors = {
            _errors: Option.none(),
            heading: Option.none(),
            dataPath: Option.none(),
        };
        tainted = {
            heading: Option.none(),
            dataPath: Option.none(),
        };
    }

    return {
        get data() { return data; },
        set data(v) { data = v; },
        get errors() { return errors; },
        set errors(v) { errors = v; },
        get tainted() { return tainted; },
        set tainted(v) { tainted = v; },
        fields,
        validate,
        reset,
    };
}
/** Parses FormData and validates it, returning a Result with the parsed data or errors. Delegates validation to decode() from @derive(Decode).  */
export function columnConfigFromFormData(formData: FormData): Exit.Exit<ColumnConfig, Array<{ field: string; message: string }>> {
    const obj: Record<string, unknown> = {};

    
    obj.heading = formData.get("heading") ?? "";
    {

        const dataPathObj: Record<string, unknown> = {};
        for (const [key, value] of Array.from(formData.entries())) {
            if (key.startsWith("dataPath.")) {
                const fieldName = key.slice("dataPath.".length);

                const parts = fieldName.split(".");
                let current = dataPathObj;
                for (let i = 0; i < parts.length - 1; i++) {
                    const part = parts[i]!;
                    if (!(part in current)) {
                        current[part] = {};
                    }
                    current = current[part] as Record<string, unknown>;
                }
                current[parts[parts.length - 1]!] = value;
            }
        }
        obj.dataPath = dataPathObj;
    }

    return toExit(columnConfigDecode(obj));
}

