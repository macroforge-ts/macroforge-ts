	id: value.id,
	title: value.title,
	content: value.content,
	apiKey: value.apiKey,
	count: value.count,
	enabled: value.enabled
});
}

export function svelteAllMacrosTestEquals(a: SvelteAllMacrosTest, b: SvelteAllMacrosTest): boolean {
    if (a === b) return true;
    return a.id === b.id && a.title === b.title && a.content === b.content && a.apiKey === b.apiKey && a.count === b.count && a.enabled === b.enabled;
}

