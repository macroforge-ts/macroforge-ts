            disabled: false,
            readonly: false,
        },
        lastLogin: {
            name: "lastLogin",
            label: "lastLogin",
            type: "text",
            optional: false,
            array: false,
            path: ["lastLogin"],
            get: () => data.lastLogin,
            set: (value: string | null) => { data.lastLogin = value; },
            getError: () => errors.lastLogin,
            setError: (value: Option.Option<Array<string>>) => { errors.lastLogin = value; },
            getTainted: () => tainted.lastLogin,
