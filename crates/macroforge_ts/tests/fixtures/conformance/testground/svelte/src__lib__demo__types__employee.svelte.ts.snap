export function employeeValidateField<K extends keyof Employee>(field: K, value: unknown): Array<{ field: string; message: string }> {
    const errors: Array<{ field: string; message: string }> = [];
    if (field === "name") {
        const __val = value as string;
        if (__val == null) { errors.push({ field: "name", message: "Employee.name is required" }); } else {
            if (__val.length === 0) { errors.push({ field: "name", message: "Employee.name must not be empty" }); }
        }
    }
    if (field === "role") {
        const __val = value as string;
        if (__val == null) { errors.push({ field: "role", message: "Employee.role is required" }); } else {
            if (__val.length === 0) { errors.push({ field: "role", message: "Employee.role must not be empty" }); }
        }
    }
    if (field === "address") {
        const __val = value as string;
        if (__val == null) { errors.push({ field: "address", message: "Employee.address is required" }); } else {
            if (__val.length === 0) { errors.push({ field: "address", message: "Employee.address must not be empty" }); }
        }
    }
    if (field === "username") {
        const __val = value as string;
        if (__val == null) { errors.push({ field: "username", message: "Employee.username is required" }); } else {
