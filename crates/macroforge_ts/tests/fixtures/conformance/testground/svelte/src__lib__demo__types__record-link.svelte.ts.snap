import type { Encoder as __mf_Encoder, Decoder as __mf_Decoder, DecodeOptions as __mf_DecodeOptions } from "@macroforge/core/endec";
import { memberCoder as __mf_memberCoder, encodedMember as __mf_encodedMember, encodedAs as __mf_encodedAs, encodedText as __mf_encodedText, encodedTextWithoutMetadata as __mf_encodedTextWithoutMetadata, member as __mf_member, EncodeContext as __mf_EncodeContext, derivedEncoder as __mf_derivedEncoder, decodedText as __mf_decodedText, guardedDecoder as __mf_guardedDecoder, DecodeContext as __mf_DecodeContext, DecodeError as __mf_DecodeError, PendingRef as __mf_PendingRef } from "@macroforge/core/endec";

export type RecordLink<T> = /** @default */ string | T;

export function recordLinkDefaultValue<T>(): RecordLink<T> {
    return "";
}

/** Encodes a value to a JSON string. @param value - The value to encode @param keepMetadata - If true, preserves __type and __id fields in the output @returns JSON string representation  */
export function recordLinkEncode<T>(value: RecordLink<T>, keepMetadata?: boolean, __encodeT?: __mf_Encoder<T>): string {
    const ctx = __mf_EncodeContext.create();
    const __raw = recordLinkEncodeWithContext(value, ctx, __encodeT);
    return keepMetadata ? __mf_encodedText(__raw) : __mf_encodedTextWithoutMetadata(__raw, "__type");
}

/** Encodes with an existing context for nested/cyclic object graphs. @param value - The value to encode @param ctx - The encoding context  */
export function recordLinkEncodeWithContext<T>(value: RecordLink<T>, ctx: __mf_EncodeContext, __encodeT?: __mf_Encoder<T>): unknown {
    const __encoder = __mf_derivedEncoder(value);
    const __variant: unknown = __encoder !== undefined ? __encoder(value, ctx) : value;

    if (__variant !== null && typeof __variant === "object" && "__type" in __variant) {
        const { __type: __typeName, ...fields } = __variant as Record<string, unknown>;
        const __tagged = { "__type": __mf_member(value, "__type") ?? __typeName, ...fields };

        const __idVal = fields["__id"];
        return typeof __idVal === "number" ? __mf_encodedAs(ctx, __idVal, __tagged) : __tagged;
    }
    return __variant;
}

/** Decodes a value to this type; JSON text decodes through `fromString`. @param input - The value to decode @param opts - Optional decoding options @returns Result containing the decoded value or validation errors  */
export function recordLinkDecode<T>(input: unknown, opts?: __mf_DecodeOptions, __decodeT?: __mf_Decoder<T>): { success: true; value: RecordLink<T> } | { success: false; errors: Array<{ field: string; message: string }> } {
    try {
        const ctx = __mf_DecodeContext.create();
        const resultOrRef = recordLinkDecodeWithContext<T>(input, ctx, __decodeT);

        if (__mf_PendingRef.is(resultOrRef)) {
            return ({
	success: false,
	errors: [{
		field: "_root",
		message: "RecordLink.decode: root cannot be a forward reference"
	}]
});
        }

        ctx.applyPatches();
        if (opts?.freeze) {
            ctx.freezeAll();
        }

        const __errors = ctx.getErrors();
        if (__errors.length > 0) {
            return ({
	success: false,
	errors: __errors
});
        }

        return ({
	success: true,
	value: resultOrRef
});
    } catch (e) {
        if (e instanceof __mf_DecodeError) {
            return ({
	success: false,
	errors: e.errors
});
        }
        const message = e instanceof Error ? e.message : String(e);
        return ({
	success: false,
	errors: [{
		field: "_root",
		message
	}]
});
    }
}
/** Decodes JSON text, as `encode` writes it, to this type. @param text - The JSON text @param opts - Optional decoding options @returns Result containing the decoded value or validation errors  */
export function recordLinkFromString<T>(text: string, opts?: __mf_DecodeOptions, __decodeT?: __mf_Decoder<T>): { success: true; value: RecordLink<T> } | { success: false; errors: Array<{ field: string; message: string }> } {
    return __mf_decodedText(text, (value) => recordLinkDecode<T>(value, opts, __decodeT));
}
/** Decodes with an existing context for nested/cyclic object graphs. @param value - The raw value to decode @param ctx - The decoding context  */
export function recordLinkDecodeWithContext<T>(value: unknown, ctx: __mf_DecodeContext, __decodeT?: __mf_Decoder<T>): RecordLink<T> | __mf_PendingRef {
    if (typeof value === "object" && value !== null && "__ref" in value) {
        if (typeof value.__ref !== "number") {
            throw new __mf_DecodeError([{ field: "__ref", message: "RecordLink.decodeWithContext: __ref must be a number" }]);
        }
        return ctx.getOrDefer(value.__ref) as RecordLink<T> | __mf_PendingRef;
    }

    
    if (typeof value === "string") {
        return value as RecordLink<T>;
    }
    if (__decodeT !== undefined && value !== null && value !== undefined) {
        return __decodeT(value, ctx) as RecordLink<T> | __mf_PendingRef;
    }
    return value as RecordLink<T>;
}
export function recordLinkHasShape(_value: unknown): boolean {
                return true;
}
export function recordLinkIs<T>(value: unknown, __isT: (value: unknown) => value is T): value is RecordLink<T> {
    return recordLinkHasShape(value) && recordLinkDecode(value, undefined, __mf_guardedDecoder(__isT, "T")).success;
