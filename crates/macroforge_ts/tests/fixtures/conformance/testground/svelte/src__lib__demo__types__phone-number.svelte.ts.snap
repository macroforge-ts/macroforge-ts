        } else {
            instance.canText = __raw_canText;
        }
    }
    {
        const __raw_canCall = obj["canCall"] as boolean;

        if (!(typeof __raw_canCall === "boolean")) {
            errors.push({ field: "canCall", message: __raw_canCall == null ? "PhoneNumber.canCall is required" : "expected boolean" });
        } else {
            instance.canCall = __raw_canCall;
        }
    }

    ctx.pushErrors(errors);

    return instance as PhoneNumber;
}
export function phoneNumberValidateField<K extends keyof PhoneNumber>(field: K, value: unknown): Array<{ field: string; message: string }> {
    const errors: Array<{ field: string; message: string }> = [];
    if (field === "phoneType") {
        const __val = value as string;
        if (__val == null) { errors.push({ field: "phoneType", message: "PhoneNumber.phoneType is required" }); } else {
            if (__val.length === 0) { errors.push({ field: "phoneType", message: "PhoneNumber.phoneType must not be empty" }); }
        }
    }
    if (field === "number") {
        const __val = value as string;
        if (__val == null) { errors.push({ field: "number", message: "PhoneNumber.number is required" }); } else {
            if (__val.length === 0) { errors.push({ field: "number", message: "PhoneNumber.number must not be empty" }); }
        }
    }
    return errors;
}

export function phoneNumberValidateFields(partial: { readonly [K in keyof PhoneNumber]?: unknown }): Array<{ field: string; message: string }> {
    const errors: Array<{ field: string; message: string }> = [];
    if ("phoneType" in partial && partial.phoneType !== undefined) {
        const __val = partial.phoneType as string;
        if (__val == null) { errors.push({ field: "phoneType", message: "PhoneNumber.phoneType is required" }); } else {
            if (__val.length === 0) { errors.push({ field: "phoneType", message: "PhoneNumber.phoneType must not be empty" }); }
        }
    }
    if ("number" in partial && partial.number !== undefined) {
        const __val = partial.number as string;
        if (__val == null) { errors.push({ field: "number", message: "PhoneNumber.number is required" }); } else {
            if (__val.length === 0) { errors.push({ field: "number", message: "PhoneNumber.number must not be empty" }); }
