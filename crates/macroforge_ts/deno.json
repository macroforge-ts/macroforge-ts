{
    "name": "@macroforge/core",
    "version": "0.1.79",
    "exports": {
        ".": "./pkg/macroforge_ts.js",
        "./serde": "./js/serde/index.ts",
        "./traits": "./js/traits/index.ts"
    },
    "publish": {
        "include": [
            "pkg/",
            "js/serde/",
            "js/traits/",
            "deno.json",
            "LICENSE",
            "README.md"
        ]
    },
    "fmt": {
        "useTabs": false,
        "indentWidth": 4,
        "lineWidth": 100,
        "singleQuote": true,
        "semiColons": true,
        "trailingCommas": "never",
        "exclude": ["**/js/**", "**/dist", "**/build", "**/node_modules"]
    },
    "lint": {
        "exclude": [
            "**/js/**",
            "**/dist",
            "**/build",
            "**/node_modules",
            "index.js",
            "index.d.ts",
            "tests/fixtures/**"
        ]
    }
}
