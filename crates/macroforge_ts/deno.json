{
    "exports": {
        ".": "./pkg-deno/macroforge_ts.js",
        "./buildtime": "./js/buildtime/index.ts",
        "./rules": "./js/rules/index.ts",
        "./endec": "./js/endec/index.ts",
        "./traits": "./js/traits/index.ts"
    },
    "fmt": {
        "exclude": [
            "**/js/**",
            "**/dist",
            "**/build",
            "**/node_modules"
        ],
        "indentWidth": 4,
        "lineWidth": 100,
        "semiColons": true,
        "singleQuote": true,
        "trailingCommas": "never",
        "useTabs": false
    },
    "lint": {
        "exclude": [
            "**/js/**",
            "**/dist",
            "**/build",
            "**/node_modules",
            "index.js",
            "index.d.ts",
            "tests/fixtures/**"
        ]
    },
    "name": "@macroforge/core",
    "publish": {
        "include": [
            "pkg-deno/",
            "pkg-deno/macroforge_ts_bg.wasm",
            "js/buildtime/",
            "js/rules/",
            "js/endec/",
            "js/traits/",
            "deno.json",
            "LICENSE",
            "README.md"
        ]
    },
    "version": "0.4.0"
}
