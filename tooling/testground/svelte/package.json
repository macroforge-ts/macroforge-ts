{
    "name": "@testground/svelte",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "node ./node_modules/.bin/vite dev",
        "build": "node ./node_modules/.bin/vite build",
        "preview": "node ./node_modules/.bin/vite preview",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "clean": "rm -rf dist .svelte-kit node_modules",
        "cleanbuild": "deno task clean && deno install --node-modules-dir && deno task build",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "dependencies": {
        "@emotion/weak-memoize": "^0.4.0",
        "@macroforge/core": "*",
        "@testground/macro": "file:../macro",
        "effect": "^3.19.4",
        "runed": "^0.36.0",
        "svelte-toolbelt": "^0.10.6",
        "ts-deepmerge": "^7.0.3"
    },
    "devDependencies": {
        "@inlang/paraglide-js": "^2.6.0",
        "@macroforge/shared": "*",
        "@macroforge/svelte-preprocessor": "*",
        "@macroforge/vite-plugin": "*",
        "@sveltejs/adapter-auto": "^7.0.0",
        "@sveltejs/kit": "^2.49.0",
        "@sveltejs/vite-plugin-svelte": "^6.2.1",
        "@tailwindcss/vite": "^4.1.10",
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/svelte": "^5.2.7",
        "@types/node": "^25.0.3",
        "@typescript/lib-decorators": "jsr:@gigatypes/decorators@0.1.4",
        "@typescript/lib-dom": "jsr:@gigatypes/dom@0.1.4",
        "@typescript/lib-es2015": "jsr:@gigatypes/es2015@0.1.4",
        "@typescript/lib-es2016": "jsr:@gigatypes/es2016@0.1.4",
        "@typescript/lib-es2017": "jsr:@gigatypes/es2017@0.1.4",
        "@typescript/lib-es2018": "jsr:@gigatypes/es2018@0.1.4",
        "@typescript/lib-es2019": "jsr:@gigatypes/es2019@0.1.4",
        "@typescript/lib-es2020": "jsr:@gigatypes/es2020@0.1.4",
        "@typescript/lib-es2021": "jsr:@gigatypes/es2021@0.1.4",
        "@typescript/lib-es2022": "jsr:@gigatypes/es2022@0.1.4",
        "@typescript/lib-es2023": "jsr:@gigatypes/es2023@0.1.4",
        "@typescript/lib-es2024": "jsr:@gigatypes/es2024@0.1.4",
        "@typescript/lib-es2025": "jsr:@gigatypes/es2025@0.1.4",
        "@typescript/lib-es5": "jsr:@gigatypes/es5@0.1.4",
        "@typescript/lib-es6": "jsr:@gigatypes/es6@0.1.4",
        "@typescript/lib-esnext": "jsr:@gigatypes/esnext@0.1.4",
        "@typescript/lib-scripthost": "jsr:@gigatypes/scripthost@0.1.4",
        "@typescript/lib-webworker": "jsr:@gigatypes/webworker@0.1.4",
        "jsdom": "^26.1.0",
        "json-schema": "^0.4.0",
        "svelte": "^5.43.8",
        "svelte-check": "^4.7.6",
        "tailwind-merge": "^3.4.0",
        "tailwindcss": "^4.1.10",
        "typescript": "^6.0.3",
        "vite": "^7.2.2",
        "vitest": "^3.2.4"
    },
    "imports": {
        "#macroforge/config": {
            "types": "./.macroforge/config/handlers.ts",
            "default": "./.macroforge/config/handlers.js"
        }
    }
}
