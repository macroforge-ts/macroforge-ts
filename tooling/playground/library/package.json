{
    "name": "@playground/library",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "svelte": "./dist/index.js",
    "files": [
        "dist"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "svelte": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./types/person-name": {
            "types": "./dist/types/person-name.d.ts",
            "default": "./dist/types/person-name.js"
        },
        "./types/order.svelte": {
            "types": "./dist/types/order.svelte.d.ts",
            "svelte": "./dist/types/order.svelte.js",
            "default": "./dist/types/order.svelte.js"
        },
        "./PersonCard.svelte": {
            "types": "./dist/PersonCard.svelte.d.ts",
            "svelte": "./dist/PersonCard.svelte"
        }
    },
    "scripts": {
        "build": "node --env-file=../../.env scripts/package.mjs",
        "package:unexpanded": "node --env-file=../../.env scripts/package.mjs --unexpanded",
        "clean": "rm -rf dist dist-unexpanded .macroforge-staging .macroforge node_modules",
        "cleanbuild": "deno task clean && deno install --node-modules-dir && deno task build"
    },
    "dependencies": {
        "macroforge": "file:../vendor/macroforge_ts"
    },
    "peerDependencies": {
        "svelte": "^5.0.0"
    },
    "devDependencies": {
        "@macroforge/svelte-preprocessor": "file:../vendor/svelte-preprocessor",
        "@sveltejs/package": "^2.5.4",
        "@sveltejs/vite-plugin-svelte": "^6.2.1",
        "svelte": "^5.43.8",
        "typescript": "^5.9.3",
        "vite": "^7.2.2"
    }
}
