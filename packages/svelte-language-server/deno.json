{
  "name": "@macroforge/svelte-language-server",
  "version": "0.1.79",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts"
  },
  "imports": {
    "@jridgewell/trace-mapping": "npm:@jridgewell/trace-mapping@^0.3.25",
    "@macroforge/shared": "npm:@macroforge/shared@^0.1.79",
    "@macroforge/typescript-plugin": "npm:@macroforge/typescript-plugin@^0.1.79",
    "@vscode/emmet-helper": "npm:@vscode/emmet-helper@2.8.4",
    "chokidar": "npm:chokidar@^4.0.1",
    "estree": "npm:@types/estree@^0.0.42",
    "estree-walker": "npm:estree-walker@^2.0.1",
    "events": "node:events",
    "fdir": "npm:fdir@^6.2.0",
    "fs": "node:fs",
    "fs/promises": "node:fs/promises",
    "globrex": "npm:globrex@^0.1.2",
    "lodash": "npm:lodash@^4.17.21",
    "macroforge": "npm:macroforge@^0.1.79",
    "os": "node:os",
    "path": "node:path",
    "perf_hooks": "node:perf_hooks",
    "prettier": "npm:prettier@~3.3.3",
    "prettier-plugin-svelte": "npm:prettier-plugin-svelte@^3.4.0",
    "svelte": "npm:svelte@^4.2.19",
    "svelte/compiler": "npm:svelte@^4.2.19/compiler",
    "svelte/types/compiler/interfaces": "npm:svelte@^4.2.19/types/compiler/interfaces",
    "svelte/types/compiler/preprocess": "npm:svelte@^4.2.19/types/compiler/preprocess",
    "svelte2tsx": "npm:svelte2tsx@^0.7.45",
    "typescript": "npm:typescript@^5.9.2",
    "typescript-auto-import-cache/out/5_0/exportInfoMap": "npm:typescript-auto-import-cache@^0.3.6/out/5_0/exportInfoMap",
    "typescript-auto-import-cache/out/5_0/moduleSpecifierCache": "npm:typescript-auto-import-cache@^0.3.6/out/5_0/moduleSpecifierCache",
    "typescript-auto-import-cache/out/5_0/packageJsonCache": "npm:typescript-auto-import-cache@^0.3.6/out/5_0/packageJsonCache",
    "typescript-auto-import-cache/out/5_0/project": "npm:typescript-auto-import-cache@^0.3.6/out/5_0/project",
    "typescript-auto-import-cache/out/5_0/projectService": "npm:typescript-auto-import-cache@^0.3.6/out/5_0/projectService",
    "typescript-auto-import-cache/out/5_0/symlinkCache": "npm:typescript-auto-import-cache@^0.3.6/out/5_0/symlinkCache",
    "typescript-auto-import-cache/out/5_3/project": "npm:typescript-auto-import-cache@^0.3.6/out/5_3/project",
    "typescript-auto-import-cache/out/5_5/project": "npm:typescript-auto-import-cache@^0.3.6/out/5_5/project",
    "url": "node:url",
    "vscode-css-languageservice": "npm:vscode-css-languageservice@~6.3.5",
    "vscode-html-languageservice": "npm:vscode-html-languageservice@~5.4.0",
    "vscode-html-languageservice/lib/umd/languageFacts/data/webCustomData": "npm:vscode-html-languageservice@~5.4.0/lib/umd/languageFacts/data/webCustomData",
    "vscode-languageserver": "npm:vscode-languageserver@9.0.1",
    "vscode-languageserver/node": "npm:vscode-languageserver@9.0.1/node",
    "vscode-languageserver-protocol": "npm:vscode-languageserver-protocol@3.17.5",
    "vscode-languageserver-types": "npm:vscode-languageserver-types@3.17.5",
    "vscode-uri": "npm:vscode-uri@~3.1.0"
  },
  "compilerOptions": {
    "lib": ["esnext", "deno.window"],
    "skipLibCheck": true,
    "noImplicitOverride": false,
    "strictPropertyInitialization": false,
    "noImplicitAny": false,
    "useUnknownInCatchVariables": false
  },
  "unstable": ["sloppy-imports"],
  "tasks": {
    "pretest": "node test/setup-fixtures.js",
    "test": "deno task pretest && TS_NODE_TRANSPILE_ONLY=true deno run -A --node-modules-dir=manual npm:mocha --timeout 60000 --require ts-node/register \"test/**/*.test.ts\" --no-experimental-strip-types"
  },
  "publish": {
    "exclude": ["test/", "dist/", "node_modules/"]
  },
  "fmt": {
    "useTabs": false,
    "indentWidth": 4,
    "lineWidth": 100,
    "singleQuote": true,
    "semiColons": true,
    "trailingCommas": "never",
    "exclude": ["**/dist", "**/build", "**/node_modules"]
  },
  "lint": {
    "exclude": ["."]
  }
}
