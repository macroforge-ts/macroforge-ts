{
  "compilerOptions": {
    "lib": [
      "esnext",
      "deno.window",
      "deno.ns"
    ],
    "skipLibCheck": true
  },
  "exports": {
    ".": "./src/index.ts",
    "./cli": "./src/cli.ts",
    "./project": "./src/project.ts"
  },
  "imports": {
    "@macroforge/shared": "npm:@macroforge/shared@^0.1.79",
    "macroforge": "npm:macroforge@^0.1.79",
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "@std/cli": "jsr:@std/cli@^1.0.0",
    "@std/path": "jsr:@std/path@^1.0.0",
    "@std/fs": "jsr:@std/fs@^1.0.0"
  },
  "license": "MIT",
  "name": "@macroforge/deno-plugin",
  "publish": {
    "exclude": [
      "tests/",
      "node_modules/"
    ]
  },
  "tasks": {
    "build": "echo 'No build needed — JSR publishes src/ directly'",
    "clean": "rm -rf node_modules",
    "cleanbuild": "deno task clean && deno task build",
    "test": "deno test -A tests/",
    "expand": "deno run -A src/cli.ts expand",
    "watch": "deno run -A src/cli.ts watch"
  },
  "version": "0.1.80"
}
