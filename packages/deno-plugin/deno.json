{
    "compilerOptions": {
        "lib": [
            "esnext",
            "deno.window",
            "deno.ns"
        ],
        "skipLibCheck": true
    },
    "exports": {
        ".": "./src/index.ts",
        "./cli": "./src/cli.ts",
        "./project": "./src/project.ts"
    },
    "imports": {
        "@std/assert": "jsr:@std/assert@^1.0.19",
        "@std/cli": "jsr:@std/cli@^1.0.32",
        "@std/fs": "jsr:@std/fs@^1.0.24",
        "@std/path": "jsr:@std/path@^1.1.6"
    },
    "license": "MIT",
    "name": "@macroforge/deno-plugin",
    "publish": {
        "exclude": [
            "tests/",
            "node_modules/"
        ]
    },
    "tasks": {
        "build": "echo 'No build needed — JSR publishes src/ directly'",
        "clean": "rm -rf node_modules",
        "cleanbuild": "deno task clean && deno task build",
        "expand": "deno run -A src/cli.ts expand",
        "test": "deno test -A tests/",
        "watch": "deno run -A src/cli.ts watch"
    },
    "version": "0.3.0"
}
