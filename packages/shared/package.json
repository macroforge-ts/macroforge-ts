{
    "bugs": {
        "url": "https://gitlab.com/macroforge-ts/macroforge-ts/-/issues"
    },
    "dependencies": {
        "@macroforge/core": "^0.2.0"
    },
    "description": "Shared utilities for Macroforge plugins",
    "devDependencies": {
        "@types/node": "^26.6.2",
        "typescript": "^5.9.3"
    },
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts"
        }
    },
    "files": [
        "dist"
    ],
    "homepage": "https://macroforge.dev",
    "license": "MIT",
    "main": "./dist/index.js",
    "name": "@macroforge/shared",
    "peerDependencies": {
        "typescript": ">=5.0.0 <6"
    },
    "repository": {
        "directory": "packages/shared",
        "type": "git",
        "url": "git+https://gitlab.com/macroforge-ts/macroforge-ts.git"
    },
    "scripts": {
        "build": "deno install --node-modules-dir --quiet && deno run -A npm:typescript@5/tsc -p tsconfig.json",
        "clean": "rm -rf dist",
        "cleanbuild": "deno task clean && deno task build",
        "test": "deno test --allow-read --allow-write tests/"
    },
    "type": "module",
    "types": "./dist/index.d.ts",
    "version": "0.2.0"
}
