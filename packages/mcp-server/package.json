{
    "bugs": {
        "url": "https://gitlab.com/macroforge-ts/macroforge-ts/-/issues"
    },
    "dependencies": {
        "@macroforge/core": "0.3.1",
        "@modelcontextprotocol/sdk": "^1.30.0"
    },
    "description": "MCP server for Macroforge documentation and code analysis",
    "devDependencies": {
        "@types/node": "^26.6.2",
        "typescript": "^5.9.3"
    },
    "exports": {
        ".": "./src/index.ts"
    },
    "homepage": "https://macroforge.dev",
    "keywords": [
        "mcp",
        "macroforge",
        "typescript",
        "macros",
        "documentation"
    ],
    "license": "MIT",
    "name": "@macroforge/mcp-server",
    "repository": {
        "directory": "packages/mcp-server",
        "type": "git",
        "url": "git+https://gitlab.com/macroforge-ts/macroforge-ts.git"
    },
    "scripts": {
        "build": "deno run -A ../../tooling/npm/build.ts mcp-server",
        "build:docs": "rust-script scripts/extract-docs.rs",
        "dev": "deno run -A npm:@modelcontextprotocol/inspector node src/index.ts",
        "start": "node src/index.ts",
        "test": "node --test tests/**/*.test.js"
    },
    "type": "module",
    "version": "0.3.1"
}
