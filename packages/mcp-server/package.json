{
    "bin": {
        "macroforge-mcp": "./dist/index.js"
    },
    "bugs": {
        "url": "https://gitlab.com/macroforge-ts/macroforge-ts/-/issues"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.30.0"
    },
    "description": "MCP server for Macroforge documentation and code analysis",
    "devDependencies": {
        "@types/node": "^26.6.2",
        "typescript": "^5.9.3"
    },
    "files": [
        "dist",
        "docs"
    ],
    "homepage": "https://macroforge.dev",
    "keywords": [
        "mcp",
        "macroforge",
        "typescript",
        "macros",
        "documentation"
    ],
    "license": "MIT",
    "main": "dist/index.js",
    "name": "@macroforge/mcp-server",
    "peerDependencies": {
        "@macroforge/core": "^0.2.0"
    },
    "peerDependenciesMeta": {
        "macroforge": {
            "optional": true
        }
    },
    "repository": {
        "directory": "packages/mcp-server",
        "type": "git",
        "url": "git+https://gitlab.com/macroforge-ts/macroforge-ts.git"
    },
    "scripts": {
        "build": "deno install --node-modules-dir --quiet && deno run -A npm:typescript@5/tsc && chmod +x dist/index.js",
        "build:docs": "rust-script scripts/extract-docs.rs",
        "clean": "rm -rf dist",
        "cleanbuild": "deno task clean && deno task build",
        "dev": "deno run -A npm:@modelcontextprotocol/inspector dist/index.js",
        "start": "node dist/index.js",
        "test": "node --test tests/**/*.test.js"
    },
    "type": "module",
    "version": "0.2.0"
}
