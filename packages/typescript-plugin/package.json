{
    "author": "macroforge contributors",
    "bugs": {
        "url": "https://github.com/macroforge-ts/macroforge-ts/issues"
    },
    "dependencies": {
        "@macroforge/shared": "file:../shared",
        "macroforge": "file:../../crates/macroforge_ts"
    },
    "description": "TypeScript language service plugin that augments classes decorated with @derive to include macro-generated methods.",
    "devDependencies": {
        "@types/node": "^18.19.130",
        "typescript": "^5.9.3"
    },
    "files": [
        "dist"
    ],
    "homepage": "https://github.com/macroforge-ts/macroforge-ts#readme",
    "keywords": [
        "typescript",
        "tsserver",
        "plugin",
        "macros",
        "derive",
        "language-service"
    ],
    "license": "MIT",
    "main": "dist/index.js",
    "name": "@macroforge/typescript-plugin",
    "peerDependencies": {
        "typescript": ">=5.0.0"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/macroforge-ts/macroforge-ts.git"
    },
    "scripts": {
        "build": "deno install --node-modules-dir --quiet && node ./scripts/link-workspace-deps.mjs && deno run -A npm:typescript@5/tsc -p tsconfig.json",
        "clean": "rm -rf dist",
        "cleanbuild": "deno task clean && deno task build",
        "test": "deno task build && node --test tests/**/*.test.cjs"
    },
    "type": "module",
    "types": "dist/index.d.ts",
    "version": "0.1.80"
}
