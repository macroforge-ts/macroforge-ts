{
    "name": "@macroforge/typescript-plugin",
    "version": "0.1.79",
    "license": "MIT",
    "exports": {
        ".": "./src/index.ts"
    },
    "imports": {
        "typescript/lib/tsserverlibrary": "npm:typescript@^5.9.3/lib/tsserverlibrary",
        "macroforge": "npm:macroforge@^0.1.79",
        "@macroforge/shared": "npm:@macroforge/shared@^0.1.79"
    },
    "unstable": ["sloppy-imports"],
    "publish": {
        "exclude": ["tests/", "dist/", "scripts/", "node_modules/"]
    },
    "fmt": {
        "useTabs": false,
        "indentWidth": 4,
        "lineWidth": 100,
        "singleQuote": true,
        "semiColons": true,
        "trailingCommas": "never",
        "exclude": ["**/fixtures/**", "**/dist", "**/build", "**/node_modules"]
    },
    "lint": {
        "exclude": [
            "**/fixtures/**",
            "**/tests/**",
            "**/dist",
            "**/build",
            "**/node_modules",
            "**/*.config.ts",
            "**/*.config.js"
        ],
        "rules": {
            "tags": ["recommended"],
            "include": ["eqeqeq"],
            "exclude": [
                "require-await",
                "no-process-global",
                "no-node-globals",
                "no-irregular-whitespace",
                "no-explicit-any",
                "no-inner-declarations"
            ]
        }
    }
}
