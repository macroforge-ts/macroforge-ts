{
    "name": "@macroforge/deno-plugin",
    "version": "0.3.1",
    "description": "Deno-native macro expansion for projects that don't use Vite",
    "exports": [
        {
            "name": "ExpandOptions",
            "kind": "interface",
            "type": null,
            "description": "Options for {@link expand} and {@link expandFile}."
        },
        {
            "name": "ExpandResult",
            "kind": "interface",
            "type": null,
            "description": "What expanding one source produced."
        },
        {
            "name": "expand",
            "kind": "function",
            "type": "(code: string, filepath: string, options?: ExpandOptions) => ExpandResult",
            "description": "Expand a single in-memory TypeScript source string. Looks up and parses `macroforge.config.*` from `projectRoot` (or `Deno.cwd()`) on every call — the config is not cached — and forwards every other concern to the Rust engine.",
            "params": [
                {
                    "name": "code",
                    "type": "string",
                    "description": ""
                },
                {
                    "name": "filepath",
                    "type": "string",
                    "description": ""
                },
                {
                    "name": "options",
                    "type": "ExpandOptions",
                    "description": ""
                }
            ],
            "returns": "ExpandResult"
        },
        {
            "name": "expandFile",
            "kind": "function",
            "type": "async (filepath: string, options?: ExpandOptions) => Promise<ExpandResult>",
            "description": "Read a file from disk and expand it.",
            "params": [
                {
                    "name": "filepath",
                    "type": "string",
                    "description": ""
                },
                {
                    "name": "options",
                    "type": "ExpandOptions",
                    "description": ""
                }
            ],
            "returns": "Promise<ExpandResult>"
        }
    ]
}
