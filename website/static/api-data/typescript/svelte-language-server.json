{
    "name": "@macroforge/svelte-language-server",
    "version": "0.5.0",
    "description": "A language server for Svelte with macroforge integration",
    "exports": [
        {
            "name": "LSOptions",
            "kind": "interface",
            "type": null,
            "description": "Options for {@link startServer}."
        },
        {
            "name": "startServer",
            "kind": "function",
            "type": "(options?: LSOptions) => void",
            "description": "Starts the language server.",
            "params": [
                {
                    "name": "options",
                    "type": "LSOptions",
                    "description": "Options to customize behavior"
                }
            ]
        },
        {
            "name": "SvelteCheckDiagnosticSource",
            "kind": "type",
            "type": "'js' | 'css' | 'svelte'",
            "description": "A kind of diagnostic svelte-check can report."
        },
        {
            "name": "SvelteCheckOptions",
            "kind": "interface",
            "type": null,
            "description": "Options for {@link SvelteCheck}."
        },
        {
            "name": "SvelteCheck",
            "kind": "class",
            "type": null,
            "description": "Small wrapper around PluginHost's Diagnostic Capabilities for svelte-check, without the overhead of the lsp."
        }
    ]
}
