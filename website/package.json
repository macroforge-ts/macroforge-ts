    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.14",
        "@macroforge/core": "file:../crates/macroforge_ts",
        "@sveltejs/adapter-static": "^3.0.10",
        "@sveltejs/kit": "^2.70.3",
        "@sveltejs/vite-plugin-svelte": "^7.3.0",
        "@tailwindcss/typography": "^0.5.20",
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^26.6.2",
        "autoprefixer": "^10.6.1",
        "mdsvex": "^0.12.8",
        "postcss": "^8.5.28",
        "remark-gfm": "^4.0.1",
        "shiki": "^4.4.3",
        "svelte": "^5.57.1",
        "svelte-check": "^4.7.6",
        "tailwindcss": "^4.3.3",
        "typescript": "^5.9.3",
        "vite": "^8.3.0",
        "wrangler": "^4.135.0"
    },
    "name": "website",
    "private": true,
    "scripts": {
        "build": "vite build",
        "build:clean": "rm -rf node_modules && rm -rf .svelte-kit build && deno install --node-modules-dir && vite build",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "deploy": "vite build && wrangler deploy",
        "dev": "vite dev",
        "lint": "deno lint",
        "prepare": "svelte-kit sync || echo ''",
        "preview": "vite preview"
    },
    "type": "module",
    "version": "0.2.0"
