# Build output
**/target/
# npm packages built by tooling/npm/build.ts; published from here.
/npm/
**/dist/
**/build/
**/coverage/
**/.svelte-kit/
**/.output/
**/*.tsbuildinfo
tooling/bench-bins/
tooling/playground/library/dist-unexpanded/

# Native and WebAssembly artifacts. `crates/macroforge_ts/pkg` is the
# wasm-bindgen output the npm package ships; it is produced by `deno task
# build`, not committed.
**/*.node
**/*.wasm
**/*.pdb
crates/macroforge_ts/pkg/
tooling/playground/macro/pkg/
tooling/playground/macro/pkg-wasm/

# Dependencies
**/node_modules/
**/.pnpm-store/
**/.pixi/
# Symlinks into this checkout, created by the macro crate's `setup-vendor` task.
tooling/playground/macro/vendor/

# Per-project macroforge state: registries, cache, lock and debug log. The
# registries record absolute paths, so they must never be committed.
**/.macroforge/
**/*.expanded.*
# Expansion fixtures are committed on purpose.
!**/tests/fixtures/*.expanded.*

# Temporary siblings atomic writes rename over their destination.
**/*.macroforge-staging-*
**/*.macroforge-old-*

# Generated into the svelte playground by the expansion pass.
tooling/playground/svelte/src/lib/form/
tooling/playground/svelte/src/lib/types/
tooling/playground/svelte/src/lib/traits/

# Regenerated by the playground suites on every run.
tooling/playground/tests/playwright-report/
# Traces and screenshots from browser-driven checks.
.playwright-mcp/
tooling/playground/tests/test-results/
tooling/playground/tests/validators/.temp/

# Scratch files beside the language-server fixtures.
packages/svelte-language-server/test/plugins/typescript/features/folding-range/debug.svelte
packages/svelte-language-server/test/plugins/typescript/features/inlayHints/debug.svelte
# A fixture that deliberately lives under a node_modules path. The directory
# has to be unignored before git will look inside it.
!packages/svelte-language-server/test/plugins/typescript/features/diagnostics/fixtures/exports-map-svelte/node_modules/
!packages/svelte-language-server/test/plugins/typescript/features/diagnostics/fixtures/exports-map-svelte/node_modules/**
# svelte2tsx writes its shims here at runtime.
**/.svelte2tsx-language-server-files/

# Environment
**/.env
**/.env.*
!**/.env.example
!**/.env.test

# Deployment
**/.vercel/
**/.netlify/
**/.wrangler/

# Logs and temporary files
**/*.log
**/npm-debug.log*
**/tmp/
**/temp/
**/.tmp/
**/*.tmp
**/*.zip
**/*.rs.bk
**/*.swp
**/*.swo
**/*~
tooling/tests/e2e/zed-diagnostics.log

# Editors and OS
.claude/
**/.vscode/
**/.idea/
**/.DS_Store
**/Thumbs.db
**/vite.config.js.timestamp-*
**/vite.config.ts.timestamp-*
